{{!-- Product listing template. Expects `products`, `user` and `currency`. --}}
<section class="products">
  {{#if user}}
    <h2>Welcome back, {{user.firstName}}!</h2>
  {{else}}
    <h2>Welcome, guest</h2>
  {{/if}}

  {{! Short comment: products are pre-sorted by the server }}
  {{#each products as |product index|}}
    <article class="product {{#if product.onSale}}sale{{/if}}" data-index="{{index}}">
      <h3>{{product.name}}</h3>
      <p>{{{product.descriptionHtml}}}</p>
      <span class="price">{{formatPrice product.price currency=../currency}}</span>
      {{#unless product.inStock}}
        <em>Out of stock</em>
      {{/unless}}
      {{#each product.tags}}
        <span class="tag">{{this}}</span>{{#unless @last}}, {{/unless}}
      {{/each}}
    </article>
  {{else}}
    <p>No products found.</p>
  {{/each}}

  {{#with user.address}}
    <address>{{street}}, {{city}} {{postcode}}</address>
  {{/with}}

  {{> pagination page=currentPage total=pageCount}}
  {{log "rendered" products.length level="debug"}}
  {{#> layout title="Catalogue"}}
    <p>Fallback content for {{lookup labels "footer"}}</p>
  {{/layout}}
  {{~#if debug~}}
    <pre>{{json this}} {{true}} {{42}} {{null}}</pre>
  {{~/if~}}
</section>
