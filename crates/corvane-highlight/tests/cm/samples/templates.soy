// Closure Templates for the Corvane demo.
{namespace corvane.demo.templates}

import {Button, Icon} from 'corvane/ui/widgets.soy';
import * as utils from "corvane/utils.soy";

/**
 * Renders a greeting card.
 * @param name The person's name.
 * @param? count Optional counter.
 */
{template .greeting}
  {@param name: string}
  {@param? count: number|null}
  {@param items: list<[title: string, price: float]>}
  {@inject locale: string}
  {@state open: bool = false}
  <div class="greeting" data-count="{$count ?: 0}">
    <h1>Hello, {$name}! Zoë — 中文</h1>
    {if $count > 1 and not $open}
      <p>You have {$count} new messages.</p>
    {elseif $count == 1}
      <p>One new message.</p>
    {else}
      <p>No messages.</p>
    {/if}
    {for $item, $i in $items}
      <li class="{$i % 2 == 0 ? 'even' : 'odd'}">{$item.title}: {$item.price |formatNum}</li>
    {ifempty}
      <li>Nothing here</li>
    {/for}
    {let $total: sum($items) /}
    {let $label kind="text"}
      Total: {$total}
    {/let}
    {call .footer}
      {param year: 2026 /}
      {param links: [1, 2, 3] /}
      {param extra kind="html"}<b>bold</b>{/param}
    {/call}
    {call utils.helper data="all" /}
    {$undeclared}
    {print $name |escapeHtml}
    {msg desc="Welcome message"}
      Welcome back, {$name}!
    {/msg}
    {switch $count}
      {case 0}
        zero
      {case 1, 2}
        few
      {default}
        many
    {/switch}
    {let $m: map('a': 1, 'b': 2) /}
    {let $r: record(x: 1, y: "two") /}
    {let $doubled: [$n * 2 for $n in [1, 2, 3] if $n > 1] /}
    <{Button(label: 'Go')} onClick="{$open}" />
    {literal}
      This {is} not {parsed}. // nor this
    {/literal}
    /* block comment
       spanning lines @param ghost unused */
    <script>
      var x = {$count}; // js comment
    </script>
    <style>
      .greeting {lb} color: red; {rb}
    </style>
    <p>unterminated "string {$name}
    {badtag}
    {/unknown}
  </div>
</template>
{/template}

{template .footer kind="html" visibility="private"}
  {@param year: int}
  {@param links: list<int>}
  {@param? tpl: (a: string) => html}
  <footer>&copy; {$year}</footer>
{/template}

{deltemplate corvane.demo.variant variant="'dark'"}
	<span>tab-indented body</span>
{/deltemplate}

{template .styles kind="css"}
  .card {lb} margin: 0; {rb}
{/template}

{template .script kind="js"}
  var data = {$ij.data};
{/template}

{export const PI = 3.14 /}
{extern parse: (s: string) => int}
  {jsimpl namespace="goog.string" function="parseInt" /}
{/extern}
