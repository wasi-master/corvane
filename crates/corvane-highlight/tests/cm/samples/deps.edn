;; deps.edn for the inventory service
{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/data.json {:mvn/version "2.4.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.894"}
        ring/ring-core {:mvn/version "1.10.0" :exclusions [commons-io/commons-io]}
        metosin/reitit {:mvn/version "0.7.0-alpha7"}
        io.github.clojure/tools.build {:git/tag "v0.9.6" :git/sha "8e78bcc"}
        local/helpers {:local/root "../helpers"}}

 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}
                     cider/cider-nrepl {:mvn/version "0.44.0"}}
        :jvm-opts ["-Xmx2g" "-Dclojure.server.repl={:port 5555 :accept clojure.core.server/repl}"]}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test
         :exec-args {:dirs ["test"] :patterns [".*-test$"]}}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.9.6"}}
          :ns-default build}

  :outdated {:replace-deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
             :main-opts ["-m" "antq.core"]}}

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 :settings {:port 8080
            :timeout-ms 30000
            :ratio 0.75
            :retries -3
            :fraction 3/4
            :big 12345678901234567890N
            :precise 1.25M
            :enabled? true
            :fallback nil
            :tags #{:web :api :db}
            :started #inst "2024-05-01T12:00:00Z"
            :id #uuid "7d9f2b3a-1c4e-4f5a-9b8c-0d1e2f3a4b5c"
            :char \x
            :name "Inventaire — été"}}
