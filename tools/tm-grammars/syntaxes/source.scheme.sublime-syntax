  - include: repo_sexp
  - include: repo_string
  - include: repo_language-functions
  - include: repo_quote
  - include: repo_illegal
  repo_comment:
  - match: (^[ \t]+)?(?=;)
    captures:
      1: punctuation.whitespace.comment.leading.scheme
    push:
    - match: (?!)
      pop: true
    - match: ;
      captures:
        0: punctuation.definition.comment.scheme
      push:
      - meta_scope: comment.line.semicolon.scheme
      - match: \n
        pop: true
  repo_constants:
  - match: '#[t|f]'
    scope: constant.language.boolean.scheme
  - match: (?<=[\(\s])((#e|#i)?[0-9]+(\.[0-9]+)?|(#x)[0-9a-fA-F]+|(#o)[0-7]+|(#b)[01]+)(?=[\s;()'",\[\]])
    scope: constant.numeric.scheme
  repo_illegal:
  - match: '[()]'
    scope: invalid.illegal.parenthesis.scheme
  repo_language-functions:
  - match: "(?x)\n\t\t\t\t\t\t(?<=(\\s|\\(|\\[)) # preceded by space or ( \n\t\t\t\t\t\t( do|or|and|else|quasiquote|begin|if|case|set!|\n\t\t\t\t\t\t  cond|let|unquote|define|let\\*|unquote-splicing|delay|\n\t\t\t\t\t\t  letrec)\n\t\t\t\t\t\t(?=(\\s|\\())"
    scope: keyword.control.scheme
  - match: "(?x)\n\t\t\t\t\t\t(?<=(\\s|\\()) # preceded by space or (\n\t\t\t\t\t\t( char-alphabetic|char-lower-case|char-numeric|\n\t\t\t\t\t\t  char-ready|char-upper-case|char-whitespace|\n\t\t\t\t\t\t  (?:char|string)(?:-ci)?(?:=|<=?|>=?)|\n\t\t\t\t\t\t  atom|boolean|bound-identifier=|char|complex|\n\t\t\t\t\t\t  identifier|integer|symbol|free-identifier=|inexact|\n\t\t\t\t\t\t  eof-object|exact|list|(?:input|output)-port|pair|\n\t\t\t\t\t\t  real|rational|zero|vector|negative|odd|null|string|\n\t\t\t\t\t\t  eq|equal|eqv|even|number|positive|procedure\n\t\t\t\t\t\t)\n\t\t\t\t\t\t(\\?)\t\t# name ends with ? sign\n\t\t\t\t\t\t(?=(\\s|\\()) # followed by space or (\n\t\t\t\t\t"
    scope: support.function.boolean-test.scheme
  - match: "(?x)\n\t\t\t\t\t\t(?<=(\\s|\\()) # preceded by space or (\n\t\t\t\t\t\t( char->integer|exact->inexact|inexact->exact|\n\t\t\t\t\t\t  integer->char|symbol->string|list->vector|\n\t\t\t\t\t\t  list->string|identifier->symbol|vector->list|\n\t\t\t\t\t\t  string->list|string->number|string->symbol|\n\t\t\t\t\t\t  number->string\n\t\t\t\t\t\t)\n\t\t\t\t\t\t(?=(\\s|\\()) # followed by space or (\t\t\t\t\t\n\t\t\t\t\t"
    scope: support.function.convert-type.scheme
  - match: "(?x)\n\t\t\t\t\t\t(?<=(\\s|\\()) # preceded by space or (\n\t\t\t\t\t\t( set-(?:car|cdr)|\t\t\t\t # set car/cdr\n\t\t\t\t\t\t  (?:vector|string)-(?:fill|set) # fill/set string/vector\n\t\t\t\t\t\t)\n\t\t\t\t\t\t(!)\t\t\t# name ends with ! sign\n\t\t\t\t\t\t(?=(\\s|\\()) # followed by space or (\n\t\t\t\t\t"
    scope: support.function.with-side-effects.scheme
  - match: "(?x)\n\t\t\t\t\t\t(?<=(\\s|\\()) # preceded by space or (\n\t\t\t\t\t\t( >=?|<=?|=|[*/+-])\n\t\t\t\t\t\t(?=(\\s|\\()) # followed by space or (\n\t\t\t\t\t\t"
    scope: keyword.operator.arithmetic.scheme
  - match: "(?x)\n\t\t\t\t\t\t(?<=(\\s|\\()) # preceded by space or (\n\t\t\t\t\t\t( append|apply|approximate|\n\t\t\t\t\t\t  call-with-current-continuation|call/cc|catch|\n\t\t\t\t\t\t  construct-identifier|define-syntax|display|foo|\n\t\t\t\t\t\t  for-each|force|cd|gen-counter|gen-loser|\n\t\t\t\t\t\t  generate-identifier|last-pair|length|let-syntax|\n\t\t\t\t\t\t  letrec-syntax|list|list-ref|list-tail|load|log|\n\t\t\t\t\t\t  macro|magnitude|map|map-streams|max|member|memq|\n\t\t\t\t\t\t  memv|min|newline|nil|not|peek-char|rationalize|\n\t\t\t\t\t\t  read|read-char|return|reverse|sequence|substring|\n\t\t\t\t\t\t  syntax|syntax-rules|transcript-off|transcript-on|\n\t\t\t\t\t\t  truncate|unwrap-syntax|values-list|write|write-char|\n\t\t\t\t\t\t  \n\t\t\t\t\t\t  # cons, car, cdr, etc\n\t\t\t\t\t\t  cons|c(a|d){1,4}r| \n                          \n\t\t\t\t\t\t  # unary math operators\n\t\t\t\t\t\t  abs|acos|angle|asin|assoc|assq|assv|atan|ceiling|\n\t\t\t\t\t\t  cos|floor|round|sin|sqrt|tan|\n\
      \t\t\t\t\t\t  (?:real|imag)-part|numerator|denominator\n                          \n\t\t\t\t\t\t  # other math operators\n\t\t\t\t\t\t  modulo|exp|expt|remainder|quotient|lcm|\n                          \n\t\t\t\t\t\t  # ports / files\n\t\t\t\t\t\t  call-with-(?:input|output)-file|\n\t\t\t\t\t\t  (?:close|current)-(?:input|output)-port|\n\t\t\t\t\t\t  with-(?:input|output)-from-file|\n\t\t\t\t\t\t  open-(?:input|output)-file|\n\t\t\t\t\t\t  \n\t\t\t\t\t\t  # char-\xABfoo\xBB\n\t\t\t\t\t\t  char-(?:downcase|upcase|ready)|\n\t\t\t\t\t\t  \n\t\t\t\t\t\t  # make-\xABfoo\xBB\n\t\t\t\t\t\t  make-(?:polar|promise|rectangular|string|vector)\n\t\t\t\t\t\t  \n\t\t\t\t\t\t  # string-\xABfoo\xBB, vector-\xABfoo\xBB\n\t\t\t\t\t\t  string(?:-(?:append|copy|length|ref))?|\n\t\t\t\t\t\t  vector(?:-length|-ref)\n\t\t\t\t\t\t)\n\t\t\t\t\t\t(?=(\\s|\\()) # followed by space or (\n\t\t\t\t\t"
    scope: support.function.general.scheme
  repo_quote:
  - match: "(?x)\n\t\t\t\t\t\t(')\\s*\n\t\t\t\t\t\t([[:alnum:]][[:alnum:]!$%&*+-./:<=>?@^_~]*)\n\t\t\t\t\t"
    scope: constant.other.symbol.scheme
    captures:
      1: punctuation.section.quoted.symbol.scheme
  - match: "(?x)\n\t\t\t\t\t\t(')\\s*\n\t\t\t\t\t\t((\\()\\s*(\\)))\n\t\t\t\t\t"
    scope: constant.other.empty-list.schem
    captures:
      1: punctuation.section.quoted.empty-list.scheme
      2: meta.expression.scheme
      3: punctuation.section.expression.begin.scheme
      4: punctuation.section.expression.end.scheme
  - match: (')\s*
    captures:
      1: punctuation.section.quoted.scheme
    push:
    - meta_scope: string.other.quoted-object.scheme
    - match: (?=[\s()])|(?<=\n)
      pop: true
    - include: repo_quoted
  repo_quote-sexp:
  - match: (?<=\()\s*(quote)\b\s*
    captures:
      1: keyword.control.quote.scheme
    push:
    - meta_content_scope: string.other.quote.scheme
    - match: (?=[\s)])|(?<=\n)
      pop: true
    - include: repo_quoted
  repo_quoted:
  - include: repo_string
  - match: (\()
    captures:
      1: punctuation.section.expression.begin.scheme
    push:
    - meta_scope: meta.expression.scheme
    - match: (\))
      pop: true
      captures:
        1: punctuation.section.expression.end.scheme
    - include: repo_quoted
  - include: repo_quote
  - include: repo_illegal
  repo_sexp:
  - match: (\()
    captures:
      1: punctuation.section.expression.begin.scheme
    push:
    - meta_scope: meta.expression.scheme
    - match: (\))(\n)?
      pop: true
      captures:
        1: punctuation.section.expression.end.scheme
        2: meta.after-expression.scheme
    - include: repo_comment
    - match: "(?x)\n\t\t\t\t\t\t(?<=\\()       # preceded by (\n\t\t\t\t\t\t(define)\\s+   # define\n\t\t\t\t\t\t(\\()          # list of parameters\n\t\t\t\t\t\t  ([[:alnum:]][[:alnum:]!$%&*+-./:<=>?@^_~]*)\n\t\t\t\t\t\t  ((\\s+\n\t\t\t\t\t\t    ([[:alnum:]][[:alnum:]!$%&*+-./:<=>?@^_~]*|[._])\n\t\t\t\t\t\t   )*\n\t\t\t\t\t\t  )\\s*\n\t\t\t\t\t\t(\\))\n\t\t\t\t\t"
      captures:
        1: keyword.control.scheme
        2: punctuation.definition.function.scheme
        3: entity.name.function.scheme
        4: variable.parameter.function.scheme
        7: punctuation.definition.function.scheme
      push:
      - meta_scope: meta.declaration.procedure.scheme
      - match: (?=\))
        pop: true
        captures:
          1: keyword.control.scheme
          2: punctuation.definition.function.scheme
          3: entity.name.function.scheme
          4: variable.parameter.function.scheme
          7: punctuation.definition.function.scheme
      - include: repo_comment
      - include: repo_sexp
      - include: repo_illegal
    - match: "(?x)\n\t\t\t\t\t\t(?<=\\() # preceded by (\n\t\t\t\t\t\t(lambda)\\s+\n\t\t\t\t\t\t(\\() # opening paren\n\t\t\t\t\t\t((?:\n\t\t\t\t\t\t  ([[:alnum:]][[:alnum:]!$%&*+-./:<=>?@^_~]*|[._])\n\t\t\t\t\t\t  \\s+\n\t\t\t\t\t\t)*(?:\n\t\t\t\t\t\t  ([[:alnum:]][[:alnum:]!$%&*+-./:<=>?@^_~]*|[._])\n\t\t\t\t\t\t)?)\n\t\t\t\t\t\t(\\)) # closing paren\n\t\t\t\t\t"
      captures:
        1: keyword.control.scheme
        2: punctuation.definition.variable.scheme
        3: variable.parameter.scheme
        6: punctuation.definition.variable.scheme
      push:
      - meta_scope: meta.declaration.procedure.scheme
      - match: (?=\))
        pop: true
        captures:
          1: keyword.control.scheme
          2: punctuation.definition.variable.scheme
          3: variable.parameter.scheme
          6: punctuation.definition.variable.scheme
      - include: repo_comment
      - include: repo_sexp
      - include: repo_illegal
    - match: (?<=\()(define)\s([[:alnum:]][[:alnum:]!$%&*+-./:<=>?@^_~]*)\s*.*?
      captures:
        1: keyword.control.scheme
        2: variable.other.scheme
      push:
      - meta_scope: meta.declaration.variable.scheme
      - match: (?=\))
        pop: true
        captures:
          1: keyword.control.scheme
          2: variable.other.scheme
      - include: repo_comment
      - include: repo_sexp
      - include: repo_illegal
    - include: repo_quote-sexp
    - include: repo_quote
    - include: repo_language-functions
    - include: repo_string
    - include: repo_constants
    - match: (?<=[\(\s])(#\\)(space|newline|tab)(?=[\s\)])
      scope: constant.character.named.scheme
    - match: (?<=[\(\s])(#\\)x[0-9A-F]{2,4}(?=[\s\)])
      scope: constant.character.hex-literal.scheme
    - match: (?<=[\(\s])(#\\).(?=[\s\)])
      scope: constant.character.escape.scheme
    - match: (?<=[ ()])\.(?=[ ()])
      scope: punctuation.separator.cons.scheme
    - include: repo_sexp
    - include: repo_illegal
  repo_string:
  - match: (")
    captures:
      1: punctuation.definition.string.begin.scheme
    push:
    - meta_scope: string.quoted.double.scheme
    - match: (")
      pop: true
      captures:
        1: punctuation.definition.string.end.scheme
    - match: \\.
      scope: constant.character.escape.scheme
