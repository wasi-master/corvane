%YAML 1.2
---
# NEON (source.neon): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-etc via GitHub Linguist v9.7.0 (license: isc).
name: NEON
scope: source.neon
file_extensions:
- neon
contexts:
  main:
  - include: repo_main
  repo_boolean:
  - match: \b(TRUE|True|true|YES|Yes|yes|ON|On|on)\b
    scope: constant.language.boolean.true.neon
  - match: \b(FALSE|False|false|NO|No|no|OFF|Off|off)\b
    scope: constant.language.boolean.false.neon
  repo_brackets:
  - match: \[
    captures:
      0: punctuation.definition.bracket.square.begin.neon
    push:
    - match: \]
      pop: true
      captures:
        0: punctuation.definition.bracket.square.end.neon
    - include: repo_main
  - match: '{'
    captures:
      0: punctuation.definition.bracket.curly.brace.begin.neon
    push:
    - match: '}'
      pop: true
      captures:
        0: punctuation.definition.bracket.curly.brace.end.neon
    - include: repo_main
  - match: \(
    captures:
      0: punctuation.definition.bracket.round.parenthesis.begin.neon
    push:
    - match: \)
      pop: true
      captures:
        0: punctuation.definition.bracket.round.parenthesis.end.neon
    - include: repo_main
  repo_comma:
  - match: ','
    scope: punctuation.separator.delimiter.comma.neon
  repo_comment:
  - match: (?<=\s|^)#
    captures:
      0: punctuation.definition.comment.neon
    push:
    - meta_scope: comment.line.number-sign.neon
    - match: $
      pop: true
  repo_datetime:
  - match: "(?x)\n\n# Date\n(\n\t(\\d{4})   (-)  # Year\n\t(\\d{1,2}) (-)  # Month\n\t(\\d{1,2})      # Day\n)\n\n# Time\n(\n\t([Tt]|\\s++)          # Separator\n\t(\\d{1,2}) (:)        # Hour\n\t(\\d{2})   (:)        # Minute\n\t(\\d{2}(?:\\.\\d*+)?) # Second\n\t\\s*+\n\t\n\t# 10: Timezone\n\t((Z)|[-+]\\d{1,2}(?::?\\d{2})?)?\n)?\n\\s*$"
    scope: constant.numeric.datetime.neon
    captures:
      1: constant.numeric.date.neon
      10: punctuation.delimiter.separator.colon.neon
      11: constant.numeric.time.minute.neon
      12: punctuation.delimiter.separator.colon.neon
      13: constant.numeric.time.second.neon
      14: constant.numeric.time.timezone.tz.neon
      15: punctuation.separator.timezone.neon
      2: constant.numeric.date.year.neon
      3: punctuation.delimiter.separator.dash.hyphen.neon
      4: constant.numeric.date.month.neon
      5: punctuation.delimiter.separator.dash.hyphen.neon
      6: constant.numeric.date.day.neon
      7: constant.numeric.time.neon
      8: punctuation.separator.datetime.neon
      9: constant.numeric.time.hour.neon
  repo_entity:
  - match: "(?x)\n(\n\t[^\\#\"',:=@\\[\\]{}()\\s!`]\n\t(?: [^\\#,:=\\]})(]\n\t| : [^\\s,\\]})]\n\t| \\S\\#\n\t)*\n) \\s* (\\()"
    captures:
      1: entity.name.type.neon
      2: punctuation.definition.entity.begin.neon
    push:
    - meta_scope: meta.entity.definition.neon
    - match: \)
      pop: true
      captures:
        0: punctuation.definition.entity.end.neon
    - include: repo_main
  repo_int:
  - match: 0x[0-9a-fA-F]++(?=\s*$)
    scope: constant.numeric.integer.int.hexadecimal.hex.neon
  - match: 0o[0-7]++(?=\s$)
    scope: constant.numeric.integer.int.octal.oct.neon
  - match: 0b[0-1]++(?=\s$)
    scope: constant.numeric.integer.int.binary.bin.neon
  repo_kv:
  - match: "(?x)\n(\n\t[^\\#\"',:=@\\[\\]{}()\\s!`]\n\t(?: [^\\#,:=\\]})(]\n\t| : [^\\s,\\]})]\n\t| \\S\\#\n\t)*+\n)\n(:|=)"
    captures:
      1: entity.name.tag.neon
      2: keyword.operator.assignment.key-value.neon
  repo_main:
  - include: repo_comment
  - include: repo_kv
  - include: repo_boolean
  - include: repo_brackets
  - include: repo_datetime
  - include: repo_int
  - include: repo_null
  - include: repo_strings
  - include: repo_comma
  - include: repo_number
  - include: repo_entity
  - include: repo_unquoted
  repo_null:
  - match: \b(NULL|Null|null)\b(?=\s*(?:$|[\]}),]|(?<=\s)#))
    scope: constant.language.null.neon
  repo_number:
  - match: '[-+]?(?:[0-9]*\.[0-9]+|[0-9]+\.)(?:[eE][-+]?[0-9]+)++(?=\s*(?:$|[\]}),]|(?<=\s)#))'
    scope: constant.numeric.float.real.decimal.dec.exponential.scientific.neon
  - match: '[-+]?(?:[0-9]*\.[0-9]+|[0-9]+\.)++(?=\s*(?:$|[\]}),]|(?<=\s)#))'
    scope: constant.numeric.float.real.decimal.dec.neon
  - match: '[-+]?[0-9]+[eE][-+]?[0-9]+(?=\s*(?:$|[\]}),]|(?<=\s)#))'
    scope: constant.numeric.integer.int.decimal.dec.exponential.scientific.neon
  - match: '[-+]?[0-9]+(?=\s*(?:$|[\]}),]|(?<=\s)#))'
    scope: constant.numeric.integer.int.decimal.dec.neon
  repo_strings:
  - match: (''')\s*$
    captures:
      1: punctuation.definition.string.begin.neon
    push:
    - meta_scope: string.quoted.single.heredoc.neon
    - match: ^\s*(''')
      pop: true
      captures:
        1: punctuation.definition.string.end.neon
  - match: (""")\s*$
    captures:
      1: punctuation.definition.string.begin.neon
    push:
    - meta_scope: string.quoted.double.heredoc.neon
    - match: ^\s*(""")
      pop: true
      captures:
        1: punctuation.definition.string.end.neon
  - match: (')
    captures:
      1: punctuation.definition.string.begin.neon
    push:
    - meta_scope: string.quoted.single.neon
    - match: (')|([^']*)$
      pop: true
      captures:
        1: punctuation.definition.string.end.neon
        2: invalid.illegal.unclosed.string.neon
    - match: '''''(?!'')'
      scope: constant.character.escape.quote.single.neon
  - match: (")
    captures:
      1: punctuation.definition.string.begin.neon
    push:
    - meta_scope: string.quoted.double.neon
    - match: (")|([^"]*)$
      pop: true
      captures:
        1: punctuation.definition.string.end.neon
        2: invalid.illegal.unclosed.string.neon
    - match: (\\)u[A-Fa-f0-9]+
      scope: constant.character.escape.unicode.codepoint.long.neon
      captures:
        1: punctuation.definition.escape.backslash.neon
    - match: (\\)x[A-Fa-f0-9]{2}
      scope: constant.character.escape.unicode.codepoint.short.neon
      captures:
        1: punctuation.definition.escape.backslash.neon
    - match: (\\)[tnrfb"\\/_]
      scope: constant.character.escape.neon
      captures:
        1: punctuation.definition.escape.backslash.neon
    - match: (\\).
      scope: invalid.illegal.unknown-escape.neon
      captures:
        1: punctuation.definition.escape.backslash.neon
  repo_unquoted:
  - match: '(?x)

      [^\#"'',:=@\[\]{}()\s!`]

      (?: [^\#,:=\]})(]

      | : [^\s,\]})]

      | \S\#

      )*'
    scope: string.unquoted.literal.neon
