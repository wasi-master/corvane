%YAML 1.2
---
# Imba (source.imba): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/imba/imba-linguist-grammar.git via GitHub Linguist v9.7.0 (license: mit).
name: Imba
scope: source.imba
file_extensions:
- imba
contexts:
  main:
  - include: repo_root
  - match: \A(#!).*(?=$)
    scope: comment.line.shebang.imba
    captures:
      1: punctuation.definition.comment.imba
  repo_array-literal:
  - match: \s*(\[)
    captures:
      1: meta.brace.square.imba
    push:
    - meta_scope: meta.array.literal.imba
    - match: \]
      pop: true
      captures:
        0: meta.brace.square.imba
    - include: repo_expr
    - include: repo_punctuation-comma
  repo_block:
  - include: repo_style-declaration
  - include: repo_object-keys
  - include: repo_tag-literal
  - include: repo_regex
  - include: repo_keywords
  - include: repo_comment
  - include: repo_literal
  - include: repo_plain-identifiers
  - include: repo_plain-accessors
  - include: repo_pairs
  - include: repo_invalid-indentation
  repo_boolean-literal:
  - match: (?<![_$[:alnum:]])(?:(?<=\.\.\.)|(?<!\.))(true|yes)(?![\?_\-$[:alnum:]])(?:(?=\.\.\.)|(?!\.))
    scope: constant.language.boolean.true.imba
  - match: (?<![_$[:alnum:]])(?:(?<=\.\.\.)|(?<!\.))(false|no)(?![\?_\-$[:alnum:]])(?:(?=\.\.\.)|(?!\.))
    scope: constant.language.boolean.false.imba
  repo_brackets:
  - match: '{'
    push:
    - match: '}|(?=\*/)'
      pop: true
    - include: repo_brackets
  - match: \[
    push:
    - match: \]|(?=\*/)
      pop: true
    - include: repo_brackets
  repo_comment:
  - match: /\*\*(?!/)
    captures:
      0: punctuation.definition.comment.imba
    push:
    - meta_scope: comment.block.documentation.imba
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.imba
    - include: repo_docblock
  - match: (/\*)(?:\s*((@)internal)(?=\s|(\*/)))?
    captures:
      1: punctuation.definition.comment.imba
      2: storage.type.internaldeclaration.imba
      3: punctuation.decorator.internaldeclaration.imba
    push:
    - meta_scope: comment.block.imba
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.imba
  - match: (###)
    captures:
      1: punctuation.definition.comment.imba
    push:
    - meta_scope: comment.block.imba
    - match: '###(?:[ \t]*\n)'
      pop: true
      captures:
        0: punctuation.definition.comment.imba
  - match: (^[ \t]+)?((//|\#\s)(?:\s*((@)internal)(?=\s|$))?)
    captures:
      1: punctuation.whitespace.comment.leading.imba
      2: comment.line.double-slash.imba
      3: punctuation.definition.comment.imba
      4: storage.type.internaldeclaration.imba
      5: punctuation.decorator.internaldeclaration.imba
    push:
    - meta_content_scope: comment.line.double-slash.imba
    - match: (?=$)
      pop: true
  repo_css-color-keywords:
  - match: (?i)(?<![\w-])(aqua|black|blue|fuchsia|gray|green|lime|maroon|navy|olive|orange|purple|red|silver|teal|white|yellow)(?![\w-])
    scope: support.constant.color.w3c-standard-color-name.css
  - match: '(?xi) (?<![\w-])

      (aliceblue|antiquewhite|aquamarine|azure|beige|bisque|blanchedalmond|blueviolet|brown|burlywood

      |cadetblue|chartreuse|chocolate|coral|cornflowerblue|cornsilk|crimson|cyan|darkblue|darkcyan

      |darkgoldenrod|darkgray|darkgreen|darkgrey|darkkhaki|darkmagenta|darkolivegreen|darkorange

      |darkorchid|darkred|darksalmon|darkseagreen|darkslateblue|darkslategray|darkslategrey|darkturquoise

      |darkviolet|deeppink|deepskyblue|dimgray|dimgrey|dodgerblue|firebrick|floralwhite|forestgreen

      |gainsboro|ghostwhite|gold|goldenrod|greenyellow|grey|honeydew|hotpink|indianred|indigo|ivory|khaki

      |lavender|lavenderblush|lawngreen|lemonchiffon|lightblue|lightcoral|lightcyan|lightgoldenrodyellow

      |lightgray|lightgreen|lightgrey|lightpink|lightsalmon|lightseagreen|lightskyblue|lightslategray

      |lightslategrey|lightsteelblue|lightyellow|limegreen|linen|magenta|mediumaquamarine|mediumblue

      |mediumorchid|mediumpurple|mediumseagreen|mediumslateblue|mediumspringgreen|mediumturquoise

      |mediumvioletred|midnightblue|mintcream|mistyrose|moccasin|navajowhite|oldlace|olivedrab|orangered

      |orchid|palegoldenrod|palegreen|paleturquoise|palevioletred|papayawhip|peachpuff|peru|pink|plum

      |powderblue|rebeccapurple|rosybrown|royalblue|saddlebrown|salmon|sandybrown|seagreen|seashell

      |sienna|skyblue|slateblue|slategray|slategrey|snow|springgreen|steelblue|tan|thistle|tomato

      |transparent|turquoise|violet|wheat|whitesmoke|yellowgreen)

      (?![\w-])'
    scope: support.constant.color.w3c-extended-color-name.css
  - match: (?i)(?<![\w-])currentColor(?![\w-])
    scope: support.constant.color.current.css
  repo_css-combinators:
  - match: '>>>|>>|>|\+|~'
    scope: punctuation.separator.combinator.css
  - match: '&'
    scope: keyword.other.parent-selector.css
  repo_css-commas:
  - match: ','
    scope: punctuation.separator.list.comma.css
  repo_css-comment:
  - match: \#(\s.+)?(\n|$)
    scope: comment.line.imba
  - match: (^\t+)(\#(\s.+)?(\n|$))
    scope: comment.line.imba
  repo_css-escapes:
  - match: \\[0-9a-fA-F]{1,6}
    scope: constant.character.escape.codepoint.css
  - match: \\$\s*
    push:
    - meta_scope: constant.character.escape.newline.css
    - match: ^(?<!)
      pop: true
  - match: \\.
    scope: constant.character.escape.css
  repo_css-functions:
  - match: (?i)(?<![\w-])(calc)(\()
    captures:
      1: support.function.calc.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - meta_scope: meta.function.calc.css
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - match: '[*/]|(?<=\s|^)[-+](?=\s|$)'
      scope: keyword.operator.arithmetic.css
    - include: repo_css-property-values
  - match: (?i)(?<![\w-])(rgba?|hsla?)(\()
    captures:
      1: support.function.misc.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - meta_scope: meta.function.color.css
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - include: repo_css-property-values
  - match: "(?xi) (?<![\\w-])\n(\n  (?:-webkit-|-moz-|-o-)?    # Accept prefixed/historical variants\n  (?:repeating-)?            # \"Repeating\"-type gradient\n  (?:linear|radial|conic)    # Shape\n  -gradient\n)\n(\\()"
    captures:
      1: support.function.gradient.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - meta_scope: meta.function.gradient.css
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - match: (?i)(?<![\w-])(from|to|at)(?![\w-])
      scope: keyword.operator.gradient.css
    - include: repo_css-property-values
  - match: (?i)(?<![\w-])(-webkit-gradient)(\()
    captures:
      1: invalid.deprecated.gradient.function.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - meta_scope: meta.function.gradient.invalid.deprecated.gradient.css
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - match: (?i)(?<![\w-])(from|to|color-stop)(\()
      captures:
        1: invalid.deprecated.function.css
        2: punctuation.section.function.begin.bracket.round.css
      push:
      - match: \)
        pop: true
        captures:
          0: punctuation.section.function.end.bracket.round.css
      - include: repo_css-property-values
    - include: repo_css-property-values
  - match: '(?xi) (?<![\w-])

      (annotation|attr|blur|brightness|character-variant|contrast|counters?

      |cross-fade|drop-shadow|element|fit-content|format|grayscale|hue-rotate

      |image-set|invert|local|minmax|opacity|ornaments|repeat|saturate|sepia

      |styleset|stylistic|swash|symbols)

      (\()'
    captures:
      1: support.function.misc.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - meta_scope: meta.function.misc.css
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - match: (?i)(?<=[,\s"]|\*/|^)\d+x(?=[\s,"')]|/\*|$)
      scope: constant.numeric.other.density.css
    - include: repo_css-property-values
    - match: '[^''"),\s]+'
      scope: variable.parameter.misc.css
  - match: (?i)(?<![\w-])(circle|ellipse|inset|polygon|rect)(\()
    captures:
      1: support.function.shape.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - meta_scope: meta.function.shape.css
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - match: (?i)(?<=\s|^|\*/)(at|round)(?=\s|/\*|$)
      scope: keyword.operator.shape.css
    - include: repo_css-property-values
  - match: (?i)(?<![\w-])(cubic-bezier|steps)(\()
    captures:
      1: support.function.timing-function.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - meta_scope: meta.function.timing-function.css
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - match: (?i)(?<![\w-])(start|end)(?=\s*\)|$)
      scope: support.constant.step-direction.css
    - include: repo_css-property-values
  - match: '(?xi) (?<![\w-])

      ( (?:translate|scale|rotate)(?:[XYZ]|3D)?

      | matrix(?:3D)?

      | skew[XY]?

      | perspective

      )

      (\()'
    captures:
      1: support.function.transform.css
      2: punctuation.section.function.begin.bracket.round.css
    push:
    - match: \)
      pop: true
      captures:
        0: punctuation.section.function.end.bracket.round.css
    - include: repo_css-property-values
  repo_css-numeric-values:
  - match: (#)(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\b
    scope: constant.other.color.rgb-value.hex.css
    captures:
      1: punctuation.definition.constant.css
  - match: "(?xi) (?<![\\w-])\n[-+]?                               # Sign indicator\n\n(?:                                 # Numerals\n    [0-9]+ (?:\\.[0-9]+)?           # Integer/float with leading digits\n  | \\.[0-9]+                       # Float without leading digits\n)\n\n(?:                                 # Scientific notation\n  (?<=[0-9])                        # Exponent must follow a digit\n  E                                 # Exponent indicator\n  [-+]?                             # Possible sign indicator\n  [0-9]+                            # Exponent value\n)?\n\n(?:                                 # Possible unit for data-type:\n  (%)                               # - Percentage\n  | ( deg|grad|rad|turn             # - Angle\n    | Hz|kHz                        # - Frequency\n    | ch|cm|em|ex|fr|in|mm|mozmm|   # - Length\n      pc|pt|px|q|rem|vh|vmax|vmin|\n      vw\n    | dpi|dpcm|dppx                 # - Resolution\n    | s|ms                          # - Time\n  \
      \  )\n  \\b                               # Boundary checking intentionally lax to\n)?                                  # facilitate embedding in CSS-like grammars"
    scope: constant.numeric.css
    captures:
      1: keyword.other.unit.percentage.css
  repo_css-property-values:
  - include: repo_css-commas
  - include: repo_css-escapes
  - include: repo_css-functions
  - include: repo_css-numeric-values
  - include: repo_css-size-keywords
  - include: repo_css-color-keywords
  - include: repo_string
  - match: '!\s*important(?![\w-])'
    scope: keyword.other.important.css
  repo_css-pseudo-classes:
  - match: "(?xi)\n(:)(:*)\n(?: active|any-link|checked|default|defined|disabled|empty|enabled|first\n  | (?:first|last|only)-(?:child|of-type)|focus|focus-visible|focus-within\n  | fullscreen|host|hover|in-range|indeterminate|invalid|left|link\n  | optional|out-of-range|placeholder-shown|read-only|read-write\n  | required|right|root|scope|target|unresolved\n  | valid|visited\n)(?![\\w-]|\\s*[;}])"
    scope: entity.other.attribute-name.pseudo-class.css
    captures:
      1: punctuation.definition.entity.css
      2: invalid.illegal.colon.css
  repo_css-pseudo-elements:
  - match: "(?xi)\n(?:\n  (::?)                       # Elements using both : and :: notation\n  (?: after\n    | before\n    | first-letter\n    | first-line\n    | (?:-(?:ah|apple|atsc|epub|hp|khtml|moz\n            |ms|o|rim|ro|tc|wap|webkit|xv)\n        | (?:mso|prince))\n      -[a-z-]+\n  )\n  |\n  (::)                        # Double-colon only\n  (?: backdrop\n    | content\n    | grammar-error\n    | marker\n    | placeholder\n    | selection\n    | shadow\n    | spelling-error\n  )\n)\n(?![\\w-]|\\s*[;}])"
    scope: entity.other.attribute-name.pseudo-element.css
    captures:
      1: punctuation.definition.entity.css
      2: punctuation.definition.entity.css
  repo_css-selector:
  - match: (?<=css\s)(?!(?:[\@\.]+[\!\<\>]?)?[\w\-\$]+(?:[\@\.]+[\!\<\>]?[\w\-\$]+)*(?:\s*\:)[^\:])
    push:
    - meta_scope: meta.selector.css
    - match: (\s*(?=(?:[\@\.]+[\!\<\>]?)?[\w\-\$]+(?:[\@\.]+[\!\<\>]?[\w\-\$]+)*(?:\s*\:)[^\:])|\s*$|(?=\s+\#\s))
      pop: true
      captures:
        0: punctuation.separator.sel-properties.css
    - include: repo_css-selector-innards
  repo_css-selector-innards:
  - include: repo_css-commas
  - include: repo_css-escapes
  - include: repo_css-combinators
  - match: \*
    scope: entity.name.tag.wildcard.css
  - match: \[
    captures:
      0: punctuation.definition.entity.begin.bracket.square.css
    push:
    - meta_scope: meta.attribute-selector.css
    - match: \]
      pop: true
      captures:
        0: punctuation.definition.entity.end.bracket.square.css
    - include: repo_string
    - match: (?<=["'\s]|^|\*/)\s*([iI])\s*(?=[\s\]]|/\*|$)
      captures:
        1: storage.modifier.ignore-case.css
    - match: (?x)(?<==)\s*((?!/\*)(?:[^\\"'\s\]]|\\.)+)
      captures:
        1: string.unquoted.attribute-value.css
    - include: repo_css-escapes
    - match: '[~|^$*]?='
      scope: keyword.operator.pattern.css
    - match: \|
      scope: punctuation.separator.css
    - match: "(?x)\n# Qualified namespace prefix\n( -?(?!\\d)(?:[\\w-]|[^\\\\x00-\\\\x7F]|\\\\(?:[0-9a-fA-F]{1,6}|.))+\n| \\*\n)\n# Lookahead to ensure there's a valid identifier ahead\n(?=\n  \\| (?!\\s|=|$|\\])\n  (?: -?(?!\\d)\n   |   [\\\\\\w-]\n   |   [^\\\\x00-\\\\x7F]\n   )\n)"
      captures:
        1: entity.other.namespace-prefix.css
    - match: '(?x)

        (-?(?!\d)(?>[\w-]|[^\\x00-\\x7F]|\\(?:[0-9a-fA-F]{1,6}|.))+)

        \s*

        (?=[~|^\]$*=]|/\*)'
      captures:
        1: entity.other.attribute-name.css
  - include: repo_css-pseudo-classes
  - include: repo_css-pseudo-elements
  repo_css-size-keywords:
  - match: (x+s|sm-|md-|lg-|sm|md|lg|x+l|hg|x+h)(?![\w-])
    scope: support.constant.size.property-value.css
  repo_curly-braces:
  - match: \s*(\{)
    captures:
      1: meta.brace.curly.imba
    push:
    - match: \}
      pop: true
      captures:
        0: meta.brace.curly.imba
    - include: repo_expr
    - include: repo_punctuation-comma
  repo_decorator:
  - match: (?<![_$[:alnum:]])(?:(?<=\.\.\.)|(?<!\.))\@(?!\@)
    captures:
      0: punctuation.decorator.imba
    push:
    - meta_scope: meta.decorator.imba
    - match: (?=\s)
      pop: true
    - include: repo_expr
  repo_directives:
  - match: ^(///)\s*(?=<(reference|amd-dependency|amd-module)(\s+(path|types|no-default-lib|lib|name)\s*=\s*((\'([^\'\\]|\\.)*\')|(\"([^\"\\]|\\.)*\")|(\`([^\`\\]|\\.)*\`)))+\s*/>\s*$)
    captures:
      1: punctuation.definition.comment.imba
    push:
    - meta_scope: comment.line.triple-slash.directive.imba
    - match: (?=$)
      pop: true
    - match: (<)(reference|amd-dependency|amd-module)
      captures:
        1: punctuation.definition.tag.directive.imba
        2: entity.name.tag.directive.imba
      push:
      - meta_scope: meta.tag.imba
      - match: />
        pop: true
        captures:
          0: punctuation.definition.tag.directive.imba
      - match: path|types|no-default-lib|lib|name
        scope: entity.other.attribute-name.directive.imba
      - match: '='
        scope: keyword.operator.assignment.imba
      - include: repo_string
  repo_docblock:
  - match: '(?x)

      ((@)(?:access|api))

      \s+

      (private|protected|public)

      \b'
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
      3: constant.language.access-type.jsdoc
  - match: "(?x)\n((@)author)\n\\s+\n(\n  [^@\\s<>*/]\n  (?:[^@<>*/]|\\*[^/])*\n)\n(?:\n  \\s*\n  (<)\n  ([^>\\s]+)\n  (>)\n)?"
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
      3: entity.name.type.instance.jsdoc
      4: punctuation.definition.bracket.angle.begin.jsdoc
      5: constant.other.email.link.underline.jsdoc
      6: punctuation.definition.bracket.angle.end.jsdoc
  - match: '(?x)

      ((@)borrows) \s+

      ((?:[^@\s*/]|\*[^/])+)    # <that namepath>

      \s+ (as) \s+              # as

      ((?:[^@\s*/]|\*[^/])+)    # <this namepath>'
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
      3: entity.name.type.instance.jsdoc
      4: keyword.operator.control.jsdoc
      5: entity.name.type.instance.jsdoc
  - match: ((@)example)\s+
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
    push:
    - meta_scope: meta.example.jsdoc
    - match: (?=@|\*/)
      pop: true
    - match: ^\s\*\s+
    - match: (<)caption(>)
      captures:
        0: entity.name.tag.inline.jsdoc
        1: punctuation.definition.bracket.angle.begin.jsdoc
        2: punctuation.definition.bracket.angle.end.jsdoc
      push:
      - meta_content_scope: constant.other.description.jsdoc
      - match: (</)caption(>)|(?=\*/)
        pop: true
        captures:
          0: entity.name.tag.inline.jsdoc
          1: punctuation.definition.bracket.angle.begin.jsdoc
          2: punctuation.definition.bracket.angle.end.jsdoc
    - match: '[^\s@*](?:[^*]|\*[^/])*'
      captures:
        0: source.embedded.imba
  - match: (?x) ((@)kind) \s+ (class|constant|event|external|file|function|member|mixin|module|namespace|typedef) \b
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
      3: constant.language.symbol-type.jsdoc
  - match: "(?x)\n((@)see)\n\\s+\n(?:\n  # URL\n  (\n    (?=https?://)\n    (?:[^\\s*]|\\*[^/])+\n  )\n  |\n  # JSDoc namepath\n  (\n    (?!\n      # Avoid matching bare URIs (also acceptable as links)\n      https?://\n      |\n      # Avoid matching {@inline tags}; we match those below\n      (?:\\[[^\\[\\]]*\\])? # Possible description [preceding]{@tag}\n      {@(?:link|linkcode|linkplain|tutorial)\\b\n    )\n    # Matched namepath\n    (?:[^@\\s*/]|\\*[^/])+\n  )\n)"
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
      3: variable.other.link.underline.jsdoc
      4: entity.name.type.instance.jsdoc
  - match: "(?x)\n((@)template)\n\\s+\n# One or more valid identifiers\n(\n  [A-Za-z_$]         # First character: non-numeric word character\n  [\\w$.\\[\\]]*        # Rest of identifier\n  (?:                # Possible list of additional identifiers\n    \\s* , \\s*\n    [A-Za-z_$]\n    [\\w$.\\[\\]]*\n  )*\n)"
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
      3: variable.other.jsdoc
  - match: "(?x)\n(\n  (@)\n  (?:arg|argument|const|constant|member|namespace|param|var)\n)\n\\s+\n(\n  [A-Za-z_$]\n  [\\w$.\\[\\]]*\n)"
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
      3: variable.other.jsdoc
  - match: ((@)typedef)\s+(?={)
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
    push:
    - match: (?=\s|\*/|[^{}\[\]A-Za-z_$])
      pop: true
    - include: repo_jsdoctype
    - match: (?:[^@\s*/]|\*[^/])+
      scope: entity.name.type.instance.jsdoc
  - match: ((@)(?:arg|argument|const|constant|member|namespace|param|prop|property|var))\s+(?={)
    captures:
      1: storage.type.class.jsdoc
      2: punctuation.definition.block.tag.jsdoc
    push:
    - match: (?=\s|\*/|[^{}\[\]A-Za-z_$])
      pop: true
    - include: repo_jsdoctype
