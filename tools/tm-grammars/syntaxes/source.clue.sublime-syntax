%YAML 1.2
---
# Clue (source.clue): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/ClueLang/Clue-for-VSCode.git via GitHub Linguist v9.7.0 (license: mit).
name: Clue
scope: source.clue
file_extensions:
- clue
contexts:
  main:
  - match: '(@version) (.+?(?=

      ))'
    captures:
      0: constant.numeric.integer.clue
      1: keyword.control.directive.clue
  - match: (@macro) ([A-Za-z_][0-9A-Za-z_]*)
    captures:
      0: meta.preprocessor.macro.clue
      1: keyword.control.macro.clue
  - match: (@import) (".*")
    captures:
      1: keyword.control.import.clue
      2: string
  - match: \$[A-Za-z_][0-9A-Za-z_]*!
    scope: meta.preprocessor.macro.invocation.clue
  - match: '@(?:(?:(?:else_)?(?:ifos|iflua|ifdef|ifndef|ifcmp|ifos|iflua|ifdef|ifcmp|if))|else|define|macro|error|print)'
    scope: keyword.control.directive.clue
  - match: (?<![\w\d.])0[xX][0-9A-Fa-f]+(?![pPeE.0-9])
    scope: constant.numeric.integer.hexadecimal.clue
  - match: (?<![\w\d.])0[xX][0-9A-Fa-f]+(\.[0-9A-Fa-f]+)?([eE]-?\d*)?([pP][-+]\d+)?
    scope: constant.numeric.float.hexadecimal.clue
  - match: (?<![\w\d.])\d+(?![pPeE.0-9])
    scope: constant.numeric.integer.clue
  - match: (?<![\w\d.])\d+(\.\d+)?([eE]-?\d*)?
    scope: constant.numeric.float.clue
  - match: ''''
    captures:
      0: punctuation.definition.string.multilined.begin.clue
    push:
    - meta_scope: string.quoted.single.clue
    - match: ''''
      pop: true
      captures:
        0: punctuation.definition.string.multilined.end.clue
    - include: repo_escaped_char
  - match: '"'
    captures:
      0: punctuation.definition.string.multilined.begin.clue
    push:
    - meta_scope: string.quoted.double.clue
    - match: '"'
      pop: true
      captures:
        0: punctuation.definition.string.multilined.end.clue
    - include: repo_escaped_char
  - match: '`'
    captures:
      0: punctuation.definition.string.multilined.begin.clue
    push:
    - meta_scope: string.multiline.clue
    - match: '`'
      pop: true
      captures:
        0: punctuation.definition.string.multilined.end.clue
    - include: repo_escaped_char
  - match: //.*
    scope: comment.line.double-dash.clue
  - match: /\*
    captures:
      0: punctuation.definition.comment.begin.clue
    push:
    - meta_scope: comment.block.clue
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.end.clue
    - include: repo_escaped_char
  - match: \b(if|elseif|else|for|of|in|with|while|meta|until|fn|method|return|loop|enum|goto|continue|break|try|catch|match|default|macro)\b
    scope: keyword.control.clue
  - match: \b(local|global|static)\b
    scope: keyword.scope.clue
  - match: (?<![^.]\.|::)\b(false|nil|true|_G|_VERSION|math\.(pi|huge))\b
    scope: constant.language.clue
  - match: \.{3}(?!\.)
    scope: constant.language.ellipsis.clue
  - match: (?<![^.]\.|::)\b(self)\b
    scope: variable.language.self.clue
  - match: \b([a-zA-Z_][a-zA-Z0-9_]*)\b(?=\(\s*)
    scope: support.function.any-method.clue
  - match: '[A-Za-z_][0-9A-Za-z_]*'
    scope: variable.other.clue
  - match: \/_|\&|\||\!|\~|\?|\.|\$|@|:|\+|-|%|#|\*|\/|\^|==?|<=?|>=?|(?<!\.)\.{2}(?!\.)|\?\?=?|(&&|\|\|)=?
    scope: keyword.operator.clue
  repo_escaped_char:
  - match: \\[abfnrtvz\\"'\n]
    scope: constant.character.escape.clue
  - match: \\\d{1,3}
    scope: constant.character.escape.byte.clue
  - match: \\x[0-9A-Fa-f][0-9A-Fa-f]
    scope: constant.character.escape.byte.clue
  - match: \\u\{[0-9A-Fa-f]+\}
    scope: constant.character.escape.unicode.clue
  - match: \\.
    scope: invalid.illegal.character.escape.clue
