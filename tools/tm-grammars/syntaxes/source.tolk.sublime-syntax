%YAML 1.2
---
# Tolk (source.tolk): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/ton-blockchain/ton-language-server.git via GitHub Linguist v9.7.0 (license: mit).
name: Tolk
scope: source.tolk
file_extensions:
- tolk
contexts:
  main:
  - match: //(.*)
    scope: comment.line.double-slash
  - match: /\*
    push:
    - meta_scope: comment.block
    - match: \*/
      pop: true
  - match: '"""'
    push:
    - meta_scope: string.quoted.triple.tolk
    - match: '"""'
      pop: true
    - match: \\.
      scope: constant.character.escape.tolk
  - match: '"'
    push:
    - meta_scope: string.quoted.double.tolk
    - match: '"'
      pop: true
    - match: \\([nrt\\'"])
      scope: constant.character.escape.tolk
  - match: \b(-?(0x[0-9a-fA-F_]*|0b[01_]*|[0-9][0-9_]*))\b
    scope: constant.numeric
  - match: \b(do|if|try|else|while|for|break|throw|catch|return|assert|repeat|continue|asm|builtin|match|lazy)\b
    scope: keyword.control
  - match: \+|-|\*|/|%|\?|:|,|;|\(|\)|\[|\]|{|}|=|<|>|!|&|\||\^|==|!=|<=|>=|<<|>>|&&|\|\||~/|\^/|\+=|-=|\*=|/=|%=|&=|\|=|\^=|->|<=>|~>>|\^>>|<<=|>>=|=>|\?\?
    scope: keyword.operator
  - match: \b(import|export|namespace|true|false|null|mutate|tolk|as|is|private|readonly)\b
    scope: keyword.other
  - match: \bself\b
    scope: keyword.other
  - match: (?<!\.)\b[TUKV]\b
    scope: entity.name.type.parameter
  - match: \b(val|var)\s+(?:type|enum|int|map|array|cell|Cell|void|dict|bool|any_address|slice|string|tuple|builder|continuation|never|unknown|coins|address|varint16|varint32|varuint16|varuint32|int\d+|uint\d+|bits\d+|bytes\d+)\b
    captures:
      1: storage.modifier
  - match: \b[A-Z][A-Z0-9_]{2,}\b
    scope: constant.other
  - match: (?<!\.)\b(type|enum|int|map|array|cell|Cell|void|dict|bool|any_address|slice|string|tuple|builder|continuation|never|unknown|coins|varint16|varint32|varuint16|varuint32|int\d+|uint\d+|bits\d+|bytes\d+)\b
    scope: storage.type
  - match: (?<!\.)\baddress\b(?!\s*:)
    scope: storage.type
  - match: \b(global|const|var|val|fun|get|struct|contract)\b
    scope: storage.modifier
  - match: (@)(?=[A-Za-z0-9_])
    captures:
      1: entity.name.function.decorator
    push:
    - match: (?![A-Za-z0-9_.])
      pop: true
    - match: '[A-Za-z0-9_]+'
      scope: entity.name.function.decorator
  - match: (\.)?(`[^`]+`|[a-zA-Z$_][a-zA-Z0-9$_]*)(?=\s*(?:<[^()\n]*>)?\s*\()
    captures:
      1: keyword.operator.accessor
      2: entity.name.function
  - match: (\.)(`[^`]+`|[a-zA-Z$_][a-zA-Z0-9$_]*)
    captures:
      1: keyword.operator.accessor
      2: variable.other.property
  - match: (?<!\.)\b[A-Z][a-zA-Z0-9]*\b
    scope: entity.name.type
