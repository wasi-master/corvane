%YAML 1.2
---
# ATS (source.ats): converted from TextMate by tools/tm-grammars/sync.py;
# source vendor/grammars/ats via GitHub Linguist v9.7.0 (license: mit).
name: ATS
scope: source.ats
file_extensions:
- dats
- hats
- sats
contexts:
  main:
  - include: repo_block
  - include: repo_comment_rest
  - include: repo_comment_line
  - include: repo_comment_block
  - include: repo_embed
  - include: repo_operators
  - include: repo_quantifier_curly
  - include: repo_quantifier_square
  - include: repo_quantifier_arrow
  - include: repo_keywords
  - include: repo_keywords_types
  - include: repo_string
  - include: repo_char
  - include: repo_records
  - include: repo_tuples
  - include: repo_number
  repo_block:
  - match: (?<=where|=|^|then|else|\$rec|\$rec_t|\$rec_vt)(?:\s*){
    push:
    - include: main
    - match: '}'
      pop: true
  repo_char:
  - match: (')([^\\]{0,1}|\\(\\|[abefpnrtv'"?]|[0-3]\d{0,2}|[4-7]\d?|x[a-fA-F0-9]{0,2}|u[a-fA-F0-9]{0,4}|U[a-fA-F0-9]{0,8}))(')
    scope: string.quoted.double
  repo_comment_block:
  - match: \(\*
    push:
    - meta_scope: comment.block
    - include: repo_comment_block
    - match: \*\)
      pop: true
  repo_comment_line:
  - match: //.*$
    scope: comment.line.double-slash
  repo_comment_rest:
  - match: ////
    push:
    - meta_scope: comment
    - match: .*
    - match: .\z
      pop: true
  repo_embed:
  - match: (%{)
    push:
    - meta_scope: meta
    - match: (%})
      pop: true
  repo_keywords:
  - match: (\#|\$)(\w+)|\b(castfn|and|andalso|assume|as|begin|break|case(\+|-)?|class|continue|dynload|dyn|else|end|exception|extern|fix|fn|for|fun|if|implement|implmnt|primplement|primplmnt|infixl|infixr|infix|in|lam|let|llam|local|macdef|macrodef|method|modprop|modtype|module|nonfix|object|of|op|or|orelse|overload|par|postfix|praxi|prefix|prfn|prfun|prval|rec|sif|staif|staload|stavar|sta|struct|symelim|symintr|then|try|union|val(\+|-)?|var|when|where|while|withprop|withtype|withviewtype|withview|with)\b
    scope: keyword
  repo_keywords_types:
  - match: (\#|\$)(\w+)|\b(abstype|abst@ype|abst0pe|absvtype|absvt@ype|absvt0pe|absviewtype|absviewt@ype|absviewt0pe|absview|absprop|datatype|datavtype|dataviewtype|dataview|dataprop|datasort|sortdef|propdef|viewdef|viewtypedef|vtypedef|stadef|typedef|)\b
    scope: keyword
  repo_number:
  - match: \b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\.?[0-9]*)|(\.[0-9]+))((e|E)(\+|~)?[0-9]+)?)(L|l|UL|ul|u|U|F|f|ll|LL|ull|ULL)?\b
    scope: constant.numeric
  repo_operators:
  - match: '!=|!|%|&&|&|\*|\+|-|-->|->|/|:=|<=|(?<=\s)<|==>|=>|=|>=|>>|>|\?|\|\||\||~|\[\]'
    scope: keyword.operator
  repo_quantifier_arrow:
  - match: (?<!\s)<
    push:
    - meta_scope: support.type
    - match: '>'
      pop: true
  repo_quantifier_curly:
  - match: ({)
    push:
    - meta_scope: support.type
    - match: (})
      pop: true
  repo_quantifier_square:
  - match: (\[)
    push:
    - meta_scope: support.type
    - match: (\])
      pop: true
  repo_records:
  - match: ('|@)({)
    push:
    - match: (})
      pop: true
    - include: main
  repo_string:
  - match: (")
    push:
    - meta_scope: string.quoted.double
    - match: (")
      pop: true
    - include: repo_string_escaped
  repo_string_escaped:
  - match: \\(\\|[abefnprtv'"?]|[0-3]\d{0,2}|[4-7]\d?|x[a-fA-F0-9]{0,2}|u[a-fA-F0-9]{0,4}|U[a-fA-F0-9]{0,8})
    scope: constant.character.escape
  repo_tuples:
  - match: ('|@)\(
    push:
    - match: (\))
      pop: true
    - include: main
