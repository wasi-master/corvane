%YAML 1.2
---
# Ballerina (source.ballerina): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/ballerina-platform/ballerina-grammar via GitHub Linguist v9.7.0 (license: apache-2.0).
name: Ballerina
scope: source.ballerina
file_extensions:
- bal
contexts:
  main:
  - include: repo_statements
  repo_access-modifier:
  - match: (?<![_$[:alnum:]])(?:(?<=\.\.\.)|(?<!\.))(public|private)(?![_$[:alnum:]])(?:(?=\.\.\.)|(?!\.))
    scope: storage.modifier.ballerina keyword.other.ballerina
  repo_annotationAttachment:
  - match: (@)((?:[_$[:alpha:]][_$[:alnum:]]*))\s*(:?)\s*((?:[_$[:alpha:]][_$[:alnum:]]*)?)
    captures:
      1: punctuation.decorator.ballerina
      2: support.type.ballerina
      3: punctuation.decorator.ballerina
      4: support.type.ballerina
  repo_annotationDefinition:
  - match: \bannotation\b
    captures:
      0: keyword.ballerina
    push:
    - match: ;
      pop: true
    - include: repo_code
  repo_array-literal:
  - match: \s*(\[)
    captures:
      1: meta.brace.square.ballerina
    push:
    - meta_scope: meta.array.literal.ballerina
    - match: \]
      pop: true
      captures:
        0: meta.brace.square.ballerina
    - include: repo_expression
    - include: repo_punctuation-comma
  repo_booleans:
  - match: \b(true|false)\b
    scope: constant.language.boolean.ballerina
  repo_butClause:
  - match: =>
    captures:
      0: meta.arrow.ballerina storage.type.function.arrow.ballerina
    push:
    - match: ',|(?=\})'
      pop: true
    - include: repo_code
  repo_butExp:
  - match: \bbut\b
    captures:
      0: keyword.ballerina
    push:
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.block.ballerina.documentation
    - include: repo_butExpBody
    - include: repo_comment
  repo_butExpBody:
  - match: \{
    captures:
      0: punctuation.definition.block.ballerina.documentation
    push:
    - match: (?=\})
      pop: true
      captures:
        0: punctuation.definition.block.ballerina.documentation
    - include: repo_parameter
    - include: repo_butClause
    - include: repo_comment
  repo_call:
  - match: (?:\')?([_$[:alpha:]][_$[:alnum:]]*)\s*(?=\()
    scope: entity.name.function.ballerina
  repo_callableUnitBody:
  - match: \{
    captures:
      0: punctuation.definition.block.ballerina
    push:
    - match: (?=\})
      pop: true
      captures:
        0: punctuation.definition.block.ballerina
    - include: repo_workerDef
    - include: repo_service-decl
    - include: repo_objectDec
    - include: repo_function-defn
    - include: repo_forkStatement
    - include: repo_code
  repo_class-body:
  - match: \{
    captures:
      0: punctuation.definition.block.ballerina
    push:
    - meta_scope: meta.class.body.ballerina
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.block.ballerina
    - include: repo_comment
    - include: repo_mdDocumentation
    - include: repo_function-defn
    - include: repo_var-expr
    - include: repo_variable-initializer
    - include: repo_access-modifier
    - include: repo_keywords
    - match: (?<=:)\s*
      push:
      - match: (?=\s|[;),}\]:\-\+]|;|^\s*$|(?:^\s*(?:abstract|async|class|const|declare|enum|export|function|import|interface|let|module|namespace|return|service|type|var)\b))
        pop: true
    - include: repo_decl-block
    - include: repo_expression
    - include: repo_punctuation-comma
    - include: repo_punctuation-semicolon
  repo_class-defn:
  - match: (\s+)(class\b)|^class\b(?=\s+|/[/*])
    captures:
      0: storage.type.class.ballerina keyword.other.ballerina
    push:
    - meta_scope: meta.class.ballerina
    - match: (?<=\})
      pop: true
    - include: repo_keywords
    - match: '[_$[:alpha:]][_$[:alnum:]]*'
      captures:
        0: entity.name.type.class.ballerina
    - include: repo_class-body
  repo_code:
  - include: repo_booleans
  - include: repo_matchStatement
  - include: repo_butExp
  - include: repo_xml
  - include: repo_stringTemplate
  - include: repo_keywords
  - include: repo_strings
  - include: repo_comment
  - include: repo_mdDocumentation
  - include: repo_annotationAttachment
  - include: repo_numbers
  - include: repo_maps
  - include: repo_paranthesised
  - include: repo_paranthesisedBracket
  - include: repo_regex
  repo_comment:
  - match: \/\/.*
    scope: comment.ballerina
  repo_constrainType:
  - match: <
    captures:
      0: punctuation.definition.parameters.begin.ballerina
    push:
    - match: '>'
      pop: true
      captures:
        0: punctuation.definition.parameters.end.ballerina
    - include: repo_comment
    - include: repo_constrainType
    - match: \b([_$[:alpha:]][_$[:alnum:]]*)\b
      scope: storage.type.ballerina
  repo_control-statement:
  - match: (?<![_$[:alnum:]])(?:(?<=\.\.\.)|(?<!\.))(return)(?![_$[:alnum:]])(?:(?=\.\.\.)|(?!\.))
    captures:
      0: keyword.control.flow.ballerina
    push:
    - match: (?=[;}]|$|;|^\s*$|(?:^\s*(?:abstract|async|class|const|declare|enum|export|function|import|interface|let|module|namespace|return|service|type|var)\b))
      pop: true
    - include: repo_expression
  - include: repo_for-loop
  - include: repo_if-statement
  - match: (?<![_$[:alnum:]])(?:(?<=\.\.\.)|(?<!\.))(else|if)(?![_$[:alnum:]])(?:(?=\.\.\.)|(?!\.))
    scope: keyword.control.conditional.ballerina
  repo_decl-block:
  - match: \{
    captures:
      0: punctuation.definition.block.ballerina
    push:
    - meta_scope: meta.block.ballerina
    - match: (?=\} external;)|(\})
      pop: true
      captures:
        0: punctuation.definition.block.ballerina
    - include: repo_statements
    - include: repo_mdDocumentation
  repo_declaration:
  - include: repo_import-declaration
  - include: repo_var-expr
  - include: repo_typeDefinition
  - include: repo_function-defn
  - include: repo_service-decl
  - include: repo_class-defn
  - include: repo_enum-decl
  - include: repo_source
  - include: repo_keywords
  repo_defaultValue:
  - match: '[=:]'
    captures:
      0: keyword.operator.ballerina
    push:
    - match: (?=[,)])
      pop: true
    - include: repo_code
  repo_defaultWithParentheses:
  - match: \(
    captures:
      0: punctuation.definition.block.ballerina
    push:
    - match: \)
      pop: true
      captures:
        0: punctuation.definition.block.ballerina
  repo_documentationBody:
  - match: \{
    captures:
      0: punctuation.definition.block.ballerina.documentation
    push:
    - match: (?=\})
      pop: true
      captures:
        0: punctuation.definition.block.ballerina.documentation
    - match: (P|R|T|F|V)({{)(.*)(}})
      captures:
        1: keyword.other.ballerina.documentation
        2: keyword.other.ballerina.documentation
        3: variable.parameter.ballerina.documentation
        4: keyword.other.ballerina.documentation
    - match: \```
      push:
      - meta_scope: comment.block.code.ballerina.documentation
      - match: \```
        pop: true
    - match: \``
      push:
      - meta_scope: comment.block.code.ballerina.documentation
      - match: \``
        pop: true
    - match: \`
      push:
      - meta_scope: comment.block.code.ballerina.documentation
      - match: \`
        pop: true
    - match: .
      scope: comment.block.ballerina.documentation
  repo_documentationDef:
  - match: \b(?:documentation|deprecated)\b
    captures:
      0: keyword.ballerina
    push:
    - match: \}
      pop: true
      captures:
        0: delimiter.curly
    - include: repo_documentationBody
    - include: repo_comment
  repo_enum-decl:
  - match: (?:\b(const)\s+)?\b(enum)\s+([_$[:alpha:]][_$[:alnum:]]*)
    captures:
      1: storage.modifier.ballerina
      2: keyword.other.ballerina
      3: entity.name.type.enum.ballerina
    push:
    - meta_scope: meta.enum.declaration.ballerina
    - match: (?<=\})
      pop: true
    - include: repo_comment
    - include: repo_mdDocumentation
    - match: \{
      captures:
        0: punctuation.definition.block.ballerina
      push:
      - match: \}
        pop: true
        captures:
          0: punctuation.definition.block.ballerina
      - include: repo_comment
      - include: repo_mdDocumentation
      - match: ([_$[:alpha:]][_$[:alnum:]]*)
        captures:
          0: variable.other.enummember.ballerina
        push:
        - match: (?=,|\}|$)
          pop: true
        - include: repo_comment
        - include: repo_variable-initializer
      - match: (?=((\'([^\'\\]|\\.)*\')|(\"([^\"\\]|\\.)*\")|(\`([^\`\\]|\\.)*\`)|(\[([^\[\]]|\[[^\[\]]*\])+\])))
        push:
        - match: (?=,|\}|$)
          pop: true
        - include: repo_string
        - include: repo_array-literal
        - include: repo_comment
        - include: repo_variable-initializer
      - include: repo_punctuation-comma
  repo_errorDestructure:
  - match: error
    captures:
      0: storage.type.ballerina
    push:
    - match: (?==>)
      pop: true
    - include: repo_code
  repo_expression:
  - include: repo_keywords
  - include: repo_expressionWithoutIdentifiers
  - include: repo_identifiers
  - include: repo_regex
  repo_expression-operators:
  - match: \*=|(?<!\()/=|%=|\+=|\-=
    scope: keyword.operator.assignment.compound.ballerina
  - match: \&=|\^=|<<=|>>=|>>>=|\|=
    scope: keyword.operator.assignment.compound.bitwise.ballerina
  - match: <<|>>>|>>
    scope: keyword.operator.bitwise.shift.ballerina
  - match: ===|!==|==|!=
    scope: keyword.operator.comparison.ballerina
  - match: <=|>=|<>|<|>
    scope: keyword.operator.relational.ballerina
  - match: (?<=[_$[:alnum:]])(\!)\s*(?:(/=)|(?:(/)(?![/*])))
    captures:
      1: keyword.operator.logical.ballerina
      2: keyword.operator.assignment.compound.ballerina
      3: keyword.operator.arithmetic.ballerina
  - match: \!|&&|\|\||\?\?
    scope: keyword.operator.logical.ballerina
  - match: \&|~|\^|\|
    scope: keyword.operator.bitwise.ballerina
  - match: \=
    scope: keyword.operator.assignment.ballerina
  - match: --
    scope: keyword.operator.decrement.ballerina
  - match: \+\+
    scope: keyword.operator.increment.ballerina
  - match: '%|\*|/|-|\+'
    scope: keyword.operator.arithmetic.ballerina
  repo_expressionWithoutIdentifiers:
  - include: repo_xml
  - include: repo_string
  - include: repo_stringTemplate
  - include: repo_comment
  - include: repo_object-literal
  - include: repo_ternary-expression
  - include: repo_expression-operators
  - include: repo_literal
  - include: repo_paranthesised
  - include: repo_regex
  repo_flags-on-off:
  - match: (\??)([imsx]*)(-?)([imsx]*)(:)
    captures:
      1: punctuation.other.non-capturing-group-begin.regexp.ballerina
      2: keyword.other.non-capturing-group.flags-on.regexp.ballerina
      3: punctuation.other.non-capturing-group.off.regexp.ballerina
      4: keyword.other.non-capturing-group.flags-off.regexp.ballerina
      5: punctuation.other.non-capturing-group-end.regexp.ballerina
    push:
    - meta_scope: constant.other.flag.regexp.ballerina
    - match: ()
      pop: true
    - include: repo_regexp
    - include: repo_template-substitution-element
  repo_for-loop:
  - match: (?<![_$[:alnum:]])(?:(?<=\.\.\.)|(?<!\.))foreach\s*
    captures:
      0: keyword.control.loop.ballerina
      1: support.type.primitive.ballerina
    push:
    - match: (?=\{)
      pop: true
    - match: \bin\b
      scope: keyword.other.ballerina
    - include: repo_identifiers
    - include: repo_comment
    - include: repo_var-expr
    - include: repo_expression
  repo_forkBody:
  - match: \{
    captures:
      0: punctuation.definition.block.ballerina
    push:
    - match: (?=\})
      pop: true
    - include: repo_workerDef
  repo_forkStatement:
  - match: \bfork\b
    captures:
      0: keyword.control.ballerina
    push:
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.block.ballerina
    - include: repo_forkBody
  repo_function-body:
  - include: repo_comment
  - include: repo_functionParameters
  - include: repo_decl-block
  - match: \=>
    captures:
      0: meta.arrow.ballerina storage.type.function.arrow.ballerina
    push:
    - meta_scope: meta.block.ballerina
    - match: (?=\;)|(?=\,)|(?=)(?=\);)
      pop: true
    - include: repo_natural-expr
    - include: repo_statements
    - include: repo_punctuation-comma
  - match: \*
    scope: keyword.generator.asterisk.ballerina
  repo_function-defn:
  - match: (?:(public|private)\s+)?(function\b)
    captures:
      1: keyword.other.ballerina
      2: keyword.other.ballerina
    push:
    - meta_scope: meta.function.ballerina
    - match: (?<=\;)|(?<=\})|(?<=\,)|(?=)(?=\);)
      pop: true
    - match: \bexternal\b
      scope: keyword.ballerina
    - include: repo_stringTemplate
    - include: repo_annotationAttachment
    - include: repo_functionReturns
    - include: repo_functionName
    - include: repo_functionParameters
    - include: repo_punctuation-semicolon
    - include: repo_function-body
    - include: repo_regex
  repo_function-parameters-body:
  - include: repo_comment
  - include: repo_numbers
  - include: repo_string
  - include: repo_annotationAttachment
  - include: repo_recordLiteral
  - include: repo_keywords
  - include: repo_parameter-name
  - include: repo_array-literal
  - include: repo_variable-initializer
  - include: repo_identifiers
  - include: repo_regex
  - match: \,
    scope: punctuation.separator.parameter.ballerina
  repo_functionName:
  - match: \bfunction\b
    scope: keyword.other.ballerina
  - include: repo_type-primitive
  - include: repo_self-literal
  - include: repo_string
  - match: \s+(\b(self)|\b(is|new|isolated|null|function|in)\b|(string|int|boolean|float|byte|decimal|json|xml|anydata)\b|\b(readonly|error|map)\b|([_$[:alpha:]][_$[:alnum:]]*))
    captures:
      2: variable.language.this.ballerina
      3: keyword.other.ballerina
      4: support.type.primitive.ballerina
      5: storage.type.ballerina
      6: meta.definition.function.ballerina entity.name.function.ballerina
  repo_functionParameters:
  - match: \(|\[
    captures:
      0: punctuation.definition.parameters.begin.ballerina
    push:
    - meta_scope: meta.parameters.ballerina
    - match: \)|\]
      pop: true
      captures:
        0: punctuation.definition.parameters.end.ballerina
    - include: repo_function-parameters-body
  repo_functionReturns:
  - match: \s*(returns)\s*
    captures:
      1: keyword.other.ballerina
    push:
    - meta_scope: meta.type.function.return.ballerina
    - match: (?==>)|(\=)|(?=\{)|(\))|(?=\;)
      pop: true
      captures:
        1: keyword.operator.ballerina
    - include: repo_comment
    - include: repo_string
    - include: repo_numbers
    - include: repo_keywords
    - include: repo_type-primitive
    - match: \s*\b(var)(?=\s+|\[|\?)
      captures:
        1: support.type.primitive.ballerina
    - match: \|
      scope: keyword.operator.ballerina
    - match: \?
      scope: keyword.operator.optional.ballerina
    - include: repo_type-annotation
    - include: repo_type-tuple
    - include: repo_keywords
    - match: '[_$[:alpha:]][_$[:alnum:]]*'
      scope: variable.other.readwrite.ballerina
  repo_functionType:
  - match: \bfunction\b
    captures:
      0: keyword.ballerina
    push:
    - match: (?=\,)|(?=\|)|(?=\:)|(?==>)|(?=\))|(?=\])
      pop: true
    - include: repo_comment
    - include: repo_functionTypeParamList
    - include: repo_functionTypeReturns
  repo_functionTypeParamList:
  - match: \(
    captures:
      0: delimiter.parenthesis
    push:
    - match: \)
      pop: true
      captures:
        0: delimiter.parenthesis
    - match: public
      scope: keyword
    - include: repo_annotationAttachment
    - include: repo_recordLiteral
    - include: repo_record
    - include: repo_objectDec
    - include: repo_functionType
    - include: repo_constrainType
    - include: repo_parameterTuple
    - include: repo_functionTypeType
    - include: repo_comment
  repo_functionTypeReturns:
  - match: \breturns\b
    captures:
      0: keyword
    push:
    - match: (?=\,)|(?:\|)|(?=\])|(?=\))
      pop: true
    - include: repo_functionTypeReturnsParameter
    - include: repo_comment
  repo_functionTypeReturnsParameter:
  - match: ((?=record|object|function)|(?:[_$[:alpha:]][_$[:alnum:]]*))
    captures:
      0: storage.type.ballerina
    push:
    - match: (?=\,)|(?:\|)|(?:\:)|(?==>)|(?=\))|(?=\])
      pop: true
    - include: repo_record
    - include: repo_objectDec
    - include: repo_functionType
    - include: repo_constrainType
    - include: repo_defaultValue
    - include: repo_comment
    - include: repo_parameterTuple
    - match: '[_$[:alpha:]][_$[:alnum:]]*'
      scope: default.variable.parameter.ballerina
  repo_functionTypeType:
  - match: '[_$[:alpha:]][_$[:alnum:]]*'
    captures:
      0: storage.type.ballerina
    push:
    - match: (?=\,)|(?:\|)|(?=\])|(?=\))
      pop: true
  repo_identifiers:
  - match: "(?x)(?:(?:(\\.)|(\\?\\.(?!\\s*[[:digit:]])))\\s*)?([_$[:alpha:]][_$[:alnum:]]*)(?=\\s*=\\s*(\n  ((\n    (function\\s*[(<*]) |\n    (function\\s+) |\n    ([_$[:alpha:]][_$[:alnum:]]*\\s*=>)\n  )) |\n  ((\n    ((<\\s*$)|((<\\s*([_$[:alpha:]]|(\\{([^\\{\\}]|(\\{([^\\{\\}]|\\{[^\\{\\}]*\\})*\\}))*\\})|(\\(([^\\(\\)]|(\\(([^\\(\\)]|\\([^\\(\\)]*\\))*\\)))*\\))|(\\[([^\\[\\]]|(\\[([^\\[\\]]|\\[[^\\[\\]]*\\])*\\]))*\\]))([^=<>]|=[^<]|\\<\\s*([_$[:alpha:]]|(\\{([^\\{\\}]|(\\{([^\\{\\}]|\\{[^\\{\\}]*\\})*\\}))*\\})|(\\(([^\\(\\)]|(\\(([^\\(\\)]|\\([^\\(\\)]*\\))*\\)))*\\))|(\\[([^\\[\\]]|(\\[([^\\[\\]]|\\[[^\\[\\]]*\\])*\\]))*\\]))([^=<>]|=[^<]|\\<\\s*([_$[:alpha:]]|(\\{([^\\{\\}]|(\\{([^\\{\\}]|\\{[^\\{\\}]*\\})*\\}))*\\})|(\\(([^\\(\\)]|(\\(([^\\(\\)]|\\([^\\(\\)]*\\))*\\)))*\\))|(\\[([^\\[\\]]|(\\[([^\\[\\]]|\\[[^\\[\\]]*\\])*\\]))*\\]))([^=<>]|=[^<])*\\>)*\\>)*>\\s*)?[\\(]\\s*((([\\{\\[]\\s*)?$)|((\\{([^\\{\\}]|(\\{([^\\{\\}]|\\{[^\\{\\}]*\\})*\\}))*\\})\\s*((:\\s*\\{?$)|((\\s*([^<>\\\
