%YAML 1.2
---
# FlatBuffers (source.flatbuffers): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/floxay/vscode-flatbuffers.git via GitHub Linguist v9.7.0 (license: mit).
name: FlatBuffers
scope: source.flatbuffers
file_extensions:
- fbs
contexts:
  main:
  - include: repo_include
  - include: repo_namespace_decl
  - include: repo_type_decl
  - include: repo_enum_decl
  - include: repo_root_decl
  - include: repo_file_ext_ident_decl
  - include: repo_attribute_decl
  - include: repo_rpc_decl
  - include: repo_comment
  repo_attribute_decl:
  - match: \b(attribute)\b\s+
    captures:
      1: keyword.other.attribute.flatbuffers
    push:
    - meta_scope: meta.attribute-declaration.flatbuffers
    - match: ;
      pop: true
      captures:
        0: punctuation.terminator.flatbuffers
    - include: repo_ident
    - match: '"'
      captures:
        0: support.other.flatbuffers
      push:
      - match: '"'
        pop: true
        captures:
          0: support.other.flatbuffers
      - include: repo_ident
  repo_comment:
  - match: /\*
    captures:
      0: punctuation.definition.comment.flatbuffers
    push:
    - meta_scope: comment.block.flatbuffers
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.flatbuffers
  - match: ///
    captures:
      0: punctuation.definition.comment.flatbuffers
    push:
    - meta_scope: comment.line.triple-slash.documentation.flatbuffers
    - match: $\n
      pop: true
  - match: //
    captures:
      0: punctuation.definition.comment.flatbuffers
    push:
    - meta_scope: comment.line.double-slash.flatbuffers
    - match: $\n
      pop: true
  repo_enum_decl:
  - match: \b(enum)|(union)\b\s+
    captures:
      1: keyword.other.enum.flatbuffers
      2: keyword.other.union.flatbuffers
    push:
    - meta_scope: meta.enum-declaration.flatbuffers
    - match: (?<=})
      pop: true
    - include: repo_comment
    - include: repo_metadata
    - include: repo_type
    - include: repo_ident
    - match: ':'
      scope: punctuation.separator.colon.flatbuffers
    - match: '{'
      captures:
        0: punctuation.curlybrace.open.flatbuffers
      push:
      - meta_scope: meta.block.flatbuffers
      - match: '}'
        pop: true
        captures:
          0: punctuation.curlybrace.close.flatbuffers
      - include: repo_comment
      - include: repo_metadata
      - include: repo_integer_constant
      - include: repo_type
      - include: repo_ident
      - match: '='
        scope: keyword.operator.assignment.flatbuffers
      - match: ':'
        scope: punctuation.separator.colon.flatbuffers
  repo_field_decl:
  - match: ([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)
    captures:
      1: variable.other.member.flatbuffers
      2: punctuation.separator.colon.flatbuffers
    push:
    - meta_scope: meta.field-declaration.flatbuffers
    - match: ;
      pop: true
      captures:
        0: punctuation.terminator.flatbuffers
    - include: repo_single_value
    - include: repo_type
    - match: '='
      scope: keyword.operator.assignment.flatbuffers
    - include: repo_metadata
  repo_file_ext_ident_decl:
  - match: \b(file_extension)|(file_identifier)\b\s+
    captures:
      1: keyword.control.file-extension.flatbuffers
      2: keyword.control.file-identifier.flatbuffers
    push:
    - match: ;
      pop: true
      captures:
        0: punctuation.terminator.flatbuffers
    - include: repo_string_constant
  repo_float_constant:
  - match: ([-+])?(([.][0-9]+)|([0-9]+[.][0-9]*))([eE][-+]?[0-9]+)?
    scope: constant.numeric.float.decimal.flatbuffers
    captures:
      1: keyword.operator.arithmetic.flatbuffers
  - match: ([-+])?(0[xX])(([.][0-9a-fA-F]+)|([0-9a-fA-F]+[.][0-9a-fA-F]*))([pP][-+]?[0-9]+)
    scope: constant.numeric.float.hexadecimal.flatbuffers
    captures:
      1: keyword.operator.arithmetic.flatbuffers
      2: storage.type.number.flatbuffers
  - match: ([-+])?(nan|inf|infinity)
    scope: constant.numeric.float.other.flatbuffers
    captures:
      1: keyword.operator.arithmetic.flatbuffers
  repo_ident:
  - match: '[a-zA-Z_][a-zA-Z0-9_]*'
    scope: entity.name.class.flatbuffers
  repo_include:
  - match: \b(include)|(native_include)\b\s+
    captures:
      1: keyword.control.import.flatbuffers
      2: keyword.control.native-import.flatbuffers
    push:
    - meta_scope: meta.import.flatbuffers
    - match: ;
      pop: true
      captures:
        0: punctuation.terminator.flatbuffers
    - include: repo_string_constant
  repo_integer_constant:
  - match: ([-+])?(0[xX])[0-9a-fA-F]+
    scope: constant.numeric.integer.hexadecimal.flatbuffers
    captures:
      1: keyword.operator.arithmetic.flatbuffers
      2: storage.type.number.flatbuffers
  - match: ([-+])?[0-9]+
    scope: constant.numeric.integer.decimal.flatbuffers
    captures:
      1: keyword.operator.arithmetic.flatbuffers
  repo_metadata:
  - match: \(
    captures:
      0: punctuation.parenthesis.open.flatbuffers
    push:
    - meta_scope: meta.metadata.flatbuffers
    - match: \)
      pop: true
      captures:
        0: punctuation.parenthesis.close.flatbuffers
    - include: repo_comment
    - include: repo_single_value
    - match: '[a-zA-Z_][a-zA-Z0-9_]*'
      scope: keyword.control.attribute.flatbuffers
    - match: ','
      scope: punctuation.separator.comma.flatbuffers
    - match: ':'
      scope: punctuation.separator.colon.flatbuffers
  repo_namespace_decl:
  - match: \b(namespace)\b\s+
    captures:
      1: keyword.other.namespace.flatbuffers
    push:
    - meta_scope: meta.namespace-declaration.flatbuffers
    - match: ;
      pop: true
      captures:
        0: punctuation.terminator.flatbuffers
    - include: repo_ident
    - match: \.
      scope: punctuation.accessor.flatbuffers
  repo_root_decl:
  - match: \b(root_type)\b\s+
    captures:
      1: keyword.control.root-type.flatbuffers
    push:
    - meta_scope: meta.root-type-declaration.flatbuffers
    - match: ;
      pop: true
      captures:
        0: punctuation.terminator.flatbuffers
    - include: repo_metadata
    - include: repo_ident
  repo_rpc_decl:
  - match: \b(rpc_service)\b\s+
    captures:
      1: keyword.other.rpc-service.flatbuffers
    push:
    - meta_scope: meta.rpc-service-declaration.flatbuffers
    - match: (?<=})
      pop: true
      captures:
        0: punctuation.terminator.flatbuffers
    - include: repo_comment
    - include: repo_ident
    - match: '{'
      captures:
        0: punctuation.curlybrace.open.flatbuffers
      push:
      - meta_scope: meta.block.flatbuffers
      - match: '}'
        pop: true
        captures:
          0: punctuation.curlybrace.close.flatbuffers
      - include: repo_comment
      - include: repo_rpc_method_member
      - include: repo_ident
      - include: repo_metadata
  repo_rpc_method_member:
  - match: ([a-zA-Z_][a-zA-Z0-9_]*)(\()([a-zA-Z_][a-zA-Z0-9_]*)(\))(:)
    captures:
      1: variable.other.member.flatbuffers
      2: punctuation.parenthesis.open.flatbuffers
      3: entity.name.class.flatbuffers
      4: punctuation.parenthesis.close.flatbuffers
      5: punctuation.separator.colon.flatbuffers
    push:
    - match: (?<=:)
      pop: true
      captures:
        0: punctuation.separator.colon.flatbuffers
  repo_scalar:
  - match: \b(true|false)\b
    scope: constant.language.flatbuffers
  - include: repo_float_constant
  - include: repo_integer_constant
  repo_single_value:
  - include: repo_scalar
  - include: repo_string_constant
  repo_string_constant:
  - match: (")((?:[^"]|\")*)(")
    scope: string.quoted.double.flatbuffers
    captures:
      1: punctuation.definition.string.begin.flatbuffers
      2: string.quoted.double.flatbuffers
      3: punctuation.definition.string.end.flatbuffers
  repo_type:
  - match: \b(bool|byte|ubyte|short|ushort|int|uint|float|long|ulong|double|int8|uint8|int16|uint16|int32|uint32|int64|uint64|float32|float64|string)\b
    scope: storage.type.flatbuffers
  - include: repo_ident
  - match: \[
    captures:
      0: punctuation.squarebracket.open.flatbuffers
    push:
    - meta_scope: meta.array.flatbuffers
    - match: \]
      pop: true
      captures:
        0: punctuation.squarebracket.close.flatbuffers
    - include: repo_type
    - include: repo_scalar
    - match: ':'
      scope: punctuation.separator.array-length.flatbuffers
  repo_type_decl:
  - match: \b(table)|(struct)\b\s+
    captures:
      1: keyword.other.table.flatbuffers
      2: keyword.other.struct.flatbuffers
    push:
    - meta_scope: meta.type-declaration.flatbuffers
    - match: (?<=})
      pop: true
    - include: repo_comment
    - include: repo_metadata
    - include: repo_ident
    - match: '{'
      captures:
        0: punctuation.curlybrace.open.flatbuffers
      push:
      - meta_scope: meta.block.flatbuffers
      - match: '}'
        pop: true
        captures:
          0: punctuation.curlybrace.close.flatbuffers
      - include: repo_comment
      - include: repo_field_decl
      - include: repo_metadata
