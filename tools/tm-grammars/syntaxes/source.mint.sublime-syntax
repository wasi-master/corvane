%YAML 1.2
---
# Mint (source.mint): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/mint-lang/mint-vscode via GitHub Linguist v9.7.0 (license: mit).
name: Mint
scope: source.mint
file_extensions:
- mint
contexts:
  main:
  - include: repo_comments
  - include: repo_html
  - include: repo_regex
  - include: repo_style
  - include: repo_js
  - include: repo_routes
  - include: repo_keywords
  - include: repo_strings
  - include: repo_directives
  repo_comments:
  - match: /\*
    push:
    - meta_scope: comment.block.mint
    - match: \*/
      pop: true
  - match: ((//).*)$
    captures:
      1: comment.line.double-slash.mint
  repo_css:
  - match: //
  - include: repo_style-nesting
  - include: scope:source.css
  - include: scope:source.css
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - include: scope:source.css.scss
  - match: (?<=^|\s)(@)(?:-(?:webkit|moz)-)?keyframes\b
    captures:
      0: keyword.control.at-rule.keyframes.scss
      1: punctuation.definition.keyword.scss
    push:
    - meta_scope: meta.at-rule.keyframes.scss
    - match: (?<=})
      pop: true
    - match: (?<=@keyframes)\s+((?:[_A-Za-z][-\w]|-[_A-Za-z])[-\w]*)
      captures:
        1: entity.name.function.scss
    - match: (?<=@keyframes)\s+(")
      captures:
        1: punctuation.definition.string.begin.scss
      push:
      - meta_scope: string.quoted.double.scss
      - meta_content_scope: entity.name.function.scss
      - match: '"'
        pop: true
        captures:
          0: punctuation.definition.string.end.scss
      - match: \\([[:xdigit:]]{1,6}|.)
        scope: constant.character.escape.scss
      - include: scope:source.css.scss
    - match: (?<=@keyframes)\s+(')
      captures:
        1: punctuation.definition.string.begin.scss
      push:
      - meta_scope: string.quoted.single.scss
      - meta_content_scope: entity.name.function.scss
      - match: ''''
        pop: true
        captures:
          0: punctuation.definition.string.end.scss
      - match: \\([[:xdigit:]]{1,6}|.)
        scope: constant.character.escape.scss
      - include: scope:source.css.scss
    - match: '{'
      captures:
        0: punctuation.section.keyframes.begin.scss
      push:
      - match: '}'
        pop: true
        captures:
          0: punctuation.section.keyframes.end.scss
      - include: repo_comments
      - match: \b(?:(?:100|[1-9]\d|\d)%|from|to)(?=\s*{)
        scope: entity.other.attribute-name.scss
      - include: repo_style-nesting
  repo_directives:
  - match: (@(svg|format|documentation))((\().*\))?
    captures:
      0: keyword.directive.mint
    push:
    - match: ''
      pop: true
  repo_html:
  - match: <{?
    captures:
      0: punctuation.definition.tag.html.mint
    push:
    - meta_scope: meta.tag.html.mint
    - match: '}?>'
      pop: true
      captures:
        0: punctuation.definition.tag.html.mint
    - match: (?<=<)/|/(?=>)
      scope: punctuation.definition.tag.html.mint
    - match: (?<=<|</)[^A-Z|{][a-z]*[^\s|:|>|/]*
      scope: entity.name.tag.block.any.html.mint
    - match: (?![A-Z][a-z]*)(?<=::)[^\s|>|::|\(|/]*
      scope: entity.name.tag.css.mint
    - include: repo_html
    - include: repo_directives
    - include: repo_regex
    - include: repo_js
    - include: repo_strings
    - include: repo_keywords
  repo_interpolation:
  - match: '#{'
    captures:
      0: punctuation.definition.template-expression.begin.mint
    push:
    - meta_scope: meta.embedded.line.mint
    - match: '}'
      pop: true
      captures:
        0: punctuation.definition.template-expression.end.mint
    - match: \.
      scope: punctuation.accessor.mint
    - include: repo_keywords
  repo_js:
  - match: '`'
    push:
    - meta_scope: meta.embedded.block.js.mint
    - match: '`'
      pop: true
    - include: scope:source.js
  repo_keywords:
  - match: (?<!\.|[a-zA-Z0-9])\b(global|state|encode|decode|for|module|provider|suite|test|parallel|sequence|case|try|catch|finally|next|with|component|property|fun|style|routes|get|connect|exposing|record|store|use|when|if|else|where|enum|using|const|as|or)\b(?![a-zA-Z0-9]|\.|\s*(=|}))
    scope: keyword.control.mint
  - match: \b[A-Z][A-Za-z0-9]*\b|\b[A-Z_]+\b
    scope: entity.name.class.mint
  - match: \d\.?
    scope: constant.numeric.mint
  - match: =>
    scope: storage.type.function.arrow.mint
  - match: (?<!\.)\.(?!\.)
    scope: punctuation.accessor.mint
  - match: '{'
    scope: punctuation.block.open.mint
  - match: '}'
    scope: punctuation.block.close.mint
  - match: (?<!:):(?!:)
    scope: punctuation.separator.mint
  - match: (?<!:|\s)::(?!:|\s)
    scope: keyword.operator.class.mint
  - match: \(
    scope: punctuation.params.open.mint
  - match: \)
    scope: punctuation.params.close.mint
  - match: \[
    scope: punctuation.array.open.mint
  - match: \]
    scope: punctuation.array.close.mint
  - match: ','
    scope: punctuation.separator.comma.mint
  - match: \+|-|/|\*
    scope: keyword.operator.arithmetic.mint
  - match: (?<=\w|\d|\s)>=?|<=?(?=\s|\d|\w)
    scope: keyword.operator.relational.mint
  - match: (?<!=)=(?!=)
    scope: keyword.operator.assignment.mint
  - match: (?<!=)==(?!=)
    scope: keyword.operator.equality.mint
  - match: \.\.\.
    scope: keyword.operator.spread.mint
  - match: \|>
    scope: keyword.operator.pipe.mint
  - match: \|(?!>)
    scope: keyword.operator.copy.mint
  - match: \b(true|false)\b
    scope: constant.language.boolean.mint
  - match: (?<!\.)\bof\b
    scope: keyword.operator.expression.of.mint
  - match: (?<=\s\bfun\b\s)[^\(|:|{]*
    scope: entity.name.function.mint
  - match: \b(?<=[^A-Za-z]|\.|\s)[a-z][a-zA-Z0-9]*\b(?=\()
    scope: entity.name.function.mint
  - match: '@[A-Z]+'
    scope: keyword.other.env.mint
  - match: \b[a-z][a-zA-Z0-9\-]*\b
    scope: support.type.property-name.mint
  repo_regex:
  - match: /(?:\\/|[^/])+/
    scope: string.regexp.mint
  - match: (?<=/)(g|i|m|y|u|s)
    scope: constant.regexp
  repo_routes:
  - match: (?<=routes\s{)
    captures:
      0: meta.block.open.routes.mint
    push:
    - meta_scope: meta.block.routes.mint
    - match: '}'
      pop: true
      captures:
        0: meta.block.close.routes.mint
    - include: repo_comments
    - match: (/|\*)[^{]*
      scope: string.route.name.mint
    - include: repo_routes-nesting
    - include: repo_keywords
  repo_routes-nesting:
  - match: '{'
    captures:
      0: meta.block.open.nested.routes.mint
    push:
    - meta_scope: meta.block.nested.routes.mint
    - match: '}'
      pop: true
      captures:
        0: meta.block.close.nested.routes.mint
    - include: repo_comments
    - include: repo_routes-nesting
    - include: repo_keywords
  repo_strings:
  - match: '"'
    push:
    - meta_scope: string.quoted.double.mint
    - match: '"'
      pop: true
    - match: \\.
      scope: constant.character.escape.mint
    - include: repo_interpolation
  repo_style:
  - match: (?<=style\s)[^{]*\s{
    captures:
      0: meta.block.open.style.mint
    push:
    - meta_scope: meta.block.style.mint
    - match: '}'
      pop: true
      captures:
        0: meta.block.close.style.mint
    - include: repo_style-conditionals
    - include: repo_css
  repo_style-conditionals:
  - match: ((?:else\s*)?if\s*\(.*\)\s*{|(?<=})\s*else\s*(?!if){|case\s*\(.*\)\s*{)
    captures:
      0: meta.block.open.style.conditional.mint
    push:
    - match: '}'
      pop: true
      captures:
        0: meta.block.close.style.conditional.mint
    - include: repo_comments
    - match: (?=:\s[^A-Z])
      push:
      - meta_scope: meta.embedded.line.scss.mint
      - match: '[^;]*$'
        pop: true
      - include: repo_css
    - include: repo_strings
    - include: repo_keywords
  repo_style-nesting:
  - match: '{'
    captures:
      0: meta.block.open.nested.style.mint
    push:
    - meta_scope: meta.block.nested.style.mint
    - match: '}'
      pop: true
      captures:
        0: meta.block.close.nested.style.mint
    - include: repo_style-conditionals
    - include: repo_css
