%YAML 1.2
---
# PlantUML (source.wsd): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/qjebbs/vscode-plantuml via GitHub Linguist v9.7.0 (license: mit).
name: PlantUML
scope: source.wsd
file_extensions:
- puml
- iuml
- plantuml
contexts:
  main:
  - match: (?i)^\s*(@start[a-z]+)((\s+)(.+?))?\s*$
    captures:
      1: keyword.control.diagram.source.wsd
      5: entity.name.function.diagram.source.wsd
    push:
    - meta_scope: diagram.source.wsd
    - match: (?i)^\s*(@end[a-z]+)\s*$
      pop: true
      captures:
        1: keyword.control.diagram.source.wsd
    - include: repo_Quoted
    - include: repo_Comment
    - include: repo_Style
    - include: repo_Class
    - include: repo_Object
    - include: repo_Activity
    - include: repo_Sequence
    - include: repo_State
    - include: repo_Keywords
    - include: repo_General
  - include: repo_Quoted
  - include: repo_Comment
  - include: repo_Style
  - include: repo_Class
  - include: repo_Object
  - include: repo_Activity
  - include: repo_Sequence
  - include: repo_State
  - include: repo_Keywords
  - include: repo_General
  repo_Activity:
  - match: (?i)^\s*(else *if|if)\s?\((.+?)\)\s?(then)(\s?\((.+?)\))?\s*$
    captures:
      1: keyword.other.activity.if.source.wsd
      2: string.quoted.double.activity.if.source.wsd
      3: keyword.other.activity.if.source.wsd
      5: meta.comment.activity.if.source.wsd
  - match: (?i)^\s*(else)(\s?\((.+?)\))?\s*$
    captures:
      1: keyword.other.activity.else.source.wsd
      3: meta.comment.activity.else.source.wsd
  - match: (?i)^\s*(repeat\s+)?(while)\s*\((.+?)\)(\s*(is)(\s*\((.+?)\))?)?\s*$
    captures:
      1: keyword.other.activity.while.source.wsd
      2: keyword.other.activity.while.source.wsd
      3: string.quoted.double.activity.while.source.wsd
      5: keyword.other.activity.while.source.wsd
      7: meta.comment.activity.while.source.wsd
  - match: (?i)^\s*(end)\s?(while)(\s*\((.+?)\))?\s*$
    captures:
      1: keyword.other.activity.endwhile.source.wsd
      2: keyword.other.activity.endwhile.source.wsd
      4: meta.comment.activity.endwhile.source.wsd
  repo_Class:
  - match: (?i)^\s*(enum|abstract\s+class|abstract|class)\s+([\w\d_\.]+|"[^"]+")(\s*(<<.+?>>))?(\s+(as)\s+([\w\d_\.]+|"[^"]+")(\s*(<<.+?>>))?)?(\s+#(([\w\|\\\/\-]+)))?\s*\{\s*$
    captures:
      1: keyword.other.class.group.source.wsd
      10: constant.numeric.class.definition.source.wsd
      2: support.variable.class.group.source.wsd
      4: string.quoted.double.class.definition.source.wsd
      6: keyword.other.class.group.source.wsd
      7: support.variable.class.group.source.wsd
      9: string.quoted.double.class.definition.source.wsd
    push:
    - match: ^\s*(?<!\\)\}\s*$
      pop: true
    - match: (?i)^\s*([.=_-]{2,})\s*((.+?)\s*([.=_-]{2,}))?
      captures:
        1: meta.comment.class.group.separator.source.wsd
        3: string.quoted.double.class.group.separator.source.wsd
        4: meta.comment.class.group.separator.source.wsd
    - match: (?i)^\s*(\s*\{(static|abstract)\}\s*)?(\s*[~#+-]\s*)?(([\p{L}0-9_]+(\[\])?\s+)?([\p{L}0-9_]+)(\(\))|([\p{L}0-9_]+)(\(\))\s*:\s*([\p{L}0-9_]+)?)\s*$
      captures:
        1: storage.modifier.class.function.source.wsd
        11: support.type.class.function.source.wsd
        3: keyword.other.class.function.source.wsd
        5: support.type.class.function.source.wsd
        7: support.variable.class.function.source.wsd
        9: support.variable.class.function.source.wsd
    - match: (?i)^\s*(\s*\{(static|abstract)\}\s*)?(\s*[~#+-]\s*)?(([\p{L}0-9_]+(\[\])?\s+)?([\p{L}0-9_]+)|([\p{L}0-9_]+)\s*:\s*(\w+)?)\s*$
      captures:
        1: storage.modifier.class.fields.source.wsd
        3: keyword.other.class.fields.source.wsd
        5: support.type.class.fields.source.wsd
        7: support.variable.class.fields.source.wsd
        8: support.variable.class.fields.source.wsd
        9: support.type.class.fields.source.wsd
    - match: (?i)^\s*(\s*\{(static|abstract)\}\s*)?(\s*[~#+-]\s*)?(.+?)\s*$
      captures:
        1: storage.modifier.class.fields.source.wsd
        3: keyword.other.class.fields.source.wsd
        4: string.quoted.double.class.other.source.wsd
  - match: (?i)^\s*(hide|show|remove)\s+(([\w\d_\.\$]+|"[^"]+")|<<.+?>>|Stereotypes|class|interface|enum|@unlinked)(\s+(empty fields|empty attributes|empty methods|empty description|fields|attributes|methods|members|circle))?\s*$
    captures:
      1: keyword.other.class.hideshow.source.wsd
      2: support.variable.class.hideshow.source.wsd
      5: constant.numeric.class.hideshow.source.wsd
  repo_Comment:
  - match: (?i)^\s*(')
    push:
    - meta_scope: comment.line.comment.source.wsd
    - match: (?i)\n
      pop: true
  - match: (?i)\s*(/')
    push:
    - meta_scope: comment.block.source.wsd
    - match: (?i)('/)\s*
      pop: true
  repo_General:
  - match: (?i)^\s*(title)\s*$
    captures:
      1: keyword.other.title.source.wsd
    push:
    - match: (?i)^\s*\b(end\s+title)\b
      pop: true
      captures:
        1: keyword.other.title.source.wsd
    - match: (?i)^\s*(.+?)\s*$
      captures:
        1: entity.name.function.title.source.wsd
  - match: (?i)^\s*(title)\s+(.+?)\s*$
    captures:
      1: keyword.other.title.source.wsd
      2: entity.name.function.title.source.wsd
  - match: (?i)^\s*(scale)\s+((max)\s+)?(\d+(\.?\d+)?)\s*((([\*/])\s*(\d+\.?(\.?\d+)?))|(width|height))?\s*$
    scope: keyword.other.scale.source.wsd
    captures:
      1: keyword.other.scale.source.wsd
      11: keyword.other.scale.source.wsd
      3: keyword.other.scale.source.wsd
      4: constant.numeric.scale.source.wsd
      8: keyword.operator.scale.source.wsd
      9: constant.numeric.scale.source.wsd
  - match: (?i)^\s*(caption)\s+(.+)\s*$
    captures:
      1: keyword.other.note.source.wsd
      2: constant.numeric.caption.source.wsd
  - match: (?i)^\s*(note\s(left|right))\s*:\s*(.+)\s*$
    captures:
      1: keyword.other.note.source.wsd
      3: meta.comment.note.source.wsd
  - match: (?i)^\s*(note\s(left|right))\s*$
    captures:
      1: keyword.other.note.source.wsd
    push:
    - match: (?i)^\s*(end\s*note)
      pop: true
      captures:
        1: keyword.other.note.source.wsd
    - match: .+?
      scope: meta.comment.multiple.note.source.wsd
  - match: (?i)^\s*([rh]?note)(?:\s+(right|left|top|bottom))?\s+(?:(?:(of|over)\s*(?:[^\s\w\d]([\w\s]+)[^\s\w\d]|(?:(".+?"|\w+)(?:,\s*(".+?"|\w+))*)))|(on\s+link))\s*(#\w+)?\s*:\s*(.+)$
    captures:
      1: keyword.other.noteof.source.wsd
      2: constant.numeric.noteof.source.wsd
      3: keyword.other.noteof.source.wsd
      4: support.variable.noteof.source.wsd
      5: support.variable.noteof.source.wsd
      6: support.variable.noteof.source.wsd
      7: keyword.other.noteof.source.wsd
      8: constant.numeric.noteof.source.wsd
      9: meta.comment.noteof.source.wsd
  - match: (?i)^\s*([rh]?note)(?:\s+(right|left|top|bottom))?\s+(?:(?:(of|over)\s*(?:[^\s\w\d]([\w\s]+)[^\s\w\d]|(?:(".+?"|\w+)(?:,\s*(".+?"|\w+))*)))|(on\s+link))\s*(#\w+)?\s*$
    captures:
      1: keyword.other.noteof.source.wsd
      2: constant.numeric.noteof.source.wsd
      3: keyword.other.noteof.source.wsd
      4: support.variable.noteof.source.wsd
      5: support.variable.noteof.source.wsd
      6: support.variable.noteof.source.wsd
      7: keyword.other.noteof.source.wsd
      8: constant.numeric.noteof.source.wsd
    push:
    - match: (?i)^\s*(end\s*[rh]?note)
      pop: true
      captures:
        1: keyword.other.multline.noteof.source.wsd
    - match: .+?
      scope: meta.comment.multline.noteof.source.wsd
  - match: (?i)^\s*(note)\s+(".+?")\s+(as)\s+([\w\d]+)\s*$
    captures:
      1: keyword.other.noteas.source.wsd
      2: meta.comment.noteas.source.wsd
      3: keyword.other.noteas.source.wsd
      4: support.variable.noteas.source.wsd
  - match: (?i)^\s*(?:(center|left|right)\s+)?(header|legend|footer)\s*\n
    captures:
      1: constant.numeric.header_legend_footer.source.wsd
      2: keyword.other.header_legend_footer.source.wsd
    push:
    - match: (?i)^\s*(end\s?(header|legend|footer))
      pop: true
      captures:
        1: keyword.other.header_legend_footer.source.wsd
    - match: .+?
      scope: meta.comment.header_legend_footer.source.wsd
  - match: (?i)^\s*(?:(center|left|right)\s+)?(header|legend|footer)\s+(.+?)\s*$
    captures:
      1: constant.numeric.header_legend_footer.source.wsd
      2: keyword.other.header_legend_footer.source.wsd
      3: meta.comment.header_legend_footer.source.wsd
  - match: (?i)(!includesub|!include|!enddefinelong|!definelong|!define|!startsub|!endsub|!ifdef|!else|!endif|!ifndef|!if|!elseif|!endif|!while|!endwhile|!(unquoted\s|final\s)*procedure|!(unquoted\s|final\s)*function|!end\s*(function|procedure)|!return|!import|!includedef|!includeurl|!include_many|!include_once|!log|!dump_memory|!theme|!pragma|!assume\s+transparent\s+(dark|light))
    scope: entity.name.function.preprocessings.source.wsd
  - match: (?i)((?:(?:(?:\s+[ox]|[+*])?(?:<<|<\|?|\\\\|\\|//|\}|\^|#|0|0\))?)(?=[-.~=]))[-.~=]+(\[(?:\#(?:[0-9a-f]{6}|[0-9a-f]{3}|\w+)(?:[-\\/](?:[0-9a-f]{6}|[0-9a-f]{3}|\w+))?\b)\])?(?:(left|right|up|down)(?:[-.~=]))?[-.]*(?:(?:>>|\|?>|\\\\|\\|//|\{|\^|#|0|\(0)?(?:[ox]\s+|[+*])?))
    captures:
      1: keyword.control.note.source.wsd
      2: constant.numeric.link.color.source.wsd
      3: constant.language.link.source.wsd
    push:
    - match: $
      pop: true
    - include: repo_General
    - match: (?i):([^:]+):\s*:(.+)$
      captures:
        1: support.variable.actor.link.source.wsd
        2: meta.comment.message.link.source.wsd
    - match: (?i):(.+)$
      captures:
        1: meta.comment.message.link.source.wsd
  - match: (?i)#(?:[0-9a-f]{6}|[0-9a-f]{3}|\w+)
    scope: constant.numeric.colors.source.wsd
  - match: \b[\w_]+
    scope: support.variable.source.wsd
  repo_Keywords:
  - match: (?i)^\s*(switch|case|usecase|actor|object|participant|boundary|control|entity|database|create|component|interface|package|node|folder|frame|cloud|annotation|enum|abstract\s+class|abstract|class|state|autonumber(\s+stop|\s+resume|\s+inc)?|activate|deactivate|return|destroy|newpage|alt|else|opt|loop|par|break|critical|group|box|rectangle|namespace|partition|agent|artifact|card|circle|collections|file|hexagon|label|person|queue|stack|storage|mainframe|map|repeat|backward|diamond|goto|binary|clock|concise|robust|compact\s+concise|compact\s+robust|json|protocol|struct|exception|metaclass|stereotype)\b
    scope: keyword.other.linebegin.source.wsd
  - match: (?i)^\s*(endswitch|split( again)?|endif|repeat|start|stop|end|end\s+fork|end\s+split|fork( again)?|detach|end\s+box|top\s+to\s+bottom\s+direction|left\s+to\s+right\s+direction|kill|end\s+merge|allow(_)?mixing)\s*$
    scope: keyword.other.wholeline.source.wsd
  - match: (?i)\b(as|{(static|abstract)\})\b
    scope: keyword.other.other.source.wsd
  repo_Object:
  - match: (?i)^\s*([\w\d_]+)\s+:\s+s*$
    captures:
      1: support.variable.object.addfields.source.wsd
      2: meta.comment.object.addfields.source.wsd
  repo_Quoted:
  - match: (?i)^\s*(:)
    push:
    - meta_scope: support.variable.definitions.source.wsd
    - match: (?i)(:)|[\];|<>/}]?\s*$
      pop: true
  - match: '"'
    push:
    - meta_scope: string.quoted.double.source.wsd
    - match: '"'
      pop: true
  repo_Sequence:
  - match: (?i)^\s*(={2,})\s*(.+?)\s*(={2,})\s*$
    captures:
      1: keyword.operator.sequence.divider.source.wsd
      2: string.quoted.double.sequence.divider.source.wsd
      3: keyword.operator.sequence.divider.source.wsd
  - match: (?i)^\s*(\.{3,})\s*$
    captures:
      1: keyword.operator.sequence.omission.source.wsd
  - match: (?i)^\s*(ref\s+over)\s+(.+?)\s*:\s*(.+)\s*$
    captures:
      1: keyword.other.sequence.ref.source.wsd
      2: support.variable.sequence.ref.source.wsd
      3: meta.comment.sequence.ref.source.wsd
  - match: (?i)^\s*(ref\s+over)\s+(.+?)\s*$
    captures:
      1: keyword.other.sequence.ref.source.wsd
      2: support.variable.sequence.ref.source.wsd
    push:
    - match: (?i)end\s+ref
      pop: true
      captures:
        0: keyword.other.sequence.ref.source.wsd
    - match: .+?
      scope: meta.comment.sequence.ref.source.wsd
  - match: (?i)^\s*(\.{3,})\s*(.+)\s*(\.{3,})\s*$
    captures:
      1: keyword.operator.sequence.delay.source.wsd
      2: meta.comment.sequence.delay.source.wsd
      3: keyword.operator.sequence.delay.source.wsd
  - match: (?i)(\|{2,})(\d+)?(\|{1,})
    captures:
      1: keyword.operator.sequence.space.source.wsd
      2: constant.numeric.sequence.space.source.wsd
      3: keyword.operator.sequence.space.source.wsd
  repo_State:
  - match: (?i)^\s*(-{2,})\s*$
    captures:
      1: keyword.other.state.concurrent.source.wsd
  repo_Style:
  - match: (?i)^\s*(skinparam)\s+(\w+)(<<\s*.+?\s*>>)?\s+([^\{\}]+?)\s*$
    captures:
      1: keyword.other.skinparam.source.wsd
      2: keyword.other.skinparam.keyword.source.wsd
      3: constant.numeric.skinparam.keyword.source.wsd
      4: string.quoted.double.skinparam.value.source.wsd
  - match: (?i)^\s*(?:(skinparam)(?:\s+(\w+?)(<<\s*.+?\s*>>)?)?|(\w+)(<<\s*.+?\s*>>)?)\s*\{\s*$
    captures:
      1: keyword.other.skinparam.source.wsd
      2: keyword.other.skinparam.keyword.source.wsd
      3: constant.numeric.skinparam.keyword.source.wsd
      4: keyword.other.skinparam.keyword.source.wsd
      5: constant.numeric.skinparam.keyword.source.wsd
    push:
    - match: ^\s*(?<!\\)\}\s*$
      pop: true
    - match: (?i)^\s*(\w+)(<<\s*.+?\s*>>)?\s+([^\{\}]+?)\s*$
      captures:
        1: keyword.other.skinparam.keyword.source.wsd
        2: constant.numeric.skinparam.keyword.source.wsd
        3: string.quoted.double.skinparam.value.source.wsd
    - include: main
