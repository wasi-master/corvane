%YAML 1.2
---
# Simple File Verification (source.sfv): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-etc via GitHub Linguist v9.7.0 (license: isc).
name: Simple File Verification
scope: source.sfv
file_extensions:
- sfv
contexts:
  main:
  - match: \A(?=; Generated by RHash v\d)
    push:
    - meta_scope: meta.rhash-output.sfv
    - match: (?=A)B
      pop: true
    - include: repo_rhash
    - include: repo_main
  - match: ^(?=[a-fA-F0-9]+ \*pocorgtfo\d{2}\.pdf\s*$)
    push:
    - meta_scope: text.checksums
    - match: (?=A)B
      pop: true
    - include: scope:text.checksums
  - include: repo_main
  repo_checksum:
  - match: ^\s*(?:((")[^"]*("))|(\S.*?))\s+([a-fA-F0-9]{8})(?=\s*$)
    scope: meta.crc32.checksum.sfv
    captures:
      1: string.quoted.double.filename.sfv
      2: punctuation.definition.string.begin.sfv
      3: punctuation.definition.string.end.sfv
      4: string.unquoted.filename.sfv
      5: constant.numeric.integer.int.hexadecimal.hex.crc32.sfv
  repo_comment:
  - match: ^\s*(;)((!)SFV_COMMENT_START)[ \t]*$
    captures:
      1: punctuation.definition.comment.sfv
      2: keyword.control.comment.begin.sfv
      3: punctuation.definition.keyword.sfv
    push:
    - meta_scope: comment.block.sfv
    - match: ^\s*(;)((!)SFV_COMMENT_END)[ \t]*$
      pop: true
      captures:
        1: punctuation.definition.comment.sfv
        2: keyword.control.comment.end.sfv
        3: punctuation.definition.keyword.sfv
  - match: ^\s*(;)
    captures:
      1: punctuation.definition.comment.sfv
    push:
    - meta_scope: comment.line.semicolon.sfv
    - match: $
      pop: true
  repo_main:
  - include: repo_comment
  - include: repo_checksum
  - include: repo_rhash
  repo_rhash:
  - match: '(?x) ^ \s* (\S.*?(?<=\S)) ((?: \s+ (?: [a-fA-F0-9]{8} |   [a-fA-F0-9]{32} |   [a-fA-F0-9]{40} |   [a-fA-F0-9]{48} |   [a-fA-F0-9]{56} |   [a-fA-F0-9]{64} |   [a-fA-F0-9]{96} |   [a-fA-F0-9]{128} |   [a-zA-Z2-7]{32} |   [a-zA-Z2-7]{39} ) )+) (?=\s*$)'
    scope: meta.checksum-record.sfv
    captures:
      1: string.unquoted.filename.sfv
