%YAML 1.2
---
# ImHex Pattern Language (source.pl): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/WerWolv/PatternLanguage-Grammar.git via GitHub Linguist v9.7.0 (license: mit).
name: ImHex Pattern Language
scope: source.pl
file_extensions:
- hexpat
contexts:
  main:
  - include: repo_toplevel-statements
  - include: repo_operators
  repo_attributes:
  - match: (\[\[)
    captures:
      1: punctuation.bracket.square.open.pl
    push:
    - meta_scope: meta.attribute.block.pl
    - match: (\]\])
      pop: true
      captures:
        1: punctuation.bracket.square.close.pl
    - match: \b([a-zA-Z_][a-zA-Z0-9_:]*)\b
      captures:
        1: entity.name.attribute.pl
    - match: \(
      push:
      - meta_scope: meta.attribute.arguments.pl
      - match: \)
        pop: true
      - include: repo_statements
      - match: ','
        scope: punctuation.separator.argument.pl
    - match: ','
      scope: punctuation.separator.attribute.pl
  repo_binary-integer:
  - match: \b(0(b|B)[01]+)\b
    scope: constant.numeric.integer.binary.pl
  repo_character-literal:
  - match: ''''
    push:
    - meta_scope: string.quoted.single.pl
    - match: ''''
      pop: true
    - match: \\.
      scope: constant.character.escape.pl
  repo_comment:
  - match: \/\*
    push:
    - meta_scope: comment.block.pl
    - match: \*\/
      pop: true
  repo_decimal-integer:
  - match: \b(0|[1-9][0-9]*)\b
    scope: constant.numeric.integer.decimal.pl
  repo_else-statement:
  - match: \b(else)\b
    scope: keyword.control.else.pl
    captures:
      1: keyword.control.else.pl
  repo_enum-definition:
  - match: (enum)\s+([a-zA-Z0-9_]+)\s*((\:)\s*([a-zA-Z0-9_]+))\s*(\{)
    captures:
      1: keyword.control.enum.pl
      2: entity.name.type.enum.pl
      5: entity.name.type.base.pl
      6: punctuation.bracket.curly.open.pl
    push:
    - meta_content_scope: meta.enum.pl
    - match: (\})\s*
      pop: true
      captures:
        1: punctuation.bracket.curly.close.pl
    - include: repo_enum-member
  repo_enum-member:
  - match: ([a-zA-Z_][a-zA-Z0-9_]*)\s*((=)\s*([a-zA-Z0-9_]+)(\s*\.\.\.\s*([a-zA-Z0-9_]+))?)?(,)?
    captures:
      1: variable.other.enum-member.pl
      3: keyword.operator.assignment.pl
      7: punctuation.separator.comma.pl
  repo_floating-point-number:
  - match: \b([+-]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([eE][+-]?[0-9]+)?)\b
    scope: constant.numeric.float.pl
  repo_for-statement:
  - match: \b(for)\s*(\()
    captures:
      1: keyword.control.for.pl
      2: punctuation.bracket.round.open.pl
    push:
    - meta_scope: meta.for.pl
    - match: (\))
      pop: true
      captures:
        1: punctuation.bracket.round.close.pl
        2: punctuation.bracket.curly.open.pl
    - include: repo_type-usage
    - include: repo_literal
    - include: repo_identifier
    - include: repo_operators
  repo_function-definition:
  - match: \b(fn)\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*(\()
    captures:
      1: keyword.control.function.pl
      2: entity.name.function.pl
      3: punctuation.bracket.round.open.pl
    push:
    - meta_scope: meta.function.definition.pl
    - match: (\))
      pop: true
      captures:
        1: punctuation.bracket.round.close.pl
        2: punctuation.bracket.curly.open.pl
    - include: repo_variable-definition
    - include: repo_statements
  repo_hexadecimal-integer:
  - match: \b(0(x|X)[0-9a-fA-F]+)\b
    scope: constant.numeric.integer.hexadecimal.pl
  repo_identifier:
  - match: \b([a-zA-Z_][a-zA-Z0-9_]*)\b
    scope: variable.other.identifier.pl
  repo_if-statement:
  - match: \b(if)\s*(\()
    captures:
      1: keyword.control.if.pl
      2: punctuation.bracket.round.open.pl
    push:
    - meta_scope: meta.if.pl
    - match: (\))
      pop: true
      captures:
        1: punctuation.bracket.round.close.pl
        2: punctuation.bracket.curly.open.pl
    - include: repo_literal
    - include: repo_identifier
    - include: repo_operators
  repo_import-statement:
  - match: \s*(import)\s*([a-zA-Z0-9_\.]+|\*)\s*((from)\s*([a-zA-Z0-9_\.]+))?\s*((as)?\s*([a-zA-Z0-9_\.]+))
    captures:
      1: keyword.control.import.pl
      2: variable.other.import.pl
      4: keyword.control.from.pl
      5: variable.other.import.pl
      7: keyword.control.as.pl
      8: variable.other.import.pl
  repo_keywords:
  - match: \b(break|continue|return|catch|try|if|else|match)\b
    scope: keyword.control.pl
  repo_line-comment:
  - match: \/\/.*
    scope: comment.line.double-slash.pl
  repo_literal:
  - include: repo_decimal-integer
  - include: repo_hexadecimal-integer
  - include: repo_binary-integer
  - include: repo_octal-integer
  - include: repo_floating-point-number
  - include: repo_string-literal
  - include: repo_character-literal
  - match: \b(true|false|null)\b
    scope: constant.language.boolean.pl
  - match: \b(this|parent|\$)\b
    scope: constant.language.special.pl
  repo_match-statement:
  - match: \b(match)\s*(\()
    captures:
      1: keyword.control.match.pl
      2: punctuation.bracket.round.open.pl
    push:
    - meta_scope: meta.match.pl
    - match: (\))
      pop: true
      captures:
        1: punctuation.bracket.round.close.pl
        2: punctuation.bracket.curly.open.pl
    - include: repo_type-usage
    - include: repo_literal
    - include: repo_identifier
    - include: repo_operators
  repo_namespace-definition:
  - match: \b(namespace)\s+((auto)\s+)?(([a-zA-Z_][a-zA-Z0-9_:]*))+\s*(\{)
    captures:
      1: keyword.control.namespace.pl
      3: storage.type.builtin.pl
      5: entity.name.namespace.pl
      6: punctuation.bracket.curly.open.pl
    push:
    - meta_scope: meta.namespace.pl
    - match: (\})
      pop: true
      captures:
        1: punctuation.bracket.curly.close.pl
    - include: repo_toplevel-statements
  repo_octal-integer:
  - match: \b(0(o|O)[0-7]+)\b
    scope: constant.numeric.integer.octal.pl
  repo_operators:
  - match: \+
    scope: keyword.operator.arithmetic.addition.pl
  - match: '-'
    scope: keyword.operator.arithmetic.subtraction.pl
  - match: \*
    scope: keyword.operator.arithmetic.multiplication.pl
  - match: \/
    scope: keyword.operator.arithmetic.division.pl
  - match: '%'
    scope: keyword.operator.arithmetic.modulus.pl
  - match: <=|>=|<|>|==|!=|&&|\|\||!
    scope: keyword.operator.comparison.pl
  - match: '&|\||\^'
    scope: keyword.operator.bitwise.pl
  - match: '@'
    scope: keyword.operator.special.pl
  - match: \.\.\.
    scope: keyword.operator.range.pl
  - match: \(|\)
    scope: punctuation.bracket.round.pl
  - match: \[|\]
    scope: punctuation.bracket.square.pl
  - match: \.
    scope: punctuation.separator.period.pl
  - match: ','
    scope: punctuation.separator.comma.pl
  - match: ;
    scope: punctuation.terminator.semicolon.pl
  - match: \?
    scope: keyword.operator.ternary.question.pl
  - match: ':'
    scope: keyword.operator.ternary.colon.pl
  - match: sizeof|addressof|typenameof
    scope: keyword.operator.function.pl
  - match: \+=|-=|\*=|/=|%=|&=|\^=|\|=
    scope: keyword.operator.assignment.pl
  repo_padding-definition:
  - match: padding
    scope: keyword.other.padding.pl
  repo_preprocessor-directive:
  - match: ^\s*(#[a-zA-Z0-9_]+)\s*(.*)$
    captures:
      1: keyword.control.import.preprocessor.pl.
      2: string.unquoted.directive.pl
  repo_scope:
  - match: \s*(\{)
    captures:
      1: punctuation.bracket.curly.open.pl
    push:
    - meta_scope: meta.scope.pl
    - match: (\})
      pop: true
      captures:
        1: punctuation.bracket.curly.close.pl
    - include: repo_statements
  repo_statements:
  - include: repo_attributes
  - include: repo_variable-definition
  - include: repo_padding-definition
  - include: repo_comment
  - include: repo_line-comment
  - include: repo_literal
  - include: repo_if-statement
  - include: repo_else-statement
  - include: repo_for-statement
  - include: repo_while-statement
  - include: repo_match-statement
  - include: repo_try-catch-statement
  - include: repo_operators
  - include: repo_identifier
  - include: repo_scope
  - match: \;
    scope: punctuation.terminator.semicolon.pl
  repo_string-literal:
  - match: '"'
    push:
    - meta_scope: string.quoted.double.pl
    - match: '"'
      pop: true
    - match: \\.
      scope: constant.character.escape.pl
  repo_struct-definition:
  - match: (struct|union|bitfield)\s+([a-zA-Z0-9_]+)(\s*<([^\>]*)>)?\s*((\:)\s*([a-zA-Z0-9_]+))?\s*(\{)
    captures:
      1: keyword.control.struct.pl
      2: entity.name.type.struct.pl
      7: entity.name.type.base.pl
      8: punctuation.bracket.curly.open.pl
    push:
    - meta_content_scope: meta.struct.pl
    - match: (\})\s*
      pop: true
      captures:
        1: punctuation.bracket.curly.close.pl
    - include: repo_statements
  repo_toplevel-statements:
  - include: repo_namespace-definition
  - include: repo_import-statement
  - include: repo_preprocessor-directive
  - include: repo_using-declaration
  - include: repo_struct-definition
  - include: repo_enum-definition
  - include: repo_function-definition
  - include: repo_statements
  repo_try-catch-statement:
  - match: \b((try)|(catch))\b
    scope: keyword.control.try-catch.pl
    captures:
      2: keyword.control.try.pl
      3: keyword.control.catch.pl
  repo_type-usage:
  - match: \b(const|ref|be|le\s+)?((u|s)(8|16|24|32|48|64|96|128)|(float|double|str|auto|bool|char|char16|unsigned|signed)|([A-Za-z_][A-Za-z0-9_]*))\b
    captures:
      1: keyword.other.ref.pl
      2: storage.type.builtin.pl
      5: storage.type.builtin.pl
  repo_using-declaration:
  - match: \b(using)\s+([a-zA-Z0-9_]+)\s*((=)\s*([a-zA-Z0-9_]+))?
    captures:
      1: keyword.control.using.pl
      2: variable.other.using.pl
  repo_variable-definition:
  - match: \s*(ref\s+)?((?!else)\b[a-zA-Z_][a-zA-Z0-9_]*)\s+([a-zA-Z_][a-zA-Z0-9_]*)(\s+(in|out))?
    captures:
      3: variable.other.definition.pl
      5: keyword.other.inout.pl
  repo_while-statement:
  - match: \b(while)\s*(\()
    captures:
      1: keyword.control.while.pl
      2: punctuation.bracket.round.open.pl
    push:
    - meta_scope: meta.while.pl
    - match: (\))
      pop: true
      captures:
        1: punctuation.bracket.round.close.pl
        2: punctuation.bracket.curly.open.pl
    - include: repo_type-usage
    - include: repo_literal
    - include: repo_identifier
    - include: repo_operators
