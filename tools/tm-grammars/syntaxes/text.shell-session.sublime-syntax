%YAML 1.2
---
# ShellSession (text.shell-session): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/atom/language-shellscript via GitHub Linguist v9.7.0 (license: mit).
name: ShellSession
scope: text.shell-session
file_extensions:
- sh-session
contexts:
  main:
  - match: "(?x) ^ (?: ( (?:\\(\\S+\\)\\s*)? (?: sh\\S*?                       | \\w+\\S+[@:]\\S+(?:\\s+\\S+)? | \\[\\S+?[@:][^\\n]+?\\].*? ) ) \\s* )? ( [>$#%\u276F\u279C] | \\p{Greek} ) \\s+ (.*) $"
    captures:
      1: entity.other.prompt-prefix.shell-session
      2: punctuation.separator.prompt.shell-session
      3: source.shell
  - match: ^.+$
    scope: meta.output.shell-session
