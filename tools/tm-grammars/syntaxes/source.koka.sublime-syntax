%YAML 1.2
---
# Koka (source.koka): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/koka-community/koka-textmate-grammar.git via GitHub Linguist v9.7.0 (license: apache-2.0).
name: Koka
scope: source.koka
file_extensions:
- kk
first_line_match: ^#!.*\b(koka)\b
contexts:
  main:
  - include: repo_line_comment
  - include: repo_line_directive
  - include: repo_block_comment
  - include: repo_string
  - include: repo_rawstring
  - include: repo_rawstring1
  - include: repo_rawstring2
  - include: repo_character
  - include: repo_characteresc
  - include: repo_type_app
  - include: repo_top_type
  - include: repo_top_type_type
  - include: repo_top_type_alias
  - include: repo_top_type_struct_args
  - include: repo_top_type_struct
  - include: repo_top_type_quantifier
  - include: repo_decl_wrong_function
  - include: repo_decl_function
  - include: repo_decl_external_import
  - include: repo_decl_external
  - include: repo_decl_toplevel_val
  - include: repo_decl_val
  - include: repo_decl_var
  - include: repo_decl_hover_expr
  - include: repo_decl_hover_implicit
  - include: repo_decl_param
  - include: repo_module_id
  - include: repo_import_id
  - include: repo_import_id2
  - include: repo_branch
  - include: repo_dot
  - include: repo_reservedid
  - include: repo_reservedcontrol
  - include: repo_reservedop
  - include: repo_libraryid
  - include: repo_externid
  - include: repo_qconstructor
  - include: repo_qoperator
  - include: repo_qidentifier
  - include: repo_identifier
  - include: repo_constructor
  - include: repo_special
  - include: repo_minus
  - include: repo_operator
  - include: repo_wildcard
  - include: repo_number
  - include: repo_inv_character
  - include: repo_whitespace
  repo_block_comment:
  - match: /\*
    captures:
      0: punctuation.definition.comment koka.comment.block
    push:
    - meta_scope: comment.block koka.comment.block
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment koka.comment.block
    - include: repo_block_comment
    - match: ^```+.*$
      push:
      - meta_scope: koka.comment.doc.pre.block
      - match: ^```+\s*$
        pop: true
    - match: '`(:[^\`\n]+)`'
      captures:
        1: koka.comment.doc.pre.type
    - match: '`(module [^\`\n]+)`'
      captures:
        1: koka.comment.doc.pre.module
    - match: '`+([^\`\n]*)`+'
      captures:
        1: koka.comment.doc.pre.source
    - match: \*([^\*]*)\*
      captures:
        1: koka.comment.doc.emph
    - match: _([^_]*)_
      captures:
        1: markup.italic koka.comment.doc.emph
  repo_branch:
  - match: (finally|initially)\s*(?=->|[\{\(])
    scope: keyword.other
  repo_character:
  - match: '''[^\''\\$]'''
    scope: string.quoted.single koka.char
  repo_characteresc:
  - match: (')(\\([abfnrtv0\\"'\?]|x[\da-fA-F]{2}|u[\da-fA-F]{4}|U[\da-fA-F]{6}))(')
    captures:
      1: string.quoted.single koka.char
      2: string.quoted.single constant.character.escape koka.char.escape
      3: string.quoted.single constant.character.escape koka.char.escape
      4: string.quoted.single koka.char
  repo_constructor:
  - match: '[@A-Z][\w\-@]*[\'']*'
    scope: entity.name.tag.css.constant.other.constructor koka.conid
  repo_decl_external:
  - match: ((?:(?:inline|noinline)\s+)?(?:(?:fip|fbip)(?:\(\d+\))?\s+)?extern)\s+((?:[@a-z][\w\-@]*/#?)*)([@a-z][\w\-@]*[\']*|\([$%&\*\+@!/\\\^~=\.:\-\?\|<>]+\)|\[\]|\"[^\s\"]+\")?
    captures:
      1: keyword.declaration.function koka.keyword.extern
      2: entity.name.variable koka.moduleid
      3: entity.name.function koka.id.decl.function
  repo_decl_external_import:
  - match: (extern\s+import)
    scope: keyword.declaration.import koka.keyword.extern
  repo_decl_function:
  - match: ((?:(?:inline|noinline)\s+)?(?:tail\s+)?(?:(?:fip|fbip)(?:\(\d+\))?\s+)?(?:fun|fn|ctl|ret))\s+((?:[@a-z][\w\-@]*/#?)*)([@a-z][\w\-@]*[\']*|\([$%&\*\+@!/\\\^~=\.:\-\?\|<>]+\)|\[\]|\"[^\s\"]+\")
    captures:
      1: keyword.declaration.function koka.keyword.fun
      2: entity.name.variable koka.moduleid
      3: entity.name.function koka.id.decl.function
  repo_decl_hover_expr:
  - match: ^expr
    scope: keyword.declaration koka.keyword.expr
  repo_decl_hover_implicit:
  - match: (\?(?:[@a-z][\w\-@]*/#?)*)([@a-z][\w\-@]*[\']*|\([$%&\*\+@!/\\\^~=\.:\-\?\|<>]+\))(?=\s*[=])
    captures:
      1: entity.name.label source.typeparam koka.param.implicit
      2: entity.name.label source.typeparam koka.param.implicit
  repo_decl_param:
  - match: ([a-z][\w\-]*[\']*)\s*(?=:)
    scope: entity.name koka.id.param
  repo_decl_toplevel_val:
  - match: (^(?:(?:inline|noinline)\s+)?val)\s+((?:[@a-z][\w\-@]*/#?)*)([@a-z][\w\-@]*[\']*|\([$%&\*\+@!/\\\^~=\.:\-\?\|<>]+\))?
    captures:
      1: keyword.declaration koka.keyword.val
      2: entity.name.variable koka.moduleid
      3: entity.name.function koka.id.decl.val
  repo_decl_val:
  - match: ((?:(?:inline|noinline)\s+)?val)\s+((?:[@a-z][\w\-@]*/#?)*)([@a-z][\w\-@]*[\']*|\([$%&\*\+@!/\\\^~=\.:\-\?\|<>]+\))?
    captures:
      1: keyword.declaration koka.keyword.val
      2: entity.name.variable koka.moduleid
      3: entity.name koka.id.decl.val
  repo_decl_var:
  - match: (var)\s+([a-z][\w\-]*[\']*|\([$%&\*\+@!/\\\^~=\.:\-\?\|<>]+\))
    captures:
      1: keyword.declaration koka.keyword.var
      2: entity.name koka.id.decl.var
  repo_decl_wrong_function:
  - match: ((?:(?:inline|noinline)\s+)?(?:tail\s+)?(?:(?:fip|fbip)(?:\(\d+\))?\s+)?(?:fun))\s+((?:wrong/|default/)(?:[@a-z][\w\-@]*/#?)*)([@a-z][\w\-@]*[\']*)
    captures:
      1: keyword.declaration.function
      2: keyword.declaration.function koka.moduleid
      3: entity.name.function koka.id.decl.function
  repo_dot:
  - match: \.
    scope: source.dot koka.special.dot
  repo_externid:
  - match: (?:c|cs|js|inline)\s+(?:inline\s+)?(?:(?:file|header-file|header-end-file)\s+)?(?=[\"\{]|r#*")
    scope: keyword.control
  repo_identifier:
  - match: '@?[a-z][\w\-@]*[\'']*'
    scope: source koka.id
  repo_import_id:
  - match: (import)(\s+(([a-z][\w\-]*/)*[a-z][\w\-]*)(\s+(=)(\s+(([a-z][\w\-]*/)*[a-z][\w\-]*))?))
    captures:
      1: keyword koka.keyword.import
      3: entity.name.variable koka.moduleid
      6: keyword koka.keyword.op
      8: entity.name.variable koka.moduleid
  repo_import_id2:
  - match: (import)(\s+(([a-z][\w\-]*/)*[a-z][\w\-]*))
    captures:
      1: keyword koka.keyword.import
      3: entity.name.variable koka.moduleid
  repo_inv_character:
  - match: '''([^''\\\n]|\\(.|x..|u....|U......))''|''$|''''?'
    scope: invalid.string.quoted.single koka.char.invalid
  repo_libraryid:
  - match: (resume|resume-shallow|rcontext)(?![\w\-?'])
    scope: keyword.control
  repo_libraryop:
  - match: (!)(?![$%&\*\+@!/\\\^~=\.:\-\?\|<>])
    scope: keyword.control koka.op.library
  repo_line_comment:
  - match: //
    captures:
      0: punctuation.definition.comment koka.comment.line
    push:
    - meta_scope: comment.line.double-slash koka.comment.line
    - match: $
      pop: true
    - match: '`(:[^\`\n]+)`'
      captures:
        1: koka.comment.doc.pre.type
    - match: '`(module [^\`\n]+)`'
      captures:
        1: koka.comment.doc.pre.module
    - match: '`+([^\`\n]*)`+'
      captures:
        1: koka.comment.doc.pre.source
    - match: \*([^\*]*)\*
      captures:
        1: koka.comment.doc.emph
    - match: _([^_]*)_
      captures:
        1: markup.italic koka.comment.doc.emph
  repo_line_directive:
  - match: ^\s*#.*$
    scope: meta.preprocessor koka.preprocessor
  repo_minus:
  - match: -(?![$%&\*\+@!/\\\^~=\.:\-\?\|<>])
    scope: source.operator.minus koka.op.minus
  repo_module_id:
  - match: (module)\s*((interface)?)\s*(([a-z][\w\-]*/)*[a-z][\w\-]*)
    captures:
      1: keyword.other koka.keyword.module
      3: keyword.other koka.keyword.interface
      4: entity.name.variable koka.moduleid
  repo_number:
  - match: -?(?:0[xX][\da-fA-F]+(?:_[\da-fA-F]+)*(\.[\da-fA-F]+(?:_[\da-fA-F]+)*)?([pP][\-+]?\d+)?|0[bB][01][01_]*|(?:0|[1-9]\d*)(?:_\d+)*(\.\d+(?:_\d+)*([eE][\-+]?\d+)?)?)
    scope: constant.numeric koka.number
  repo_operator:
  - match: '[$%&\*\+@!/\\\^~=\.:\-\?\|<>]+'
    scope: source.operator koka.op
  repo_param_identifier:
  - match: ([^]\s+)?(\?[\?]?\s*)?([@a-z][\w\-@]*[\']*)\s*(?=[:,\)])
    captures:
      1: koka.keyword.borrow
      2: koka.keyword.implicit
      3: source koka.id.param
  repo_qconstructor:
  - match: ((?:[@a-z][\w\-@]*/#?)+)(@?[A-Z][\w\-@]*[\']*)
    captures:
      1: entity.name.variable koka.moduleid
      2: entity.name.tag.css.constant.other.constructor koka.conid
  repo_qidentifier:
  - match: ([\?]?(?:[@a-z][\w\-@]*/#?)+)(@?[a-z][\w\-@]*[\']*)
    captures:
      1: entity.name.variable koka.moduleid
      2: source koka.id
  repo_qoperator:
  - match: ([\?]?(?:[@a-z][\w\-@]*/#?)+)(\([^\n\r\)]+\))
    captures:
      1: entity.name.variable koka.moduleid
      2: source.operator koka.op
  repo_rawstring:
  - match: r"
    captures:
      0: punctuation.definition.string koka.string
    push:
    - meta_scope: string.quoted.double koka.string.raw
    - match: '"'
      pop: true
      captures:
        0: punctuation.definition.string koka.string
    - match: '[^"]+'
      scope: string.quoted.double koka.string.raw
    - match: .
      scope: invalid.string.quoted.double koka.string.raw
  repo_rawstring1:
  - match: r#"
    captures:
      0: punctuation.definition.string koka.string
    push:
    - meta_scope: string.quoted.double koka.string.raw
    - match: '"#'
      pop: true
      captures:
        0: punctuation.definition.string koka.string
    - match: '[^"]+'
      scope: string.quoted.double koka.string.raw
    - match: '"(?!#)'
      scope: string.quoted.double koka.string.raw
    - match: .
      scope: invalid.string.quoted.double koka.string.raw
  repo_rawstring2:
  - match: r##"
    captures:
      0: punctuation.definition.string koka.string
    push:
    - meta_scope: string.quoted.double koka.string.raw
    - match: '"##'
      pop: true
      captures:
        0: punctuation.definition.string koka.string
    - match: '[^"]+'
      scope: string.quoted.double koka.string.raw
    - match: '"(?!##)'
      scope: string.quoted.double koka.string.raw
    - match: .
      scope: invalid.string.quoted.double koka.string.raw
  repo_reservedcontrol:
  - match: (if|then|else|elif|match|return)(?![\w\-'])
    scope: keyword.control
  repo_reservedid:
  - match: (return(?=(?:\(|\s+\(?)\w[\w\-]*\s*(?:\)\s*(?:[^;])))|infix|infixr|infixl|type|co|lazy(?:\s+tail)?(?:\s+(?:fip|fbip)(?:\(\d+\))?)?|rec|struct|alias|forall|exists|some|extern|fun|fn|val|var|con|with(?:\s+override)?|module|import|as|in|ctx|hole|pub|abstract|effect|named|(?:raw\s+|final\s+)ctl|break|continue|unsafe|mask(?:\s+behind)?|handle|handler)(?![\w\-'])
    scope: keyword.other koka.keyword
  repo_reservedop:
  - match: (=|=>|\->|<\-|\||\.|:|:=)(?![$%&\*\+!/\\\^~=\.:\-\?\|<>])
    scope: keyword koka.keyword.op
  repo_special:
  - match: '[{}\(\)\[\];,]'
    scope: punctuation.separator koka.special
  repo_string:
  - match: '"'
    captures:
      0: punctuation.definition.string koka.string
    push:
    - meta_scope: string.quoted.double koka.string
    - match: '"|$'
      pop: true
      captures:
        0: punctuation.definition.string koka.string
    - match: ([^"\\]|\\.)+$
      scope: invalid.string.quoted.double koka.string.invalid
    - match: '[^"\\]+'
      scope: string.quoted.double.regular koka.string
    - match: \\([abfnrtvz0\\"'\?]|x[\da-fA-F]{2}|u[\da-fA-F]{4}|U[\da-fA-F]{6})
      scope: string.quoted.double constant.character.escape koka.string.escape
    - match: .
      scope: invalid.string.quoted.double koka.string
  repo_top_type:
  - match: (:(?![$%&\*\+@!\\\^~=\.:\-\|<>]))|(where|iff|when)(?![\w\-])
    captures:
      1: constant.numeric.type support.type koka.type
      2: keyword
    push:
    - match: (?=[,\)\{\}\[\]=;"`A-Z]|  |(infix|infixr|infixl|inline|noinline|fip|fbip|tail|value|reference|open|extend|rec|co|lazy|type|linear|effect|ambient|alias|extern|fn|fun|function|val|raw|final|ctl|var|con|if|then|else|elif|match|inject|mask|named|handle|handler|return|module|import|as|pub|abstract)(?![\w\-?']))
      pop: true
      captures:
        0: invalid.keyword koka.invalid
    - include: repo_type_content_top
  repo_top_type_alias:
  - match: (alias)\s+([a-z][\w\-]+)
    captures:
      1: keyword.declaration koka.keyword
      2: constant.numeric.type support.type koka.type.typecon
    push:
    - match: (?=[,\)\{\}\[\];"`A-Z]|(infix|infixr|infixl|inline|noinline|fip|fbip|tail|type|co|lazy|rec|linear|alias|effect|ambient|extern|fn|fun|function|val|var|con|if|then|else|elif|match|inject|mask|named|handle|handler|return|module|import|as|pub|abstract)(?![\w\-?']))
      pop: true
      captures:
        0: invalid.keyword koka.keyword.invalid
    - match: '='
      scope: keyword.other koka.keyword.op
    - include: repo_type_content_top
  repo_top_type_quantifier:
  - match: (exists|forall|some)(\s*)(<)
    captures:
      1: keyword koka.keyword
      3: constant.numeric.type support.type koka.type.special
    push:
    - match: (>)|(?=[\)\{\}\[\]=;"`]|(infix|infixr|infixl|inline|noinline|fip|fbip|tail|type|co|lazy|rec|effect|ambient|alias|extern|fn|fun|function|val|var|if|then|else|elif|match|inject|mask|named|handle|handler|return|module|import|as|pub|abstract)(?![\w\-?']))
      pop: true
      captures:
        1: constant.numeric.type support.type koka.type.special
        2: invalid.keyword koka.keyword.invalid
    - include: repo_type_content
  repo_top_type_struct:
  - match: ((?:(?:value|ref)\s*)?struct)\s+((?:[@a-z][\w\-@]*/#?)*)(@?[a-z][\w\-@]*[\']*)
    captures:
      1: keyword.declaration koka.keyword.struct
      2: entity.name.variable koka.moduleid
      3: constant.numeric.type support.type koka.type.typecon
  repo_top_type_struct_args:
  - match: ((?:(?:value|ref)\s*)?struct)\s+([a-z][\w\-]*|\(,*\))\s*(<)
    captures:
      1: keyword.declaration koka.keyword.struct
      2: constant.numeric.type support.type koka.type.typecon
      3: constant.numeric.type support.type koka.type.special
    push:
    - match: (>)|(?=[\)\{\}\[\]=;"`]|(infix|infixr|infixl|inline|noinline|fip|fbip|tail|type|co|lazy|rec|effect|ambient|alias|extern|fn|fun|function|val|var|if|then|else|elif|match|inject|mask|named|handle|handler|return|module|import|as|pub|abstract)(?![\w\-?']))
      pop: true
      captures:
        1: constant.numeric.type support.type koka.type.special
        2: invalid.keyword koka.keyword.invalid
    - include: repo_type_content
  repo_top_type_type:
  - match: ((?:(?:value|reference|open|extend|rec|co|lazy(?:\s+tail)?(?:\s+(?:fip|fbip)(?:\(\d+\))?)?)?\s*type)|(?:named\s+)?(?:scoped\s+)?(?:linear\s+)?(?:rec\s+)?(?:effect|ambient))\s+(?!fn|fun|val|raw|final|ctl|ret)((?:[@a-z][\w\-@]*/#?)*)(@?[a-z][\w\-@]*[\']*)
    captures:
      1: keyword.declaration.type koka.keyword
      2: entity.name.variable koka.moduleid
      3: constant.numeric.type support.type koka.type.typecon
    push:
    - match: (?=[\)\{\}\[\]=;"`A-Z]|  [\r\n]|(infix|infixr|infixl|inline|noinline|fip|fbip|tail|type|co|lazy|rec|effect|ambient|alias|extern|fn|fun|function|val|var|raw|final|ctl|con|if|then|else|elif|match|inject|mask|named|handle|handler|return|module|import|as|pub|abstract|value|reference|open|extend)(?![\w\-?']))
      pop: true
      captures:
        0: punctuation.separator koka.special
    - include: repo_type_content_top
  repo_type_app:
  - match: <(?![%&\*\+@!/\\\^~=\.:\-\?\|\s\d])
    captures:
      0: constant.numeric.type support.type koka.type.special
    push:
    - meta_scope: constant.numeric.type support.type koka.type.special
    - match: '>|\n|  '
      pop: true
      captures:
        0: constant.numeric.type support.type koka.type.special
    - include: repo_type_content
  repo_type_content:
  - include: repo_type_implicit_parameter
  - include: repo_type_parameter
  - include: repo_type_content_top
  repo_type_content_top:
  - match: (forall|exists|some|with|in|iff|when|is|if)(?![\w\-])
    scope: keyword.other
  - match: (\->|::?|\.)(?![$%&\*\+@!\\\^~=\.:\-\?\|<>])
    scope: constant.numeric.type support.type koka.type.special
  - include: repo_type_qidentifier
  - include: repo_type_variable
  - include: repo_type_identifier
  - include: repo_type_kind
  - match: \(
    captures:
      0: constant.numeric.type support.type koka.type.special
    push:
    - meta_scope: constant.numeric.type support.type koka.type.parens
    - match: \)
      pop: true
      captures:
        0: constant.numeric.type support.type koka.type.special
    - include: repo_type_content
  - match: <(?![%&\*\+@!/\\\^~=\.:\-\?\|])
    captures:
      0: constant.numeric.type support.type koka.type.special
    push:
    - meta_scope: constant.numeric.type support.type koka.type.special
    - match: '>|\n|  '
      pop: true
      captures:
        0: constant.numeric.type support.type koka.type.special
    - include: repo_type_content
  - match: \[
    captures:
      0: constant.numeric.type support.type koka.type.special
    push:
    - meta_scope: constant.numeric.type support.type koka.type.special
    - match: \]
      pop: true
      captures:
        0: constant.numeric.type support.type koka.type.special
    - include: repo_type_content
  - include: repo_line_comment
  - include: repo_block_comment
  - match: '[;,]|:'
    scope: constant.numeric.type support.type koka.type.special
  repo_type_identifier:
  - match: '[\$]?[@a-z][\w\-@]*[\'']*'
    scope: constant.numeric.type support.type koka.type.typecon
  repo_type_implicit_parameter:
  - match: (\?(?:[@a-z][\w\-@]*/#?)*)([@a-z][\w\-@]*[\']*|\([$%&\*\+@!/\\\^~=\.:\-\?\|<>]+\))\s*(?=:(?!:))
    captures:
      1: entity.name.label source.typeparam koka.type.typeparam.implicit
      2: entity.name.label source.typeparam koka.type.typeparam.implicit
  repo_type_kind:
  - match: '[A-Z](?![\w\-])'
    scope: constant.numeric.type support.type koka.type.kind
  repo_type_parameter:
  - match: ([\^]\s+)?((?:[\?][\?]?\s*)?[@a-z][\w\-@]*[\']*)\s*(?=:(?!:))
    captures:
      1: keyword.other koka.keyword.borrow
      2: entity.name.label source.typeparam koka.type.typeparam
  repo_type_qidentifier:
  - match: ([@a-z][\w\-@]*[\']*/#?)+
    scope: entity.name.variable koka.moduleid
  repo_type_variable:
  - match: ([_]?[a-z][0-9]*|_[\w\-]*[\']*|self)(?!\w)
    scope: markup.italic constant.numeric.type support.type koka.type.typevar
  repo_whitespace:
  - match: '[ \t]+'
    scope: source koka.white
  repo_wildcard:
  - match: '@?_[\w\-@]*[\'']*'
    scope: source.wildcard koka.id.wildcard
