%YAML 1.2
---
# Mojo (source.mojo): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/modular/vscode-mojo.git via GitHub Linguist v9.7.0 (license: apache-2.0).
name: Mojo
scope: source.mojo
file_extensions:
- mojo
contexts:
  main:
  - include: repo_statement
  - include: repo_expression
  repo_annotated-parameter:
  - match: "(?x)\n  \\b\n  ([[:alpha:]_]\\w*) \\s* (:)\n"
    captures:
      1: variable.parameter.function.language.python
      2: punctuation.separator.annotation.python
    push:
    - match: (,)|(?=\))
      pop: true
      captures:
        1: punctuation.separator.parameters.python
    - include: repo_expression
    - match: =(?!=)
      scope: keyword.operator.assignment.python
  repo_assignment-operator:
  - match: "(?x)\n     <<= | >>= | //= | \\*\\*=\n    | \\+= | -= | /= | @=\n    | \\*= | %= | ~= | \\^= | &= | \\|=\n    | =(?!=)\n"
    scope: keyword.operator.assignment.python
  repo_backticks:
  - match: \`
    push:
    - meta_scope: string.quoted.single.python
    - match: (?:\`|(?<!\\)(\n))
      pop: true
  repo_builtin-callables:
  - include: repo_illegal-names
  - include: repo_illegal-object-name
  - include: repo_builtin-exceptions
  - include: repo_builtin-functions
  - include: repo_builtin-types
  repo_builtin-exceptions:
  - match: "(?x) (?<!\\.) \\b(\n  (\n    Arithmetic | Assertion | Attribute | Buffer | BlockingIO\n    | BrokenPipe | ChildProcess\n    | (Connection (Aborted | Refused | Reset)?)\n    | EOF | Environment | FileExists | FileNotFound\n    | FloatingPoint | IO | Import | Indentation | Index | Interrupted\n    | IsADirectory | NotADirectory | Permission | ProcessLookup\n    | Timeout\n    | Key | Lookup | Memory | Name | NotImplemented | OS | Overflow\n    | Reference | Runtime | Recursion | Syntax | System\n    | Tab | Type | UnboundLocal | Unicode(Encode|Decode|Translate)?\n    | Value | Windows | ZeroDivision | ModuleNotFound\n  ) Error\n|\n  ((Pending)?Deprecation | Runtime | Syntax | User | Future | Import\n    | Unicode | Bytes | Resource\n  )? Warning\n|\n  SystemExit | Stop(Async)?Iteration\n  | KeyboardInterrupt\n  | GeneratorExit | (Base)?Exception\n)\\b\n"
    scope: support.type.exception.python
  repo_builtin-functions:
  - match: "(?x)\n  (?<!\\.) \\b(\n    __import__ | abs | aiter | all | any | anext | ascii | bin\n    | breakpoint | callable | chr | compile | copyright | credits\n    | delattr | dir | divmod | enumerate | eval | exec | exit\n    | filter | format | getattr | globals | hasattr | hash | help\n    | hex | id | input | isinstance | issubclass | iter | len\n    | license | locals | map | max | memoryview | min | next\n    | oct | open | ord | pow | print | quit | range | reload | repr\n    | reversed | round | setattr | sorted | sum | vars | zip\n  )\\b\n"
    scope: support.function.builtin.python
  - match: "(?x)\n  (?<!\\.) \\b(\n    file | reduce | intern | raw_input | unicode | cmp | basestring\n    | execfile | long | xrange\n  )\\b\n"
    scope: variable.legacy.builtin.python
  repo_builtin-possible-callables:
  - include: repo_builtin-callables
  - include: repo_magic-names
  repo_builtin-types:
  - match: "(?x)\n  (?<!\\.) \\b(\n    __mlir_attr | __mlir_op | __mlir_type | bool | bytearray | bytes | classmethod | complex | dict\n    | float | frozenset | int | SIMD | list | object | property\n    | set | slice | staticmethod | always_inline | capturing | parameter | throws | escaping | str | tuple | type\n\n    (?# Although 'super' is not a type, it's related to types,\n        and is special enough to be highlighted differently from\n        other built-ins)\n    | super\n  )\\b\n"
    scope: support.type.python
  repo_call-wrapper-inheritance:
  - match: "(?x)\n  \\b(?=\n    ([[:alpha:]_]\\w*) \\s* (\\()\n  )\n"
    push:
    - meta_scope: meta.function-call.python
    - match: (\))
      pop: true
      captures:
        1: punctuation.definition.arguments.end.python
    - include: repo_inheritance-name
    - include: repo_function-arguments
  repo_class-declaration:
  - match: "(?x)\n  \\s*(class|struct|trait)\\s+\n    (?=\n      [[:alpha:]_]\\w* \\s* (:|\\()\n    )\n"
    captures:
      1: storage.type.class.python
    push:
    - meta_scope: meta.class.python
    - match: (:)
      pop: true
      captures:
        1: punctuation.section.class.begin.python
    - include: repo_class-name
    - include: repo_class-inheritance
  repo_class-inheritance:
  - match: (\()
    captures:
      1: punctuation.definition.inheritance.begin.python
    push:
    - meta_scope: meta.class.inheritance.python
    - match: (\))
      pop: true
      captures:
        1: punctuation.definition.inheritance.end.python
    - match: (\*\*|\*)
      scope: keyword.operator.unpacking.arguments.python
    - match: ','
      scope: punctuation.separator.inheritance.python
    - match: =(?!=)
      scope: keyword.operator.assignment.python
    - match: \bmetaclass\b
      scope: support.type.metaclass.python
    - include: repo_illegal-names
    - include: repo_class-kwarg
    - include: repo_call-wrapper-inheritance
    - include: repo_expression-base
    - include: repo_member-access-class
    - include: repo_inheritance-identifier
  repo_class-kwarg:
  - match: "(?x)\n  \\b ([[:alpha:]_]\\w*) \\s*(=)(?!=)\n"
    captures:
      1: entity.other.inherited-class.python variable.parameter.class.python
      2: keyword.operator.assignment.python
  repo_class-name:
  - include: repo_illegal-object-name
  - include: repo_builtin-possible-callables
  - match: "(?x)\n  \\b ([[:alpha:]_]\\w*) \\b\n"
    scope: entity.name.type.class.python
  repo_codetags:
  - match: (?:\b(NOTE|XXX|HACK|FIXME|BUG|TODO)\b)
    captures:
      1: keyword.codetag.notation.python
  repo_comments:
  - match: "(?x)\n  (?:\n    \\# \\s* (type:)\n    \\s*+ (?# we want `\\s*+` which is possessive quantifier since\n             we do not actually want to backtrack when matching\n             whitespace here)\n    (?! $ | \\#)\n  )\n"
    captures:
      0: meta.typehint.comment.python
      1: comment.typehint.directive.notation.python
    push:
    - meta_scope: comment.line.number-sign.python
    - meta_content_scope: meta.typehint.comment.python
    - match: (?:$|(?=\#))
      pop: true
    - match: "(?x)\n   ignore\n  (?= \\s* (?: $ | \\#))\n"
      scope: comment.typehint.ignore.notation.python
    - match: "(?x)\n  (?<!\\.)\\b(\n    bool | bytes | float | int | object | str\n    | List | Dict | Iterable | Sequence | Set\n    | FrozenSet | Callable | Union | Tuple\n    | Any | None\n  )\\b\n"
      scope: comment.typehint.type.notation.python
    - match: ([\[\]\(\),\.\=\*]|(->))
      scope: comment.typehint.punctuation.notation.python
    - match: ([[:alpha:]_]\w*)
      scope: comment.typehint.variable.notation.python
  - include: repo_comments-base
  repo_comments-base:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.python
    push:
    - meta_scope: comment.line.number-sign.python
    - match: ($)
      pop: true
    - include: repo_codetags
  repo_comments-string-double-three:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.python
    push:
    - meta_scope: comment.line.number-sign.python
    - match: ($|(?="""))
      pop: true
    - include: repo_codetags
  repo_comments-string-single-three:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.python
    push:
    - meta_scope: comment.line.number-sign.python
    - match: ($|(?='''))
      pop: true
    - include: repo_codetags
  repo_curly-braces:
  - match: \{
    captures:
      0: punctuation.definition.dict.begin.python
    push:
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.dict.end.python
    - match: ':'
      scope: punctuation.separator.dict.python
    - include: repo_expression
  repo_decorator:
  - match: "(?x)\n  ^\\s*\n  ((@)) \\s* (?=[[:alpha:]_]\\w*)\n"
    captures:
      1: entity.name.function.decorator.python
      2: punctuation.definition.decorator.python
    push:
    - meta_scope: meta.function.decorator.python
    - match: "(?x)\n  ( \\) )\n    # trailing whitespace and comments are legal\n    (?: (.*?) (?=\\s*(?:\\#|$)) )\n  | (?=\\n|\\#)\n"
      pop: true
      captures:
        1: punctuation.definition.arguments.end.python
        2: invalid.illegal.decorator.python
    - include: repo_decorator-name
    - include: repo_function-arguments
  repo_decorator-name:
  - include: repo_builtin-callables
  - include: repo_illegal-object-name
  - match: "(?x)\n  ([[:alpha:]_]\\w*) | (\\.)\n"
    scope: entity.name.function.decorator.python
    captures:
      2: punctuation.separator.period.python
  - include: repo_line-continuation
  - match: "(?x)\n  \\s* ([^([:alpha:]\\s_\\.#\\\\] .*?) (?=\\#|$)\n"
    scope: invalid.illegal.decorator.python
    captures:
      1: invalid.illegal.decorator.python
  repo_double-one-regexp-character-set:
  - match: "(?x)\n  \\[ \\^? \\] (?! .*?\\])\n"
  - match: (\[)(\^)?(\])?
    captures:
      1: punctuation.character.set.begin.regexp constant.other.set.regexp
      2: keyword.operator.negation.regexp
      3: constant.character.set.regexp
    push:
    - meta_scope: meta.character.set.regexp
    - match: (\]|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: punctuation.character.set.end.regexp constant.other.set.regexp
        2: invalid.illegal.newline.python
    - include: repo_regexp-character-set-escapes
    - match: '[^\n]'
      scope: constant.character.set.regexp
  repo_double-one-regexp-comments:
  - match: \(\?#
    captures:
      0: punctuation.comment.begin.regexp
    push:
    - meta_scope: comment.regexp
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: punctuation.comment.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_codetags
  repo_double-one-regexp-conditional:
  - match: (\()\?\((\w+(?:\s+[[:alnum:]]+)?|\d+)\)
    captures:
      0: keyword.operator.conditional.regexp
      1: punctuation.parenthesis.conditional.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.conditional.negative.regexp punctuation.parenthesis.conditional.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-expression:
  - include: repo_regexp-base-expression
  - include: repo_double-one-regexp-character-set
  - include: repo_double-one-regexp-comments
  - include: repo_regexp-flags
  - include: repo_double-one-regexp-named-group
  - include: repo_regexp-backreference
  - include: repo_double-one-regexp-lookahead
  - include: repo_double-one-regexp-lookahead-negative
  - include: repo_double-one-regexp-lookbehind
  - include: repo_double-one-regexp-lookbehind-negative
  - include: repo_double-one-regexp-conditional
  - include: repo_double-one-regexp-parentheses-non-capturing
  - include: repo_double-one-regexp-parentheses
  repo_double-one-regexp-lookahead:
  - match: (\()\?=
    captures:
      0: keyword.operator.lookahead.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookahead.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookahead-negative:
  - match: (\()\?!
    captures:
      0: keyword.operator.lookahead.negative.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookahead.negative.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookbehind:
  - match: (\()\?<=
    captures:
      0: keyword.operator.lookbehind.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookbehind.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookbehind-negative:
  - match: (\()\?<!
    captures:
      0: keyword.operator.lookbehind.negative.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookbehind.negative.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-named-group:
  - match: "(?x)\n  (\\()  (\\?P <\\w+(?:\\s+[[:alnum:]]+)?>)\n"
    captures:
      1: support.other.parenthesis.regexp punctuation.parenthesis.named.begin.regexp
      2: entity.name.tag.named.group.regexp
    push:
    - meta_scope: meta.named.regexp
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.named.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-parentheses:
  - match: \(
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-parentheses-non-capturing:
  - match: '\(\?:'
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-one-regexp-expression
  repo_double-three-regexp-character-set:
  - match: "(?x)\n  \\[ \\^? \\] (?! .*?\\])\n"
  - match: (\[)(\^)?(\])?
    captures:
      1: punctuation.character.set.begin.regexp constant.other.set.regexp
      2: keyword.operator.negation.regexp
      3: constant.character.set.regexp
    push:
    - meta_scope: meta.character.set.regexp
    - match: (\]|(?="""))
      pop: true
      captures:
        1: punctuation.character.set.end.regexp constant.other.set.regexp
        2: invalid.illegal.newline.python
    - include: repo_regexp-character-set-escapes
    - match: '[^\n]'
      scope: constant.character.set.regexp
  repo_double-three-regexp-comments:
  - match: \(\?#
    captures:
      0: punctuation.comment.begin.regexp
    push:
    - meta_scope: comment.regexp
    - match: (\)|(?="""))
      pop: true
      captures:
        1: punctuation.comment.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_codetags
  repo_double-three-regexp-conditional:
  - match: (\()\?\((\w+(?:\s+[[:alnum:]]+)?|\d+)\)
    captures:
      0: keyword.operator.conditional.regexp
      1: punctuation.parenthesis.conditional.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.conditional.negative.regexp punctuation.parenthesis.conditional.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-expression:
  - include: repo_regexp-base-expression
  - include: repo_double-three-regexp-character-set
  - include: repo_double-three-regexp-comments
  - include: repo_regexp-flags
  - include: repo_double-three-regexp-named-group
  - include: repo_regexp-backreference
  - include: repo_double-three-regexp-lookahead
  - include: repo_double-three-regexp-lookahead-negative
  - include: repo_double-three-regexp-lookbehind
  - include: repo_double-three-regexp-lookbehind-negative
  - include: repo_double-three-regexp-conditional
  - include: repo_double-three-regexp-parentheses-non-capturing
  - include: repo_double-three-regexp-parentheses
  - include: repo_comments-string-double-three
  repo_double-three-regexp-lookahead:
  - match: (\()\?=
    captures:
      0: keyword.operator.lookahead.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookahead.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookahead-negative:
  - match: (\()\?!
    captures:
      0: keyword.operator.lookahead.negative.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookahead.negative.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookbehind:
  - match: (\()\?<=
    captures:
      0: keyword.operator.lookbehind.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookbehind.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookbehind-negative:
  - match: (\()\?<!
    captures:
      0: keyword.operator.lookbehind.negative.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookbehind.negative.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-named-group:
  - match: "(?x)\n  (\\()  (\\?P <\\w+(?:\\s+[[:alnum:]]+)?>)\n"
    captures:
      1: support.other.parenthesis.regexp punctuation.parenthesis.named.begin.regexp
      2: entity.name.tag.named.group.regexp
    push:
    - meta_scope: meta.named.regexp
    - match: (\)|(?="""))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.named.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-parentheses:
  - match: \(
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-parentheses-non-capturing:
  - match: '\(\?:'
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.end.regexp
        2: invalid.illegal.newline.python
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_ellipsis:
  - match: \.\.\.
    scope: constant.other.ellipsis.python
  repo_escape-sequence:
  - match: "(?x)\n  \\\\ (\n        x[0-9A-Fa-f]{2}\n        | [0-7]{1,3}\n        | [\\\\\"'abfnrtv]\n     )\n"
    scope: constant.character.escape.python
  repo_escape-sequence-unicode:
  - match: "(?x)\n  \\\\ (\n        u[0-9A-Fa-f]{4}\n        | U[0-9A-Fa-f]{8}\n        | N\\{[\\w\\s]+?\\}\n     )\n"
    scope: constant.character.escape.python
  repo_expression:
  - include: repo_expression-base
  - include: repo_member-access
  - match: (?x) \b ([[:alpha:]_]\w*) \b
  repo_expression-bare:
  - include: repo_backticks
  - include: repo_literal
  - include: repo_regexp
  - include: repo_string
  - include: repo_lambda
  - include: repo_generator
  - include: repo_illegal-operator
  - include: repo_operator
  - include: repo_curly-braces
  - include: repo_item-access
  - include: repo_list
  - include: repo_odd-function-call
  - include: repo_round-braces
  - include: repo_function-call
  - include: repo_builtin-functions
  - include: repo_builtin-types
  - include: repo_builtin-exceptions
  - include: repo_magic-names
  - include: repo_special-names
  - include: repo_illegal-names
  - include: repo_special-variables
  - include: repo_ellipsis
  - include: repo_punctuation
  - include: repo_line-continuation
  repo_expression-base:
  - include: repo_comments
  - include: repo_expression-bare
  - include: repo_line-continuation
  repo_f-expression:
  - include: repo_expression-bare
  - include: repo_member-access
  - match: (?x) \b ([[:alpha:]_]\w*) \b
  repo_fregexp-base-expression:
  - include: repo_fregexp-quantifier
  - include: repo_fstring-formatting-braces
  - match: \{.*?\}
  - include: repo_regexp-base-common
  repo_fregexp-quantifier:
  - match: "(?x)\n  \\{\\{(\n    \\d+ | \\d+,(\\d+)? | ,\\d+\n  )\\}\\}\n"
    scope: keyword.operator.quantifier.regexp
  repo_fstring-fnorm-quoted-multi-line:
  - match: (\b[fF])([bBuU])?('''|""")
    captures:
      1: string.interpolated.python string.quoted.multi.python storage.type.string.python
      2: invalid.illegal.prefix.python
      3: punctuation.definition.string.begin.python string.interpolated.python string.quoted.multi.python
    push:
    - meta_scope: meta.fstring.python
    - match: (\3)
      pop: true
      captures:
        1: punctuation.definition.string.end.python string.interpolated.python string.quoted.multi.python
        2: invalid.illegal.newline.python
