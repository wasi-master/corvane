      push:
      - meta_scope: constant.other.menu-comment.texinfo
      - match: $|(?=\s*@end\s)
        pop: true
      - include: repo_main
    - include: repo_main
  repo_param:
  - match: '[^\s{}@,]+|(?<=\s)({)[^\s{}@,]+(})'
    scope: variable.parameter.texinfo
    captures:
      1: punctuation.definition.begin.texinfo
      2: punctuation.definition.end.texinfo
  repo_quotation:
  - match: ((@)(quotation|smallquotation))(?=\s|$)
