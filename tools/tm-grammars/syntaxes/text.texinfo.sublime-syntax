    - meta_scope: meta.manual-name.texinfo
    - meta_content_scope: constant.other.reference.link.texinfo
    - match: \)
      pop: true
      captures:
        0: punctuation.definition.reference.manual.end.texinfo
    - include: repo_main
  repo_menu:
  - match: ((@)(detailmenu|direntry|menu))(?=\s|$)
    captures:
      2: punctuation.definition.function.texinfo
    push:
    - match: ((@)end\s+\3)\b
      pop: true
      captures:
        2: punctuation.definition.function.texinfo
    - match: ^\*\s
      captures:
        0: punctuation.definition.list.menu.texinfo
      push:
      - meta_scope: markup.list.texinfo
      - match: ^(?=\S)
        pop: true
      - match: (\s*\(.*?\))?
        push:
        - meta_content_scope: entity.name.tag.entry-name.texinfo
        - match: ::?|(?=\s*$)
          pop: true
          captures:
            0: punctuation.separator.key-value.menu.texinfo
        - include: repo_main
      - match: (?<=[^:]:)\s*(\(.*?\))?
