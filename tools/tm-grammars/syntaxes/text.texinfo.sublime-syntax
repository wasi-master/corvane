  - include: repo_dashes
  - include: repo_alias
  - include: repo_menu
  - include: repo_booleanCommands
  - include: repo_symbolCommands
  - include: repo_set
  - include: repo_definitions
  - include: repo_quotation
  - include: repo_boldText
  - include: repo_italicText
  - include: repo_verbatim
  - include: repo_codeBlocks
