%YAML 1.2
---
# KakouneScript (source.kakscript): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/kakoune-editor/language-kak via GitHub Linguist v9.7.0 (license: unlicense).
name: KakouneScript
scope: source.kakscript
file_extensions:
- kak
- kakrc
contexts:
  main:
  - include: repo_kakscript
  repo_boolean:
  - match: \b(yes|no|false|true)\b
  repo_builtinOption:
  - match: \b(tabstop|indentwidth|scrolloff|eolformat|BOM|readonly|incsearch|aligntab|autoinfo|autocomplete|ignored_files|disabled_hooks|filetype|path|completers|static_words|extra_word_chars|matching_pairs|autoreload|writemethod|debug|idle_timeout|fs_check_timeout|modelinefmt|ui_options|startup_info_version)\b
    scope: support.variable.kakscript
  repo_builtinVariable:
  - match: \b(bufname|buffile|buflist|buf_line_count|timestamp|history_id|selection|selections|runtime|config|version|session|client|client_pid|client_list|modified|cursor_line|cursor_column|cursor_char_value|cursor_char_column|cursor_display_column|cursor_byte_offset|selection_desc|selections_desc|selections_char_desc|selections_display_column_desc|selection_length|selections_length|window_width|window_height|user_modes|window_range|history|uncommitted_modifications|(?:opt_|main_reg_|reg_|client_env_)\w+)\b
    scope: support.constant.kakscript
  repo_colour:
  - match: \b(default|(?:bright-)?(?:black|red|green|yellow|blue|magenta|cyan|white))\b
  repo_command:
  - match: \b(edit|write|kill|quit|write-quit|delete-buffer)!
  - match: \b(edit|write|write-all|kill|quit|write-quit|write-all-quit|map|unmap|alias|unalias|buffer|buffer-next|buffer-previous|delete-buffer|add-highlighter|remove-highlighter|hook|trigger-user-hook|remove-hooks|define-command|echo|debug|source|try|catch|fail|nop|set-option|unset-option|update-option|declare-option|execute-keys|evaluate-commands|prompt|menu|on-key|info|set-face|unset-face|rename-client|set-register|select|change-directory|rename-session|colorscheme|declare-user-mode|enter-user-mode|provide-module|require-module)\b
  - match: \b(e|w|q|wq|db)!
  - match: \b(help|cd|e|w|wa|q|wq|waq|b|bn|bp|db|decl|set|unset|def|eval|exec|rmhooks|face|addhl|rmhl|reg)\b
  repo_comment:
  - match: '#.+'
    scope: comment.line.number-sign.kakscript
  repo_hookType:
  - match: \b(NormalIdle|NormalKey|InsertIdle|InsertKey|InsertChar|InsertDelete|InsertMove|PromptIdle|WinCreate|WinClose|WinResize|WinDisplay|WinSetOption|GlobalSetOption|BufSetOption|BufNewFile|BufOpenFile|BufCreate|BufWritePre|BufWritePost|BufReload|BufClose|BufOpenFifo|BufReadFifo|BufCloseFifo|ClientCreate|ClientClose|RuntimeError|ModeChange|KakBegin|KakEnd|FocusIn|FocusOut|InsertCompletionShow|InsertCompletionHide|RawKey|RegisterModified|ModuleLoaded|User)\b
    scope: support.function.hook.kakscript
  repo_kakscript:
  - include: repo_boolean
  - include: repo_builtinOption
  - include: repo_builtinVariable
  - include: repo_comment
  - include: repo_colour
  - include: repo_command
  - include: repo_hookType
  - include: repo_namedKeys
  - include: repo_number
  - include: repo_optionType
  - include: repo_shellExpansion
  - include: repo_scopeType
  - include: repo_string
  repo_namedKeys:
  - match: <(ret|space|tab|lt|gt|backspace|esc|up|down|left|right|pageup|pagedown|home|end|ins|del|plus|minus|semicolon|percent)>
    scope: constant.character.kakscript
  repo_number:
  - match: \b(\d+)\b
    scope: constant.numeric.integer.kakscript
  repo_optionType:
  - match: \b(int|bool|str|regex|int-list|str-list|completions|line-specs|range-specs|str-to-str-map)\b
    scope: storage.type.kakscript
  repo_scopeExpansion:
  - match: '%(arg|val|opt|reg)\{[w-]+\}'
    scope: string.interpolated.kakscript
  repo_scopeType:
  - match: \b(current|global|buffer|window)\b
    scope: entity.name.type.kakscript
  repo_shellExpansion:
  - match: '%sh\{'
    push:
    - meta_scope: source.shell.embedded.kakscript
    - match: '}'
      pop: true
    - include: scope:source.shell
  repo_string:
  - match: (").*?(")
    scope: string.quoted.double.kakscript
    captures:
      1: punctuation.definition.string.begin.kakscript
      2: punctuation.definition.string.end.kakscript
  - match: (').*?(')
    scope: string.quoted.single.kakscript
    captures:
      1: punctuation.definition.string.begin.kakscript
      2: punctuation.definition.string.end.kakscript
