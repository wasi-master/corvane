name: TI Program
scope: source.8xp
file_extensions:
- 8xp
- 8xp.txt
contexts:
  main:
  - include: repo_functions
  - include: repo_special-chars
  - include: repo_control
  - include: repo_operators
  - include: repo_numbers
  - include: repo_snippets
  - include: repo_strings
  - include: repo_constants
  - include: repo_headers
  - include: repo_variables
  - include: repo_reals
  repo_constants:
  - match: CENTER|LEFT|RIGHT
    scope: constant.language.8xp
  - match: \[(MATHPRINT|CLASSIC|(U)?n\/d|AUTO|DEC|FRAC(\-APPROX)?|STATWIZARD O(FF|N))\]
    scope: constant.language.8xp
  - match: BLUE|RED|BLACK|MAGENTA|GREEN|ORANGE|BROWN|NAVY|LTBLUE|YELLOW|WHITE|LTGRAY|MEDGRAY|GRAY|DARKGRAY
    scope: constant.language.8xp
  - match: Blue|Red|Black|Magenta|Green|Orange|Brown|Navy|LtBlue|Yellow|White|LtGray|MedGray|Gray|DarkGray
    scope: constant.language.8xp
  repo_control:
  - match: '(If|While|Repeat|Lbl|Goto|Wait|DelVar) '
    scope: keyword.control.8xp
  - match: Then|Else|End|Pause|Return|Stop|ExecLib
    scope: keyword.control.8xp
  - match: (For|IS>|DS<|Menu|GraphStyle|GraphColor|OpenLib)(?=\()
    scope: keyword.control.8xp
  repo_functions:
  - match: "prgm([A-Z\u03B8]|theta)([0-9A-Z\u03B8]|theta){0,7}"
    scope: entity.name.function.8xp
  - match: "(abs|angle|ANOVA|Asm(Comp)?|augment|bal|binom(c|p)df|checkTmr|(\u03C7\xB2|chi\\^2)((c|p)df|(GOF)?-Test)|Circle|conj|cos(h)?(\\^-1|\u207B\xB9)?|cumSum|dayOfWk|dbd|det|dim|DS<|(e|10|\u2081\u2080)\\^\\^|(>|\u25BA)Eff|Equ(>|\u25BA)String|eval|expr|(F|\U0001D405)(c|p)df|Fill|fM(ax|in)|fnInt|fPart|gcd|geomet(c|p)df|Get|GetCalc|get(Dt|Tm)Str|identity|imag|inString|int|(Sigma|\u03A3)Int|inv(Binom|Norm|T)|iPart|irr|IS>|lcm|length|Line|(Delta|\u0394)List|List(>|\u25BA)matr|ln|log(BASE)?|Matr(>|\u25BA)list|max|mean|median|min|nDeriv|(>|\u25BA)Nom|normal(c|p)df|npv|Output|piece[wW]ise|Plot[1-3]|poisson(c|p)df|(Sigma|\u03A3)Prn|prod|[1-2]\\-PropZ(Int|Test)|P(t|xl)\\-(Change|O(ff|n))|pxl\\-Test|P(>|\u25BA)R[x-y]|rand(Bin|Int(NoRep)?|M|Norm)|real|ref|remainder|round|\\*row(\\+)?|row(\\+|Swap)|rref|R(>|\u25BA)P(r|theta|\u03B8)|2\\-SampZ(Int|Test)|Select|Send|seq|set(Date|Time)|set(Dt|Tm)Fmt|Shade(\u03C7\xB2|chi\\^2|F|\U0001D405|Norm|_t)?|sin(h)?(\\^-1|\u207B\xB9)?|solve|Sort(A|D)|stdDev|String(>|\u25BA\
      )Equ|su[bm]|Sigma|\u03A3|tan(h)?(\\^-1|\u207B\xB9)?|Tangent|t[cp]df|Text(Color)?|timeCnv|toString|variance|Z\\-Test)(?=\\()"
    scope: entity.name.function.8xp
  - match: "(Archive|AxesOn|BackgroundOn|BorderColor|ClrList|Disp|Draw(F|Inv)|ExpReg|Fix|FnO(ff|n)|GridDot|GridLine|Horizontal|Input|Lbl|LinReg\\((a\\+bx|ax\\+b)\\)|LinRegT(Int|Test)|LnReg|Logistic|Manual\\-Fit|Med\\-Med| n(C|P)r|PlotsO(ff|n)|Prompt|PwrReg|Qua(d|rt)Reg|(Recall|Store)(GDB|Pic)|2\\-Samp(F|\U0001D405)Test|2\\-SampT(Int|Test)|SetUpEditor|SinReg|TInterval|T\\-Test|UnArchive|(1|2)-Var Stats|Vertical|Wait) "
