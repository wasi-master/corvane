    scope: entity.name.function.8xp
  - match: "(?:(?<=Goto )|(?<=Lbl ))([0-9A-Z\u03B8]|theta){1,2}"
    scope: entity.name.function.8xp
  repo_headers:
  - match: ^\:DCS(6|)$
    scope: entity.name.section.8xp
  repo_numbers:
  - match: (\d+\.?\d*|\.\d+)
    scope: constant.numeric.8xp
  repo_operators:
  - match: "(->|\\+|-|\\*|/|\\^|=|\u2260|!=|>|\u2265|>=|<|\u2264|<=|squareroot|\u221A|xroot|\u02E3\u221A|(sqrt|\u221A|cuberoot|\xB3\u221A)\\()"
    scope: keyword.operator.8xp
  - match: (cuberoot|sqrt)(?=\()
    scope: keyword.operator.8xp
  - match: ( (and|or|xor) |not(?=\())
    scope: keyword.operator.expression.8xp
  repo_reals:
  - match: "[A-Z\u03B8]|theta"
    scope: variable.parameter.8xp
  repo_snippets:
  - match: <[a-z ]+>
    scope: variable.other.8xp
  repo_special-chars:
  - match: "(\\^\\^(r|o|\\-1|2|T|3)|\u02B3|\xB0|\u207B\xB9|\xB2|\u1D40|\xB3|\\|(N|F|\U0001D405|[PC]\\/Y)|\U0001D5E1|I%|invertedequal|(square|cross|dot)plot|\u25A1|\uFE62|\xB7|sharps|small(T|10|[0-9])|(bold)?(up|down)arrow|plotpixel|\xB7|U?n\\/d|mathprintbox|\u2B1A|plottinydot)"
    scope: markup.raw.8xp
  repo_strings:
  - match: '"'
    push:
    - meta_scope: string.quoted.double.8xp
    - match: '"|

        |(?=->)'
      pop: true
  repo_variables:
  - match: Ans
    scope: variable.language.8xp
  - match: \[(xhat(1|2)?|sigma[xy]|yhat|recursiven|phat(1|2)?|(factor|error)(df|SS|MS))\]
