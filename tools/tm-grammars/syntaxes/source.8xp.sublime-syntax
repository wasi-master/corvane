  - match: "Xmin|Xmax|Xscl|Ymin|Ymax|Yscl|[UV](n-1|\U0001D48F-\u2081)|Xres|(Delta|\u2206)[XY]|XFact|YFact|TraceStep|Tmin|Tmax|Tstep|Z?(theta|\u03B8)[mM]in|Z?(theta|\u03B8)[mM]ax|Z?(theta|\u03B8)step|\\|[uvw]|((?<=[uvw])\\(((n|\U0001D48F)Min\\)))|(n|\U0001D48F)Min|(n|\U0001D48F)Max|PlotStart|PlotStep"
    scope: variable.parameter.8xp
  - match: "ZXmin|ZXmax|ZXscl|ZYmin|ZYmax|ZYscl|ZXres|ZTmin|ZTmax|ZTstep|thetastep|Z[uvw]|(((?<=Z[uvw])|(?<=[uvw]))\\(((n|\U0001D48F)Min\\)))|Z(n|\U0001D48F)Min|Z(n|\U0001D48F)Max|ZPlotStart|ZPlotStep"
    scope: variable.parameter.8xp
  - match: (Pic|Image|GDB|Str)[0-9]
    scope: variable.parameter.8xp
  - match: "\\[(n(1|2)?|i|RegEQ|xhat(1|2)?|yhat|Sigma[xy](\\^2)?|Sx(1|2|p)?|Sy|(min|max)[XY]|Sigmaxy|r(\\^2)?|Med|Q[13\u2081\u2083]|\\|[Fa-e]|[xy][1-3]|[pstz]|chi\\^2|df|lower|upper|R\\^2|e)\\]"
    scope: variable.parameter.8xp
  - match: "\U0001D456|[xy][\u2081-\u2083]|\u03C7\xB2|(x\u0304|n|Sx)[\u2081\u2082]|(r|R)\xB2"
    scope: variable.parameter.8xp
  - match: "Tbl(Start|Input)|(Delta|\u2206)Tbl"
    scope: variable.parameter.8xp
  - match: "theta|\u03B8|pi(?!xelplot)|\u03C0|alpha|\u03B1|beta|\u03B2|gamma|\u03B3|Delta|\u0394|delta|\u03B4|epsilon|\u03B5|lambda|\u03BB|mu|\u03BC|greek_pi|\\|\u03C0|rho|\u03C1|Sigma|\u03A3|Phi|\u03A6|Omega|\u03A9|phat|\u1E57|chi|\u03C7|sigma|\u03C3|tau|\u03C4"
    scope: variable.parameter.8xp
  - match: "{Y[0-9]}|Y[\u2080-\u2089]"
    scope: variable.parameter.8xp
  - match: "{[XY][1-6]T}|[XY][\u2081-\u2086]\u1D1B"
    scope: variable.parameter.8xp
  - match: "{r[1-6]}|r[\u2081-\u2086]"
    scope: variable.parameter.8xp
  - match: "L[1-6\u2081-\u2086]"
    scope: variable.parameter.8xp
  - match: "((?<=->)|\\|L)([A-Z\u03B8]|theta)([0-9A-Z\u03B8]|theta){0,4}"
    scope: variable.parameter.8xp
  - match: \[[A-J]\]
    scope: variable.parameter.8xp
