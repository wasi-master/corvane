%YAML 1.2
---
# Mask (source.mask): converted from TextMate by tools/tm-grammars/sync.py;
# source vendor/grammars/sublime-mask via GitHub Linguist v9.7.0 (license: mit).
name: Mask
scope: source.mask
file_extensions:
- mask
contexts:
  main:
  - include: repo_comments
  - include: repo_punctuation
  - include: repo_literal-string
  - include: repo_decorator
  - include: repo_import
  - include: repo_xml_markdown
  - include: repo_xml_style
  - include: repo_xml_script
  - include: repo_xml
  - include: repo_define
  - include: repo_tag_javascript
  - include: repo_tag_var
  - include: repo_tag_style
  - include: repo_tag_markdown
  - include: repo_tag
  - include: repo_statement
  - include: repo_node_klass_id
  - include: repo_node_template
  - include: repo_node
  repo_comments:
  - match: /\*
    captures:
      0: punctuation.definition.comment.js
    push:
    - meta_scope: comment.block.js
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.js
  - match: (//).*$\n?
    scope: comment.line.double-slash.js
    captures:
      1: punctuation.definition.comment.js
  repo_decorator:
  - match: (\[)
    captures:
      1: keyword
    push:
    - match: (\])
      pop: true
      captures:
        1: keyword
    - include: scope:source.js
  repo_define:
  - match: ((define|let)\b)
    captures:
      1: support.constant
    push:
    - meta_scope: define.mask
    - match: (?<=[>;\{\}])|(?=[>;\{\}])|([>;\{\}])
      pop: true
    - match: (as|extends)\b
      scope: keyword
    - match: (,)
      scope: punctuation
    - match: ([\w_\-:]+)
      scope: entity.other.attribute-name
    - match: (\([^\)]*\))
      scope: variable.parameter
  repo_expression:
  - match: (\()
    captures:
      0: variable.parameter
    push:
    - meta_scope: markup.italic
    - match: \)
      pop: true
      captures:
        0: variable.parameter
    - include: repo_js-expression
    - include: scope:source.js
  repo_html:
  - match: ((\{|>)\s*('''|"""))
    captures:
      1: variable.parameter
    push:
    - meta_scope: syntax.html.mask
    - match: (('''|"""))
      pop: true
      captures:
        1: variable.parameter
    - include: scope:text.html.basic
  repo_import:
  - match: (import)\b
    captures:
      1: keyword
    push:
    - meta_scope: import.mask
    - match: (;|(?<=['|"]))
      pop: true
    - match: \b(sync|async|as|from)\b
      scope: keyword
    - match: (,)
      scope: punctuation
    - include: repo_literal-string
  repo_interpolation:
  - match: (?<!\\)(~)([\w\.]+)
    scope: markup.italic
    captures:
      1: variable.parameter
      2: other.interpolated.mask
  - match: (~\[)
    captures:
      0: variable.parameter
    push:
    - meta_scope: markup.italic
    - match: \]
      pop: true
      captures:
        0: variable.parameter
    - match: (\s*\w*\s*:)
      scope: keyword.util.mask
    - include: repo_js-interpolation
    - include: scope:source.js
  repo_javascript:
  - match: \{
    captures:
      0: variable.parameter
    push:
    - meta_scope: syntax.js.mask
    - match: \}
      pop: true
      captures:
        0: variable.parameter
    - include: repo_js-block
    - include: scope:source.js
  repo_js-block:
  - match: \{
    push:
    - meta_scope: other.interpolated.mask
    - match: \}
      pop: true
    - include: repo_js-block
    - include: scope:source.js
  repo_js-expression:
  - match: \(
    push:
    - meta_scope: other.interpolated.mask
    - match: \)
      pop: true
    - include: repo_js-expression
    - include: scope:source.js
  repo_js-interpolation:
  - match: \[
    push:
    - meta_scope: other.interpolated.mask
    - match: \]
      pop: true
    - include: repo_js-interpolation
    - include: scope:source.js
  repo_klass_id:
  - match: ([\.#][\w_\-$:]*)
    captures:
      1: entity.other.attribute-name.markup.bold.mask
    push:
    - meta_scope: node-head.attribute.mask
    - match: (?=[\s\.#])
      pop: true
    - include: repo_interpolation
    - match: (([\w_\-$]+)(?=[\s.#]))
      scope: entity.other.attribute-name.mask
  repo_literal-string:
  - match: (''')
    captures:
      0: string.quoted.single.js
    push:
    - meta_scope: literal-string
    - match: (''')
      pop: true
      captures:
        0: string.quoted.single.js
    - include: repo_string-content
  - match: (""")
    captures:
      0: string.quoted.single.js
    push:
    - meta_scope: literal-string
    - match: (""")
      pop: true
      captures:
        0: string.quoted.single.js
    - include: repo_string-content
  - match: (')
    captures:
      0: string.quoted.single.js
    push:
    - meta_scope: literal-string
    - match: (')
      pop: true
      captures:
        0: string.quoted.single.js
    - include: repo_string-content
  - match: (")
    captures:
      0: string.quoted.single.js
    push:
    - meta_scope: literal-string
    - match: (")
      pop: true
      captures:
        0: string.quoted.single.js
    - include: repo_string-content
  repo_markdown:
  - match: ((\{|>)\s*('''|"""))
    captures:
      1: variable.parameter
    push:
    - meta_scope: syntax.markdown.mask
    - match: ('''|""")
      pop: true
      captures:
        1: variable.parameter
    - include: scope:text.md
  repo_node:
  - match: ([^\s\.#;>\{\(]+)
    captures:
      0: entity.name.tag.mask
    push:
    - meta_scope: node.mask
    - match: (?<=[>;\{\}])|(?=[>;\{\}])|([>;\{\}])
      pop: true
    - include: repo_node_attributes
  repo_node_attribute:
  - include: repo_comments
  - include: repo_expression
  - match: ([\w_\-$]+)(\s*=\s*)
    captures:
      1: entity.other.attribute-name
      2: keyword.operator.assignment
    push:
    - meta_scope: attribute-key-value
    - match: ([\s;>\{])
      pop: true
    - include: repo_node_attribute_value
  - match: ([\w_\-$:]+)(?=([\s;>\{])|$)
    scope: entity.other.attribute-name
  repo_node_attribute_expression:
  - match: (\()
    push:
    - meta_scope: meta.group.braces.round
    - match: (\))
      pop: true
    - include: repo_js-expression
  repo_node_attribute_value:
  - match: (true|false)(?=[\s>;\{])
    scope: constant.character
  - match: ([\d\.]+)(?=[\s>;\{])
    scope: constant.numeric
  - include: repo_literal-string
  - match: ((\s*)[^\s>;\{]+)
    scope: string.quoted
  repo_node_attributes:
  - include: repo_klass_id
  - include: repo_node_attribute
  repo_node_klass_id:
  - match: (?=[\.#])
    push:
    - meta_scope: node.head.mask
    - match: (?<=[>;\{\}])|(?=[>;\{\}])|([>;\{\}])
      pop: true
    - include: repo_klass_id
    - include: repo_node_attribute
  repo_node_template:
  - match: (@[^\s\.#;>\{]+)
    captures:
      0: variable.parameter.mask
    push:
    - meta_scope: node.mask
    - match: (?<=[>;\{\}])|(?=[>;\{\}])|([>;\{\}])
      pop: true
    - include: repo_klass_id
    - include: repo_node_attribute
  repo_punctuation:
  - match: ([>;\{\}])
    scope: meta.group.braces
  repo_statement:
  - match: (if|else|with|each|for|switch|case|\+if|\+with|\+each|\+for|debugger|log|script|\:import|\:template|include)(?=[\s.#;\{\}]|$)
    captures:
      1: support.constant
    push:
    - meta_scope: tag.mask
    - match: (?<=[>;\{\}])|(?=[>;\{\}])|([>;\{\}])
      pop: true
    - include: repo_node_attributes
  repo_string-content:
  - match: \\(x[\da-fA-F]{2}|u[\da-fA-F]{4}|.)
    scope: constant.character.escape.js
  - include: repo_interpolation
  - match: (.)
    scope: string
  repo_style:
  - match: (\{)
    captures:
      1: variable.parameter
    push:
    - meta_scope: syntax.style.mask
    - match: (\})
      pop: true
      captures:
        1: variable.parameter
    - include: scope:source.css
  repo_tag:
  - match: (a|abbr|acronym|address|applet|area|article|aside|audio|b|base|basefont|bdo|big|blockquote|body|br|button|canvas|caption|center|cite|code|col|colgroup|command|datalist|dd|del|details|dfn|dir|div|dl|dt|em|embed|fieldset|figcaption|figure|font|footer|form|frame|frameset|h1|h2|h3|h4|h5|h6|head|header|hgroup|hr|html|i|iframe|img|input|ins|keygen|kbd|label|legend|li|link|map|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|pre|progress|q|rp|rt|ruby|s|samp|script|section|select|small|source|span|strike|strong|style|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|tt|u|ul|video|wbr|xmp)(?=[\s.#;\{\}]|$)
    captures:
      1: storage.type.mask
    push:
    - meta_scope: tag.mask
    - match: (?<=[>;\{\}])|(?=[>;\{\}])|([>;\{\}])
      pop: true
    - include: repo_node_attributes
  repo_tag_javascript:
  - match: (slot|pipe|event|function|script)\b
    captures:
      1: support.constant
    push:
    - meta_scope: slot.mask
    - match: (\})|(?<=\})
      pop: true
    - match: \b(static|private|public|async|self)\b
      scope: keyword
    - include: repo_klass_id
    - include: repo_node_attribute
    - include: repo_javascript
  repo_tag_markdown:
  - match: (md|markdown)\b
    captures:
      1: support.constant
    push:
    - meta_scope: syntax.markdown.mask
    - match: (?<=\})|(\})
      pop: true
    - include: repo_klass_id
    - include: repo_node_attribute
    - include: repo_markdown
  repo_tag_style:
  - match: (style)\b
    captures:
      1: support.constant
    push:
    - meta_scope: syntax.style.mask
    - match: (?<=\})|(\})
      pop: true
    - include: repo_klass_id
    - include: repo_node_attribute
    - include: repo_style
  repo_tag_var:
  - match: (var)\b
    captures:
      1: support.constant
    push:
    - meta_scope: var.mask
    - match: ([\};\]])|(?<=[\};\]])
      pop: true
    - include: scope:source.js
  repo_xml:
  - match: (?=</?\s*(\w+))
    push:
    - meta_scope: syntax.html.mask
    - match: (?<=</\1>)
      pop: true
    - match: (<mask>)
      push:
      - match: (</mask>)
        pop: true
      - include: main
    - include: scope:text.html.basic
    - include: repo_xml
  repo_xml_markdown:
  - match: (?i)<markdown[^\>]*>
    captures:
      0: variable.parameter
    push:
    - meta_scope: syntax.markdown.mask
    - match: (?i)</markdown[^\>]*>
      pop: true
      captures:
        0: variable.parameter
    - include: scope:text.md
  repo_xml_script:
  - match: (?i)<script[^\>]*>
    captures:
      0: variable.parameter
    push:
    - meta_scope: syntax.markdown.mask
    - match: (?i)</script[^\>]*>
      pop: true
      captures:
        0: variable.parameter
    - include: scope:source.js
  repo_xml_style:
  - match: (?i)<style[^\>]*>
    captures:
      0: variable.parameter
    push:
    - meta_scope: syntax.markdown.mask
    - match: (?i)</style[^\>]*>
      pop: true
      captures:
        0: variable.parameter
    - include: scope:source.css
