  repo_fnstatement:
  - match: (?ix) \b(?<![:\.])(FUNCTION|AGGREGATE|ABSTRACT CONSTRAINT)\b
    captures:
      1: keyword.declaration.edgeql
    push:
    - match: (?=[^\s\w:]|\bEXTENDING\b|$)
      pop: true
    - include: repo_builtins
    - include: repo_identifier
    - match: (::)
      scope: keyword.operator.namespace.edgeql
