  - match: "(?x) \\b(?<!::|\\.|\\.<|\\.>)(\n  cal | cfg | enc | ext |\n  fts | go | http | js |\n  lang | math | net | perm |\n  pg | py | rs | schema |\n  std | sys\n)\\b\n"
