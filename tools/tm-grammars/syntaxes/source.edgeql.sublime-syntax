    captures:
      1: punctuation.definition.comment.edgeql
      2: comment.line.note.notation.edgeql
      3: comment.line.note.edgeql
  - match: (#).*$\n?
    scope: comment.line.number-sign.edgeql
    captures:
      1: punctuation.definition.comment.edgeql
