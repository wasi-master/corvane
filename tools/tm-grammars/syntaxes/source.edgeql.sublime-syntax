      1: keyword.declaration.edgeql
      3: keyword.declaration.edgeql
  - match: "(?xi)\n  \\b(FROM) \\s+\n  (SQL) \\s+\n  (\\$\\w?\\$)\n"
    captures:
      1: keyword.declaration.edgeql
      3: string.quoted.edgeql
    push:
    - match: (\3)
