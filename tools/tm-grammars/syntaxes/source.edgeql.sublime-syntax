    scope: keyword.operator.navigation.edgeql
  - match: (::)
    scope: keyword.operator.namespace.edgeql
  - match: ->
    scope: keyword.declaration.edgeql
  - match: (:(?!=))
    scope: punctuation.declaration.delimiter.edgeql
  - match: "(?x)\n  \\?\\!\\= | \\?\\? | \\?\\= | \\>\\= | \\<\\= | \\:\\= | \\/\\/ | \\+\\+ |\n  \\!\\= | \\^ | \\> | \\= | \\< | \\/ | \\- | \\+ |\n  \\* | \\%\n"
    scope: keyword.operator.edgeql
  repo_parencommon:
  - match: (,)
    scope: punctuation.separator.element.edgeql
  - match: (;)
    scope: invalid.illegal.delimiter.edgeql
  repo_parentheses:
  - match: (\()
    captures:
      1: punctuation.parenthesis.begin.edgeql
    push:
    - match: (\))
      pop: true
      captures:
        1: punctuation.parenthesis.end.edgeql
    - include: repo_expressions
    - include: repo_parencommon
  repo_quoted-name:
  - match: (`.*?`)
    scope: string.interpolated.edgeql
  repo_shape:
  - match: (?=\S)
    push:
    - match: (?=\})
      pop: true
    - match: (;)
      scope: punctuation.statement.delimiter.edgeql
    - include: repo_expressions
    - include: repo_parencommon
  repo_squarebraces:
  - match: (\[)
    captures:
      1: punctuation.parenthesis.begin.edgeql
    push:
    - match: (\])
      pop: true
      captures:
        1: punctuation.parenthesis.end.edgeql
    - match: (^|\b|\s)(->)($|\b|\s)
      scope: keyword.operator.edgeql
    - include: repo_expressions
    - include: repo_parencommon
  repo_string:
  - match: (r)(['"])
    captures:
      1: storage.type.string.edgeql
      2: punctuation.definition.string.begin.edgeql
    push:
    - meta_scope: string.quoted.raw.edgeql
    - match: (\2)
      pop: true
      captures:
        1: punctuation.definition.string.end.edgeql
  - match: (['"])
    captures:
      1: punctuation.definition.string.begin.edgeql
    push:
    - meta_scope: string.quoted.edgeql
    - match: (\1)
      pop: true
      captures:
        1: punctuation.definition.string.end.edgeql
    - include: repo_string-escapes
    - include: repo_string-invalid-escapes
  - match: (\$([[:alpha:]_][[:alnum:]]*)*\$)
    captures:
      1: punctuation.definition.string.begin.edgeql
    push:
    - meta_scope: string.dollar.edgeql
    - match: (\1)
      pop: true
      captures:
        1: punctuation.definition.string.end.edgeql
  repo_string-escapes:
  - match: "(?x)\n  (\n    \\\\(?=\\s*\\n) |\n    \\\\[\\\\'\"bfnrt] |\n    \\\\x[0-7][0-9a-fA-F] |\n    \\\\u[0-9a-fA-F]{4} |\n    \\\\U[0-9a-fA-F]{8}\n  )\n"
    scope: constant.character.escape.edgeql
  repo_string-invalid-escapes:
  - match: (\\.)
    scope: invalid.illegal.escapes.edgeql
  repo_types:
  - match: \b(?<!::|\.)(tuple)\s*(<)
    captures:
      1: storage.type.edgeql
      2: storage.type.placeholder.begin.edgeql
    push:
    - match: (>)
      pop: true
      captures:
        1: storage.type.placeholder.end.edgeql
    - include: repo_types
    - match: (,)
      scope: punctuation.separator.type.edgeql
    - match: (:)
    - include: repo_types-common
  - match: \b(?<!::|\.)(array)\s*(<)
    captures:
      1: storage.type.edgeql
      2: storage.type.placeholder.begin.edgeql
    push:
    - match: (>)
      pop: true
      captures:
        1: storage.type.placeholder.end.edgeql
    - match: array
      scope: invalid.illegal.type.edgeql
    - include: repo_types
    - include: repo_array-dimensions
    - include: repo_types-common
  - match: "(?x) \\b(?<!::|\\.)(\n  array | tuple\n)\\b\n"
    scope: storage.type.edgeql
  - include: repo_builtin-modules
  - include: repo_builtin-types
  - include: repo_builtin-indexes
  repo_types-common:
  - include: repo_identifier
  - match: (::)
    scope: keyword.operator.namespace.edgeql
  repo_values:
  - include: repo_number
  - include: repo_bytes
  - include: repo_string
  repo_variables:
  - match: (\$)(?=[[:alnum:]_]|`)
    push:
    - meta_scope: constant.language.variable.edgeql
    - match: (?<=[[:alnum:]_`])
      pop: true
    - include: repo_identifier
    - include: repo_quoted-name
    - match: (\d)+
