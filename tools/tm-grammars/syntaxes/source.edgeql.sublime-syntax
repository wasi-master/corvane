name: EdgeQL
scope: source.edgeql
file_extensions:
- edgeql
- esdl
contexts:
  main:
  - include: repo_all
  repo_all:
  - include: repo_fnstatement
  - include: repo_expressions
  - match: (;)
    scope: punctuation.statement.delimiter.edgeql
  repo_array-dimensions:
  - match: (\[)
    captures:
      1: punctuation.parenthesis.begin.edgeql
    push:
    - match: (\])
      pop: true
      captures:
        1: punctuation.parenthesis.end.edgeql
    - match: (\d+)
      scope: constant.numeric.edgeql
    - match: \S+
      scope: invalid.illegal.type.edgeql
  repo_builtin-indexes:
  - match: "(?x) \\b(?<!\\.|\\.<|\\.>) (\n  brin | btree | gin | gist |\n  hash | index | spgist\n)\\b\n"
    scope: support.other.index.builtin.edgeql
