      2: support.function.builtin.edgeql
      3: entity.name.function.edgeql
      4: string.interpolated.edgeql
      5: keyword.operator.namespace.edgeql
      6: support.function.builtin.edgeql
      7: entity.name.function.edgeql
      8: string.interpolated.edgeql
      9: punctuation.definition.arguments.begin.edgeql
    push:
    - meta_scope: meta.function-call.edgeql
