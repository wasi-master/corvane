      1: storage.type.string.edgeql
      2: punctuation.definition.string.begin.edgeql
    push:
    - meta_scope: string.quoted.bytes.edgeql
    - match: (\2)
      pop: true
      captures:
        1: punctuation.definition.string.end.edgeql
    - include: repo_bytes-escapes
    - match: ([\n -!#-\[\]-~])+
    - match: (\\x.{1,2})|(\\.)|(.)
      scope: invalid.illegal.bytes.edgeql
  repo_bytes-escapes:
  - match: "(?x)\n  (\n    \\\\[\\\\'\"bfnrt] |\n    \\\\x[0-9a-fA-F]{2}\n  )\n"
    scope: constant.character.escape.edgeql
  repo_casts:
  - match: "(?xi)\n  (?:\n    (?<= ^ | [@~+\\-*/%^<>=?,:(\\[{])\n    |\n    (?<=\n      AND | OR | NOT | LIKE | ILIKE | IS | IN | IF | ELSE |\n      UNION | ALL | EXISTS |\n\n      SELECT | GROUP | UPDATE | BY | THEN | LIMIT |\n      # there are some ligature-related issues with \"fi\" and \"ff\"\n      F[Ii]LTER | OF[Ff]SET\n    )\n  ) \\s* (\\<)\n"
    captures:
      1: keyword.operator.cast.begin.edgeql
    push:
    - meta_content_scope: meta.typecast.edgeql
    - match: (\>)
      pop: true
      captures:
        1: keyword.operator.cast.end.edgeql
    - include: repo_types
    - include: repo_types-common
  repo_code:
  - match: "(?xi)\n  \\b(FROM) \\s+ (EDGEQL | SQL) \\s+ (EXPRESSION)\n"
