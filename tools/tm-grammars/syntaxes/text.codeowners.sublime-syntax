---
# CODEOWNERS (text.codeowners): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-etc via GitHub Linguist v9.7.0 (license: isc).
name: CODEOWNERS
scope: text.codeowners
file_extensions:
- CODEOWNERS
contexts:
  main:
  - include: repo_main
  repo_main:
  - include: scope:etc
  - include: scope:etc
  - include: repo_pattern
  repo_owner:
  - match: (@)((?:[-.\w]+/)?[-.\w]+)(?=$| |#)
    scope: meta.owner.codeowners
    captures:
      1: keyword.operator.mention.codeowners
      2: variable.assignment.team
  repo_pattern:
  - match: ^((?:[^#\s\\]|\\[^#])++)
    push:
    - meta_scope: meta.pattern.codeowners
    - match: $|(?=#)
      pop: true
    - include: scope:etc
    - match: \s
      push:
      - match: (?=$|#)
        pop: true
      - include: scope:etc
      - include: repo_owner
