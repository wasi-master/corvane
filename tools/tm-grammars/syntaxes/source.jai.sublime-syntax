---
# Jai (source.jai): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/SogoCZE/Jails.git via GitHub Linguist v9.7.0 (license: mit).
name: Jai
scope: source.jai
file_extensions:
- jai
contexts:
  main:
  - include: repo_block-comments
  - include: repo_comments
  - include: repo_imports
  - include: repo_asm
  - include: repo_strings
  - include: repo_casts
  - include: repo_keywords
  - include: repo_proc
  - include: repo_deprecated
  - include: repo_fors
  - include: repo_structs
  - include: repo_enums
  - include: repo_enum-members
  - include: repo_composite-literals
  - include: repo_symbols
  - include: repo_numbers
  - include: repo_declarations
  - include: repo_more-directives
  - include: repo_variables
  - include: repo_more-numbers
  repo_array:
  - match: (\[)([^\]]*)(\])
    captures:
      1: punctuation.section.brackets.begin.jai
      3: punctuation.section.brackets.end.jai
  repo_asm:
  - match: (#asm)\s*(([A-Z0-9]+)\s*(,[^}]*)?)?(\{)
    captures:
      1: keyword.other.directive.asm.jai
      3: keyword.other.feature.asm.jai
      5: punctuation.section.braces.begin.jai
    push:
    - meta_content_scope: source.asm.x86_64
    - match: (\})
      pop: true
      captures:
        1: punctuation.section.braces.end.jai
    - match: (===)
      captures:
        1: keyword.operator.pin.jai
  repo_block-comments:
  - match: (\/\*)
    captures:
      1: punctuation.definition.comment.jai
    push:
    - meta_scope: comment.block.jai
    - match: (\*\/)
      pop: true
      captures:
        1: punctuation.definition.comment.jai
    - include: repo_block-comments
    - match: (`)([^`]*)(`)
      captures:
        1: markup.quote.comment.jai
        2: comment.block.backquoted.jai
        3: markup.quote.comment.jai
    - match: (\@)((?i)TODO)([^@]*)
      captures:
        1: comment.block.punctuation.annotation.todo.jai
        2: comment.block.annotation.todo.jai
        3: comment.block.todo.jai
    - match: (\@)((?i)Release)([^@]*)
      captures:
        1: comment.block.punctuation.annotation.release.jai
        2: comment.block.annotation.release.jai
        3: comment.block.release.jai
    - match: (\@)((?i)Note)([^@]*)
      captures:
        1: comment.block.punctuation.annotation.note.jai
        2: comment.block.annotation.note.jai
        3: comment.block.note.jai
    - match: (\@)((?i)Urgent)([^@]*)
      captures:
        1: comment.block.punctuation.annotation.urgent.jai
        2: comment.block.annotation.urgent.jai
        3: comment.block.urgent.jai
    - match: (\@)((?i)Speed)([^@]*)
      captures:
        1: comment.block.punctuation.annotation.speed.jai
        2: comment.block.annotation.speed.jai
        3: comment.block.speed.jai
    - match: (\@)((?i)Robustness)([^@]*)
      captures:
        1: comment.block.punctuation.annotation.robustness.jai
        2: comment.block.annotation.robustness.jai
        3: comment.block.robustness.jai
    - match: (\@)((?i)NoCheckin)([^@]*)
      captures:
        1: comment.block.punctuation.annotation.nocheckin.jai
        2: comment.block.annotation.nocheckin.jai
        3: comment.block.todo.jai
    - match: (\@)(\w+)
      captures:
        1: comment.block.punctuation.annotation.jai
        2: comment.block.annotation.jai
    - match: (-) (\w+) ([0-9]{4}-[0-9]{2}-[0-9]{2})
      scope: comment.block.signature.jai
      captures:
        1: comment.block.punctuation.signature.jai
        2: comment.block.signature.name.jai
        3: comment.block.signature.date.jai
    - match: ^\s*(\[)( )(\])(.*)
      captures:
        1: comment.block.punctuation.checklist.brackets.todo.begin.jai
        2: comment.block.punctuation.checklist.mark.todo.jai
        3: comment.block.punctuation.checklist.brackets.todo.end.jai
        4: comment.block.checklist.item.todo.jai
    - match: ^\s*(\[)(\.)(\])(.*)
      captures:
        1: comment.block.punctuation.checklist.brackets.partial.begin.jai
        2: comment.block.punctuation.checklist.mark.partial.jai
        3: comment.block.punctuation.checklist.brackets.partial.end.jai
        4: comment.block.checklist.item.partial.jai
    - match: ^\s*(\[)([^ \.])(\])(.*)
      captures:
        1: comment.block.punctuation.checklist.brackets.done.begin.jai
        2: comment.block.punctuation.checklist.mark.done.jai
        3: comment.block.punctuation.checklist.brackets.done.end.jai
        4: comment.block.checklist.item.done.jai
  repo_block-comments-line:
  - match: (`)([^`]*)(`)
    captures:
      1: markup.quote.comment.jai
      2: comment.block.backquoted.jai
      3: markup.quote.comment.jai
  - match: (\@)((?i)TODO)([^@]*)
    captures:
      1: comment.block.punctuation.annotation.todo.jai
      2: comment.block.annotation.todo.jai
      3: comment.block.todo.jai
  - match: (\@)((?i)Release)([^@]*)
    captures:
      1: comment.block.punctuation.annotation.release.jai
      2: comment.block.annotation.release.jai
      3: comment.block.release.jai
  - match: (\@)((?i)Note)([^@]*)
    captures:
      1: comment.block.punctuation.annotation.note.jai
      2: comment.block.annotation.note.jai
      3: comment.block.note.jai
  - match: (\@)((?i)Urgent)([^@]*)
    captures:
      1: comment.block.punctuation.annotation.urgent.jai
      2: comment.block.annotation.urgent.jai
      3: comment.block.urgent.jai
  - match: (\@)((?i)Speed)([^@]*)
    captures:
      1: comment.block.punctuation.annotation.speed.jai
      2: comment.block.annotation.speed.jai
      3: comment.block.speed.jai
  - match: (\@)((?i)Robustness)([^@]*)
    captures:
      1: comment.block.punctuation.annotation.robustness.jai
      2: comment.block.annotation.robustness.jai
      3: comment.block.robustness.jai
  - match: (\@)((?i)NoCheckin)([^@]*)
    captures:
      1: comment.block.punctuation.annotation.nocheckin.jai
      2: comment.block.annotation.nocheckin.jai
      3: comment.block.nocheckin.jai
  - match: (\@)(\w+)
    captures:
      1: comment.block.punctuation.annotation.jai
      2: comment.block.annotation.jai
  - match: (-)\s*(.*)\s*([0-9]{4}-[0-9]{2}-[0-9]{2})
    scope: comment.block.signature.jai
    captures:
      1: comment.block.punctuation.signature.jai
      2: comment.block.signature.name.jai
      3: comment.block.signature.date.jai
  repo_casts:
  - match: \b(cast(,trunc)?(,no_check)?(,trunc)?)\s*(\()\s*((\**)[a-zA-Z_](?:\w|\\ *)*)\s*(\))
    captures:
      1: keyword.control.cast.jai
      5: punctuation.section.parens.begin.jai
      6: storage.type
      7: keyword.operator.pointer.jai
      8: punctuation.section.parens.begin.jai
  - match: \b(xx|cast)\b
    scope: keyword.control.cast.jai
  repo_comma-joined-asm-features:
  - match: (,)\s*([A-Z0-9]+)\s*
    captures:
      1: punctuation.separator.jai
      2: keyword.other.feature.asm.jai
  repo_comma-joined-variables:
  - match: (,)\s*((it_index|it)|([a-zA-Z_](?:\w|\\ *)*))
    captures:
      1: punctuation.separator.jai
      2: variable.other.declaration.jai
      3: support.variable.jai
  repo_comments:
  - match: (//)\s*(\[)( )(\])(.*)
    captures:
      1: punctuation.definition.comment.jai
      2: comment.line.double-slash.punctuation.checklist.brackets.todo.begin.jai
      3: comment.line.double-slash.punctuation.checklist.mark.todo.jai
      4: comment.line.double-slash.punctuation.checklist.brackets.todo.end.jai
      5: comment.line.double-slash.checklist.item.todo.jai
  - match: (//)\s*(\[)(\.)(\])(.*)
    captures:
      1: punctuation.definition.comment.jai
      2: comment.line.double-slash.punctuation.checklist.brackets.partial.begin.jai
      3: comment.line.double-slash.punctuation.checklist.mark.partial.jai
      4: comment.line.double-slash.punctuation.checklist.brackets.partial.end.jai
      5: comment.line.double-slash.checklist.item.partial.jai
  - match: (//)\s*(\[)([^ \.])(\])(.*)
    captures:
      1: punctuation.definition.comment.jai
      2: comment.line.double-slash.punctuation.checklist.brackets.done.begin.jai
      3: comment.line.double-slash.punctuation.checklist.mark.done.jai
      4: comment.line.double-slash.punctuation.checklist.brackets.done.end.jai
      5: comment.line.double-slash.checklist.item.done.jai
  - match: (//)(.*)
    captures:
      1: comment.line.double-slash.jai
      2: comment.line.double-slash.jai
  repo_comments-line:
  - match: (`)([^`]*)(`)
    captures:
      1: markup.quote.comment.jai
      2: comment.line.double-slash.backquoted.jai
      3: markup.quote.comment.jai
  - match: (\@)((?i)TODO)([^@]*)
    captures:
      1: comment.line.double-slash.punctuation.annotation.todo.jai
      2: comment.line.double-slash.annotation.todo.jai
      3: comment.line.double-slash.todo.jai
  - match: (\@)((?i)Release)([^@]*)
    captures:
      1: comment.line.double-slash.punctuation.annotation.release.jai
      2: comment.line.double-slash.annotation.release.jai
      3: comment.line.double-slash.release.jai
  - match: (\@)((?i)Note)([^@]*)
    captures:
      1: comment.line.double-slash.punctuation.annotation.note.jai
      2: comment.line.double-slash.annotation.note.jai
      3: comment.line.double-slash.note.jai
  - match: (\@)((?i)Urgent)([^@]*)
    captures:
      1: comment.line.double-slash.punctuation.annotation.urgent.jai
      2: comment.line.double-slash.annotation.urgent.jai
      3: comment.line.double-slash.urgent.jai
  - match: (\@)((?i)Speed)([^@]*)
    captures:
      1: comment.line.double-slash.punctuation.annotation.speed.jai
      2: comment.line.double-slash.annotation.speed.jai
      3: comment.line.double-slash.speed.jai
  - match: (\@)((?i)Robustness)([^@]*)
    captures:
      1: comment.line.double-slash.punctuation.annotation.robustness.jai
      2: comment.line.double-slash.annotation.robustness.jai
      3: comment.line.double-slash.robustness.jai
  - match: (\@)((?i)NoCheckin)([^@]*)
    captures:
      1: comment.line.double-slash.punctuation.annotation.nocheckin.jai
      2: comment.line.double-slash.annotation.nocheckin.jai
      3: comment.line.double-slash.nocheckin.jai
  - match: (\@)(\w+)
    captures:
      1: comment.line.double-slash.punctuation.annotation.jai
      2: comment.line.double-slash.annotation.jai
  - match: (-)\s*(.*)\s*([0-9]{4}-[0-9]{2}-[0-9]{2})
    scope: comment.line.double-slash.signature.jai
    captures:
      1: comment.line.double-slash.punctuation.signature.jai
      2: comment.line.double-slash.signature.name.jai
      3: comment.line.double-slash.signature.date.jai
  repo_composite-literals:
  - match: \b([a-zA-Z_](?:\w|\\ *)*)?\s*(\.)(\{)
    captures:
      1: storage.type.struct.jai
      2: punctuation.accessor.jai
      3: punctuation.section.braces.begin.jai
  - match: \b([a-zA-Z_](?:\w|\\ *)*)?\s*(\.)(\[)
    captures:
      1: storage.type.struct.jai
      2: punctuation.accessor.jai
      3: punctuation.section.bracket.begin.jai
  repo_declarations:
  - match: \b([a-zA-Z_](?:\w|\\ *)*)((\s*,\s*[a-zA-Z_](?:\w|\\ *)*)*)\s*(:)\s*(\[[^\]]*\])?\s*((\**)((#type(,(isa|distinct))?)|[a-zA-Z_](?:\w|\\ *)*))?\s*(:)
    captures:
      1: variable.other.constant.declaration.jai
      12: keyword.declaration.jai
      4: keyword.declaration.jai
      6: storage.type.jai
      7: keyword.operator.pointer.jai
      9: keyword.other.directive.jai
  - match: \b([a-zA-Z_](?:\w|\\ *)*)\s*(:)\s*(\[[^\]]*\])?\s*((\**)((#type(,(isa|distinct))?)|[a-zA-Z_](?:\w|\\ *)*))?\s*(:)
    captures:
      1: variable.other.constant.declaration.jai
      10: keyword.declaration.jai
      2: keyword.declaration.jai
      4: storage.type.jai
      5: keyword.operator.pointer.jai
      7: keyword.other.directive.jai
  - match: \b((it_index|it)|([a-zA-Z_](?:\w|\\ *)*))((\s*,\s*[a-zA-Z_](?:\w|\\ *)*)*)\s*(:)\s*((struct)|(enum)|(enum_flags))\b\s*([a-zA-Z_](?:\w|\\ *)*)?
    captures:
      1: variable.other.declaration.jai
      10: keyword.declaration.enum.jai
      11: storage.type.jai
      2: support.variable.jai
      6: keyword.declaration.jai
      8: keyword.declaration.struct.jai
      9: keyword.declaration.enum.jai
  - match: \b((it_index|it)|([a-zA-Z_](?:\w|\\ *)*))\s*(:)\s*((struct)|(enum)|(enum_flags))\b\s*([a-zA-Z_](?:\w|\\ *)*)?
    captures:
      1: variable.other.declaration.jai
      2: support.variable.jai
      4: keyword.declaration.jai
      6: keyword.declaration.struct.jai
      7: keyword.declaration.enum.jai
      8: keyword.declaration.enum.jai
      9: storage.type.jai
  - match: \b((it_index|it)|([a-zA-Z_](?:\w|\\ *)*))((\s*,\s*[a-zA-Z_](?:\w|\\ *)*)*)\s*(:)\s*(\[[^\]]*\])?\s*((\**)((#type(,(isa|distinct))?)|[a-zA-Z_](?:\w|\\ *)*))?\s*(=)?
    captures:
      1: variable.other.declaration.jai
      11: keyword.other.directive.jai
      14: keyword.declaration.jai
      2: support.variable.jai
      6: keyword.declaration.jai
      8: storage.type.jai
      9: keyword.operator.pointer.jai
  - match: \b((it_index|it)|([a-zA-Z_](?:\w|\\ *)*))\s*(:)\s*(\[[^\]]*\])?\s*((\**)((#type(,(isa|distinct))?)|[a-zA-Z_](?:\w|\\ *)*))?\s*(=)?
    captures:
      1: variable.other.declaration.jai
      12: keyword.declaration.jai
      2: support.variable.jai
      4: keyword.declaration.jai
      6: storage.type.jai
      7: keyword.operator.pointer.jai
      9: keyword.other.directive.jai
  repo_deprecated:
  - match: (#deprecated\s*((")(([^"\\]|\\.)*)("))?)
    captures:
      1: invalid.deprecated.jai
      3: punctuation.definition.string.deprecated.begin.jai
      4: string-quoted.other.deprecated.jai
      6: punctuation.definition.string.deprecated.end.jai
  repo_enum-members:
  - match: ([^\w])(\.)([a-zA-Z_](?:\w|\\ *)*)
    captures:
      2: punctuation.accessor.jai
      3: variable.enum.jai
  repo_enums:
  - match: \b([a-zA-Z_](?:\w|\\ *)*)\s*(::)\s*(enum(_flags)?)
    captures:
      1: entity.name.enum.jai
      2: keyword.declaration.jai
      3: keyword.declaration.enum.jai
  repo_expression:
  - include: repo_strings
  - include: repo_casts
  - include: repo_deprecated
  - include: repo_enum-members
  - include: repo_keywords
  - include: repo_symbols
  - include: repo_numbers
  - include: repo_variables
  - include: repo_more-numbers
  repo_fors:
  - match: \b(for)\s+([*<\s]*)\s*([a-zA-Z_](?:\w|\\ *)*)\s*(,)\s*([a-zA-Z_](?:\w|\\ *)*)\s*(:)
    captures:
      1: keyword.control.loop.for.jai
      2: keyword.operator.jai
      3: variable.other.declaration.jai
      4: punctuation.separator.jai
      5: variable.other.declaration.jai
      6: keyword.declaration.jai
  - match: \b(for)\s+([*<\s]*)\s*([a-zA-Z_](?:\w|\\ *)*)\s*(:)
    captures:
      1: keyword.control.loop.for.jai
      2: keyword.operator.jai
      3: variable.other.declaration.jai
      4: keyword.declaration.jai
  - match: \b(for)\s+([*<\s]*)
    captures:
      1: keyword.control.loop.for.jai
      2: keyword.operator.jai
  repo_imports:
  - match: ^\s*([a-zA-Z_](?:\w|\\ *)*)\s*(::)\s*(#import(,file|,dir|,string)?)\s+(")([^"]+)(")
    captures:
      1: entity.name.namespace.jai
      2: keyword.declaration.jai
      3: keyword.control.import.directive.jai
      6: punctuation.definition.string.import.begin.jai
      7: string-quoted.other.import.jai
      8: punctuation.definition.string.import.end.jai
  - match: (#import(,file|,dir|,string)?|#load)\s+(")([^"]+)(")
    captures:
      1: keyword.control.import.directive.jai
      4: punctuation.definition.string.import.begin.jai
      5: string-quoted.other.import.jai
      6: punctuation.definition.string.import.end.jai
  - match: (#import(,file|,dir|,string)?|#load)\s+("[^"]*)?$
    captures:
      1: keyword.control.import.directive.jai
      4: punctuation.definition.string.import.begin.jai
      5: string-quoted.other.import.jai
  - match: ^\s*([a-zA-Z_](?:\w|\\ *)*)\s*(::)\s*(#foreign_(system_)?library)\s+(")([^"]+)(")
    captures:
      1: constant.other.import.jai
      2: keyword.declaration.jai
      3: keyword.control.import.directive.jai
      5: punctuation.definition.string.import.begin.jai
      6: string-quoted.other.import.jai
      7: punctuation.definition.string.import.end.jai
  - match: ^\s*([a-zA-Z_](?:\w|\\ *)*)\s*(::)\s*(#foreign_(system_)?library)\s+("[^"]*)?$
    captures:
      1: constant.other.import.jai
      2: keyword.declaration.jai
      3: keyword.control.import.directive.jai
      5: punctuation.definition.string.import.begin.jai
      6: string-quoted.other.import.jai
  repo_keywords:
  - match: \b(if|ifx|then|else|case)\b
    scope: keyword.control.conditional.jai
  - match: \b(return|break|continue)\b
    scope: keyword.control.jump.jai
  - match: \b(while)\b
    scope: keyword.control.loop.while.jai
  - match: \b(remove)\b
    scope: keyword.control.loop.for.remove.jai
  - match: \b(defer)\b
    scope: keyword.control.defer.jai
  - match: (#add_context|#align|#as|#assert|#bake(_arguments|_constants)?|#bytes|#caller_code|#caller_location|#code(,(null|typed))?|#compile_time|#complete|#dump|#elsewhere|#expand|#file|#filepath|#ifx|#if|\binline\b|#insert(,scope)?|#intrinsic|#modify|#module_parameters|#must|#no_abc|#no_aoc|#no_alias|#no_padding|#no_reset|#place|#placeholder|#procedure_name|#procedure_of_call|#program_export|#run|#exists|#v2|#Context|#specified|#symmetric|#this|#through|#type(,(isa|distinct))?|#type_info_none|#type_info_procedures_are_void_pointers|#type_info_no_size_complaint|#unshared)\b
    scope: keyword.other.directive.jai
  - match: (#scope_export|#scope_file|#scope_module)
    scope: keyword.other.directive.scope.jai
  - match: (#char)
    scope: keyword.other.directive.string.jai
  - match: \b(context|push_context)\b
    scope: keyword.other.context.jai
  - match: \b(using(,map|,except|,only)?)\b
    scope: keyword.other.using.jai
  - match: \b(temp)\b
    scope: keyword.other.allocator.jai
  - match: \b(true)\b
    scope: constant.language.true.jai
  - match: \b(false)\b
    scope: constant.language.false.jai
  - match: \b(null)\b
    scope: constant.language.null.jai
  - match: \b(struct)\b
    scope: keyword.declaration.struct.jai
  - match: \b(enum)\b
    scope: keyword.declaration.enum.jai
  - match: \b(union)\b
    scope: keyword.declaration.union.jai
  - match: \b(int|u8|u16|u32|u64|s8|s16|s32|s64|float|float32|float64|bool|string|void|Code|Type)\b
    scope: storage.type.jai
  repo_more-directives:
  - match: (#foreign\s+([A-Z-a-z_]\w*(\s*(")(([^"\\]|\\.)*)("))?)|#compiler|#intrinsic|#runtime_support)
    captures:
      1: keyword.control.import.directive.decl.jai
      3: constant.other.import.jai
      5: punctuation.definition.string.import.begin.jai
      6: string-quoted.other.import.jai
      8: punctuation.definition.string.import.end.jai
  repo_more-numbers:
  - match: (0b[01_]+)
    captures:
      1: constant.numeric.jai
  - match: (0x[a-fA-F_\d]+)
    captures:
      1: constant.numeric.jai
  - match: (\d[\d_]*)
    captures:
      1: constant.numeric.jai
  repo_numbers:
  - match: '[(\[{:\s=.,/*+<>-](0b[01_]+)'
    captures:
      1: constant.numeric.jai
  - match: '[(\[{:\s=.,/*+<>-](0x[a-fA-F_\d]+)'
    captures:
      1: constant.numeric.jai
  - match: '[(\[\{:\s=.,/*+<>-](\d[\d_]*)'
    captures:
      1: constant.numeric.jai
  repo_proc:
  - match: \b([a-zA-Z_](?:\w|\\ *)*)\s*(::)\s*(#type)\b\s*((inline)\s*|(no_inline)\s*)*(\()(.*)(\))\s*((->)([^{]+))?\s*(((#foreign\s+([a-zA-Z_](?:\w|\\ *)*(\s*(")(([^"\\]|\\.)*)("))?)|#compiler|#intrinsic|#runtime_support)\s*)+\s*(#deprecated\s*((")(([^"\\]|\\.)*)("))?)?\s*(;)?)?(\s*#c_call|\s*#no_context|\s*#symmetric)*
