      12: meta.function.return-type.jai
      13: keyword.control.import.directive.decl.jai
      16: constant.other.import.jai
      18: punctuation.definition.string.import.begin.jai
      19: string-quoted.other.import.jai
      2: keyword.declaration.jai
      21: punctuation.definition.string.import.end.jai
