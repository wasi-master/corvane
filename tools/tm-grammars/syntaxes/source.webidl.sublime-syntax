%YAML 1.2
---
# WebIDL (source.webidl): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/andik/IDL-Syntax via GitHub Linguist v9.7.0 (license: mit).
name: WebIDL
scope: source.webidl
file_extensions:
- webidl
contexts:
  main:
  - include: repo_preprocessor-rule-enabled
  - include: repo_preprocessor-rule-disabled
  - include: repo_preprocessor-rule-other
  - include: repo_comments
  - include: repo_modblock
  - match: (cpp_quote)\b\(
    captures:
      1: keyword.cpp_quote.webidl
    push:
    - meta_scope: meta.modblock.webidl
    - match: \)
      pop: true
    - include: main
  - match: (SAFEARRAY)\b\(
    captures:
      1: storage.type.safearray.webidl
    push:
    - meta_scope: meta.safearray.webidl
    - match: \)
      pop: true
    - include: main
  - match: \b(break|case|continue|default|do|else|for|goto|if|_Pragma|return|switch|while)\b
    scope: keyword.control.webidl
  - match: \b(asm|__asm__|auto|bool|_Bool|char|_Complex|double|float|_Imaginary|int|long|short|signed|typedef|union|unsigned|void|VARIANT|BSTR)\b
    scope: storage.type.webidl
  - match: \b(const|extern|register|restrict|static|volatile|inline)\b
    scope: storage.modifier.webidl
  - match: \bk[A-Z]\w*\b
    scope: constant.other.variable.mac-classic.webidl
  - match: \bg[A-Z]\w*\b
    scope: variable.other.readwrite.global.mac-classic.webidl
  - match: \bs[A-Z]\w*\b
    scope: variable.other.readwrite.static.mac-classic.webidl
  - match: \b(NULL|true|false|TRUE|FALSE)\b
    scope: constant.language.webidl
  - include: repo_sizeof
  - match: \b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\.?[0-9]*)|(\.[0-9]+))((e|E)(\+|-)?[0-9]+)?)(L|l|UL|ul|u|U|F|f|ll|LL|ull|ULL)?\b
    scope: constant.numeric.webidl
  - match: '"'
    captures:
      0: punctuation.definition.string.begin.webidl
    push:
    - meta_scope: string.quoted.double.webidl
    - match: '"'
      pop: true
      captures:
        0: punctuation.definition.string.end.webidl
    - include: repo_string_escaped_char
    - include: repo_string_placeholder
  - match: ''''
    captures:
      0: punctuation.definition.string.begin.webidl
    push:
    - meta_scope: string.quoted.single.webidl
    - match: ''''
      pop: true
      captures:
        0: punctuation.definition.string.end.webidl
    - include: repo_string_escaped_char
  - match: "(?x)\n        \t\t^\\s*\\#\\s*(define)\\s+             # define\n        \t\t((?<id>[a-zA-Z_][a-zA-Z0-9_]*))  # macro name\n        \t\t(?:                              # and optionally:\n        \t\t    (\\()                         # an open parenthesis\n        \t\t        (\n        \t\t            \\s* \\g<id> \\s*       # first argument\n        \t\t            ((,) \\s* \\g<id> \\s*)*  # additional arguments\n        \t\t            (?:\\.\\.\\.)?          # varargs ellipsis?\n        \t\t        )\n        \t\t    (\\))                         # a close parenthesis\n        \t\t)?\n        \t"
    captures:
      1: keyword.control.import.define.webidl
      2: entity.name.function.preprocessor.webidl
      4: punctuation.definition.parameters.webidl
      5: variable.parameter.preprocessor.webidl
      7: punctuation.separator.parameters.webidl
      8: punctuation.definition.parameters.webidl
    push:
    - meta_scope: meta.preprocessor.macro.webidl
    - match: (?=(?://|/\*))|$
      pop: true
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.webidl
    - include: main
  - match: ^\s*#\s*(error|warning)\b
    captures:
      1: keyword.control.import.error.webidl
    push:
    - meta_scope: meta.preprocessor.diagnostic.webidl
    - match: $
      pop: true
      captures:
        1: keyword.control.import.error.webidl
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.webidl
  - match: ^\s*#\s*(include|import)\b\s+
    captures:
      1: keyword.control.import.include.webidl
    push:
    - meta_scope: meta.preprocessor.c.include
    - match: (?=(?://|/\*))|$
      pop: true
      captures:
        1: keyword.control.import.include.webidl
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.webidl
    - match: '"'
      captures:
        0: punctuation.definition.string.begin.webidl
      push:
      - meta_scope: string.quoted.double.include.webidl
      - match: '"'
        pop: true
        captures:
          0: punctuation.definition.string.end.webidl
    - match: <
      captures:
        0: punctuation.definition.string.begin.webidl
      push:
      - meta_scope: string.quoted.other.lt-gt.include.webidl
      - match: '>'
        pop: true
        captures:
          0: punctuation.definition.string.end.webidl
  - include: repo_pragma-mark
  - match: ^\s*#\s*(define|defined|elif|else|if|ifdef|ifndef|line|pragma|undef)\b
    captures:
      1: keyword.control.import.webidl
    push:
    - meta_scope: meta.preprocessor.webidl
    - match: (?=(?://|/\*))|$
      pop: true
      captures:
        1: keyword.control.import.webidl
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.webidl
  - match: \b(u_char|u_short|u_int|u_long|ushort|uint|u_quad_t|quad_t|qaddr_t|caddr_t|daddr_t|dev_t|fixpt_t|blkcnt_t|blksize_t|gid_t|in_addr_t|in_port_t|ino_t|key_t|mode_t|nlink_t|id_t|pid_t|off_t|segsz_t|swblk_t|uid_t|id_t|clock_t|size_t|ssize_t|time_t|useconds_t|suseconds_t)\b
    scope: support.type.sys-types.webidl
  - match: \b(pthread_attr_t|pthread_cond_t|pthread_condattr_t|pthread_mutex_t|pthread_mutexattr_t|pthread_once_t|pthread_rwlock_t|pthread_rwlockattr_t|pthread_t|pthread_key_t)\b
    scope: support.type.pthread.webidl
  - match: \b(int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|int_least8_t|int_least16_t|int_least32_t|int_least64_t|uint_least8_t|uint_least16_t|uint_least32_t|uint_least64_t|int_fast8_t|int_fast16_t|int_fast32_t|int_fast64_t|uint_fast8_t|uint_fast16_t|uint_fast32_t|uint_fast64_t|intptr_t|uintptr_t|intmax_t|intmax_t|uintmax_t|uintmax_t)\b
    scope: support.type.stdint.webidl
  - match: \b(noErr|kNilOptions|kInvalidID|kVariableLengthArray)\b
    scope: support.constant.mac-classic.webidl
  - match: \b(AbsoluteTime|Boolean|Byte|ByteCount|ByteOffset|BytePtr|CompTimeValue|ConstLogicalAddress|ConstStrFileNameParam|ConstStringPtr|Duration|Fixed|FixedPtr|Float32|Float32Point|Float64|Float80|Float96|FourCharCode|Fract|FractPtr|Handle|ItemCount|LogicalAddress|OptionBits|OSErr|OSStatus|OSType|OSTypePtr|PhysicalAddress|ProcessSerialNumber|ProcessSerialNumberPtr|ProcHandle|Ptr|ResType|ResTypePtr|ShortFixed|ShortFixedPtr|SignedByte|SInt16|SInt32|SInt64|SInt8|Size|StrFileName|StringHandle|StringPtr|TimeBase|TimeRecord|TimeScale|TimeValue|TimeValue64|UInt16|UInt32|UInt64|UInt8|UniChar|UniCharCount|UniCharCountPtr|UniCharPtr|UnicodeScalarValue|UniversalProcHandle|UniversalProcPtr|UnsignedFixed|UnsignedFixedPtr|UnsignedWide|UTF16Char|UTF32Char|UTF8Char)\b
    scope: support.type.mac-classic.webidl
  - match: \b(DISPID_NEWENUM|DISPID_VALUE)\b
    scope: constant.language.windows.webidl
  - match: \b(__int32|BOOL|BYTE|CLSID|COLORREF|DECIMAL|DOUBLE|DWORD|FLOAT|GUID|HDC|HRESULT|HWND|IDispatch|INT|IUnknown|IWeakReference|LONG|LPSTR|LPWSTR|MSG|OLE_COLOR|RECT|REFIID|SHORT|TCHAR|UINT|UINT_PTR|ULONG|ULONGLONG|VARIANT_BOOL)\b
    scope: storage.type.windows.webidl
  - include: repo_block
  - include: repo_function
  - match: \b(coclass|dispinterface|library|struct|interface|enum)\s+([_A-Za-z][_A-Za-z0-9]*\b)
    captures:
      1: storage.type.webidl
      2: entity.name.type.webidl
    push:
    - meta_scope: meta.class-struct-block.webidl
    - match: ([_A-Za-z][_A-Za-z0-9]*\b)? (?<=\})|(?=(;|,|\(|\)|>|\[|\]))
      pop: true
    - match: (\{)
      captures:
        1: punctuation.definition.scope.webidl
      push:
      - match: (\})(\s*\n)?
        pop: true
        captures:
          1: punctuation.definition.invalid.webidl
          2: invalid.illegal.you-forgot-semicolon.webidl
      - include: repo_function
      - include: repo_modblock
      - include: main
    - include: main
  repo_access:
  - match: \.[a-zA-Z_][a-zA-Z_0-9]*\b(?!\s*\()
    scope: variable.other.dot-access.webidl
  repo_block:
  - match: \{
    push:
    - meta_scope: meta.block.webidl
    - match: \}
      pop: true
    - include: repo_block_innards
  repo_block_innards:
  - include: repo_preprocessor-rule-enabled-block
  - include: repo_preprocessor-rule-disabled-block
  - include: repo_preprocessor-rule-other-block
  - include: repo_sizeof
  - include: repo_access
  - match: (\s*)\b(hypot(f|l)?|s(scanf|ystem|nprintf|ca(nf|lb(n(f|l)?|ln(f|l)?))|i(n(h(f|l)?|f|l)?|gn(al|bit))|tr(s(tr|pn)|nc(py|at|mp)|c(spn|hr|oll|py|at|mp)|to(imax|d|u(l(l)?|max)|k|f|l(d|l)?)|error|pbrk|ftime|len|rchr|xfrm)|printf|et(jmp|vbuf|locale|buf)|qrt(f|l)?|w(scanf|printf)|rand)|n(e(arbyint(f|l)?|xt(toward(f|l)?|after(f|l)?))|an(f|l)?)|c(s(in(h(f|l)?|f|l)?|qrt(f|l)?)|cos(h(f)?|f|l)?|imag(f|l)?|t(ime|an(h(f|l)?|f|l)?)|o(s(h(f|l)?|f|l)?|nj(f|l)?|pysign(f|l)?)|p(ow(f|l)?|roj(f|l)?)|e(il(f|l)?|xp(f|l)?)|l(o(ck|g(f|l)?)|earerr)|a(sin(h(f|l)?|f|l)?|cos(h(f|l)?|f|l)?|tan(h(f|l)?|f|l)?|lloc|rg(f|l)?|bs(f|l)?)|real(f|l)?|brt(f|l)?)|t(ime|o(upper|lower)|an(h(f|l)?|f|l)?|runc(f|l)?|gamma(f|l)?|mp(nam|file))|i(s(space|n(ormal|an)|cntrl|inf|digit|u(nordered|pper)|p(unct|rint)|finite|w(space|c(ntrl|type)|digit|upper|p(unct|rint)|lower|al(num|pha)|graph|xdigit|blank)|l(ower|ess(equal|greater)?)|al(num|pha)|gr(eater(equal)?|aph)|xdigit|blank)|logb(f|l)?|max(div|abs))|di(v|fftime)|_Exit|unget(c|wc)|p(ow(f|l)?|ut(s|c(har)?|wc(har)?)|error|rintf)|e(rf(c(f|l)?|f|l)?|x(it|p(2(f|l)?|f|l|m1(f|l)?)?))|v(s(scanf|nprintf|canf|printf|w(scanf|printf))|printf|f(scanf|printf|w(scanf|printf))|w(scanf|printf)|a_(start|copy|end|arg))|qsort|f(s(canf|e(tpos|ek))|close|tell|open|dim(f|l)?|p(classify|ut(s|c|w(s|c))|rintf)|e(holdexcept|set(e(nv|xceptflag)|round)|clearexcept|testexcept|of|updateenv|r(aiseexcept|ror)|get(e(nv|xceptflag)|round))|flush|w(scanf|ide|printf|rite)|loor(f|l)?|abs(f|l)?|get(s|c|pos|w(s|c))|re(open|e|ad|xp(f|l)?)|m(in(f|l)?|od(f|l)?|a(f|l|x(f|l)?)?))|l(d(iv|exp(f|l)?)|o(ngjmp|cal(time|econv)|g(1(p(f|l)?|0(f|l)?)|2(f|l)?|f|l|b(f|l)?)?)|abs|l(div|abs|r(int(f|l)?|ound(f|l)?))|r(int(f|l)?|ound(f|l)?)|gamma(f|l)?)|w(scanf|c(s(s(tr|pn)|nc(py|at|mp)|c(spn|hr|oll|py|at|mp)|to(imax|d|u(l(l)?|max)|k|f|l(d|l)?|mbs)|pbrk|ftime|len|r(chr|tombs)|xfrm)|to(b|mb)|rtomb)|printf|mem(set|c(hr|py|mp)|move))|a(s(sert|ctime|in(h(f|l)?|f|l)?)|cos(h(f|l)?|f|l)?|t(o(i|f|l(l)?)|exit|an(h(f|l)?|2(f|l)?|f|l)?)|b(s|ort))|g(et(s|c(har)?|env|wc(har)?)|mtime)|r(int(f|l)?|ound(f|l)?|e(name|alloc|wind|m(ove|quo(f|l)?|ainder(f|l)?))|a(nd|ise))|b(search|towc)|m(odf(f|l)?|em(set|c(hr|py|mp)|move)|ktime|alloc|b(s(init|towcs|rtowcs)|towc|len|r(towc|len))))\b
    captures:
      1: punctuation.whitespace.support.function.leading.webidl
      2: support.function.C99.webidl
  - match: "(?x) (?: (?= \\s )  (?:(?<=else|new|return) | (?<!\\w)) (\\s+))?\n\t\t\t(\\b\n\t\t\t\t(?!(while|for|do|if|else|switch|catch|enumerate|return|r?iterate)\\s*\\()(?:(?!NS)[A-Za-z_][A-Za-z0-9_]*+\\b | :: )++                  # actual name\n\t\t\t)\n\t\t\t \\s*(\\()"
    scope: meta.function-call.webidl
    captures:
      1: punctuation.whitespace.function-call.leading.webidl
      2: support.function.any-method.webidl
      3: punctuation.definition.parameters.webidl
  - match: "(?x)\n\t\t\t        (?x)\n\t\t\t(?:\n\t\t\t     (?: (?= \\s )           (?<!else|new|return) (?<=\\w)\\s+      #  or word + space before name\n\t\t\t     )\n\t\t\t)\n\t\t\t(\n\t\t\t\t(?: [A-Za-z_][A-Za-z0-9_]*+ | :: )++    |              # actual name\n\t\t\t\t(?: (?<=operator) (?: [-*&<>=+!]+ | \\(\\) | \\[\\] ) )?  # if it is a C++ operator\n\t\t\t)\n\t\t\t \\s*(\\()"
    scope: meta.initialization.webidl
    captures:
      1: variable.other.webidl
      2: punctuation.definition.parameters.webidl
  - include: repo_block
  - include: main
  repo_comments:
  - match: ^/\* =(\s*.*?)\s*= \*/$\n?
    scope: comment.block.webidl
    captures:
      1: meta.toc-list.banner.block.webidl
  - match: /\*
    captures:
      0: punctuation.definition.comment.webidl
    push:
    - meta_scope: comment.block.webidl
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.webidl
  - match: \*/.*\n
    scope: invalid.illegal.stray-comment-end.webidl
  - match: ^// =(\s*.*?)\s*=\s*$\n?
    scope: comment.line.banner.webidl
    captures:
      1: meta.toc-list.banner.line.webidl
  - match: //
    captures:
      0: punctuation.definition.comment.webidl
    push:
    - meta_scope: comment.line.double-slash.webidl
    - match: $\n?
      pop: true
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.webidl
  repo_disabled:
  - match: ^\s*#\s*if(n?def)?\b.*$
    push:
    - match: ^\s*#\s*endif\b.*$
      pop: true
    - include: repo_disabled
    - include: repo_pragma-mark
  repo_function:
  - match: "(?x)\n\t  \t\t(?:  ^                                 # begin-of-line\n\t  \t\t  |\n\t  \t\t     (?: (?= \\s )           (?<!else|new|return) (?<=\\w)      #  or word + space before name\n\t  \t\t       | (?= \\s*[A-Za-z_] ) (?<!&&)       (?<=[*&>])   #  or type modifier before name\n\t  \t\t     )\n\t  \t\t)\n\t  \t\t(\\s*) (?!(while|for|do|if|else|switch|catch|enumerate|return|r?iterate)\\s*\\()\n\t  \t\t(\n\t  \t\t\t(?: [A-Za-z_][A-Za-z0-9_]*+ | :: )++ |                  # actual name\n\t  \t\t\t(?: (?<=operator) (?: [-*&<>=+!]+ | \\(\\) | \\[\\] ) )  # if it is a C++ operator\n\t  \t\t)\n\t  \t\t \\s*(?=\\()"
    captures:
      1: punctuation.whitespace.function.leading.webidl
      3: entity.name.function.webidl
      4: punctuation.definition.parameters.webidl
    push:
    - meta_scope: meta.function.webidl
    - match: (?<=\})|(?=#)|(;)
      pop: true
    - include: repo_comments
    - include: repo_modblock
    - include: repo_parens
    - match: \b(const|override)\b
      scope: storage.modifier.webidl
    - include: repo_block
  repo_modblock:
  - match: \[
    push:
    - meta_scope: meta.modblock.webidl
    - match: \]
      pop: true
    - match: ([A-Za-z_][A-Za-z0-9_]*+)\b\s*\(
      captures:
        1: storage.modifier.modblock.key.webidl
      push:
      - meta_scope: meta.modblock.webidl
      - match: \)
        pop: true
      - include: main
    - match: '[A-Za-z_][A-Za-z0-9_]*+'
      scope: storage.modifier.modblock.key.webidl
  repo_parens:
  - match: \(
    push:
    - meta_scope: meta.parens.webidl
    - match: \)
      pop: true
    - include: main
  repo_pragma-mark:
  - match: ^\s*(#\s*(pragma\s+mark)\s+(.*))
    scope: meta.section
    captures:
      1: meta.preprocessor.webidl
      2: keyword.control.import.pragma.webidl
      3: meta.toc-list.pragma-mark.webidl
  repo_preprocessor-rule-disabled:
  - match: ^\s*(#(if)\s+(0)\b).*
    captures:
      1: meta.preprocessor.webidl
      2: keyword.control.import.if.webidl
      3: constant.numeric.preprocessor.webidl
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.if.webidl
        3: constant.numeric.preprocessor.webidl
    - match: ^\s*(#\s*(else)\b)
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.else.webidl
      push:
      - match: (?=^\s*#\s*endif\b.*$)
        pop: true
        captures:
          1: meta.preprocessor.webidl
          2: keyword.control.import.else.webidl
      - include: main
    - include: repo_disabled
    - include: repo_pragma-mark
  repo_preprocessor-rule-disabled-block:
  - match: ^\s*(#(if)\s+(0)\b).*
    captures:
      1: meta.preprocessor.webidl
      2: keyword.control.import.if.webidl
      3: constant.numeric.preprocessor.webidl
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.if.webidl
        3: constant.numeric.preprocessor.webidl
    - match: ^\s*(#\s*(else)\b)
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.else.webidl
      push:
      - match: (?=^\s*#\s*endif\b.*$)
        pop: true
        captures:
          1: meta.preprocessor.webidl
          2: keyword.control.import.else.webidl
      - include: repo_block_innards
    - include: repo_disabled
    - include: repo_pragma-mark
  repo_preprocessor-rule-enabled:
  - match: ^\s*(#(if)\s+(0*1)\b)
    captures:
      1: meta.preprocessor.webidl
      2: keyword.control.import.if.webidl
      3: constant.numeric.preprocessor.webidl
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.if.webidl
        3: constant.numeric.preprocessor.webidl
    - match: ^\s*(#\s*(else)\b).*
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.else.webidl
      push:
      - meta_content_scope: comment.block.preprocessor.else-branch
      - match: (?=^\s*#\s*endif\b.*$)
        pop: true
        captures:
          1: meta.preprocessor.webidl
          2: keyword.control.import.else.webidl
      - include: repo_disabled
      - include: repo_pragma-mark
    - include: main
  repo_preprocessor-rule-enabled-block:
  - match: ^\s*(#(if)\s+(0*1)\b)
    captures:
      1: meta.preprocessor.webidl
      2: keyword.control.import.if.webidl
      3: constant.numeric.preprocessor.webidl
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.if.webidl
        3: constant.numeric.preprocessor.webidl
    - match: ^\s*(#\s*(else)\b).*
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.else.webidl
      push:
      - meta_content_scope: comment.block.preprocessor.else-branch.in-block
      - match: (?=^\s*#\s*endif\b.*$)
        pop: true
        captures:
          1: meta.preprocessor.webidl
          2: keyword.control.import.else.webidl
      - include: repo_disabled
      - include: repo_pragma-mark
    - include: repo_block_innards
  repo_preprocessor-rule-other:
  - match: ^\s*(#\s*(if(n?def)?)\b.*?(?:(?=(?://|/\*))|$))
    captures:
      1: meta.preprocessor.webidl
      2: keyword.control.import.webidl
    push:
    - match: ^\s*(#\s*(endif)\b).*$
      pop: true
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.webidl
    - include: main
  repo_preprocessor-rule-other-block:
  - match: ^\s*(#\s*(if(n?def)?)\b.*?(?:(?=(?://|/\*))|$))
    captures:
      1: meta.preprocessor.webidl
      2: keyword.control.import.webidl
    push:
    - match: ^\s*(#\s*(endif)\b).*$
      pop: true
      captures:
        1: meta.preprocessor.webidl
        2: keyword.control.import.webidl
    - include: repo_block_innards
  repo_sizeof:
