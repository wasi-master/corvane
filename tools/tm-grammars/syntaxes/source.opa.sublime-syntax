%YAML 1.2
---
# Opa (source.opa): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/mads379/opa.tmbundle via GitHub Linguist v9.7.0 (license: mit).
name: Opa
scope: source.opa
file_extensions:
- opa
contexts:
  main:
  - include: repo_code
  repo_code:
  - include: repo_xml-literal
  - include: repo_strings
  - include: repo_comments
  - include: repo_declarations
  - include: repo_keywords
  - include: repo_constants
  - include: repo_directive
  repo_comments:
  - match: /\*(\*)?
    push:
    - meta_scope: comment.block.opa
    - match: \*/
      pop: true
    - match: '@\w*'
      scope: keyword.annotation.opa
    - include: repo_comments
  - match: \/\/.*$
    scope: comment.single.opa
  repo_constants:
  - match: \b(void|false|true)\b
    scope: constant.language
  - match: \b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\.?[0-9]*)|(\.[0-9]+))((e|E)(\+|-)?[0-9]+)?)([LlFfUuDd]|UL|ul)?\b
    scope: constant.numeric.opa
  repo_declarations:
  - match: ([\w_]*)\s*=\s*{{
    captures:
      1: entity.name.module
  - match: \b(type)\b\s*([a-zA-Z_][a-zA-Z0-9_]*|`[^`\n\r]`)
    captures:
      1: keyword.opa
      2: entity.name.type
  - match: ^\s*(@[\w_]*)?\s*([\w_]*)\((?=.*\)\s*(:\s(\w*))?\s*=)
    captures:
      1: keyword.directive.opa
      2: entity.name.function
    push:
    - match: \)\s*(:\s(\w*))?\s*=
      pop: true
  - match: (\w*)(:.*)?\s*=[^=]
    captures:
      1: variable.other.opa
  repo_directive:
  - match: '@[\w_]*'
    scope: keyword.directive.opa
  repo_embedded-source:
  - match: '{'
    push:
    - meta_scope: source.opa.embeded.block
    - match: '}'
      pop: true
    - include: repo_code
    - include: repo_embedded-source
  repo_keywords:
  - match: \b(_|as|do|else|if|match|then|type|with|and|begin|css|db|end|external|forall|import|package|parser|rec|server|val|xml_parser)\b
    scope: keyword.opa
  repo_strings:
  - match: (?<!\\)"
    push:
    - meta_scope: string.quoted.double.scala
    - match: '"'
      pop: true
    - match: \\.
      scope: constant.character.escape.scala
  repo_xml-attribute:
  - match: (\w+)=(("[^"]*")|(#\w*))
    captures:
      1: entity.other.attribute-name
      3: string.quoted.double
      4: variable.other.opa
  repo_xml-literal:
  - match: </?([a-zA-Z0-9]+)
    captures:
      1: entity.name.tag
    push:
    - meta_scope: text.xml
    - match: /?>
      pop: true
    - include: repo_xml-literal
    - include: repo_xml-attribute
    - include: repo_embedded-source
