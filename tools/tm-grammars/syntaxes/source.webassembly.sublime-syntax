%YAML 1.2
---
# WebAssembly (source.webassembly): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-webassembly via GitHub Linguist v9.7.0 (license: isc).
name: WebAssembly
scope: source.webassembly
file_extensions:
- wast
- wat
contexts:
  main:
  - match: \A(#!)
    captures:
      1: punctuation.definition.comment.hashbang.webassembly
    push:
    - meta_scope: comment.line.hashbang.webassembly
    - match: $
      pop: true
  - include: repo_main
  repo_comment-block:
  - match: \(;
    captures:
      0: punctuation.section.comment.begin.webassembly
    push:
    - meta_scope: comment.block.semicolon.webassembly
    - match: ;\)
      pop: true
      captures:
        0: punctuation.section.comment.end.webassembly
    - include: repo_comment-block
  repo_comment-line:
  - match: ;;
    captures:
      0: punctuation.definition.comment.webassembly
    push:
    - meta_scope: comment.line.semicolon.webassembly
    - match: $
      pop: true
  repo_expression:
  - match: (\()(\w+)(?=[\s()]|$|;;)
    captures:
      1: punctuation.section.expression.begin.webassembly
    push:
    - match: \)
      pop: true
      captures:
        0: punctuation.section.expression.end.webassembly
    - include: repo_main
  - match: \(
    captures:
      0: punctuation.section.expression.begin.webassembly
    push:
    - meta_scope: meta.expression.webassembly
    - match: \)
      pop: true
      captures:
        0: punctuation.section.expression.end.webassembly
    - include: repo_main
  repo_instructions:
  - match: '(?x) \b

      ( block

      | br(?:_if|_table|_on_(?:cast|data|func|i31|null))?

      | call(?:_indirect|_ref)?

      | catch_all

      | catch

      | delegate

      | else

      | end

      | if

      | loop

      | nop

      | rethrow

      | return(?:_call(?:_indirect|_ref)?)?

      | then

      | throw

      | try

      | unreachable

      | unwind

      ) (?=[\s()]|$|;;)'
  - match: "(?x) \\b\n(\n\t(f32|f64) \\.\n\t( (?<=f32.) (demote_f64|reinterpret_i32)\n\t| (?<=f64.) (promote_f32|reinterpret_i64)\n\t| abs\n\t| add\n\t| atomic (?:\\.\\w+)++\n\t| ceil\n\t| const\n\t| convert_i(32|64)_[su]\n\t| copysign\n\t| div\n\t| eq\n\t| floor\n\t| [gl][et]\n\t| load\n\t| max\n\t| min\n\t| mul\n\t| nearest\n\t| neg?\n\t| ne\n\t| sqrt\n\t| store\n\t| sub\n\t| trunc\n\t)\n\t|\n\t\n\t(i32|i64) \\.\n\t( (?<=i32.) (reinterpret_f32|wrap_i64)\n\t| (?<=i64.) (extend_i32_[su]|extend32_s|load32_[su]|reinterpret_f64|store32)\n\t| add\n\t| and\n\t| atomic (?:\\.\\w+)++\n\t| clz\n\t| const\n\t| ctz\n\t| div_[su]\n\t| eqz?\n\t| eq\n\t| extend(8|16)_s\n\t| [gl][et]_[su]\n\t| load(8|16)_[su]\n\t| load\n\t| mul\n\t| ne\n\t| x?or\n\t| popcnt\n\t| rem_[su]\n\t| rot[lr]\n\t| shl\n\t| shr_[su]\n\t| store(8|16)?\n\t| sub\n\t| trunc_(sat_)?f(32|64)_[su]\n\t)\n\t|\n\t\n\tv128 \\.\n\t( andnot\n\t| and\n\t| any_true\n\t| atomic (?:\\.\\w+)++\n\t| bitselect\n\t| const\n\t| load((8|16)_lane|(32|64)_(lane|zero)|(8|16|32|64)_splat|(8x8|16x4|32x2)_[su])?\n\
      \t| not\n\t| x?or\n\t| store((8|16|32|64)_lane)?\n\t)\n\t|\n\n\t(f32x4|f64x2) \\.\n\t( (?<=f32x4.) (convert_i32x4_[su]|demote_f64x2_zero)\n\t| (?<=f64x2.) (convert_low_i32x4_[su]|promote_low_f32x4)\n\t| abs\n\t| add\n\t| ceil\n\t| div\n\t| eq\n\t| (extract|replace)_lane\n\t| floor\n\t| [gl][et]\n\t| p?max\n\t| p?min\n\t| mul\n\t| nearest\n\t| neg?\n\t| splat\n\t| sqrt\n\t| sub\n\t| trunc\n\t)\n\t|\n\t\n\ti8x16 \\.\n\t( abs\n\t| (?:add|sub)_sat_[su]\n\t| add\n\t| all_true\n\t| avgr_u\n\t| bitmask\n\t| eq\n\t| extract_lane_[su]\n\t| [gl][et]_[su]\n\t| load_splat\n\t| max_[su]\n\t| min_[su]\n\t| narrow_i16x8_[su]\n\t| neg?\n\t| ne\n\t| popcnt\n\t| replace_lane\n\t| shl\n\t| shr_[su]\n\t| shuffle\n\t| splat\n\t| sub\n\t| swizzle\n\t)\n\t|\n\t\n\ti16x8 \\.\n\t( abs\n\t| (?:add|sub)_sat_[su]\n\t| add\n\t| all_true\n\t| avgr_u\n\t| bitmask\n\t| eq\n\t| ext(add_pairwise|(end|mul)_(high|low))_i8x16_[su]\n\t| extract_lane_[su]\n\t| [gl][et]_[su]\n\t| load8x8_[su]\n\t| load_splat\n\t| max_[su]\n\
      \t| min_[su]\n\t| mul\n\t| narrow_i32x4_[su]\n\t| neg?\n\t| ne\n\t| q15mulr_sat_s\n\t| replace_lane\n\t| shl\n\t| shr_[su]\n\t| splat\n\t| sub\n\t)\n\t|\n\n\ti32x4 \\.\n\t( abs\n\t| add\n\t| all_true\n\t| bitmask\n\t| dot_i16x8_s\n\t| eq\n\t| ext(add_pairwise|(end|mul)_(high|low))_i16x8_[su]\n\t| extract_lane\n\t| [gl][et]_[su]\n\t| load16x4_[su]\n\t| load_splat\n\t| max_[su]\n\t| min_[su]\n\t| mul\n\t| neg?\n\t| ne\n\t| replace_lane\n\t| shl\n\t| shr_[su]\n\t| splat\n\t| sub\n\t| trunc_sat_f32x4_[su]\n\t| trunc_sat_f64x2_[su]_zero\n\t)\n\t|\n\n\ti64x2 \\.\n\t( abs\n\t| add\n\t| all_true\n\t| bitmask\n\t| eq\n\t| ext(end|mul)_(high|low)_i32x4_[su]\n\t| extract_lane\n\t| [gl][et]_s\n\t| load32x2_[su]\n\t| load_splat\n\t| mul\n\t| neg?\n\t| ne\n\t| replace_lane\n\t| shl\n\t| shr_[su]\n\t| splat\n\t| sub\n\t)\n) (?=[\\s()]|$|;;)"
  - match: \b([if](?:32|64)(\.)\w+)(/)([if](?:32|64))
    captures:
      2: punctuation.separator.method.period.webassembly
      3: punctuation.separator.method.slash.webassembly
  - match: '(?x) \b

      ( (array|struct) (\. (len|new(_default)?_with_rtt|get_[su]|[gs]et))?

      | (current|grow)_memory

      | data\.drop

      | drop

      | elem\.drop

      | field

      | i31 \. (new|get_[su])

      | ([gs]et|tee)_(local|global)

      | global\.[gs]et

      | local\.([gs]et|tee)

      | memory\.(atomic\.(notify|wait32|wait64)|copy|fill|grow|init|size)

      | ref(\.([ai]s_(data|func|i31|non_null)|cast|eq|func|is_null|null|test))?

      | rtt(\.(canon|sub))?

      | select

      | table\.(copy|fill|get|grow|init|set|size)

      ) (?=[\s()]|$|;;)'
  - match: '(?x) \b

      ( anyfunc

      | data

      | declare

      | element

      | elem

      | export

      | extern

      | func

      | global

      | import

      | item

      | local

      | memory

      | module

      | mut

      | offset

      | param

      | result

      | start

      | table

      | type

      ) (?=[\s()]|$|;;)'
  - match: '(?x) \b

      ( assert_exhaustion

      | assert_invalid

      | assert_malformed

      | assert_return (?:_(?:arithmetic|canonical)_nan)?

      | assert_trap

      | assert_unlinkable

      | binary

      | input

      | invoke

      | get

      | output

      | quote

      | ref\.extern

      | ref\.host

      | register

      | script

      ) (?=[\s()]|$|;;)'
    scope: support.function.scripting.webassembly
  repo_main:
  - include: repo_comment-line
  - include: repo_comment-block
  - include: repo_expression
  - include: repo_instructions
  - include: repo_type
  - include: repo_number
  - include: repo_name
  - include: repo_string
  - include: repo_optional-immediate
  repo_name:
  - match: (\$)[-A-Za-z0-9_.+*/\\^~=<>!?@#$%&|:'`]+
    scope: variable.other.name.webassembly
    captures:
      1: punctuation.definition.variable.webassembly
  repo_number:
  - match: (?<!\w)[-+]?nan(:)(0x(?!_)(?:_?[A-Fa-f0-9])+)
    scope: constant.language.nan.with-payload.webassembly
    captures:
      1: punctuation.separator.payload.colon.webassembly
      2: constant.numeric.int.hex.payload.webassembly
  - match: (?<!\w)[-+]?(inf|nan)(?:(?<=nan):(arithmetic|canonical))?(?!\w)
  - match: '(?x) (?<!\w)

      [-+]? 0x      (?!_)(?:_? [A-Fa-f0-9])++

      (?: \.       (?!_)(?:_? [A-Fa-f0-9])*+ )?

      (?: [pP][-+]? (?!_)(?:_? [0-9])++ )?'
    scope: constant.numeric.float.hex.webassembly
  - match: '(?x) (?<!\w)

      [-+]?         (?!_)(?:_? \d)++

      (?: \.       (?!_)(?:_? \d)*+ )?

      (?: [eE][-+]? (?!_)(?:_? \d)++ )?'
    scope: constant.numeric.float.decimal.webassembly
  - match: (?<!\w)[-+]?0x(?!_)(?:_?[A-Fa-f0-9])++
    scope: constant.numeric.int.hex.webassembly
  - match: (?<!\w)[-+]?(?!_)(?:_?\d)++
    scope: constant.numeric.int.decimal.webassembly
  repo_optional-immediate:
  - match: (?<!\w)(align|offset)(=)(?=[-+]?(?:\d|0x[\dA-Fa-f]))
    captures:
      2: keyword.operator.assignment.webassembly
  repo_string:
  - match: '"'
    captures:
      0: punctuation.definition.string.begin.webassembly
    push:
    - meta_scope: string.quoted.double.webassembly
    - match: '"'
      pop: true
      captures:
        0: punctuation.definition.string.end.webassembly
    - match: \\n
      scope: constant.character.escape.newline.webassembly
    - match: \\t
      scope: constant.character.escape.tab.webassembly
    - match: \\{2}
      scope: constant.character.escape.backslash.webassembly
    - match: \\'
      scope: constant.character.escape.quote.single.webassembly
    - match: \\"
      scope: constant.character.escape.quote.double.webassembly
    - match: \\[0-9A-Fa-f]{2}|\\u({)[A-Fa-f0-9]+(})
      scope: constant.character.escape.hex.unicode.webassembly
      captures:
        1: punctuation.definition.unicode-escape.begin.bracket.curly.webassembly
        2: punctuation.definition.unicode-escape.end.bracket.curly.webassembly
  repo_type:
  - match: \b([if](?:32|64)|v128|i8|i16)(?=[\s()]|$|;;)
  - match: \b(f32x4|f64x2|i8x16|i16x8|i32x4|i64x2)(?=[\s()]|$|;;)
  - match: \b((?:any|data|eq|extern|func|i31)ref)(?=[\s()]|$|;;)
