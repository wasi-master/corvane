  - match: (?i)^(menu)\x20+((?:status|channel|query|nicklist|menubar|(?:channel)?link|@[^\x20,]+|\*)(?:,(?:status|channel|query|nicklist|menubar|(?:channel)?link|@[^\x20,]+))*|\*)\x20+{
    captures:
      1: storage.type.menu.msl
      2: storage.modifier.function.msl
    push:
    - meta_scope: meta.menu.code.msl
    - match: (?i)(?=\z|(?:^(?:on|raw|ctcp|dialog|\#[^\s]+|alias|menu)\b))|}$
      pop: true
    - include: repo_menu_content
  repo_menu_content:
  - include: repo_comments
  - include: repo_parameters
  - match: (?:^\s*|)\x20*((?:mouse|(?:s|d(?:r|m)?|u|r|lb|m)click)|leave|drop)(?:\x20*:\x20*)?
    captures:
      1: keyword.other.menu.item.msl
    push:
    - match: (?=\z|\x20}|$)
      pop: true
    - include: repo_code_content
  - match: ^\x20*(?!$)
    push:
    - match: (?=\z|\x20}|$)
      pop: true
    - include: repo_parameters
    - match: (?<=:|{)
      push:
      - match: (?=\z|\x20}|$)
        pop: true
      - include: repo_code_content
  repo_parameters:
  - include: repo_variables
  - include: repo_identifiers
  - include: repo_constants
  repo_switches:
  - match: (?<=\x20)[-+][[:alnum:]]+(?=\s)
    scope: keyword.other.switch.msl
  repo_variables:
  - match: (?<![^(,\x20!])(%)[^\x20),]+
    scope: variable.other.normal.msl
  - match: (?<![^(,\x20!])(&)[^\x20),]+
    scope: variable.other.binary.msl
