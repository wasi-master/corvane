%YAML 1.2
---
# YARA (source.yara): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/infosec-intern/vscode-yara.git via GitHub Linguist v9.7.0 (license: mit).
name: YARA
scope: source.yara
file_extensions:
- yar
- yara
contexts:
  main:
  - include: repo_includes
  - include: repo_imports
  - include: repo_rules
  - include: repo_comments
  - include: repo_unmatched-characters
  repo_arithmetic-operators:
  - match: (?<=[0-9A-Z_a-z()\[\]\s]|^)([+*\\%])(?=[-0-9A-Z_a-z()\s]|[!@#$]|$)
    scope: keyword.operator.arithmetic.yara
  repo_arithmetic-unary-operators:
  - match: (?<=[0-9A-Z_a-z()\[\]\s]|^)(-)(?=[-0-9A-Z_a-z()\s]|[!@#$]|$)
    scope: keyword.operator.arithmetic.yara
  repo_array-subscripting:
  - match: (\[|\])
    scope: punctuation.definition.array.access.yara
  repo_base64-modifier:
  - match: \b(base64)\s*(\()(?=\s*")
    captures:
      1: keyword.other.modifier.yara
      2: punctuation.parenthesis.begin.yara
    push:
    - match: (\))
      pop: true
      captures:
        1: punctuation.parenthesis.end.yara
    - include: repo_quoted-strings-64
    - include: repo_unmatched-characters
  repo_bitwise-operators:
  - match: (?<=[0-9A-Z_a-z()\[\]\s]|^)([&|^]|<<|>>)(?=[-0-9A-Z_a-z()\s]|[!@#$]|$)
    scope: keyword.operator.bitwise.yara
  repo_bitwise-unary-operators:
  - match: (?<=[0-9A-Z_a-z()\[\]\s]|^)(~)(?=[-0-9A-Z_a-z()\s]|[!@#$]|$)
    scope: keyword.operator.bitwise.yara
  repo_boolean-operators:
  - match: \b(not|defined|and|or)\b
    scope: keyword.operator.logical.yara
  repo_booleans:
  - match: \b(false|true)\b
    scope: constant.language.yara
  repo_comments:
  - match: //.*$
    scope: comment.line.double-slash.yara
  - match: /\*
    push:
    - meta_scope: comment.block.yara
    - match: \*/
      pop: true
  repo_condition-expression:
  - include: repo_comments
  - include: repo_condition-nested-expression
  - include: repo_boolean-operators
  - include: repo_struct-member-access
  - include: repo_array-subscripting
  - include: repo_relational-operators
  - include: repo_relational-operators-text
  - include: repo_relational-operators-regexp
  - include: repo_arithmetic-unary-operators
  - include: repo_arithmetic-operators
  - include: repo_bitwise-unary-operators
  - include: repo_bitwise-operators
  - include: repo_regexp-strings
  - include: repo_quoted-strings
  - include: repo_numbers
  - include: repo_separator
  - include: repo_range-operator
  - include: repo_string-identifiers
  - include: repo_booleans
  - match: \b(all|any|none|filesize)\b
    scope: constant.numeric.keyword.yara
  - match: \b(entrypoint)\b
    scope: constant.numeric.keyword.yara invalid.deprecated.keyword.yara
  - match: \b(them)\b
    scope: variable.language.string.identifier.wildcard.yara
  - match: \b(at|for|in|of)\b
    scope: keyword.other.yara
  - match: '\b((?:u?int)(?:8|16|32)(?:be)?)(?=\s*(\(|

      ))'
    scope: support.function.other.yara
  - match: ([!@#$])(?![0-9A-Z_a-z])
    scope: variable.language.loop.variable.yara
  - include: repo_identifiers
  - include: repo_unmatched-characters
  repo_condition-nested-expression:
  - match: (:\s*)?\(
    push:
    - match: \)
      pop: true
    - include: repo_condition-expression
  repo_hex-alternate-values:
  - match: \(
    push:
    - match: \)
      pop: true
    - include: repo_hex-values
    - match: \|
      scope: entity.other.special.pipe.hex.yara
    - include: repo_hex-alternate-values
    - include: repo_unmatched-characters
  repo_hex-jump:
  - match: \[\s*(?=([1-9][0-9]*|[0-9]*\s*-|[0-9]+\s*-\s*[0-9]*)\s*\])
    push:
    - meta_scope: entity.name.jump.hex.yara
    - match: \]
      pop: true
    - match: '[0-9]'
      scope: constant.numeric.jump.hex.yara
    - match: '-'
      scope: entity.other.dash.jump.hex.yara
    - include: repo_unmatched-characters
  repo_hex-string-value:
  - match: \{
    push:
    - meta_content_scope: entity.name.hex.yara
    - match: \}|(?=[^?0-9A-Fa-f\[\-\]()/\s\n])(.*)
      pop: true
      captures:
        1: invalid.illegal.newline.yara
    - include: repo_comments
    - include: repo_hex-jump
    - include: repo_hex-values
    - include: repo_hex-alternate-values
    - include: repo_unmatched-characters
  repo_hex-values:
  - match: (?=[0-9?A-Fa-f])
    push:
    - meta_content_scope: string.other.hex.yara
    - match: (?=[\s\[()}/|])
      pop: true
    - match: (?<![0-9?A-Fa-f])[0-9?A-Fa-f]([0-9?A-Fa-f]{2})*(?![0-9?A-Fa-f])
      scope: invalid.illegal.hex.missingchar.yara
    - match: '[0-9A-Fa-f]'
      scope: string.other.hex.yara
    - match: \?
      scope: constant.other.placeholder.hex.yara
    - include: repo_unmatched-characters
  repo_identifiers:
  - include: repo_reserved-identifiers
  - match: \b[A-Z_a-z][0-9A-Z_a-z]{0,127}\b
    scope: variable.other.identifier.yara
  - include: repo_unmatched-characters
  repo_imports:
  - match: \b(import)(?=\s+")
    push:
    - meta_scope: keyword.control.directive.yara
    - match: (?<=")
      pop: true
    - include: repo_quoted-strings
  repo_includes:
  - match: \b(include)(?=\s+")
    push:
    - meta_scope: keyword.control.directive.yara
    - match: (?<=")
      pop: true
    - include: repo_quoted-strings
  repo_integers:
  - match: \b[0-9]+(KB|MB)?\b
    scope: constant.numeric.dec.yara
    captures:
      1: storage.type.number.postfix.yara
  - match: \b0x[0-9A-Fa-f]+\b
    scope: constant.numeric.hex.yara
  - match: \b(0o)([0-7]+)\b
    scope: constant.numeric.oct.yara
    captures:
      1: storage.type.number.yara
  repo_meta-value-bool:
  - match: \b([A-Z_a-z][0-9A-Z_a-z]{0,127})\s*(=)\s*(true|false)
    scope: support.other.meta-name.strings.yara
    captures:
      1: entity.other.meta.identifier.yara
      2: keyword.operator.assignment.yara
      3: constant.language.yara
  repo_meta-value-int:
  - match: \b([A-Z_a-z][0-9A-Z_a-z]{0,127})\s*(=)\s*([0-9]+)(KB|MB)?
    scope: support.other.meta-name.strings.yara
    captures:
      1: entity.other.meta.identifier.yara
      2: keyword.operator.assignment.yara
      3: constant.numeric.yara
      4: storage.type.number.postfix.yara
  repo_meta-value-string:
  - match: \b([A-Z_a-z][0-9A-Z_a-z]{0,127})\s*(=)\s*(?=")
    captures:
      1: entity.other.meta.identifier.yara
      2: keyword.operator.assignment.yara
    push:
    - meta_scope: support.other.meta-name.strings.yara
    - match: (?<=")
      pop: true
    - include: repo_quoted-strings
  repo_numbers:
  - match: \b([0-9]+\.[0-9]+)\b
    scope: constant.numeric.yara
  - include: repo_integers
  repo_quoted-strings:
  - match: (?<!")(")(?!\n)
    captures:
      1: punctuation.definition.string.begin.yara
    push:
    - meta_scope: string.quoted.double.yara
    - match: (")|((?:\\")?[^"]*\n)
      pop: true
      captures:
        1: punctuation.definition.string.end.yara
        2: invalid.illegal.newline.yara
    - match: \\([nrt\\"]|x[0-9A-Fa-f]{2})
      scope: constant.character.escape.yara
    - match: '[\x20\x21\x23-\x5B\x5D-\x7E]'
      scope: string.quoted.double.ascii.yara
    - match: '[^\x00-\x7F]'
      scope: string.quoted.double.unicode.yara
    - match: '["\\\n\r]'
      scope: invalid.illegal.character.yara
  repo_quoted-strings-64:
  - match: (")(?=(\\([nrt\\"]|x[0-9A-Fa-f]{2})|[\x20\x21\x23-\x5B\x5D-\x7E]){64}")
    captures:
      1: punctuation.definition.string.begin.yara
      2: invalid.illegal.character.length.yara
    push:
    - meta_scope: string.quoted.double.yara
    - match: (")|(\n)
      pop: true
      captures:
        1: punctuation.definition.string.end.yara
        2: invalid.illegal.newline.yara
    - match: \\([nrt\\"]|x[0-9A-Fa-f]{2})
      scope: constant.character.escape.yara
    - match: '[\x20\x21\x23-\x5B\x5D-\x7E]'
      scope: string.double.quoted.ascii.yara
  repo_range-operator:
  - match: (?<!\.)\.\.(?!\.)
    scope: keyword.operator.range.yara
  repo_regexp-base-expression:
  - match: \.
    scope: constant.character.class.regexp
  - match: \^
    scope: constant.character.assertion.regexp
  - match: \$
    scope: constant.character.assertion.regexp
  - match: '[+*?]\??'
    scope: keyword.operator.quantifier.regexp
  - match: \|
    scope: keyword.operator.disjunction.regexp
  - match: \{([0-9]+|[0-9]+,(?:[0-9]+)?|,[0-9]+)\}
    scope: keyword.operator.quantifier.regexp
    captures:
      1: constant.numeric.yara
  - include: repo_regexp-escape-sequence
  - match: '[\x20!"#%&'',\-0-9:->@A-Z\]_`a-z{}~]'
    scope: string.regexp.yara
  - include: repo_unmatched-characters
  repo_regexp-character-set:
  - match: (\[)(\^)?(\])?(-)?
    captures:
      1: constant.other.set.regexp punctuation.character.set.begin.regexp
      2: keyword.operator.negation.regexp
      3: constant.character.set.regexp
      4: constant.character.set.regexp
    push:
    - meta_scope: meta.character.set.regexp
    - match: (-?)(\])|([^\]]*)(?=\n)
      pop: true
      captures:
        1: constant.character.set.regexp
        2: constant.other.set.regexp punctuation.character.set.end.regexp
        3: invalid.illegal.newline.yara
    - include: repo_regexp-character-set-escapes
    - include: repo_regexp-escape-sequence
    - match: '[\x20-\x2E\x30-\x5B\x5E-\x7E]'
      scope: constant.character.set.regexp
  repo_regexp-character-set-escapes:
  - match: \\([\]bB])
    scope: constant.character.escape.regexp
  - match: (-)(-)(-)
    captures:
      1: constant.character.set.regexp
      2: constant.character.class.range.regexp
      3: constant.character.set.regexp
  - match: (-)
    captures:
      1: constant.character.class.range.regexp
  repo_regexp-escape-sequence:
  - match: \\[./afnrt\\]
    scope: constant.character.escape.regexp
  - match: (\\x[0-9A-Fa-f]{2})|(\\x[^\]/]{0,2})
    captures:
      1: constant.character.escape.regexp
      2: invalid.illegal.character.escape.regex
  - match: \\([wWsSdD])
    scope: constant.character.class.regexp
  - match: \\([bB])
    scope: constant.character.assertion.regexp
  - match: \\(.)
    scope: constant.character.escape.regexp
  repo_regexp-expression:
  - include: repo_regexp-parentheses
  - include: repo_regexp-character-set
  - include: repo_regexp-base-expression
  - match: /
    scope: invalid.illegal.regexp.end.yara
  repo_regexp-parentheses:
  - match: (\()([+*?])?
    captures:
      1: punctuation.parenthesis.begin.regexp support.other.parenthesis.regexp
      2: invalid.illegal.group.construct.regexp
    push:
    - match: (\))|([^)]*)(?=\n)
      pop: true
      captures:
        1: punctuation.parenthesis.end.regexp support.other.parenthesis.regexp
        2: invalid.illegal.newline.yara
    - include: repo_regexp-expression
  repo_regexp-strings:
  - match: (?<!/)(/)(?!/|\n)
    captures:
      1: punctuation.definition.regexp.begin.yara
    push:
    - meta_scope: string.regexp.yara
    - match: (?<!\\)(/)(i?s?)|((?:\\/)?[^/]*\n)
      pop: true
      captures:
        1: punctuation.definition.regexp.end.yara
        2: storage.modifier.flag.regexp
        3: invalid.illegal.newline.yara
    - include: repo_regexp-expression
  repo_relational-operators:
  - match: (?<=[0-9A-Z_a-z()\[\]\s]|^)(>=?|<=?|==|!=)(?=[-0-9A-Z_a-z()\s]|[!@#$]|$)
    scope: keyword.operator.comparison.yara
  repo_relational-operators-regexp:
  - match: \b(matches)(?=\s*/)
    scope: keyword.operator.comparison.yara
  repo_relational-operators-text:
  - match: \b(contains|icontains|startswith|istartswith|endswith|iendswith|iequals)(?=\s*")
    scope: keyword.operator.comparison.yara
  repo_reserved-identifiers:
  - match: \b(all|and|any|ascii|at|base64|base64wide|condition|contains|endswith|entrypoint|false|filesize|for|fullword|global|import|icontains|iendswith|iequals|in|include|int16|int16be|int32|int32be|int8|int8be|istartswith|matches|meta|nocase|none|not|of|or|private|rule|startswith|strings|them|true|uint16|uint16be|uint32|uint32be|uint8|uint8be|wide|xor|defined)\b
    scope: invalid.illegal.identifier.yara
  repo_rule-conditions:
  - match: '\b(condition)\s*:'
    captures:
      1: keyword.other.condition.yara
    push:
    - meta_scope: entity.name.section.condition.yara
    - match: (?=\})
      pop: true
    - include: repo_comments
    - include: repo_condition-expression
    - include: repo_reserved-identifiers
    - include: repo_unmatched-characters
  repo_rule-declaration:
  - match: \b(rule)\b
    captures:
      1: storage.type.function.yara
    push:
    - meta_scope: meta.function.yara
    - match: (?=[{:])
      pop: true
    - include: repo_reserved-identifiers
    - match: \b[A-Z_a-z][0-9A-Z_a-z]{0,127}\b
      scope: entity.name.function.yara
    - include: repo_unmatched-characters
  repo_rule-end:
  - match: \}
    scope: punctuation.definition.rule.end.yara
  repo_rule-meta:
  - match: '\b(meta)\s*:'
    captures:
      1: keyword.other.meta.yara
    push:
    - match: (?=\b(strings|condition)\b)
      pop: true
    - include: repo_reserved-identifiers
    - include: repo_comments
    - include: repo_meta-value-bool
    - include: repo_meta-value-int
    - include: repo_meta-value-string
    - include: repo_unmatched-characters
  repo_rule-restrictions:
  - match: \b(global|private)\b
    scope: entity.name.type.restrictions.yara
  repo_rule-start:
  - match: \{
    scope: punctuation.definition.rule.start.yara
  repo_rule-strings:
  - match: '\b(strings)\s*:'
    captures:
      1: keyword.other.strings.yara
    push:
    - meta_scope: entity.name.section.strings.yara
    - match: (?=\b(condition)\b)
      pop: true
    - include: repo_reserved-identifiers
    - include: repo_comments
    - include: repo_string-assignment-text
    - include: repo_string-assignment-regex
    - include: repo_string-assignment-hex
    - include: repo_unmatched-characters
  repo_rule-tags:
  - match: ':'
    push:
    - meta_scope: entity.name.tag.yara
    - match: (?=\{)
      pop: true
    - include: repo_identifiers
  repo_rules:
  - include: repo_rule-restrictions
  - include: repo_rule-declaration
  - include: repo_rule-tags
  - include: repo_rule-start
  - include: repo_rule-meta
  - include: repo_rule-strings
  - include: repo_rule-conditions
  - include: repo_comments
  - include: repo_rule-end
  repo_separator:
  - match: ','
    scope: punctuation.separator.arguments.yara
  repo_string-assignment-hex:
  - match: (\$)([0-9A-Z_a-z]+\b)?+\s*+([^\n\s=][^=]*)?(=)
    captures:
      1: variable.language.string.identifier.yara
      2: variable.other.string.identifier.yara
      3: invalid.illegal.string.identifier.yara
      4: keyword.operator.assignment.yara
    push:
    - meta_scope: support.other.attribute-name.strings.yara
    - match: (?=\b(condition)\b|\$)
      pop: true
    - include: repo_comments
    - include: repo_hex-string-value
    - match: \b(private)\b
      scope: keyword.other.modifier.yara
    - include: repo_reserved-identifiers
    - include: repo_unmatched-characters
  repo_string-assignment-regex:
  - match: (\$)([0-9A-Z_a-z]+\b)?+\s*+([^\n\s=][^=]*)?(=)(?=\s*/)
    captures:
      1: variable.language.string.identifier.yara
      2: variable.other.string.identifier.yara
      3: invalid.illegal.string.identifier.yara
      4: keyword.operator.assignment.yara
    push:
    - meta_scope: support.other.attribute-name.strings.yara
    - match: (?=\b(condition)\b|\$)
      pop: true
    - include: repo_comments
    - include: repo_regexp-strings
    - match: \b(nocase|wide|ascii|fullword|private)\b
      scope: keyword.other.modifier.yara
    - include: repo_reserved-identifiers
    - include: repo_unmatched-characters
  repo_string-assignment-text:
  - match: (\$)([0-9A-Z_a-z]+\b)?+\s*+([^\n\s=][^=]*)?(=)(?=\s*")
    captures:
      1: variable.language.string.identifier.yara
      2: variable.other.string.identifier.yara
      3: invalid.illegal.string.identifier.yara
      4: keyword.operator.assignment.yara
    push:
    - meta_scope: support.other.attribute-name.strings.yara
    - match: (?=\b(condition)\b|\$)
      pop: true
    - include: repo_comments
    - include: repo_text-strings
    - include: repo_reserved-identifiers
    - include: repo_unmatched-characters
  repo_string-identifiers:
  - match: ([!@#$])([0-9A-Z_a-z]+|(?=[*]))([*]?)
    scope: variable.other.string_identifier.yara
    captures:
      1: variable.language.string.identifier.yara
      2: variable.other.string.identifier.yara
      3: string.interpolated.string.identifier.yara
  repo_struct-member-access:
  - match: (?!<\.\s*)\.\s*(?!\.)
    scope: meta.struct.access.yara
  repo_text-strings:
  - include: repo_quoted-strings
  - include: repo_xor-modifier
  - include: repo_base64-modifier
  - match: \b(nocase|wide|ascii|xor|base64|base64wide|fullword|private)\b(?!\()
    scope: keyword.other.modifier.yara
  - include: repo_comments
  - include: repo_unmatched-characters
  repo_unmatched-characters:
  - match: \S
    scope: invalid.illegal.character.yara
  repo_xor-modifier:
  - match: \b(xor)\s*(\()\s*(0x[0-9A-Fa-f]{1,2}|0o[0-7]{1,3}|[0-9]{1,3})(?:\s*(-)\s*(0x[0-9A-Fa-f]{1,2}|0o[0-7]{1,3}|[0-9]{1,3}))?\s*(\))
    captures:
      1: keyword.other.modifier.yara
      2: punctuation.parenthesis.begin.yara
      3: constant.numeric.yara
      4: constant.character.hyphen.yara
      5: constant.numeric.yara
      6: punctuation.parenthesis.end.yara
