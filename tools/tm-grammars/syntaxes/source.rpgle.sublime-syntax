name: RPGLE
scope: source.rpgle
file_extensions:
- rpgle
- sqlrpgle
contexts:
  main:
  - match: (?i)(?=(\*\*(FREE)))
    push:
    - meta_scope: rpgle.free.allfree
    - match: (E-\*-O-\*-F)
      pop: true
    - match: (?i)^\*\*FREE
      scope: keyword.other.rpgle.free.precompiler.allfree
    - include: repo_ctarrays
    - include: repo_freeSQL
    - include: repo_freerpglecommon
    - include: repo_freeformat
  - match: (?i)^.{5}.[*]
    push:
    - meta_scope: comment.line.rpgle.fixed
    - match: '

        '
      pop: true
  - include: repo_tempfreeformat
  - include: repo_fixedSQL
  - include: repo_fixedfreeSQL
  - include: repo_fixedprecompiler
  - include: repo_ctarrays
  - include: repo_fixedcomment
  - include: repo_fixedformat
  - include: repo_rpglecommon
  - include: repo_fixedfreeformat
  repo_comments:
  - match: (//).*
    scope: comment.line.rpgle.free
  repo_constants:
  - match: (?i)[*]IN([0-9]{2}|K[A-N]|K[P-Y]|[HL][1-9]|LR|MR|RT|U[1-8]|O[A-G]|OV|1P)?(?![A-Z0-9])
    scope: constant.language.rpgle.indicator
  - match: '[*][a-zA-Z][a-zA-Z0-9]*'
    scope: constant.language.rpgle
  - match: "(?<![a-zA-Z0-9_#@$\xA7\xC6\xD8\xC5\xC4\xD6\xA3\xD1\xA5\xE0\xD0\u015E\u0130])\\d+\\.?\\d*?(?![a-zA-Z0-9_#@$\xA7\xC6\xD8\xC5\xC4\xD6\xA3\xD1\xA5\xE0\xD0\u015E\u0130])"
    scope: constant.numeric.rpgle
  - match: "(?i)(?<![a-zA-Z0-9_#@$\xA7\xC6\xD8\xC5\xC4\xD6\xA3\xD1\xA5\xE0\xD0\u015E\u0130])(UDATE|UMONTH|UDAY|UYEAR|PAGE[1-7]|PAGE)(?![a-zA-Z0-9_#@$\xA7\xC6\xD8\xC5\xC4\xD6\xA3\xD1\xA5\xE0\xD0\u015E\u0130])"
    scope: constant.language.rpgle
  repo_ctarrays:
  - match: (?=^(\*{2})(?!free))
    push:
    - match: (E-\*-O-\*-F)
      pop: true
  repo_fixedSQL:
  - match: (?i)(?=(^.{5}(C)(\/EXEC)\s+(SQL)\b))
    push:
    - match: (?i)(?=(^.{5}(C)(\/END\-EXEC)\b))
      pop: true
    - match: (?i)(C)(\/EXEC)\s+(sql)\b
      scope: keyword.other.rpgle.sql
    - include: repo_fixedcomment
    - match: (?i)(C[\+|\/])
      scope: keyword.other.rpgle.fixed.specs
    - include: repo_sqlcommon
  - match: (?i)(C\/END\-EXEC)
    scope: keyword.other.rpgle.sql
  repo_fixedcomment:
  - match: (?i)^.{5}.[*]
    push:
    - meta_scope: comment.line.rpgle.fixed
    - match: '

        '
      pop: true
  - match: ^.{1,5}
    scope: comment.gutter
  - match: (?i)(?<=^.{5})[HFDICOP](?![+/])
    scope: keyword.other.rpgle.fixed.specs
  - match: (?<=^.{80})(?=.)
    push:
    - meta_scope: comment.block.line.rpgle.fixed
    - match: (?=\n)
      pop: true
  repo_fixedformat:
  - include: repo_fixedprecompiler
  - include: repo_fixedcomment
  - match: (?i)(?<=^.{5})[H|F|D|I|C|O|P]
    scope: keyword.other.rpgle.fixed.specs
  - match: (?i)(?<=^.{5}H)
