    - match: (?i)(?=(?<=((?<=^.{5}F).{11})).{3})(P|S|R|T|F)
      scope: constant.language.rpgle.fixed.f.designation
    - match: (?i)(?=(?<=((?<=^.{5}F).{12})).{2})E
      scope: constant.language.rpgle.fixed.f.eof
    - match: (?i)(?=(?<=((?<=^.{5}F).{13})).{2})A
      scope: constant.language.rpgle.fixed.f.addition
    - match: (?i)(?=(?<=((?<=^.{5}F).{14})).{2})(A|D)
      scope: constant.language.rpgle.fixed.f.sequence
    - match: (?i)(?=(?<=((?<=^.{5}F).{15})).{2})(E|F)
      scope: constant.language.rpgle.fixed.f.format
    - match: (?i)(?<=(?<=(?<=^.{5}F).{10}).{5}F)([0-9]|\s){5}
