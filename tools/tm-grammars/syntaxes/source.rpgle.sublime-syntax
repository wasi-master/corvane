    - match: (?i)(?<=((?<=^.{5}D).{16}))(S|U)
      scope: constant.language.rpgle.fixed.d.dstype
    - match: (?i)(?<=((?<=^.{5}D).{17}))(DS|PI|PR|(S\s)|(C\s))
