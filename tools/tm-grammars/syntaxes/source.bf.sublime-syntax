%YAML 1.2
---
# Brainfuck (source.bf): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Drako/SublimeBrainfuck via GitHub Linguist v9.7.0 (license: mit).
name: Brainfuck
scope: source.bf
file_extensions:
- b
- bf
contexts:
  main:
  - match: '[+-]'
    scope: constant.character.modify-value.bf
  - match: '[<>]'
    scope: keyword.operator.modify-pointer.bf
  - match: '[.,]'
    scope: entity.name.function.io.bf
  - match: \[
    scope: punctuation.definition.tag.begin.bf
  - match: \]
    scope: punctuation.definition.tag.end.bf
  - match: '[^-.,+<>\[\]]'
    scope: comment.block.bf
