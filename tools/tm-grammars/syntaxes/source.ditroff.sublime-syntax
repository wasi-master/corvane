%YAML 1.2
---
# Ditroff (Troff Intermediate Output) (source.ditroff): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-roff via GitHub Linguist v9.7.0 (license: isc).
name: Ditroff (Troff Intermediate Output)
scope: source.ditroff
hidden: true
contexts:
  main:
  - include: repo_main
  repo_colourMode:
  - match: (?:(m)|(D)\s*(F))\s*(d)
    scope: meta.colour-mode.default.gnu.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.function.ditroff
      3: keyword.operator.subcommand.ditroff
      4: constant.language.colour-scheme.ditroff
  - match: (?:(m)|(D)\s*(F))\s*(r)((?:\s*\d+){3})
    scope: meta.colour-mode.rgb.gnu.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.function.ditroff
      3: keyword.operator.subcommand.ditroff
      4: constant.language.colour-scheme.ditroff
  - match: (?:(m)|(D)\s*(F))\s*(k)((?:\s*\d+){4})
    scope: meta.colour-mode.cmyk.gnu.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.function.ditroff
      3: keyword.operator.subcommand.ditroff
      4: constant.language.colour-scheme.ditroff
  - match: (?:(m)|(D)\s*(F))\s*(c)((?:\s*\d+){3})
    scope: meta.colour-mode.cmy.gnu.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.function.ditroff
      3: keyword.operator.subcommand.ditroff
      4: constant.language.colour-scheme.ditroff
  - match: (?:(m)|(D)\s*(F))\s*(g)\s*(\d+)
    scope: meta.colour-mode.grey.gnu.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.function.ditroff
      3: keyword.operator.subcommand.ditroff
      4: constant.language.colour-scheme.ditroff
  repo_comment:
  - match: '#'
    captures:
      0: punctuation.definition.comment.ditroff
    push:
    - meta_scope: comment.line.number-sign.ditroff
    - match: $
      pop: true
  repo_continueLine:
  - match: ^\+
    scope: keyword.operator.line-continuation.gnu.ditroff
  repo_deviceControl:
  - match: (x)\s*(X\S*)[ \t]*
    captures:
      0: meta.device-control.lhs.ditroff
      1: keyword.operator.function.ditroff
      2: keyword.device.control.ditroff
    push:
    - meta_scope: meta.device-control.x-command.ditroff
    - match: (?=^(?!\+))(?!)
      pop: true
    - include: repo_xCommands
  - match: (x)\s*
    captures:
      0: meta.device-control.lhs.ditroff
      1: keyword.operator.function.ditroff
    push:
    - meta_scope: meta.device-control.ditroff
    - match: (?=$|#)
      pop: true
    - match: ([ipst]\S*)\s*?(?=$|#)
      scope: keyword.device.control.ditroff
    - match: (u\S*)\s+(?:(1|0)|(\d+))\s*?(?=$|#)
      scope: meta.space-underlining.gnu.ditroff
      captures:
        1: keyword.device.control.ditroff
        2: constant.numeric.integer.ditroff
        3: invalid.illegal.argument.ditroff
    - match: (F\S*)\s+(\S+)\s*?(?=$|#)
      scope: meta.source-filename.gnu.ditroff
      captures:
        1: keyword.device.control.ditroff
        2: string.other.link.filename.ditroff
    - match: (T\S*)\s+(\S+)
      scope: meta.typesetter-device.ditroff
      captures:
        1: keyword.device.control.ditroff
        2: support.constant.device-name.ditroff
    - match: (r\S*)((?:\s+(\d+)){1,3})\s*?(?=$|#)
      scope: meta.device-resolution.ditroff
      captures:
        1: keyword.device.control.ditroff
    - match: (f\S*)(?:\s+(\d+))?(?:\s+([-\w]+))?(?:\s+(\S.*?)\s+(\d+)[ \t]*$)?[ \t]*?(?=$|#)
      scope: meta.mount-font.ditroff
      captures:
        1: keyword.device.control.ditroff
        2: constant.numeric.integer.position.ditroff
        3: entity.name.font.ditroff
        4: string.other.link.filename.ditroff
        5: constant.numeric.integer.flags.ditroff
    - match: (f\S*)(?:\s+(\d+))?(?:\s+([-\w]+))?\s*?(?=$|#)
      scope: meta.mount-font.ditroff
      captures:
        1: keyword.device.control.ditroff
        2: constant.numeric.integer.ditroff
        3: variable.parameter.ditroff
    - match: ([HS]\S*)\s+(?:(-23)\s+(-?[\d.]+)|(-?\d+))?\s*?(?=$|#)
      scope: meta.set-character-property.ditroff
      captures:
        1: keyword.device.control.ditroff
        2: comment.dummy.argument.ditroff
        3: constant.numeric.float.ditroff
        4: constant.numeric.integer.ditroff
    - match: (\S+)
      captures:
        1: keyword.device.control.ditroff
      push:
      - meta_scope: meta.unknown-command.ditroff
      - match: (?=$|#)
        pop: true
  repo_eol:
  - match: (n)((?:\s*\d+){2})
    scope: meta.end-of-line.ditroff
    captures:
      1: keyword.operator.function.ditroff
  repo_font:
  - match: (f)\s*(\d+)
    scope: meta.change-font.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: constant.numeric.integer.ditroff
  repo_graphics:
  - match: (D)\s*(C)\s*(\d+)(?:\s+(\d+))?
    scope: meta.graphics.gnu.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.subcommand.ditrof
      3: constant.numeric.integer.ditroff
      4: comment.dummy.argument.ditroff
  - match: (D)\s*(E)((?:\s*(\d+)){1,2})
    scope: meta.graphics.gnu.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.subcommand.ditroff
  - match: (D)\s*([lceafptPR~])
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.subcommand.ditroff
    push:
    - meta_scope: meta.graphics.ditroff
    - match: (?=$|#)
      pop: true
    - include: scope:text.roff
  - match: (D)\s*([^\s\\])
    captures:
      1: keyword.operator.function.ditroff
      2: keyword.operator.subcommand.ditroff
    push:
    - meta_scope: meta.graphics.unknown-command.ditroff
    - meta_content_scope: variable.parameter.ditroff
    - match: (?=$|#)
      pop: true
  repo_main:
  - include: repo_comment
  - include: repo_deviceControl
  - include: repo_colourMode
  - include: repo_print
  - include: repo_font
  - include: repo_eol
  - include: repo_move
  - include: repo_size
  - include: repo_page
  - include: repo_graphics
  - include: repo_movePrint
  - include: repo_wordSpace
  repo_move:
  - match: ([HhVv])\s*(-?\d+)
    scope: meta.move.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: constant.numeric.integer.ditroff
  repo_movePrint:
  - match: (\d{2})(.)
    scope: meta.move-and-print.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: constant.character.ditroff
  repo_page:
  - match: (p)\s*(\d+)
    scope: meta.start-page.ditroff
    captures:
      1: keyword.control.page.ditroff
      2: constant.numeric.integer.ditroff
  repo_print:
  - match: (N)\s*(-?\d+)
    scope: meta.print-character.indexed.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: constant.numeric.integer.ditroff
  - match: (c)(?:\s*(\S)|(\s))|(CPS|C)\s*(\S+)
    scope: meta.print-character.ditroff
    captures:
      1: keyword.operator.function.ditroff
      2: constant.character.ditroff
      3: constant.character.whitespace.ditroff
      4: keyword.operator.function.ditroff
      5: string.unquoted.ditroff
  - match: (t)\s*
    captures:
      0: keyword.operator.function.ditroff
      1: punctuation.definition.entity.ditroff
    push:
    - meta_scope: meta.print-text.gnu.ditroff
    - meta_content_scope: string.quoted.double.ditroff
    - match: (?=$)|\s+(\d*)
      pop: true
      captures:
        1: comment.dummy.argument.ditroff
  - match: (u)\s*(-?\d+)\s*
    captures:
      1: keyword.operator.function.ditroff
      2: constant.numeric.integer.ditroff
    push:
    - meta_scope: meta.print-text.track-kerned.gnu.ditroff
    - meta_content_scope: string.quoted.double.ditroff
    - match: (?=\s|$)
      pop: true
  repo_size:
  - match: (s)\s*(?:(-23)\s+(-?[\d.]+)|(-?\d+))
    captures:
      1: keyword.operator.function.ditroff
      2: comment.dummy.argument.ditroff
      3: constant.numeric.float.ditroff
      4: constant.numeric.integer.ditroff
  repo_wordSpace:
  - match: (?<=^|[\s\d])w
    scope: keyword.operator.function.word-space.ditroff
  repo_xCommands:
  - match: (?:|^)(?:(ps)\s*(:)(?=\s*(?:exec|m?def)\b)|(PSSetup|PS)\s*(:)?)
    captures:
      1: keyword.device.control.subcommand.gnu.ditroff
      2: punctuation.separator.key-value.colon.ditroff
      3: keyword.device.control.subcommand.heirloom.ditroff
      4: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: (?:(?<=:)\s*(?:(exec|def)|(mdef)(?:\s+(\d+))?)\b)?\s*
      captures:
        1: keyword.control.directive.gnu.ditroff
        2: keyword.control.directive.gnu.ditroff
        3: constant.numeric.integer.ditroff
      push:
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
      - match: .+
        scope: source.embedded.postscript
    - include: repo_continueLine
  - match: (?:|^)(ps)\s*(:)
    captures:
      1: keyword.device.control.subcommand.gnu.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: \s*(?:(invis)|(endinvis))\b
      captures:
        1: keyword.control.suppress-output.begin.gnu.ditroff
        2: keyword.control.suppress-output.end.gnu.ditroff
    - match: \s*(file)(?:\s+|$)
      captures:
        1: keyword.control.directive.gnu.ditroff
      push:
      - meta_content_scope: string.other.link.filename.ditroff
      - match: (?=^(?!\+))(?!)
        pop: true
      - include: repo_continueLine
    - match: \s*(import)(?:\s+|$)
      captures:
        1: keyword.control.directive.gnu.ditroff
      push:
      - match: (?=^(?!\+))(?!)
        pop: true
      - include: repo_xImportParams
    - include: repo_continueLine
  - match: (?:|^)(pdf)\s*(:)
    captures:
      1: keyword.device.control.subcommand.gnu.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: \s*(xrev)\b
      scope: keyword.control.directive.gnu.ditroff
    - match: \s*(pdfpic)(?:\s+|$)
      captures:
        1: keyword.control.directive.gnu.ditroff
      push:
      - match: (?=^(?!\+))
        pop: true
      - include: repo_xImportParams
    - match: \s*(mark(start|end|suspend|restart))\b(\s+(\S.*))?
      captures:
        1: keyword.control.directive.gnu.ditroff
        3: source.embedded.postscript
      push:
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
    - match: \s*(transition)(?:\s+|$)
      captures:
        1: keyword.control.directive.gnu.ditroff
      push:
      - meta_scope: meta.transition-settings.ditroff
      - match: (?=^(?!\+))
        pop: true
      - match: \b(Blinds|Box|Cover|Dissolve|Fade|Fly|Glitter|Push|R|Split|Uncover|Wipe)\b
        scope: support.constant.other.mode.ditroff
      - match: \b(true|false)\b
      - match: \b(?:None)\b
        scope: constant.language.null.ditroff
      - match: \b(?:SLIDE|BLOCK)\b
        scope: support.constant.feature.ditroff
      - match: \b(?:H|V)\b
        scope: support.constant.dimension.ditroff
      - match: \b(?:I|O)\b
        scope: support.constant.motion.ditroff
      - match: '[-+]?[\d.]+'
        scope: constant.numeric.ditroff
      - include: repo_continueLine
    - match: \s*(pagename)(?:$|\s+)[ \t]*
      captures:
        1: keyword.control.directive.gnu.ditroff
      push:
      - meta_scope: meta.page-name.ditroff
      - match: (?=^(?!\+))
        pop: true
      - match: (\S.*?)(?=[ \t]*$)
        scope: entity.name.page.ditroff
      - include: repo_continueLine
    - match: \s*(switchtopage)(?:\s+(after|before))?(?=$|\s)[ \t]*
      captures:
        1: keyword.control.directive.gnu.ditroff
        2: support.constant.other.insertion-location.gnu.ditroff
      push:
      - meta_scope: meta.switch-to-page.ditroff
      - match: (?=^(?!\+))
        pop: true
      - match: (\S.*?)(?=[ \t]*$)
        scope: entity.name.page.ditroff
      - include: repo_continueLine
    - match: \s*(background)(?:\s+|$)
      captures:
        1: keyword.control.directive.gnu.ditroff
      push:
      - meta_scope: meta.background-rectangle.ditroff
      - match: (?=^(?!\+))
        pop: true
      - match: \s*(?:(off|footnote)|((?:page|fill|box)+))\b
        captures:
          2: support.constant.other.background-type.gnu.ditroff
      - match: '[-+]?[\d.]+'
        scope: constant.numeric.ditroff
      - include: repo_continueLine
    - include: repo_continueLine
  - match: (?:|^)(PDFMark)\b(?:\s*(:))?
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - meta_scope: meta.pdfmark.ditroff
    - match: (?=^(?!\+))
      pop: true
    - match: \s*(Bookmark(?:Closed)?)(?:\s+(\d+))?(?:\s+|$)
      captures:
        1: storage.type.bookmark.ditroff
        2: constant.numeric.integer.level.ditroff
      push:
      - meta_scope: meta.bookmark.ditroff
      - meta_content_scope: string.unquoted.ditroff
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
    - match: \s*(\S+)(?:\s+|$)
      captures:
        1: entity.name.field.ditroff
      push:
      - meta_scope: meta.pdfmark.ditroff
      - meta_content_scope: string.unquoted.ditroff
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
    - include: repo_continueLine
  - match: (?:|^)(tty)s*(:)
    captures:
      1: keyword.device.control.subcommand.gnu.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: \s*(link)(?=\s|$)
      captures:
        1: storage.type.link.ditroff
      push:
      - meta_scope: meta.osc8-link.ditroff
      - match: (?=^(?!\+))
        pop: true
      - match: \s*(\S+)
        scope: meta.link-destination.ditroff
        captures:
          1: string.other.link.ditroff
      - match: (?!)([^\s=]+)(=)
        captures:
          1: entity.other.attribute-name.ditroff
          2: punctuation.separator.key-value.ditroff
        push:
        - meta_scope: meta.link-parameter.ditroff
        - meta_content_scope: string.unquoted.ditroff
        - match: (?=\s|$)
          pop: true
    - match: \s*(sgr)\b(?:\s+([-+]?[\d.0]+))?
      captures:
        1: keyword.control.directive.gnu.ditroff
        2: constant.numeric.ditroff
    - include: repo_continueLine
  - match: (?:|^)(papersize)\s*(=)
    captures:
      1: storage.type.paper-size.ditroff
      2: punctuation.separator.key-value.equals-sign.ditroff
    push:
    - meta_scope: meta.set-paper-size.ditroff
    - match: (?=^(?!\+))
      pop: true
    - include: scope:source.ditroff.desc
    - include: repo_continueLine
  - match: (?:|^)(devtag)\s*(:)
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - meta_scope: meta.devtag.ditroff
    - match: (?=^(?!\+))
      pop: true
    - include: repo_continueLine
    - match: '[-+]?\d+(?:\.\d+)?'
      scope: constant.numeric.ditroff
    - match: \.?[^\s.]+(?:\.[^\s.]+)*+
      scope: entity.name.tag.ditroff
  - match: (?:|^)(infer)\s*(:)
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - meta_scope: meta.infer.ditroff
    - match: (?=^(?!\+))
      pop: true
    - include: repo_continueLine
    - match: \s*(start|end)\s+(\S+)(?=\s|$)
      captures:
        2: entity.name.type.ditroff
      push:
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
      - match: .+
        scope: support.constant.other.ditroff
  - match: (?:|^)(html)\s+(?:(manref\s+end)|(manref(?:\s+start)?))(?:\s+((?!#)\S+))(?:\s+(?:(\()([0-9])(\))|((?!#)\S+)))
    scope: meta.manpage-reference.ditroff
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: keyword.control.end-reference.ditroff
      3: keyword.control.start-reference.ditroff
      4: entity.name.subject.ditroff
      5: punctuation.definition.bracket.round.begin.ditroff
      6: constant.numeric.section.ditroff
      7: punctuation.definition.bracket.round.end.ditroff
      8: constant.numeric.section.ditroff
  - match: (?:|^)(index)\s*(:)(?:\s*(\d+)(?=\s))?.*
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
      3: constant.numeric.integer.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - include: repo_continueLine
  - match: (?:|^)(assertion)\s*(:)(?=\s*\[)
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - meta_scope: meta.assertion.ditroff
    - match: (?=^(?!\+))
      pop: true
    - match: \s*(\[)(x|y)?
      captures:
        1: punctuation.section.bracket.square.begin.ditroff
      push:
      - meta_content_scope: string.raw.unquoted.heredoc.ditroff
      - match: \s*(\])|(?=^(?!\+))
        pop: true
        captures:
          1: punctuation.section.bracket.square.end.ditroff
      - include: repo_continueLine
    - include: repo_continueLine
  - match: (?:|^)((?:html|math)\b(?:<[/?]p>)?)(?:\s*(:))?
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: '[ \t]*'
      push:
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
      - match: .+
        scope: text.embedded.html.basic
    - include: repo_continueLine
  - match: (?:|^)(Anchor|U?Link)\b(?:\s*(:))?
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: (?:\s+([+-]?\d+(?:,[+-]?\d+)*+)(?=\s))?\s*
      push:
      - meta_content_scope: string.other.link.ditroff
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
    - include: repo_continueLine
  - match: (?:|^)(BleedAt|CropAt|HorScale|PaperSize|Track|TrimAt)\b(?:\s*(:))?
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: '[-+]?\d+(?:\.\d+)?'
      scope: constant.numeric.ditroff
    - include: repo_continueLine
  - match: (?:|^)(LC_CTYPE)\b(?:\s*(:))?\s+((?!#)\S+)(.*)
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
      3: entity.name.locale.ditroff
  - match: (?:|^)(SupplyFont)\b(?:\s*(:))?
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: \s*(\S+)[ \t]*
      captures:
        1: entity.name.font.ditroff
      push:
      - meta_content_scope: string.other.link.filename.ditroff
      - match: (?=^(?!\+))
        pop: true
      - include: repo_continueLine
    - include: repo_continueLine
  - match: (?:|^)(SetColor)\b(?:\s*(:))?
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - match: (?=^(?!\+))
      pop: true
    - match: (?:|^)\s*(?:([\s\d.]+)(?<=\s)(rgb|hsb|cmyk|setgray|setcolor)|(\S+))
      captures:
        2: constant.language.colour-scheme.ditroff
        3: variable.other.named-colour.ditroff
    - include: repo_continueLine
  - match: (?:|^)([^\s:#]+)(?:\s*(:))?
    captures:
      1: keyword.device.control.subcommand.ditroff
      2: punctuation.separator.key-value.colon.ditroff
    push:
    - meta_content_scope: string.raw.unquoted.heredoc.ditroff
    - match: (?=^(?!\+))
      pop: true
    - include: repo_continueLine
  - include: repo_continueLine
  repo_xImportParams:
  - match: (?:|^(\+[ \t]+)?)(\S+)(?:\s+((-)[LCR]))?
    captures:
      2: string.other.link.filename.ditroff
      3: constant.language.alignment-type.ditroff
      4: punctuation.definition.dash.ditroff
  - match: '[-+]?(?:\d*\.\d+|\d+)'
    scope: constant.numeric.ditroff
  - include: repo_continueLine
