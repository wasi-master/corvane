---
# Bluespec BH (source.bh): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/B-Lang-org/language-bh.git via GitHub Linguist v9.7.0 (license: bsd-3-clause).
name: Bluespec BH
scope: source.bh
file_extensions:
- bs
contexts:
  main:
  - include: repo_comment_like
  - include: repo_numeric_literals
  - include: repo_string_literal
  - include: repo_char_literal
  - match: (?<!@|#)-\}
    scope: invalid
  - match: (\()\s*(\))
    scope: constant.language.unit.bh
    captures:
      1: punctuation.paren.bh
      2: punctuation.paren.bh
  - match: (\()(#)\s*(#)(\))
    scope: constant.language.unit.unboxed.bh
    captures:
      1: punctuation.paren.bh
      2: keyword.operator.hash.bh
      3: keyword.operator.hash.bh
      4: punctuation.paren.bh
  - match: (\()\s*,[\s,]*(\))
    scope: support.constant.tuple.bh
    captures:
      1: punctuation.paren.bh
      2: punctuation.paren.bh
  - match: (\()(#)\s*,[\s,]*(#)(\))
    scope: support.constant.tuple.unboxed.bh
    captures:
      1: punctuation.paren.bh
      2: keyword.operator.hash.bh
      3: keyword.operator.hash.bh
      4: punctuation.paren.bh
  - match: (\[)\s*(\])
    scope: constant.language.empty-list.bh
    captures:
      1: punctuation.bracket.bh
      2: punctuation.bracket.bh
  - match: (\b(?<!')(package)|^(signature))(\b(?!'))
    captures:
      2: keyword.other.package.bh
      3: keyword.other.signature.bh
    push:
    - meta_scope: meta.declaration.package.bh
    - match: (?=\b(?<!')where\b(?!'))
      pop: true
    - include: repo_comment_like
    - include: repo_package_name
    - include: repo_package_exports
    - match: '[a-z]+'
      scope: invalid
  - include: repo_ffi
  - match: ^(\s*)(class)(\s+(:?in?)coherent)?(\b(?!'))
    captures:
      2: keyword.other.class.bh
      3: keyword.other.coherent.bh
    push:
    - meta_scope: meta.declaration.class.bh
    - match: "(?x) # Detect end of class declaration:\n         # 'where' keyword\n   (?=(?<!')\\bwhere\\b(?!'))  \n         # Decreasing indentation\n   |(?=\\}|;)      # Explicit indentation\n   |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n       \\1\\s+\\S    # - more indented, or\n     | \\s*        # - starts with whitespace, followed by:\n       (?: $      #   - the end of the line (i.e. empty line), or\n       |\\{-[^@]   #   - the start of a block comment, or\n       |--+       #   - the start of a single-line comment.\n          (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                  # The double dash may not be followed by other operator characters\n                  # (then it would be an operator, not a comment)\n     )"
      pop: true
    - include: repo_comment_like
    - include: repo_where
    - include: repo_type_signature
  - include: repo_role_annotation
  - match: "^(\\s*)(pattern)\\s+(.*?)\\s+(::|\u2237)(?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])"
    captures:
      2: keyword.other.pattern.bh
      4: keyword.operator.double-colon.bh
    push:
    - meta_scope: meta.declaration.pattern.type.bh
    - match: "(?x) # Detect end of pattern type definition by decreasing indentation:\n  (?=\\}|;)       # Explicit indentation\n  |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n      \\1\\s+\\S    # - more indented, or\n    | \\s*        # - starts with whitespace, followed by:\n      (?: $      #   - the end of the line (i.e. empty line), or\n      |\\{-[^@]   #   - the start of a block comment, or\n      |--+       #   - the start of a single-line comment.\n         (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                 # The double dash may not be followed by other operator characters\n                 # (then it would be an operator, not a comment)\n    )\n"
      pop: true
    - include: repo_type_signature
  - match: ^\s*(pattern)\b(?!')
    captures:
      1: keyword.other.pattern.bh
    push:
    - meta_scope: meta.declaration.pattern.bh
    - match: "(?x) # Detect end of pattern type definition by decreasing indentation:\n  (?=\\}|;)       # Explicit indentation\n  |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n      \\1\\s+\\S    # - more indented, or\n    | \\s*        # - starts with whitespace, followed by:\n      (?: $      #   - the end of the line (i.e. empty line), or\n      |\\{-[^@]   #   - the start of a block comment, or\n      |--+       #   - the start of a single-line comment.\n         (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                 # The double dash may not be followed by other operator characters\n                 # (then it would be an operator, not a comment)\n    )\n"
      pop: true
      captures:
        1: keyword.other.pattern.bh
    - include: main
  - match: "(?x)\n  # Data declaration\n  ^(\\s*)(data|newtype|interface|struct)\\s+\n  # Keep consuming characters until:\n  (((?!\n  # the equals symbol or the start of a single-line comment, or\n    (?: \n      (?<![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]) # non-symbol\n      (?:=|--+)\n      (?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])  # non-symbol\n    )\n  # the \"where\" or \"deriving\" keywords, or\n  | (?:\\b(?<!')(?:where|deriving)\\b(?!'))\n  # the start of a block comment.\n  | {-\n  #\n  ).)*)"
    push:
    - match: "(?x) # Detect end of data declaration: \n     # Decreasing indentation\n   (?=\\}|;)      # Explicit indentation\n   |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n       \\1\\s+\\S    # - more indented, or\n     | \\s*        # - starts with whitespace, followed by:\n       (?: $      #   - the end of the line (i.e. empty line), or\n       |\\{-[^@]   #   - the start of a block comment, or\n       |--+       #   - the start of a single-line comment.\n          (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                  # The double dash may not be followed by other operator characters\n                  # (then it would be an operator, not a comment)\n     )"
      pop: true
    - include: repo_comment_like
    - include: repo_deriving
    - include: repo_forall
    - include: repo_adt_constructor
    - include: repo_data_context
    - include: repo_record_decl
    - include: repo_type_signature
  - match: "(?x)\n  # Type declaration\n  ^(\\s*)(type)(?:\\s+(instance))?\\s+\n  # Keep consuming characters until:\n  (((?!\n  # the equals symbol, the start of a single-line comment, or a type signature\n    (?: \n      (?<![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]) # non-symbol\n      (?:=|--+|::|\u2237)\n      (?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])  # non-symbol\n    )\n  # the start of a block comment.\n  | {-\n  #\n  ).)*)"
    captures:
      2: keyword.other.type.bh
      3: keyword.other.instance.bh
    push:
    - meta_scope: meta.declaration.type.bh
    - match: "(?x) # Detect end of type definition by decreasing indentation:\n  (?=\\}|;)       # Explicit indentation\n  |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n      \\1\\s+\\S    # - more indented, or\n    | \\s*        # - starts with whitespace, followed by:\n      (?: $      #   - the end of the line (i.e. empty line), or\n      |\\{-[^@]   #   - the start of a block comment, or\n      |--+       #   - the start of a single-line comment.\n         (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                 # The double dash may not be followed by other operator characters\n                 # (then it would be an operator, not a comment)\n    )\n"
      pop: true
    - include: repo_type_signature
  - match: ^(\s*)(instance)(\b(?!'))
    captures:
      2: keyword.other.instance.bh
    push:
    - meta_scope: meta.declaration.instance.bh
    - match: "(?x) # Detect end of instance declaration:\n  # 'where' keyword\n  (?=\\b(?<!')(where)\\b(?!'))\n  # Decreasing indentation\n  |(?=\\}|;)      # Explicit indentation\n  |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n      \\1\\s+\\S    # - more indented, or\n    | \\s*        # - starts with whitespace, followed by:\n      (?: $      #   - the end of the line (i.e. empty line), or\n      |\\{-[^@]   #   - the start of a block comment, or\n      |--+       #   - the start of a single-line comment.\n         (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                 # The double dash may not be followed by other operator characters\n                 # (then it would be an operator, not a comment)\n    )\n"
      pop: true
    - include: repo_comment_like
    - include: repo_where
    - include: repo_type_signature
  - match: ^(\s*)(import)(\b(?!'))
    captures:
      2: keyword.other.import.bh
    push:
    - meta_scope: meta.import.bh
    - match: "(?x) # Detect end of import\n  # 'where' keyword\n  (?=\\b(?<!')(where)\\b(?!'))\n  # Decreasing indentation\n  |(?=\\}|;)      # Explicit indentation\n  |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n      \\1\\s+\\S    # - more indented, or\n    | \\s*        # - starts with whitespace, followed by:\n      (?: $      #   - the end of the line (i.e. empty line), or\n      |\\{-[^@]   #   - the start of a block comment, or\n      |--+       #   - the start of a single-line comment.\n         (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                 # The double dash may not be followed by other operator characters\n                 # (then it would be an operator, not a comment)\n    )\n"
      pop: true
    - include: repo_comment_like
    - include: repo_where
    - match: (qualified|as|hiding)
    - include: repo_package_name
    - include: repo_package_exports
  - include: repo_deriving
  - include: repo_layout_herald
  - include: repo_keyword
  - match: ^\s*(infix[lr]?)\s+(.*)
    scope: meta.fixity-declaration.bh
  - include: repo_start_type_signature
  - include: repo_overloaded_label
  - include: repo_type_application
  - include: repo_reserved_symbol
  - include: repo_fun_decl
  - include: repo_qualifier
  - match: :[\p{S}\p{P}&&[^(),;\[\]`{}_"']]*
    scope: constant.other.operator.infix.bh
  - include: repo_data_constructor
  - include: repo_prefix_op
  - include: repo_infix_op
  - match: (\()(#)\s
    captures:
      1: punctuation.paren.bh
      2: keyword.operator.hash.bh
    push:
    - match: (#)(\))
      pop: true
      captures:
        1: keyword.operator.hash.bh
        2: punctuation.paren.bh
    - include: repo_comma
    - include: main
  - match: (\()
    captures:
      1: punctuation.paren.bh
    push:
    - match: (\))
      pop: true
      captures:
        1: punctuation.paren.bh
    - include: repo_comma
    - include: main
  - include: repo_quasi_quote
  - match: (\[)
    captures:
      1: punctuation.bracket.bh
    push:
    - match: (\])
      pop: true
      captures:
        1: punctuation.bracket.bh
    - include: repo_comma
    - include: main
  - include: repo_record
  repo_adt_constructor:
  - include: repo_comment_like
  - match: "(?x)\n  (?<![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]) # non-symbol\n  (?:(=)|(\\|))\n  (?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])  # non-symbol"
    captures:
      1: keyword.operator.eq.bh
      2: keyword.operator.pipe.bh
    push:
    - match: "(?x)\n  (?: # Infix data constructor\n    # First argument\n    (?:\n    # Simple type\n      (?<!')\\b((?:[\\p{Ll}_\\p{Lu}\\p{Lt}\\p{Nd}'\\.])+)\n    # Type inside balanced parentheses\n    | ('? # Optional promotion tick\n        (?<paren>\n          \\(          # Opening parenthesis\n          (?:\n            [^\\(\\)]*  # Match non-parentheses\n          | \\g<paren> # or recurse into further depth\n          )*\n          \\)          # Closing parenthesis\n        )\n      )\n    # Type inside balanced brackets\n    | ('? # Optional promotion tick\n        (?<brac>\n          \\[          # Opening bracket\n          (?:\n            [^\\[\\]]*  # Match non-brackets\n          | \\g<brac>  # or recurse into further depth\n          )*\n          \\]          # Closing bracket\n        )\n      )\n    )\n    # Then either\n    \\s*\n      # - a symbolic infix constructor, or\n    (?:(?<![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])(:[\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]*)\n \
        \     # - an alphabetic infix constructor\n    | (`)([\\p{Lu}\\p{Lt}][\\p{Ll}_\\p{Lu}\\p{Lt}\\p{Nd}']*)(`)\n    )\n  ) # Otherwise, prefix data constructor, either:\n  | # - an alphabetic data constructor e.g. \"Cons_123\"\n    (?:(?<!')\\b([\\p{Lu}\\p{Lt}][\\p{Ll}_\\p{Lu}\\p{Lt}\\p{Nd}']*))\n  | # - a symbolic (prefix) data constructor\n    (\\()\\s*(:[\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]*)\\s*(\\))\n  | # Otherwise, try to fail early to avoid excessive backtracking (https://github.com/JustusAdam/language-bh/issues/161)\n      # Fail when detecting a lowercase identifier and then something not starting with a tick or colon\n      (?=\\b(?<!')(?!(?:forall|deriving)\\s)[\\p{Ll}_]\\S+\\s+[^`:])\n      # Fail when seeing another equal signs or pipe symbol\n     |(?=\n        (?<![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]) # non-symbol\n        (?:=|\\|)\n        (?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])  # non-symbol\n      )"
      pop: true
      captures:
        10: constant.other.bh
        11: punctuation.paren.bh
        12: constant.other.operator.prefix.bh
        13: punctuation.paren.bh
        6: constant.other.operator.infix.bh
        7: punctuation.backtick.bh
        8: constant.other.infix.bh
        9: punctuation.backtick.bh
    - include: repo_comment_like
    - include: repo_deriving
    - include: repo_record_decl
    - include: repo_forall
    - include: repo_data_context
    - include: repo_type_signature
  repo_block_comment:
  - match: \{-
    captures:
      0: punctuation.definition.comment.bh
    push:
    - meta_scope: comment.block.bh
    - include: repo_block_comment
    - match: -\}
      pop: true
      captures:
        0: punctuation.definition.comment.bh
  repo_char_literal:
  - match: "(?x)\n  (?<![\\p{Ll}_\\p{Lu}\\p{Lt}\\p{Nd}'])\n  (')\n  (?:\n    [\\ -\\[\\]-~]                         # Basic Char\n  | (\\\\(?:NUL|SOH|STX|ETX|EOT|ENQ|ACK|BEL|BS|HT|LF|VT|FF|CR|SO|SI|DLE\n       |DC1|DC2|DC3|DC4|NAK|SYN|ETB|CAN|EM|SUB|ESC|FS|GS|RS\n       |US|SP|DEL|[abfnrtv\\\\\\\"'\\\\&]))   # Escapes\n  | (\\\\o[0-7]+)                         # Octal Escapes\n  | (\\\\x[0-9A-Fa-f]+)                   # Hexadecimal Escapes\n  | (\\\\\\^[A-Z@\\[\\]\\\\\\^_])                 # Control Chars\n  )\n  (')\n"
    scope: string.quoted.single.bh
    captures:
      1: punctuation.definition.string.begin.bh
      2: constant.character.escape.bh
      3: constant.character.escape.octal.bh
      4: constant.character.escape.hexadecimal.bh
      5: constant.character.escape.control.bh
      6: punctuation.definition.string.end.bh
  repo_comma:
  - match: ','
    scope: punctuation.separator.comma.bh
  repo_comment_like:
  - include: repo_cpp
  - include: repo_pragma
  - include: repo_comments
  repo_comments:
  - match: ^(\s*)(--\s[\|\$])
    captures:
      2: punctuation.whitespace.comment.leading.bh
    push:
    - meta_scope: comment.block.documentation.bh
    - match: (?=^(?!\1--+(?![\p{S}\p{P}&&[^(),;\[\]`{}_"']])))
      pop: true
  - match: (^[ \t]+)?(--(@)\s)
    captures:
      1: punctuation.whitespace.comment.leading.bh
    push:
    - meta_scope: comment.line.documentation.bh
    - match: \n
      pop: true
  - match: \{-\s?[\|\$\*\^]
    captures:
      0: punctuation.definition.comment.bh
    push:
    - meta_scope: comment.block.documentation.bh
    - include: repo_block_comment
    - match: -\}
      pop: true
      captures:
        0: punctuation.definition.comment.bh
  - match: (^[ \t]+)?(?=--+(?![\p{S}\p{P}&&[^(),;\[\]`{}_"']]))
    captures:
      1: punctuation.whitespace.comment.leading.bh
    push:
    - match: (?!)
      pop: true
    - match: --
      captures:
        0: punctuation.definition.comment.bh
      push:
      - meta_scope: comment.line.double-dash.bh
      - match: \n
        pop: true
  - include: repo_block_comment
  repo_cpp:
  - match: ^(#).*$
    scope: meta.preprocessor.c
    captures:
      1: punctuation.definition.preprocessor.c
  repo_data_constructor:
  - match: \b(?<!')[\p{Lu}\p{Lt}][\p{Ll}_\p{Lu}\p{Lt}\p{Nd}']*(?![\.'\w])
    scope: constant.other.bh
  - match: (\()\s*(:[\p{S}\p{P}&&[^(),;\[\]`{}_"']]*)\s*(\))
    scope: constant.other.operator.bh
  repo_data_context:
  - match: "(?x)\n  (.*)\n  (?<![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])\n  (=>|\u21D2)\n  (?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])\n"
    captures:
      2: keyword.operator.big-arrow.bh
  repo_deriving:
  - match: ^(\s*)(deriving)\s+(?:(via|stock|newtype|anyclass)\s+)?
    captures:
      2: keyword.other.deriving.bh
    push:
    - meta_scope: meta.deriving.bh
    - match: "(?x) # Detect end of deriving statement\n  # Decreasing indentation\n   (?=\\}|;)      # Explicit indentation\n  |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n      \\1\\s+\\S    # - more indented, or\n    | \\s*        # - starts with whitespace, followed by:\n      (?: $      #   - the end of the line (i.e. empty line), or\n      |\\{-[^@]   #   - the start of a block comment, or\n      |--+       #   - the start of a single-line comment.\n         (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                 # The double dash may not be followed by other operator characters\n                 # (then it would be an operator, not a comment)\n    )"
      pop: true
    - include: repo_comment_like
    - match: (?<!')\b(instance)\b(?!')
      scope: keyword.other.instance.bh
    - match: (?<!')\b(via|stock|newtype|anyclass)\b(?!')
    - include: repo_type_signature
  - match: (deriving)(?:\s+(stock|newtype|anyclass))?\s*(\()
    captures:
      1: keyword.other.deriving.bh
      3: punctuation.paren.bh
    push:
    - meta_scope: meta.deriving.bh
    - match: (\))
      pop: true
      captures:
        1: punctuation.paren.bh
    - include: repo_type_signature
  - match: "(?x)\n  (deriving)(?:\\s+(stock|newtype|anyclass))?\\s+\n    ([\\p{Lu}\\p{Lt}][\\p{Ll}_\\p{Lu}\\p{Lt}\\p{Nd}']*)\n    (\\s+(via)\\s+(.*)$)?\n"
    scope: meta.deriving.bh
    captures:
      1: keyword.other.deriving.bh
      5: keyword.other.deriving.strategy.via.bh
  - match: (?<!')\b(via)\b(?!')
    scope: keyword.other.deriving.strategy.via.bh
  repo_double_colon:
  - match: "\\s*(::|\u2237)(?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])\\s*"
    captures:
      1: keyword.operator.double-colon.bh
  repo_export_constructs:
  - include: repo_comment_like
  - match: \b(?<!')(pattern)\b(?!')
    captures:
      1: keyword.other.pattern.bh
    push:
    - match: "(?x)\n   # Data constructor\n   ([\\p{Lu}\\p{Lt}][\\p{Ll}_\\p{Lu}\\p{Lt}\\p{Nd}']*)\n   # Prefix form of symbolic constructor\n   | (\\()\\s*(:[\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]+)\\s*(\\))"
      pop: true
      captures:
        1: constant.other.bh
        2: punctuation.paren.bh
        3: constant.other.operator.prefix.bh
        4: punctuation.paren.bh
    - include: repo_comment_like
  - match: \b(?<!')(type)\b(?!')
    captures:
      1: keyword.other.type.bh
    push:
    - match: (?=,|\))
      pop: true
    - include: repo_comment_like
    - include: repo_reserved_symbol
    - include: repo_type_constructor
    - include: repo_type_operator
  - include: repo_record_wildcard
  - include: repo_reserved_symbol
  - match: (\()\s*(:[\p{S}\p{P}&&[^(),;\[\]`{}_"']]*)\s*(\))
    scope: storage.type.operator.bh
  - match: (?<!')\b[\p{Ll}_][\p{Ll}_\p{Lu}\p{Lt}\p{Nd}']*
    scope: entity.name.function.bh
  - match: (?<!')\b[\p{Lu}\p{Lt}][\p{Ll}_\p{Lu}\p{Lt}\p{Nd}']*
    scope: storage.type.bh
  - include: repo_prefix_op
  repo_ffi:
  - match: ^(\s*)(foreign)\s+(import|export)\s+
    captures:
      2: keyword.other.foreign.bh
    push:
    - match: "(?x) # Detect end of FFI block by decreasing indentation:\n  (?=\\}|;)       # Explicit indentation\n  |^(?!          # Implicit indentation: end match on newline *unless* the new line is either:\n      \\1\\s+\\S    # - more indented, or\n    | \\s*        # - starts with whitespace, followed by:\n      (?: $      #   - the end of the line (i.e. empty line), or\n      |\\{-[^@]   #   - the start of a block comment, or\n      |--+       #   - the start of a single-line comment.\n         (?![\\p{S}\\p{P}&&[^(),;\\[\\]{}`_\"']]).*$) # non-symbol\n                 # The double dash may not be followed by other operator characters\n                 # (then it would be an operator, not a comment)\n    )\n"
      pop: true
    - include: repo_comment_like
    - match: \b(?<!')(ccall|cplusplus|dotnet|jvm|stdcall|prim|capi)\s+
    - match: (?=")|(?=\b(?<!')([\p{Ll}_][\p{Ll}_\p{Lu}\p{Lt}\p{Nd}']*)\b(?!'))
      push:
      - match: "(?=(::|\u2237)(?![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]))"
        pop: true
      - include: repo_comment_like
      - match: "(?x)\n  \\b(?<!')(safe|unsafe|interruptible)\\b(?!')\n  \\s*\n  (\"(?:\\\\\"|[^\"])*\")?\n  \\s*\n  (?:\n    (?:\\b(?<!'')([\\p{Ll}_][\\p{Ll}_\\p{Lu}\\p{Lt}\\p{Nd}']*)\\b(?!'))\n   |(?:\\(\\s*(?!--+\\))([\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]+)\\s*\\))\n  )\n"
        captures:
          2: entity.name.foreign.bh
          3: entity.name.function.bh
          4: entity.name.function.infix.bh
