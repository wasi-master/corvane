name: Jest Snapshot
scope: source.jest.snap
file_extensions:
- snap
contexts:
  main:
  - include: repo_directives
  - include: repo_statements
  - match: \A(#!).*(?=$)
    scope: comment.line.shebang.ts
    captures:
      1: punctuation.definition.comment.ts
  repo_access-modifier:
  - match: (?<!\.|\$)\b(abstract|public|protected|private|readonly|static)\b(?!\$)
    scope: storage.modifier.tsx
  repo_after-operator-block:
  - match: (?<=[=(,\[?+!]|await|return|yield|throw|in|of|typeof|&&|\|\||\*)\s*(\{)
    captures:
      1: punctuation.definition.block.tsx
    push:
    - meta_scope: meta.objectliteral.tsx
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.block.tsx
    - include: repo_object-member
  repo_array-binding-pattern:
  - match: (?:(\.\.\.)\s*)?(\[)
    captures:
      1: keyword.operator.rest.tsx
      2: punctuation.definition.binding-pattern.array.tsx
    push:
    - match: \]
      pop: true
      captures:
        0: punctuation.definition.binding-pattern.array.tsx
    - include: repo_binding-element
    - include: repo_punctuation-comma
  repo_array-literal:
  - match: \[
    captures:
      0: meta.brace.square.tsx
    push:
    - meta_scope: meta.array.literal.tsx
    - match: \]
      pop: true
      captures:
        0: meta.brace.square.tsx
    - include: repo_expression
    - include: repo_punctuation-comma
  repo_arrow-function:
  - match: (?<!\.|\$)(\basync)(?=\s*[<(])
    scope: meta.arrow.tsx
    captures:
      1: storage.modifier.async.tsx
  - match: (?:(?<!\.|\$)(\basync)\s*)?([_$[:alpha:]][_$[:alnum:]]*)\s*(?==>)
    scope: meta.arrow.tsx
    captures:
      1: storage.modifier.async.tsx
      2: variable.parameter.tsx
  - match: (?x)\s*(?=(<([^<>]|\<[^<>]+\>)+>\s*)?\(([^()]|\([^()]*\))*\)(\s*:\s*(.)*)?\s*=>)
    push:
    - meta_scope: meta.arrow.tsx
    - match: (?==>)
      pop: true
    - include: repo_comment
    - include: repo_type-parameters
    - include: repo_function-parameters
    - include: repo_arrow-return-type
  - match: =>
    captures:
      0: storage.type.function.arrow.tsx
    push:
    - meta_scope: meta.arrow.tsx
    - match: (?<=\})|((?!\{)(?=\S))
      pop: true
    - include: repo_decl-block
    - include: repo_expression
  repo_arrow-return-type:
  - match: (?<=\))\s*(:)
    captures:
      1: keyword.operator.type.annotation.tsx
    push:
    - meta_scope: meta.return.type.arrow.tsx
    - match: (?<!:)((?=$)|(?==>|;|//))
      pop: true
    - include: repo_type-predicate-operator
    - include: repo_type
  repo_binding-element:
  - include: repo_comment
  - include: repo_object-binding-pattern
  - include: repo_array-binding-pattern
  - include: repo_destructuring-variable-rest
  - include: repo_variable-initializer
  repo_boolean-literal:
  - match: (?<!\.|\$)\btrue\b(?!\$)
    scope: constant.language.boolean.true.tsx
  - match: (?<!\.|\$)\bfalse\b(?!\$)
    scope: constant.language.boolean.false.tsx
  repo_case-clause:
  - match: (?<!\.|\$)\b(case|default(?=:))\b(?!\$)
    captures:
      1: keyword.control.switch.tsx
    push:
    - meta_scope: case-clause.expr.tsx
    - match: ':'
      pop: true
      captures:
        0: punctuation.definition.section.case-statement.tsx
    - include: repo_expression
  repo_cast:
  - include: repo_jsx
  repo_class-or-interface-body:
  - match: \{
    captures:
      0: punctuation.definition.block.tsx
    push:
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.block.tsx
    - include: repo_string
    - include: repo_comment
    - include: repo_decorator
    - include: repo_method-declaration
    - include: repo_indexer-declaration
    - include: repo_field-declaration
    - include: repo_type-annotation
    - include: repo_variable-initializer
    - include: repo_access-modifier
    - include: repo_property-accessor
    - include: repo_expression
    - include: repo_punctuation-comma
    - include: repo_punctuation-semicolon
  repo_class-or-interface-declaration:
  - match: (?<!\.|\$)\b(?:(export)\s+)?\b(?:(abstract)\s+)?\b(?:(class)|(interface))\b
    captures:
      1: keyword.control.export.tsx
      2: storage.modifier.tsx
      3: storage.type.class.tsx
      4: storage.type.interface.tsx
    push:
    - meta_scope: meta.class.tsx
    - match: (?<=\})
      pop: true
      captures:
        1: punctuation.definition.block.tsx
    - include: repo_comment
    - include: repo_class-or-interface-heritage
    - match: '[_$[:alpha:]][_$[:alnum:]]*'
      captures:
        0: entity.name.type.class.tsx
    - include: repo_type-parameters
    - include: repo_class-or-interface-body
  repo_class-or-interface-heritage:
  - match: (?<!\.|\$)(?:\b(extends|implements)\b)(?!\$)
    captures:
      1: storage.modifier.tsx
    push:
    - match: (?=\{)
      pop: true
      captures:
        1: punctuation.definition.block.tsx
    - include: repo_comment
    - include: repo_class-or-interface-heritage
    - include: repo_type-parameters
    - match: ([_$[:alpha:]][_$[:alnum:]]*)\s*(\.)(?=\s*[_$[:alpha:]][_$[:alnum:]]*(\s*\.\s*[_$[:alpha:]][_$[:alnum:]]*)*\s*([,<{]|extends|implements|//|/\*))
      captures:
        1: entity.name.type.module.tsx
        2: punctuation.accessor.tsx
    - match: ([_$[:alpha:]][_$[:alnum:]]*)(?=\s*([,<{]|extends|implements|//|/\*))
      captures:
        1: entity.other.inherited-class.tsx
    - include: repo_expression
  repo_comment:
  - match: /\*\*(?!/)
    captures:
      0: punctuation.definition.comment.tsx
    push:
    - meta_scope: comment.block.documentation.tsx
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.tsx
    - include: repo_docblock
  - match: /\*
    captures:
      0: punctuation.definition.comment.tsx
    push:
    - meta_scope: comment.block.tsx
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.tsx
  - match: (^[ \t]+)?(?=//)
    captures:
      1: punctuation.whitespace.comment.leading.tsx
    push:
    - match: (?=$)
      pop: true
    - match: //
      captures:
        0: punctuation.definition.comment.tsx
      push:
      - meta_scope: comment.line.double-slash.tsx
      - match: (?=$)
        pop: true
  repo_control-statement:
  - match: (?<!\.|\$)\b(catch|finally|throw|try)\b(?!\$)
    scope: keyword.control.trycatch.tsx
  - match: (?<!\.|\$)\b(break|continue|do|goto|while)\b(?!\$)
    scope: keyword.control.loop.tsx
  - match: (?<!\.|\$)\b(return)\b(?!\$)
    scope: keyword.control.flow.tsx
  - match: (?<!\.|\$)\b(yield)\b(?!\$)(?:\s*(\*))?
    captures:
      1: keyword.control.flow.tsx
      2: keyword.generator.asterisk.tsx
  - match: (?<!\.|\$)\b(case|default|switch)\b(?!\$)
    scope: keyword.control.switch.tsx
  - match: (?<!\.|\$)\b(else|if)\b(?!\$)
    scope: keyword.control.conditional.tsx
  - match: (?<!\.|\$)\b(with)\b(?!\$)
    scope: keyword.control.with.tsx
  - match: (?<!\.|\$)\b(debugger)\b(?!\$)
    scope: keyword.other.debugger.tsx
  - match: (?<!\.|\$)\b(declare)\b(?!\$)
    scope: storage.modifier.tsx
  repo_decl-block:
  - match: \{
    captures:
      0: punctuation.definition.block.tsx
    push:
    - meta_scope: meta.block.tsx
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.block.tsx
    - include: repo_statements
  repo_declaration:
  - include: repo_decorator
  - include: repo_var-expr
  - include: repo_function-declaration
  - include: repo_class-or-interface-declaration
  - include: repo_type-declaration
  - include: repo_enum-declaration
  - include: repo_namespace-declaration
  - include: repo_import-equals-declaration
  - include: repo_import-declaration
  - include: repo_export-declaration
  repo_decorator:
  - match: (?<!\.|\$)\@
    captures:
      0: punctuation.decorator.tsx
    push:
    - meta_scope: meta.decorator.tsx
    - match: (?=\s)
      pop: true
    - include: repo_expression
  repo_destructuring-parameter:
  - match: (?<!=|:)\s*(\{)
    captures:
      1: punctuation.definition.binding-pattern.object.tsx
    push:
    - meta_scope: meta.parameter.object-binding-pattern.tsx
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.binding-pattern.object.tsx
    - include: repo_parameter-object-binding-element
  - match: (?<!=|:)\s*(\[)
    captures:
      1: punctuation.definition.binding-pattern.array.tsx
    push:
    - meta_scope: meta.paramter.array-binding-pattern.tsx
    - match: \]
      pop: true
      captures:
        0: punctuation.definition.binding-pattern.array.tsx
    - include: repo_parameter-binding-element
    - include: repo_punctuation-comma
  repo_destructuring-parameter-rest:
  - match: (?:(\.\.\.)\s*)?([_$[:alpha:]][_$[:alnum:]]*)
    captures:
      1: keyword.operator.rest.tsx
      2: variable.parameter.tsx
  repo_destructuring-variable:
  - match: (?<!=|:|of|in)\s*(?=\{)
    push:
    - meta_scope: meta.object-binding-pattern-variable.tsx
    - match: (?=$|[;,=}]|(\s+(of|in)\s+))
      pop: true
    - include: repo_object-binding-pattern
    - include: repo_type-annotation
    - include: repo_comment
  - match: (?<!=|:|of|in)\s*(?=\[)
    push:
    - meta_scope: meta.array-binding-pattern-variable.tsx
    - match: (?=$|[;,=}]|(\s+(of|in)\s+))
      pop: true
    - include: repo_array-binding-pattern
    - include: repo_type-annotation
    - include: repo_comment
  repo_destructuring-variable-rest:
  - match: (?:(\.\.\.)\s*)?([_$[:alpha:]][_$[:alnum:]]*)
    captures:
      1: keyword.operator.rest.tsx
      2: meta.definition.variable.tsx variable.other.readwrite.tsx
  repo_directives:
  - match: ^(///)\s*(?=<(reference|amd-dependency|amd-module)(\s+(path|types|no-default-lib|name)\s*=\s*((\'[^']*\')|(\"[^"]*\")))+\s*/>\s*$)
    captures:
      1: punctuation.definition.comment.tsx
    push:
    - meta_scope: comment.line.triple-slash.directive.tsx
    - match: (?=$)
      pop: true
    - match: (<)(reference|amd-dependency|amd-module)
      captures:
        1: punctuation.definition.tag.directive.tsx
        2: entity.name.tag.directive.tsx
      push:
      - meta_scope: meta.tag.tsx
      - match: />
        pop: true
        captures:
          0: punctuation.definition.tag.directive.tsx
      - match: path|types|no-default-lib|name
        scope: entity.other.attribute-name.directive.tsx
      - match: '='
        scope: keyword.operator.assignment.tsx
      - include: repo_string
  repo_docblock:
  - match: "(?x)(?<!\\w)@(\n  abstract|access|alias|arg|argument|async|attribute|augments|author|beta|borrows|bubbes|callback|chainable|class\n  |classdesc|code|config|const|constant|constructor|constructs|copyright|default|defaultvalue|define|deprecated|desc\n  |description|dict|emits|enum|event|example|exports?|extends|extension|extension_for|extensionfor|external|file\n  |fileoverview|final|fires|for|function|global|host|ignore|implements|implicitCast|inherit[Dd]oc|inner|instance\n  |interface|kind|lends|license|listens|main|member|memberof|method|mixex|mixins?|modifies|module|name|namespace\n  |noalias|nocollapse|nocompile|nosideeffects|override|overview|package|param|preserve|private|prop|property\n  |protected|public|read[Oo]nly|record|require[ds]|returns?|see|since|static|struct|submodule|summary|suppress\n  |template|this|throws|todo|type|typedef|unrestricted|uses|var|variation|version|virtual|writeOnce)\\b"
    scope: storage.type.class.jsdoc
  - match: "(?x)\n(\n  \\[\n    [^\\]]+            # Optional [link text] preceding {@link syntax}\n  \\]\n\n  (?!                  # Check to avoid highlighting two sets of link text\n    {\n      @\\w+            # Tagname\n      \\s+\n      [^\\s|}]+        # Namepath/URL\n      [\\s|]           # Whitespace or bar delimiting description\n      [^}]*\n    }\n  )\n)?\n\n(?:\n  {\n    (\n      @\n      (?: link         # Name of tag\n        | linkcode\n        | linkplain\n        | tutorial\n      )\n    )\n\n    \\s+\n\n    ([^\\s|}]+)        # Namepath or URL\n\n    (?:                # Optional link text following link target\n      [\\s|]           # Bar or space separating target and text\n      [^}]*            # Actual text\n    )?\n  }\n)"
    scope: other.meta.jsdoc
    captures:
      0: entity.name.type.instance.jsdoc
      1: constant.other.description.jsdoc
      2: storage.type.class.jsdoc
      3: variable.other.description.jsdoc
  - match: "(?x)\n\n(?:(?<=@param)|(?<=@arg)|(?<=@argument)|(?<=@type)|(?<=@property)|(?<=@prop))\n\n\\s+\n\n({(?:\n  \\* |                                       # {*} any type\n  \\? |                                       # {?} unknown type\n\n  (?:\n    (?:                                       # Check for a prefix\n      \\? |                                   # {?string} nullable type\n      !   |                                   # {!string} non-nullable type\n      \\.{3}                                  # {...string} variable number of parameters\n    )?\n\n    (?:\n      (?:\n        function                              # {function(string, number)} function type\n        \\s*\n        \\(\n        \\s*\n        (?:\n          [a-zA-Z_$][\\w$]*\n          (?:\n            \\s*,\\s*\n            [a-zA-Z_$][\\w$]*\n          )*\n        )?\n        \\s*\n        \\)\n        (?:                                   # {function(): string} function return type\n          \\s*:\\s*\n  \
      \        [a-zA-Z_$][\\w$]*\n        )?\n      )?\n      |\n      (?:\n        \\(                                   # Opening bracket of multiple types with parenthesis {(string|number)}\n          [a-zA-Z_$]+\n          (?:\n            (?:\n              [\\w$]*\n              (?:\\[\\])?                     # {(string[]|number)} type application, an array of strings or a number\n            ) |\n            \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>    # {Array<string>} or {Object<string, number>} type application (optional .)\n          )\n          (?:\n            [\\.|~]                           # {Foo.bar} namespaced, {string|number} multiple, {Foo~bar} class-specific callback\n            [a-zA-Z_$]+\n            (?:\n              (?:\n                [\\w$]*\n                (?:\\[\\])?                   # {(string|number[])} type application, a string or an array of numbers\n              ) |\n              \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>  # {Array<string>} or {Object<string, number>}\
      \ type application (optional .)\n            )\n          )*\n        \\) |\n        [a-zA-Z_$]+\n        (?:\n          (?:\n            [\\w$]*\n            (?:\\[\\])?                       # {(string|number[])} type application, a string or an array of numbers\n          ) |\n          \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>      # {Array<string>} or {Object<string, number>} type application (optional .)\n        )\n        (?:\n          [\\.|~]                             # {Foo.bar} namespaced, {string|number} multiple, {Foo~bar} class-specific callback\n          [a-zA-Z_$]+\n          (?:\n            [\\w$]* |\n            \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>    # {Array<string>} or {Object<string, number>} type application (optional .)\n          )\n        )*\n      )\n    )\n                                              # Check for suffix\n    (?:\\[\\])?                               # {string[]} type application, an array of strings\n    =?                                        #\
      \ {string=} optional parameter\n  )\n)})\n\n\\s+\n\n(\n  \\[                                         # [foo] optional parameter\n    \\s*\n    (?:\n      [a-zA-Z_$][\\w$]*\n      (?:\n        (?:\\[\\])?                           # Foo[].bar properties within an array\n        \\.                                   # Foo.Bar namespaced parameter\n        [a-zA-Z_$][\\w$]*\n      )*\n      (?:\n        \\s*\n        =                                     # [foo=bar] Default parameter value\n        \\s*\n        [\\w$\\s]*\n      )?\n    )\n    \\s*\n  \\] |\n  (?:\n    [a-zA-Z_$][\\w$]*\n    (?:\n      (?:\\[\\])?                             # Foo[].bar properties within an array\n      \\.                                     # Foo.Bar namespaced parameter\n      [a-zA-Z_$][\\w$]*\n    )*\n  )?\n)\n\n\\s+\n\n(?:-\\s+)?                                     # optional hyphen before the description\n\n((?:(?!\\*\\/).)*)                             # The type description"
    captures:
      0: other.meta.jsdoc
      1: entity.name.type.instance.jsdoc
      2: variable.other.jsdoc
      3: other.description.jsdoc
  - match: "(?x)\n\n({(?:\n  \\* |                                       # {*} any type\n  \\? |                                       # {?} unknown type\n\n  (?:\n    (?:                                       # Check for a prefix\n      \\? |                                   # {?string} nullable type\n      !   |                                   # {!string} non-nullable type\n      \\.{3}                                  # {...string} variable number of parameters\n    )?\n\n    (?:\n      (?:\n        function                              # {function(string, number)} function type\n        \\s*\n        \\(\n        \\s*\n        (?:\n          [a-zA-Z_$][\\w$]*\n          (?:\n            \\s*,\\s*\n            [a-zA-Z_$][\\w$]*\n          )*\n        )?\n        \\s*\n        \\)\n        (?:                                   # {function(): string} function return type\n          \\s*:\\s*\n          [a-zA-Z_$][\\w$]*\n        )?\n      )?\n      |\n      (?:\n        \\(         \
      \                          # Opening bracket of multiple types with parenthesis {(string|number)}\n          [a-zA-Z_$]+\n          (?:\n            [\\w$]* |\n            \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>    # {Array<string>} or {Object<string, number>} type application (optional .)\n          )\n          (?:\n            [\\.|~]                           # {Foo.bar} namespaced, {string|number} multiple, {Foo~bar} class-specific callback\n            [a-zA-Z_$]+\n            (?:\n              [\\w$]* |\n              \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>  # {Array<string>} or {Object<string, number>} type application (optional .)\n            )\n          )*\n        \\) |\n        [a-zA-Z_$]+\n        (?:\n          [\\w$]* |\n          \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>      # {Array<string>} or {Object<string, number>} type application (optional .)\n        )\n        (?:\n          [\\.|~]                             # {Foo.bar} namespaced, {string|number} multiple, {Foo~bar} class-specific\
      \ callback\n          [a-zA-Z_$]+\n          (?:\n            [\\w$]* |\n            \\.?<[\\w$]+(?:,\\s+[\\w$]+)*>    # {Array<string>} or {Object<string, number>} type application (optional .)\n          )\n        )*\n      )\n    )\n                                              # Check for suffix\n    (?:\\[\\])?                               # {string[]} type application, an array of strings\n    =?                                        # {string=} optional parameter\n  )\n)})\n\n\\s+\n\n(?:-\\s+)?                                    # optional hyphen before the description\n\n((?:(?!\\*\\/).)*)                            # The type description"
    captures:
      0: other.meta.jsdoc
      1: entity.name.type.instance.jsdoc
      2: other.description.jsdoc
  repo_enum-declaration:
  - match: (?<!\.|\$)(?:(\bexport)\s+)?(?:\b(const)\s+)?\b(enum)\s+([_$[:alpha:]][_$[:alnum:]]*)
    captures:
      1: keyword.control.export.tsx
      2: storage.modifier.tsx
      3: storage.type.enum.tsx
      4: entity.name.type.enum.tsx
    push:
    - meta_scope: meta.enum.declaration.tsx
    - match: (?<=\})
      pop: true
    - include: repo_comment
    - match: \{
      captures:
        0: punctuation.definition.block.tsx
      push:
      - match: \}
        pop: true
        captures:
          0: punctuation.definition.block.tsx
      - include: repo_comment
      - match: ([_$[:alpha:]][_$[:alnum:]]*)
        captures:
          0: variable.other.enummember.tsx
        push:
        - match: (?=,|\}|$)
          pop: true
        - include: repo_comment
        - include: repo_variable-initializer
      - match: (?=((\'[^']*\')|(\"[^"]*\")|(\[([^\[\]]|\[[^\[\]]*\])+\])))
        push:
        - match: (?=,|\}|$)
          pop: true
        - include: repo_string
        - include: repo_array-literal
        - include: repo_comment
        - include: repo_variable-initializer
      - include: repo_punctuation-comma
  repo_export-declaration:
  - match: (?<!\.|\$)\b(export)\s+(as)\s+(namespace)\s+([_$[:alpha:]][_$[:alnum:]]*)
    captures:
      1: keyword.control.export.tsx
      2: keyword.control.as.tsx
      3: storage.type.namespace.tsx
      4: entity.name.type.module.tsx
  - match: (?<!\.|\$)\b(export)(?:(?:\s*(=))|(?:\s+(default)(?=\s+)))
    captures:
      1: keyword.control.export.tsx
      2: keyword.operator.assignment.tsx
      3: keyword.control.default.tsx
    push:
    - meta_scope: meta.export.default.tsx
    - match: (?=;|\bexport\b|\bfunction\b|\bclass\b|\binterface\b|\blet\b|\bvar\b|\bconst\b|\bimport\b|\benum\b|\bnamespace\b|\bmodule\b|\btype\b|\babstract\b|\bdeclare\b|\basync\b|$)
      pop: true
    - include: repo_expression
  - match: (?<!\.|\$)\b(export)(?!(\s*:)|(\$))\b
    captures:
      0: keyword.control.export.tsx
    push:
    - meta_scope: meta.export.tsx
    - match: (?=;|\bexport\b|\bfunction\b|\bclass\b|\binterface\b|\blet\b|\bvar\b|\bconst\b|\bimport\b|\benum\b|\bnamespace\b|\bmodule\b|\btype\b|\babstract\b|\bdeclare\b|\basync\b|$)
      pop: true
    - include: repo_import-export-declaration
  repo_expression:
  - include: repo_jsx
  - include: repo_string
  - include: repo_regex
  - include: repo_template
  - include: repo_comment
  - include: repo_literal
  - include: repo_function-declaration
  - include: repo_class-or-interface-declaration
  - include: repo_arrow-function
  - include: repo_cast
  - include: repo_ternary-expression
  - include: repo_new-expr
  - include: repo_object-literal
  - include: repo_expression-operators
  - include: repo_function-call
  - include: repo_support-objects
  - include: repo_identifiers
  - include: repo_paren-expression
  - include: repo_punctuation-comma
  - include: repo_punctuation-accessor
  repo_expression-operators:
  - match: (?<!\.|\$)\b(await)\b(?!\$)
    scope: keyword.control.flow.tsx
  - match: (?<!\.|\$)\bdelete\b(?!\$)
    scope: keyword.operator.expression.delete.tsx
