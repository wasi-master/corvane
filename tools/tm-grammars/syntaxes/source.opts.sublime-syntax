%YAML 1.2
---
# Option List (source.opts): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-etc via GitHub Linguist v9.7.0 (license: isc).
name: Option List
scope: source.opts
file_extensions:
- .ackrc
- .rspec
- .yardopts
- ackrc
- mocha.opts
contexts:
  main:
  - include: repo_main
  repo_escape:
  - include: scope:etc
  - match: (%)[A-Fa-f0-9]{2}
    scope: constant.character.percent.url-encoded.opts
    captures:
      1: punctuation.definition.character.percentage.opts
  repo_main:
  - include: scope:etc
  - include: repo_option
  - include: repo_escape
  repo_option:
  - match: ((--?)[^-\s=][^\s=]*)
    captures:
      1: entity.name.option.opts
      2: punctuation.definition.option.name.dash.opts
    push:
    - meta_scope: meta.option.opts
    - match: (?!)(?=\$|\S)
      pop: true
    - match: "(?xi)\n(?<= # HACK: Fixed-width look-behinds enforced by Oniguruma\n\t\\w[-_]pattern \n\t| reg[-_]exp   \n\t| regexp       \n\t| reg[-_]ex    \n\t| regex        \n) \\s+ (\\S+)"
      captures:
        1: string.regexp.opts
    - match: (=)(\S*)
    - match: \s+(?!#|-)(\S+)
  repo_value:
  - include: scope:etc
  - include: scope:etc
