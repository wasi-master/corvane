%YAML 1.2
---
# ucode (source.ucode): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/NoahBPeterson/ucode-lsp.git via GitHub Linguist v9.7.0 (license: mit).
name: ucode
scope: source.ucode
file_extensions:
- uc
first_line_match: ^#!.*\b(ucode)\b
contexts:
  main:
  - include: repo_template_blocks
  - include: repo_comments
  - include: repo_regexp
  - include: repo_strings
  - include: repo_numbers
  - include: repo_property_access
  - include: repo_keywords
  - include: repo_operators
  - include: repo_functions
  - include: repo_objects
  - include: repo_variables
  repo_comments:
  - match: //.*$
    scope: comment.line.double-slash.ucode
  - match: /\*/(?!/)
    scope: comment.block.empty.ucode
  - match: /\*
    push:
    - meta_scope: comment.block.ucode
    - match: \*/
      pop: true
  - match: '{#'
    push:
    - meta_scope: comment.block.template.ucode
    - match: '#}'
      pop: true
  repo_functions:
  - match: \b(print|printf|sprintf|length|substr|split|join|trim|ltrim|rtrim|chr|ord|uc|lc|type|keys|values|push|pop|shift|unshift|index|rindex|require|include|json|match|replace|system|time|sleep|localtime|gmtime|timelocal|timegm|min|max|uniq|b64enc|b64dec|hexenc|hexdec|hex|uchr|iptoarr|arrtoip|int|loadstring|loadfile|wildcard|regexp|assert|call|signal|clock|sourcepath|gc|die|exists|exit|filter|getenv|map|proto|render|reverse|slice|sort|splice|trace|warn)\b(?=\s*\()
    scope: support.function.builtin.ucode
  - match: \b([a-zA-Z_$][a-zA-Z0-9_$]*)\s*(?=\()
    scope: entity.name.function.ucode
  repo_keywords:
  - match: \b(default)\s+(?=as\b)
    captures:
      1: variable.other.ucode
  - match: \bas\s+(default)\b
    captures:
      1: variable.other.ucode
  - match: \b(if|else|elif|endif|while|endwhile|for|endfor|break|continue|return|try|catch|switch|case|default|in)\b
    scope: keyword.control.ucode
  - match: \b(let|const|function|endfunction)\b
    scope: storage.type.ucode
  - match: \b(delete)\b(?!\s*\()
    scope: keyword.operator.delete.ucode
  - match: \b(import|export)\b
    scope: keyword.control.module.ucode
  - match: \b(true|false|null|this)\b
    scope: constant.language.ucode
  repo_numbers:
  - match: \b0[xX][0-9a-fA-F]+\b
    scope: constant.numeric.hex.ucode
  - match: \b0[bB][01]+\b
    scope: constant.numeric.binary.ucode
  - match: \b0[oO][0-7]+\b
    scope: constant.numeric.octal.ucode
  - match: \b\d+(\.\d+)?([eE][+-]?\d+)?\b
    scope: constant.numeric.decimal.ucode
  repo_objects:
  - match: \{
    push:
    - meta_scope: meta.object.literal.ucode
    - match: \}
      pop: true
    - match: \b(try|catch|if|else|while|for|return|break|continue|function|let|const|true|false|null|this|switch|case|default|import|export|in|delete|[a-zA-Z_$][a-zA-Z0-9_$]*)\s*(?=:)
      captures:
        1: variable.other.property.ucode
      push:
      - meta_scope: meta.object.property.ucode
      - match: (?=:)
        pop: true
    - include: main
  repo_operators:
  - match: (\+|\-|\*|/|%|\*\*|\+\+|--)
    scope: keyword.operator.arithmetic.ucode
  - match: (=|\+=|\-=|\*=|/=|%=|\*\*=|&=|\^=|\|=|<<=|>>=|&&=|\|\|=|\?\?=)
    scope: keyword.operator.assignment.ucode
  - match: (===|!==|==|!=|<|<=|>|>=)
    scope: keyword.operator.comparison.ucode
  - match: (&&|\|\||!)
    scope: keyword.operator.logical.ucode
  - match: (&|\||\^|~|<<|>>)
    scope: keyword.operator.bitwise.ucode
  - match: (\?|:)
    scope: keyword.operator.ternary.ucode
  - match: (\?\.)
    scope: keyword.operator.optional-chaining.ucode
  - match: (\?\?)
    scope: keyword.operator.nullish-coalescing.ucode
  - match: (=>)
    scope: keyword.operator.arrow.ucode
  repo_property_access:
  - match: (?<=\.)\b([a-zA-Z_$][a-zA-Z0-9_$]*)\s*(?=\()
    scope: entity.name.function.method.ucode
  - match: (?<=\.)\b(try|catch|if|else|elif|endif|while|endwhile|for|endfor|break|continue|return|switch|case|default|in|let|const|function|endfunction|delete|import|export|true|false|null|this|[a-zA-Z_$][a-zA-Z0-9_$]*)\b
    scope: variable.other.property.ucode
  repo_regexp:
  - match: (?<=[=(,:;!?\[]|\breturn|\bcase|&&|\|\|)\s*(/(?![/*]))
    captures:
      1: string.regexp.ucode
    push:
    - meta_content_scope: string.regexp.ucode
    - match: /[gis]*
      pop: true
      captures:
        0: string.regexp.ucode
    - match: \\.
      scope: constant.character.escape.regexp.ucode
    - match: \[\^?\]?
      push:
      - meta_scope: constant.other.character-class.regexp.ucode
      - match: \]
        pop: true
      - match: \\.
        scope: constant.character.escape.regexp.ucode
  repo_strings:
  - match: '"'
    push:
    - meta_scope: string.quoted.double.ucode
    - match: '"|((?<!\\)$)'
      pop: true
    - match: \\.
      scope: constant.character.escape.ucode
  - match: ''''
    push:
    - meta_scope: string.quoted.single.ucode
    - match: '''|((?<!\\)$)'
      pop: true
    - match: \\.
      scope: constant.character.escape.ucode
  - match: '`'
    push:
    - meta_scope: string.template.ucode
    - match: '`'
      pop: true
    - match: \\.
      scope: constant.character.escape.ucode
    - match: \$\{
      push:
      - meta_scope: keyword.control.interpolation.ucode
      - match: \}
        pop: true
      - include: main
  repo_template_blocks:
  - match: '{{'
    push:
    - meta_scope: meta.embedded.block.expression.ucode
    - match: '}}'
      pop: true
    - include: main
  - match: '{%'
    push:
    - meta_scope: meta.embedded.block.statement.ucode
    - match: '%}'
      pop: true
    - include: main
  repo_variables:
  - match: \b[a-zA-Z_$][a-zA-Z0-9_$]*\b
    scope: variable.other.ucode
