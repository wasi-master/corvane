%YAML 1.2
---
# Java Template Engine (text.html.jte): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/maj2c/jte-template-syntax-highlight.git via GitHub Linguist v9.7.0 (license: apache-2.0).
name: Java Template Engine
scope: text.html.jte
file_extensions:
- jte
contexts:
  main:
  - include: repo_jte-keyword
  - include: repo_jte-comment
  - include: repo_jte-statement
  - include: repo_jte-declaration
  - include: repo_jte-comparison
  - include: repo_html_tags
  - include: scope:text.html.basic
  repo_entities:
  - match: (&)([a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+)(;)
    scope: constant.character.entity.html
    captures:
      1: punctuation.definition.entity.html
      3: punctuation.definition.entity.html
  - match: '&'
    scope: invalid.illegal.bad-ampersand.html
  repo_escaped-double-quote:
  - match: \\"
    scope: constant.character.escape.js
  repo_escaped-single-quote:
  - match: \\'
    scope: constant.character.escape.js
  repo_html_tags:
  - match: (<)([a-zA-Z0-9:-]+)(?=[^>]*></\2>)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.html
    push:
    - meta_scope: meta.tag.any.html
    - match: (>(<)/)(\2)(>)
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: meta.scope.between-tag-pair.html
        3: entity.name.tag.html
        4: punctuation.definition.tag.html
    - include: repo_tag-stuff
  - match: (<\?)(xml)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.xml.html
    push:
    - meta_scope: meta.tag.preprocessor.xml.html
    - match: (\?>)
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.xml.html
    - include: repo_tag_generic_attribute
    - include: repo_string
  - match: <!--
    captures:
      0: punctuation.definition.comment.html
    push:
    - meta_scope: comment.block.html
    - match: --\s*>
      pop: true
      captures:
        0: punctuation.definition.comment.html
    - match: --
      scope: invalid.illegal.bad-comments-or-CDATA.html
  - match: <!
    captures:
      0: punctuation.definition.tag.html
    push:
    - meta_scope: meta.tag.sgml.html
    - match: '>'
      pop: true
      captures:
        0: punctuation.definition.tag.html
    - match: (DOCTYPE|doctype)
      captures:
        1: entity.name.tag.doctype.html
      push:
      - meta_scope: meta.tag.sgml.doctype.html
      - match: (?=>)
        pop: true
        captures:
          1: entity.name.tag.doctype.html
      - match: '"[^">]*"'
        scope: string.quoted.double.doctype.identifiers-and-DTDs.html
    - match: \[CDATA\[
      push:
      - meta_scope: constant.other.inline-data.html
      - match: ']](?=>)'
        pop: true
    - match: (\s*)(?!--|>)\S(\s*)
      scope: invalid.illegal.bad-comments-or-CDATA.html
  - match: (?:^\s+)?(<)((?i:style))\b(?![^>]*/>)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.style.html
      3: punctuation.definition.tag.html
    push:
    - meta_scope: source.css.embedded.html
    - match: (</)((?i:style))(>)(?:\s*\n)?
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.style.html
        3: punctuation.definition.tag.html
    - include: repo_tag-stuff
    - match: (>)
      captures:
        1: punctuation.definition.tag.html
      push:
      - match: (?=</(?i:style))
        pop: true
      - include: scope:source.css
  - match: (?:^\s+)?(<)((?i:script))\b(?![^>]*/>)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.script.html
    push:
    - meta_scope: source.js.embedded.html
    - match: (?<=</(script|SCRIPT))(>)(?:\s*\n)?
      pop: true
      captures:
        2: punctuation.definition.tag.html
    - include: repo_tag-stuff
    - match: (?<!</(?:script|SCRIPT))(>)
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.script.html
      push:
      - match: (</)((?i:script))
        pop: true
        captures:
          1: punctuation.definition.tag.html
          2: entity.name.tag.script.html
      - match: (//).*?((?=</script)|$\n?)
        scope: comment.line.double-slash.js
        captures:
          1: punctuation.definition.comment.js
      - match: /\*
        captures:
          0: punctuation.definition.comment.js
        push:
        - meta_scope: comment.block.js
        - match: \*/|(?=</script)
          pop: true
          captures:
            0: punctuation.definition.comment.js
      - include: scope:source.js
  - match: (</?)((?i:body|head|html)\b)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.structure.any.html
    push:
    - meta_scope: meta.tag.structure.any.html
    - match: (>)
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.structure.any.html
    - include: repo_tag-stuff
  - match: (</?)((?i:address|blockquote|dd|div|header|section|footer|aside|nav|dl|dt|fieldset|form|frame|frameset|h1|h2|h3|h4|h5|h6|iframe|noframes|object|ol|p|ul|applet|center|dir|hr|menu|pre)\b)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.block.any.html
    push:
    - meta_scope: meta.tag.block.any.html
    - match: (>)
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.block.any.html
    - include: repo_tag-stuff
  - match: (</?)((?i:a|abbr|acronym|area|b|base|basefont|bdo|big|br|button|caption|cite|code|col|colgroup|del|dfn|em|font|head|html|i|img|input|ins|isindex|kbd|label|legend|li|link|map|meta|noscript|optgroup|option|param|q|s|samp|script|select|small|span|strike|strong|style|sub|sup|table|tbody|td|textarea|tfoot|th|thead|title|tr|tt|u|var)\b)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.inline.any.html
    push:
    - meta_scope: meta.tag.inline.any.html
    - match: '((?: ?/)?>)'
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.inline.any.html
    - include: repo_tag-stuff
  - match: (</?)([a-zA-Z0-9:-]+)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.other.html
    push:
    - meta_scope: meta.tag.other.html
    - match: (>)
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.other.html
    - include: repo_tag-stuff
  - match: (</?)([a-zA-Z0-9{}:-]+)
    captures:
      1: punctuation.definition.tag.html
      2: entity.name.tag.tokenised.html
    push:
    - meta_scope: meta.tag.tokenised.html
    - match: (>)
      pop: true
      captures:
        1: punctuation.definition.tag.html
        2: entity.name.tag.tokenised.html
    - include: repo_tag-stuff
  - include: repo_entities
  - match: <>
    scope: invalid.illegal.incomplete.html
  - match: <
    scope: invalid.illegal.bad-angle-bracket.html
  repo_jte-comment:
  - match: <%--
    captures:
      0: punctuation.definition.block.comment.jte
    push:
    - meta_scope: comment.jte
    - match: --%>
      pop: true
      captures:
        0: punctuation.definition.block.comment.jte
  repo_jte-comparison:
  - match: '@(if|elseif|for)'
    push:
    - meta_scope: comparison.jte
    - meta_content_scope: source.java
    - match: '

        '
      pop: true
    - include: scope:source.java
  repo_jte-declaration:
  - match: '@(import|param)'
    push:
    - meta_scope: declaration.jte
    - meta_content_scope: source.java
    - match: '

        '
      pop: true
    - include: scope:source.java
  repo_jte-keyword:
  - match: '@(import|param|if|else|elseif|endif|for|endfor|template)'
    scope: keyword.jte
  repo_jte-statement:
  - match: \${
    push:
    - meta_scope: statement.jte
    - meta_content_scope: source.java
    - match: '}'
      pop: true
    - include: scope:source.java
  repo_string:
  - include: repo_string-single-quoted
  - include: repo_string-double-quoted
  repo_string-double-quoted:
  - match: '"'
    captures:
      0: punctuation.definition.string.begin.html
    push:
    - meta_scope: string.quoted.double.jte
    - match: '"'
      pop: true
      captures:
        0: punctuation.definition.string.end.html
    - include: repo_escaped-double-quote
    - include: repo_jte-comment
    - include: repo_jte-statement
  repo_string-single-quoted:
  - match: ''''
    captures:
      0: punctuation.definition.string.begin.html
    push:
    - meta_scope: string.quoted.single.jte
    - match: ''''
      pop: true
      captures:
        0: punctuation.definition.string.end.html
    - include: repo_escaped-single-quote
    - include: repo_jte-comment
    - include: repo_jte-statement
  repo_tag-stuff:
  - include: repo_tag_id_attribute
  - include: repo_tag_generic_attribute
  - include: repo_string
  - include: repo_jte-comment
  repo_tag_generic_attribute:
  - match: \b([a-zA-Z0-9_-]+)\b\s*(=)
    captures:
      1: entity.other.attribute-name.generic.html
      2: punctuation.separator.key-value.html
    push:
    - meta_scope: entity.other.attribute-name.html
    - match: (?<='|"|)
      pop: true
      captures:
        1: entity.other.attribute-name.generic.html
        2: punctuation.separator.key-value.html
    - include: repo_string
    - include: repo_jte-statement
  repo_tag_id_attribute:
  - match: \b(id)\b\s*(=)
    captures:
      1: entity.other.attribute-name.id.html
      2: punctuation.separator.key-value.html
    push:
    - meta_scope: meta.attribute-with-value.id.html
    - match: (?<='|"|)
      pop: true
      captures:
        1: entity.other.attribute-name.id.html
        2: punctuation.separator.key-value.html
    - include: repo_string
