%YAML 1.2
---
# JCL (source.jcl): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/spgennard/vscode_cobol.git via GitHub Linguist v9.7.0 (license: mit).
name: JCL
scope: source.jcl
file_extensions:
- jcl
contexts:
  main:
  - match: ^//\*.*$
    scope: comment.line.jcl
  - match: (?i:DD\s+\*$|DD\s+\*.*[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$)
    captures:
      0: keyword.jcl
    push:
    - meta_scope: meta.symbol.jcl
    - match: (?i:(//[A-Za-z0-9\$\#@\.]*)|/\*)
      pop: true
      captures:
        0: variable.other.jcl
  - match: (//[A-Za-z0-9\$\#@\.]*)\s+(COMMAND|CNTL|ENCNTL|EXEC|IF|THEN|ELSE|ENDIF|INCLUDE|JCLIB|JOB|OUTPUT|PEND|UTPROC|PROC|SET|XMIT)
    captures:
      1: variable.other.jcl
      2: keyword.other.jcl
      3: variable.other.jcl
  - match: (^/\*JOBPARM)
    scope: keyword.other.jcl
  - match: (?<![a-zA-Z])(BURST|B|BYTES|M|CARDS|C|FORMS|F|LINECT|K|LINES|L|NOLOG|J|PAGES|G|PROCLIB|P|RESTART|E|ROOM|R|SYSAFF|S|TIME|T)(=)
    captures:
      1: keyword.other.jcl
      2: keyword.operator.jcl
  - match: (^/\*OUTPUT)
    scope: keyword.other.jcl
  - match: (?<![a-zA-Z])(BURST|CHARS|CKPTLNS|CKPTPGS|COMPACT|COPIES|COPYG|DEST|FCB|FLASHC|FLASH|FORMS|B|X|E|P|Z|N|G|D|C|Q|O|F)(=)
    captures:
      1: variable.other.jcl
      2: keyword.operator.jcl
  - match: (^/\*MESSAGE)\s+(.*$)
    captures:
      1: keyword.other.jcl
      2: token.info-token.jcl
  - match: (^/\*(?i:NETACCT|NOTIFY|SETUP|SIGNOFF|SIGNON|XEQ|XMIT))\s+(.*$)
    captures:
      1: keyword.other.jcl
      2: variable.parameter.jcl
  - match: (^/\*PRIORITY)\s+([a-zA-Z0-9])(.*$)
    captures:
      1: keyword.other.jcl
      2: token.info-token.jcl
      3: token.error-token.jcl
  - match: (^/\*ROUTE)\s+(PRINT|PUNCH|XEQ)\s+(.*$)
    captures:
      1: keyword.other.jcl
      2: variable.other.jcl
      3: meta.symbol.jcl
  - match: ^//\s+
    scope: keyword.continuation.jcl
  - match: '''.*'''
    scope: string.quoted.single.jcl
  - match: (?<![a-zA-Z])(?i:DSN|DISP|DCB|UNIT|VOL|SYSOUT|SPACE|RECFM|LRECL)(=)
    captures:
      0: variable.language.jcl
      1: keyword.operator.jcl
  - match: (?<![a-zA-Z])(?i:PGM|UTPROC|PROC|PARM|ADDRSPC|ACCT|TIME|REGION|COND|DSNME|DATAC)(=)
    scope: variable.language.jcl
    captures:
      1: variable.exec.language.jcl
      2: keyword.operator.jcl
  - match: (?<![a-zA-Z])(?i:ADDSPC|BYTES|CARDS|DSENQSHR|GROUP|JESLOG|JOBRC|LINES|MEMLIMIT|MSGCLASS|MSGLEVEL|NOTIFY|PAGES|PASSWORD|PERFORM|PRTY|RD|REGION|RESTART|SECLABEL|SCHENV|SYAFF|SYSTEM|TIME|TYPRUN|UJOBCORR|USER|CLASS|UID)(=|$)
    scope: variable.language.job.jcl
    captures:
      1: constant.language.job.jcl
      2: keyword.operator.jcl
  - match: (?<![a-zA-Z])(?i:NEW|DELETE|OLD|KEEP|KEEP|SHR|PASS|CATLG|MOD|CATLG|UNCATLG)(=|$)
    scope: variable.language.jcl
    captures:
      1: constant.language.disp.jcl
  - match: (?i:HOLD|JCLHOLD|SCAN)
    scope: variable.language.typrun.jcl
    captures:
      1: constant.language.typrun.jcl
  - match: (?i:BFALN|BFTEK|BLKSIZE|BUFIN|BUFL|BUFMAX|BUFNO|BUFOFF|BUFOUT|BUFSIZE|CPRI|CYLOFL|DEN|DIAGNS|DSORG|EROPT|FUNC|GNCP|INTVL|IPL|TXID|KEYLEN|LIMCT|LRECL|MODE|NCP|NTM|OPTCD|PCI|PRTSP|RECFM|RESERVE|RKP|STACK|THRESH|TRTCH)
    scope: variable.language.dcb.jcl
    captures:
      1: constant.language.dbc.jcl
  - match: (?<![-_\.a-zA-Z])(?i:BLKSIZE|DCB|DDname|DEST|DISP|DSNAME|DSNTYPE|EXPDT|KEYLEN|LABEL|LIKE|LRECL|OUTLIM|OUTPUT|RECFM|RECORG|RETPD|SPACE|SYSOUT|UNIT|VOLUME)
    scope: variable.language.dcb.jcl
    captures:
      1: constant.language.dbc_generic.jcl
  - match: (?i:COND\..*=|COND=)
    scope: keyword.control.conditional.jcl
  - match: (?<![a-zA-Z])(?i:LT|GT|GE|EQ|LE|NE|EVEN|ONLY)(?=\)|,)
    scope: keyword.operator.comparison.jcl
  - match: ^(//[A-Za-z0-9\$\#@\.]*)
    scope: variable.other.jcl
  - match: (?i:DD\s+)
    scope: keyword.other.jcl
