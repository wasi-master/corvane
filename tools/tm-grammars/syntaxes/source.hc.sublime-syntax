%YAML 1.2
---
# HolyC (source.hc): converted from TextMate by tools/tm-grammars/sync.py;
# source vendor/grammars/holyc.tmbundle via GitHub Linguist v9.7.0 (license: unlicense).
name: HolyC
scope: source.hc
file_extensions:
- hc
contexts:
  main:
  - include: repo_preprocessor-rule-enabled
  - include: repo_preprocessor-rule-disabled
  - include: repo_preprocessor-rule-other
  - include: repo_comments
  - match: \b(break|case|continue|default|do|else|for|goto|if|return|switch|while|throw|try|catch|extern|MOV|CALL|PUSH|LEAVE|RET|SUB|SHR|ADD|RETF|CMP|JNE|BTS|INT|XOR|JC|JZ|LOOP|POP|TEST|SHL|ADC|SBB|JMP|INC)\b
    scope: keyword.control.c
  - match: \b(U0|I8|U8|I16|U16|I32|U32|I64|U64|F64|Bool|class|union|DU8|DU16|DU32|DU64|RAX|RCX|RDX|RBX|RSP|RBP|RSI|RDI|EAX|ECX|EDX|EBX|ESP|EBP|ESI|EDI|AX|CX|DX|BX|SP|BP|SI|DI|SS|CS|DS|ES|FS|GS|CH)\b
    scope: storage.type.c
  - match: \b(asm|const|extern|register|restrict|static|volatile|inline|_extern|_import|IMPORT|public)\b
    scope: storage.modifier.c
  - match: \bk[A-Z]\w*\b
    scope: constant.other.variable.mac-classic.c
  - match: \bg[A-Z]\w*\b
    scope: variable.other.readwrite.global.mac-classic.c
  - match: \bs[A-Z]\w*\b
    scope: variable.other.readwrite.static.mac-classic.c
  - match: \b(NULL|TRUE|FALSE|ON|OFF)\b
    scope: constant.language.c
  - include: repo_sizeof
  - match: "(?x)\\b\n\t\t\t(  (?i:\n\t\t\t      0x ( [0-9A-Fa-f]+ ( ' [0-9A-Fa-f]+ )* )?  # Hexadecimal\n\t\t\t   |  0b ( [0-1]+       ( ' [0-1]+ )* )?        # Binary\n\t\t\t   |  0  ( [0-7]+       ( ' [0-7]+ )* )         # Octal\n\t\t\t   |     ( [0-9]+       ( ' [0-9]+ )* )         # Decimal\n\t\t\t   )\n\t\t\t   ( ([uUfF] | u?ll? | U?LL?)\\b | (?<inc>') | \\b )\n\t\t\t|  ( [0-9]+ ( ' [0-9]+ )* )?\n\t\t\t   (?i:\n\t\t\t      \\. ( [0-9]+ ( ' [0-9]+ )* ) E(\\+|-)? ( [0-9]+ ( ' [0-9]+ )* )\n\t\t\t   |  \\. ( [0-9]+ ( ' [0-9]+ )* )\n\t\t\t   |  E(\\+|-)? ( [0-9]+ ( ' [0-9]+ )* )\n\t\t\t   )\n\t\t\t   ( (?<inc>') | \\b )\n\t\t\t)"
    scope: constant.numeric.c
  - match: '"'
    captures:
      0: punctuation.definition.string.begin.c
    push:
    - meta_scope: string.quoted.double.c
    - match: '"'
      pop: true
      captures:
        0: punctuation.definition.string.end.c
    - include: repo_string_escaped_char
    - include: repo_string_placeholder
  - match: ''''
    captures:
      0: punctuation.definition.string.begin.c
    push:
    - meta_scope: string.quoted.single.c
    - match: ''''
      pop: true
      captures:
        0: punctuation.definition.string.end.c
    - include: repo_string_escaped_char
  - match: "(?x)\n        \t\t^\\s*\\#\\s*(define)\\s+             # define\n        \t\t((?<id>[a-zA-Z_][a-zA-Z0-9_]*))  # macro name\n        \t\t(?:                              # and optionally:\n        \t\t    (\\()                         # an open parenthesis\n        \t\t        (\n        \t\t            \\s* \\g<id> \\s*       # first argument\n        \t\t            ((,) \\s* \\g<id> \\s*)*  # additional arguments\n        \t\t            (?:\\.\\.\\.)?          # varargs ellipsis?\n        \t\t        )\n        \t\t    (\\))                         # a close parenthesis\n        \t\t)?\n        \t"
    captures:
      1: keyword.control.import.define.c
      2: entity.name.function.preprocessor.c
      4: punctuation.definition.parameters.begin.c
      5: variable.parameter.preprocessor.c
      7: punctuation.separator.parameters.c
      8: punctuation.definition.parameters.end.c
    push:
    - meta_scope: meta.preprocessor.macro.c
    - match: (?=(?://|/\*))|$
      pop: true
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.c
    - include: main
  - match: ^\s*#\s*(error|warning|help_index|assert)\b
    captures:
      1: keyword.control.import.error.c
    push:
    - meta_scope: meta.preprocessor.diagnostic.c
    - match: $
      pop: true
      captures:
        1: keyword.control.import.error.c
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.c
  - match: ^\s*#\s*(include|import|exe)\b
    captures:
      1: keyword.control.import.include.c
    push:
    - meta_scope: meta.preprocessor.c.include
    - match: (?=(?://|/\*))|$
      pop: true
      captures:
        1: keyword.control.import.include.c
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.c
    - match: '"'
      captures:
        0: punctuation.definition.string.begin.c
      push:
      - meta_scope: string.quoted.double.include.c
      - match: '"'
        pop: true
        captures:
          0: punctuation.definition.string.end.c
    - match: <
      captures:
        0: punctuation.definition.string.begin.c
      push:
      - meta_scope: string.quoted.other.lt-gt.include.c
      - match: '>'
        pop: true
        captures:
          0: punctuation.definition.string.end.c
  - include: repo_pragma-mark
  - match: ^\s*#\s*(define|defined|elif|else|if|ifdef|ifndef|line|pragma|undef)\b
    captures:
      1: keyword.control.import.c
    push:
    - meta_scope: meta.preprocessor.c
    - match: (?=(?://|/\*))|$
      pop: true
      captures:
        1: keyword.control.import.c
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.c
  - match: \b([a-z0-9_]+_t)\b
    scope: support.type.posix-reserved.c
  - include: repo_block
  - match: "(?x)\n    \t\t(?:  ^                                 # begin-of-line\n    \t\t  |  \n    \t\t     (?: (?= \\s )           (?<!else|new|return) (?<=\\w)      #  or word + space before name\n    \t\t       | (?= \\s*[A-Za-z_] ) (?<!&&)       (?<=[*&>])   #  or type modifier before name\n    \t\t     )\n    \t\t)\n    \t\t(\\s*) (?!(while|for|do|if|else|switch|catch|enumerate|return|sizeof|[cr]?iterate|(?:::)?new|(?:::)?delete)\\s*\\()\n    \t\t(\n    \t\t\t(?: [A-Za-z_][A-Za-z0-9_]*+ | :: )++ |                  # actual name\n    \t\t\t(?: (?<=operator) (?: [-*&<>=+!]+ | \\(\\) | \\[\\] ) )  # if it is a C++ operator\n    \t\t)\n    \t\t \\s*(?=\\()"
    captures:
      1: punctuation.whitespace.function.leading.c
      3: entity.name.function.c
      4: punctuation.definition.parameters.c
    push:
    - meta_scope: meta.function.c
    - match: (?<=\})|(?=#)|(;)
      pop: true
    - include: repo_comments
    - include: repo_parens
    - match: \b(const|final|override|noexcept)\b
    - include: repo_block
  repo_access:
  - match: (\.|\->)(?:\s*(template)\s+)?([a-zA-Z_][a-zA-Z_0-9]*)\b(?!\s*\()
    captures:
      1: punctuation.separator.variable-access.c
      2: storage.modifier.template.c++
      3: variable.other.dot-access.c
  repo_block:
  - match: \{
    captures:
      0: punctuation.section.block.begin.c
    push:
    - meta_scope: meta.block.c
    - match: \}
      pop: true
      captures:
        0: punctuation.section.block.end.c
    - include: repo_block_innards
  repo_block_innards:
  - include: repo_preprocessor-rule-enabled-block
  - include: repo_preprocessor-rule-disabled-block
  - include: repo_preprocessor-rule-other-block
  - include: repo_sizeof
  - include: repo_access
  - include: main
  - include: repo_c_function_call
  - match: "(?x)\n\t\t\t        (?x)\n\t\t\t(?:  \n\t\t\t     (?: (?= \\s )           (?<!else|new|return) (?<=\\w)\\s+      #  or word + space before name\n\t\t\t     )\n\t\t\t)\n\t\t\t(\n\t\t\t\t(?: [A-Za-z_][A-Za-z0-9_]*+ | :: )++    |              # actual name\n\t\t\t\t(?: (?<=operator) (?: [-*&<>=+!]+ | \\(\\) | \\[\\] ) )?  # if it is a C++ operator\n\t\t\t)\n\t\t\t \\s*(\\()"
    scope: meta.initialization.c
    captures:
      1: variable.other.c
      2: punctuation.definition.parameters.c
  - include: repo_block
  - include: main
  repo_c_function_call:
  - match: "(?x) (?: (?= \\s )  (?:(?<=else|new|return) | (?<!\\w)) (\\s+))?\n\t\t\t(\\b \n\t\t\t\t(?!(while|for|do|if|else|switch|catch|enumerate|return|sizeof|[cr]?iterate|(?:::)?new|(?:::)?delete)\\s*\\()(?:(?!NS)[A-Za-z_][A-Za-z0-9_]*+\\b | :: )++                  # actual name\n\t\t\t)\n\t\t\t \\s*(\\()"
    scope: meta.function-call.c
    captures:
      1: punctuation.whitespace.function-call.leading.c
      2: support.function.any-method.c
      3: punctuation.definition.parameters.c
  repo_comments:
  - match: ^/\* =(\s*.*?)\s*= \*/$\n?
    scope: comment.block.c
    captures:
      1: meta.toc-list.banner.block.c
  - match: /\*
    captures:
      0: punctuation.definition.comment.begin.c
    push:
    - meta_scope: comment.block.c
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.end.c
  - match: \*/.*\n
    scope: invalid.illegal.stray-comment-end.c
  - match: ^// =(\s*.*?)\s*=\s*$\n?
    scope: comment.line.banner.c++
    captures:
      1: meta.toc-list.banner.line.c
  - match: (^[ \t]+)?(?=//)
    captures:
      1: punctuation.whitespace.comment.leading.c++
    push:
    - match: (?!)
      pop: true
    - match: //
      captures:
        0: punctuation.definition.comment.c++
      push:
      - meta_scope: comment.line.double-slash.c++
      - match: \n
        pop: true
      - match: (?>\\\s*\n)
        scope: punctuation.separator.continuation.c++
  repo_disabled:
  - match: ^\s*#\s*if(n?def)?\b.*$
    push:
    - match: ^\s*#\s*endif\b
      pop: true
    - include: repo_disabled
    - include: repo_pragma-mark
  repo_parens:
  - match: \(
    captures:
      0: punctuation.section.parens.begin.c
    push:
    - meta_scope: meta.parens.c
    - match: \)
      pop: true
      captures:
        0: punctuation.section.parens.end.c
    - include: main
  repo_pragma-mark:
  - match: ^\s*(#\s*(pragma\s+mark)\s+(.*))
    scope: meta.section
    captures:
      1: meta.preprocessor.c
      2: keyword.control.import.pragma.c
      3: meta.toc-list.pragma-mark.c
  repo_preprocessor-rule-disabled:
  - match: ^\s*(#(if)\s+(0)\b).*
    captures:
      1: meta.preprocessor.c
      2: keyword.control.import.if.c
      3: constant.numeric.preprocessor.c
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.if.c
        3: constant.numeric.preprocessor.c
    - match: ^\s*(#\s*(else)\b)
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.else.c
      push:
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.c
          2: keyword.control.import.else.c
      - include: main
    - include: repo_disabled
    - include: repo_pragma-mark
  repo_preprocessor-rule-disabled-block:
  - match: ^\s*(#(if)\s+(0)\b).*
    captures:
      1: meta.preprocessor.c
      2: keyword.control.import.if.c
      3: constant.numeric.preprocessor.c
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.if.c
        3: constant.numeric.preprocessor.c
    - match: ^\s*(#\s*(else)\b)
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.else.c
      push:
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.c
          2: keyword.control.import.else.c
      - include: repo_block_innards
    - include: repo_disabled
    - include: repo_pragma-mark
  repo_preprocessor-rule-enabled:
  - match: ^\s*(#(if)\s+(0*1)\b)
    captures:
      1: meta.preprocessor.c
      2: keyword.control.import.if.c
      3: constant.numeric.preprocessor.c
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.if.c
        3: constant.numeric.preprocessor.c
    - match: ^\s*(#\s*(else)\b).*
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.else.c
      push:
      - meta_content_scope: comment.block.preprocessor.else-branch
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.c
          2: keyword.control.import.else.c
      - include: repo_disabled
      - include: repo_pragma-mark
    - include: main
  repo_preprocessor-rule-enabled-block:
  - match: ^\s*(#(if)\s+(0*1)\b)
    captures:
      1: meta.preprocessor.c
      2: keyword.control.import.if.c
      3: constant.numeric.preprocessor.c
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.if.c
        3: constant.numeric.preprocessor.c
    - match: ^\s*(#\s*(else)\b).*
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.else.c
      push:
      - meta_content_scope: comment.block.preprocessor.else-branch.in-block
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.c
          2: keyword.control.import.else.c
      - include: repo_disabled
      - include: repo_pragma-mark
    - include: repo_block_innards
  repo_preprocessor-rule-other:
  - match: ^\s*(#\s*(if(n?def)?)\b.*?(?:(?=(?://|/\*))|$))
    captures:
      1: meta.preprocessor.c
      2: keyword.control.import.c
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.c
    - include: main
  repo_preprocessor-rule-other-block:
  - match: ^\s*(#\s*(if(n?def)?)\b.*?(?:(?=(?://|/\*))|$))
    captures:
      1: meta.preprocessor.c
      2: keyword.control.import.c
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.c
        2: keyword.control.import.c
    - include: repo_block_innards
  repo_sizeof:
  - match: \b(sizeof)\b
    scope: keyword.operator.sizeof.c
  repo_string_escaped_char:
  - match: \\(\\|[abefnprtv'"?]|[0-3]\d{0,2}|[4-7]\d?|x[a-fA-F0-9]{0,2}|u[a-fA-F0-9]{0,4}|U[a-fA-F0-9]{0,8})
    scope: constant.character.escape.c
  - match: \\.
    scope: invalid.illegal.unknown-escape.c
  repo_string_placeholder:
  - match: "(?x)%\n    \t\t\t\t\t\t(\\d+\\$)?                             # field (argument #)\n    \t\t\t\t\t\t[#0\\- +']*                           # flags\n    \t\t\t\t\t\t[,;:_]?                              # separator character (AltiVec)\n    \t\t\t\t\t\t((-?\\d+)|\\*(-?\\d+\\$)?)?              # minimum field width\n    \t\t\t\t\t\t(\\.((-?\\d+)|\\*(-?\\d+\\$)?)?)?         # precision\n    \t\t\t\t\t\t(hh|h|ll|l|j|t|z|q|L|vh|vl|v|hv|hl)? # length modifier\n    \t\t\t\t\t\t[diouxXDOUeEfFgGaACcSspn%]           # conversion type\n    \t\t\t\t\t"
    scope: constant.other.placeholder.c
