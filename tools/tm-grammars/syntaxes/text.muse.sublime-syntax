---
# Muse (text.muse): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-emacs-lisp via GitHub Linguist v9.7.0 (license: isc).
name: Muse
scope: text.muse
file_extensions:
- muse
contexts:
  main:
  - match: \A\s*$
    push:
    - meta_scope: meta.blank-lines.muse
    - match: (?=^\s*\S)
      pop: true
  - match: ^(?=#\w+)
    push:
    - meta_scope: meta.prologue.muse
    - match: ^(?=\s*$)
      pop: true
    - include: repo_directives
  - match: ^(?=[^\s#]|\s+\S)
    push:
    - meta_scope: meta.document.muse
    - match: (?=A)B
      pop: true
    - include: repo_main
  repo_alignCentre:
  - match: ^(\s{6,19})(?=\S)
    push:
    - meta_scope: meta.paragraph.align.center.muse
    - match: ^(?!\1|\s*$)
      pop: true
    - include: repo_anchor
    - include: repo_inline
  repo_alignLeft:
  - match: ^\s?(?=\S)
    push:
    - meta_scope: meta.paragraph.align.left.muse
    - match: (?=^>\s|^\s*$|^\s{2,}\S|^\s(?:-|(?:\d+|[a-z]+|[A-Z]+)\.\s))
      pop: true
    - include: repo_anchor
    - include: repo_inline
  repo_alignRight:
  - match: ^(\s{20,})(?=\S)
    push:
    - meta_scope: meta.paragraph.align.right.muse
    - match: ^(?!\1|\s*$)
      pop: true
    - include: repo_anchor
    - include: repo_inline
  repo_anchor:
  - match: (?:|^)\s*((#)[a-zA-Z][-a-zA-Z0-9]*)
    captures:
      1: keyword.control.anchor.muse
      2: punctuation.definition.anchor.muse
  repo_anchorLine:
  - match: ^\s*((#)[a-zA-Z][-a-zA-Z0-9]*)\s*$
    captures:
      1: keyword.control.anchor.muse
      2: punctuation.definition.anchor.muse
  repo_comment:
  - match: ^(;)\s
    captures:
      1: punctuation.definition.comment.begin.muse
    push:
    - meta_scope: comment.line.semicolon.muse
    - match: (?=$)
      pop: true
  repo_directives:
  - match: ^((#)([a-zA-Z]+))
    captures:
      1: variable.assignment.directive.muse
      2: punctuation.definition.directive.muse
    push:
    - match: (?!)(?=^(?:#|\s*$))
      pop: true
    - match: (?<=#pubdate|#date)\s+(\d{4}(?:-\d{2}-\d{2})?)(?=\s|$)
      captures:
        1: constant.other.date.muse
    - include: repo_link
  repo_divider:
  - match: ^\s*(-{4,})\s*$
    captures:
      1: constant.character.horizontal.line.muse
  repo_emphasis:
  - match: (?<=\W|^)(\*{3})(?=\S)
    captures:
      1: punctuation.definition.emphasis.begin.muse
    push:
    - meta_scope: markup.bold.italic.strong.emphasis.muse
    - match: (?<=\S)\1(?!\*+\w)(?=\W|$)|(?=^[ \t]*$)
      pop: true
      captures:
        0: punctuation.definition.emphasis.end.muse
    - include: repo_inlineInnards
  - match: (?<=\W|^)(\*{2})(?=\S)
    captures:
      1: punctuation.definition.emphasis.begin.muse
    push:
    - meta_scope: markup.bold.strong.emphasis.muse
    - match: (?<=\S)\1(?!\*+\w)(?=\W|$)|(?=^[ \t]*$)
      pop: true
      captures:
        0: punctuation.definition.emphasis.end.muse
    - include: repo_inlineInnards
  - match: (?<=\W|^)\*(?=\S)
    captures:
      0: punctuation.definition.emphasis.begin.muse
    push:
    - meta_scope: markup.italic.emphasis.muse
    - match: (?<=\S)\*(?!\*+\w)(?=\W|$)|(?=^[ \t]*$)
      pop: true
      captures:
        0: punctuation.definition.emphasis.end.muse
    - include: repo_inlineInnards
  repo_example:
  - match: '{{{'
    captures:
      0: keyword.operator.example.begin.muse
    push:
    - meta_scope: meta.example.muse
    - meta_content_scope: markup.raw.code.muse
    - match: '}}}'
      pop: true
      captures:
        0: keyword.operator.example.end.muse
  repo_footnote:
  - match: ^(\[\d\]|\{\d\})(\s+)(?=\S)
    captures:
      2: punctuation.whitespace.separator.muse
    push:
    - meta_scope: meta.footnote.muse
    - meta_content_scope: markup.list.footnote.muse
    - match: ^(?!\s{3}\2)(?:\s*$|\s*?(?=\s\S))
      pop: true
    - include: repo_inline
  - match: ^(\[\d{2}\]|\{\d{2}\})(\s+)(?=\S)
    captures:
      2: punctuation.whitespace.separator.muse
    push:
    - meta_scope: meta.footnote.muse
    - meta_content_scope: markup.list.footnote.muse
    - match: ^(?!\s{4}\2)(?:\s*$|\s*?(?=\s\S))
      pop: true
    - include: repo_inline
  - match: ^(\[\d{3}\]|\{\d{3}\})(\s+)(?=\S)
    captures:
      2: punctuation.whitespace.separator.muse
    push:
    - meta_scope: meta.footnote.muse
    - meta_content_scope: markup.list.footnote.muse
    - match: ^(?!\s{5}\2)(?:\s*$|\s*?(?=\s\S))
      pop: true
    - include: repo_inline
  repo_footnoteReference:
  - match: (\[)(\d+)(\])
    captures:
      1: punctuation.definition.footnote.begin.muse
      3: punctuation.definition.footnote.end.muse
  - match: (\{)(\d+)(\})
    captures:
      1: punctuation.definition.footnote.begin.muse
      3: punctuation.definition.footnote.end.muse
  repo_heading:
  - match: ^(\*{1,5})( )(.*)
    captures:
      1: keyword.operator.heading.bullet.muse
      2: punctuation.whitespace.separator.muse
      3: markup.heading.muse
  repo_inline:
  - include: repo_tags
  - include: repo_example
  - include: repo_emphasis
  - include: repo_literal
  - include: repo_link
  - include: repo_footnoteReference
  - include: repo_nbsp
  - include: repo_underline
  repo_inlineInnards:
  - match: (?:(?=|^)|(?<=[\w*]))\*+(?=\w)
  - include: repo_inline
  repo_link:
  - match: (\[)(?=\[.*?\]\])
    captures:
      1: punctuation.definition.link.begin.muse
    push:
    - meta_scope: meta.link.muse
    - match: \]
      pop: true
      captures:
        0: punctuation.definition.link.end.muse
    - match: (\[)
      captures:
        1: punctuation.definition.link.target.begin.muse
      push:
      - meta_scope: meta.link.target.muse
      - match: \]
        pop: true
        captures:
          0: punctuation.definition.link.target.end.muse
      - match: \s*([^\s\]]+)
        captures:
          1: constant.other.reference.link.muse
      - match: (?<=\s)(?:([\d.]+)([rlf])?|([rlf]))
        captures:
          1: constant.numeric.width.muse
          2: storage.modifier.align.muse
          3: storage.modifier.align.muse
    - match: (?<=\])(\[)
      captures:
        1: punctuation.definition.link.label.begin.muse
      push:
      - meta_scope: meta.link.label.muse
      - meta_content_scope: entity.name.link.label.muse
      - match: \]
        pop: true
        captures:
          0: punctuation.definition.link.label.end.muse
      - include: repo_inline
  repo_list:
  - match: ^(\s+)(?=-|(?:\d+|[a-z]+|[A-Z]+)\.)
    captures:
      1: punctuation.whitespace.leading.muse
    push:
    - meta_scope: markup.list.muse
    - match: (?=^(?!\1)(?!\s*$))|(?=^\S)
      pop: true
    - match: (?<=\S)\s*$\s*
      push:
      - match: (?=^\s*$|^(?=\S))
        pop: true
      - include: repo_listInnards
    - include: repo_listInnards
  repo_listInnards:
  - include: repo_listMarker
  - include: repo_term
  - include: repo_inline
  repo_listMarker:
  - match: (?:|^\s+)(-)\s
    captures:
      1: keyword.operator.list.unnumbered.marker.muse
  - match: (?:|^\s+)((?:\d+|[a-z]+|[A-Z]+)\.)\s
    captures:
      1: keyword.operator.list.numbered.marker.muse
  repo_literal:
  - match: (?<=\W|^)=(?=\S)
    captures:
      0: punctuation.definition.literal.begin.muse
    push:
    - meta_scope: markup.raw.literal.muse
    - match: (?!)(?<=\S)=(?=\W|$)|(?=^[ \t]*$)
      pop: true
      captures:
        0: punctuation.definition.literal.end.muse
  repo_main:
  - include: repo_comment
  - include: repo_heading
  - include: repo_pageBreak
  - include: repo_divider
  - include: repo_anchorLine
  - include: repo_term
  - include: repo_list
  - include: repo_verse
  - include: repo_table
  - include: repo_quote
  - include: repo_footnote
  - include: repo_inline
  - include: repo_alignCentre
  - include: repo_alignRight
  - include: repo_alignLeft
  repo_nbsp:
  - match: ~~
    scope: constant.character.non-breaking-space.muse
  repo_pageBreak:
  - match: ^(\s{5})((?:\s+\*){5})
    captures:
      1: punctuation.whitespace.separator.muse
      2: meta.separator.page-break.muse
  repo_quote:
  - match: ^(\s{2,5})(?=\S)
    push:
    - meta_scope: markup.quote.paragraph.muse
    - match: ^(?!\1|\s*$)
      pop: true
    - include: repo_anchor
    - include: repo_inline
  repo_table:
  - match: ^(?=\s+(?:\|\+.*?\+\||\S.*?\s\|{1,3}\s+\S))
    push:
    - meta_scope: markup.table.muse
    - match: (?=\s*$)
      pop: true
    - match: ^\s+(\|\+)(.*)(\+\|)
      scope: markup.table.caption.muse
      captures:
        1: keyword.operator.caption.begin.muse
        2: constant.other.caption.muse
        3: keyword.operator.caption.end.muse
    - match: ^\s+(\S.*?\s\|\|\|\s.*)\s*$
      scope: markup.table.footer.muse
    - match: ^\s+(\S.*?\s\|\|\s.*)\s*$
      scope: markup.table.header.muse
    - match: ^\s+(\S.*?\s\|\s.*)\s*$
      scope: markup.table.body.muse
  repo_tags:
  - match: (<)br(>)
    scope: meta.tag.br.muse
    captures:
      0: entity.name.tag.br.muse
      1: punctuation.definition.tag.begin.muse
      3: punctuation.definition.tag.end.muse
  - match: (<)(center|right)(>)
    captures:
      1: punctuation.definition.tag.begin.muse
      3: punctuation.definition.tag.end.muse
    push:
    - match: (</)\2(>)
      pop: true
      captures:
        1: punctuation.definition.tag.begin.muse
        3: punctuation.definition.tag.end.muse
    - include: repo_inline
  - match: (<)(code|example|verbatim)(>)
    captures:
      1: punctuation.definition.tag.begin.muse
      3: punctuation.definition.tag.end.muse
    push:
    - meta_content_scope: markup.raw.code.muse
    - match: (</)\2(>)
      pop: true
      captures:
        1: punctuation.definition.tag.begin.muse
        3: punctuation.definition.tag.end.muse
  - match: (<)comment(>)
    captures:
