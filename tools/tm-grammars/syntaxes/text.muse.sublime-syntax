      1: punctuation.definition.tag.begin.muse
      2: punctuation.definition.tag.end.muse
    push:
    - meta_scope: meta.tag.em.muse
    - meta_content_scope: markup.italic.emphasis.muse
    - match: (</)em(>)
      pop: true
      captures:
        0: entity.name.tag.em.muse
        1: punctuation.definition.tag.begin.muse
        2: punctuation.definition.tag.end.muse
