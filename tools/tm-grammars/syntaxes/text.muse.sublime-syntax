      1: punctuation.definition.tag.begin.muse
      2: punctuation.definition.tag.end.muse
    push:
    - meta_scope: meta.tag.comment-block.muse
    - meta_content_scope: comment.block.muse
    - match: (</)comment(>)
      pop: true
      captures:
        0: entity.name.tag.comments.muse
        1: punctuation.definition.tag.begin.muse
        2: punctuation.definition.tag.end.muse
