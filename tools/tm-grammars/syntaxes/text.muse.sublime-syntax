    captures:
      1: entity.name.tag.quote.muse
      2: punctuation.definition.tag.begin.muse
      3: punctuation.definition.tag.end.muse
    push:
    - meta_scope: meta.tag.quote.muse
    - meta_content_scope: markup.quote.block.muse
    - match: (</)quote(>)
