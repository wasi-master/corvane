%YAML 1.2
---
# Cirru (source.cirru): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Cirru/sublime-cirru via GitHub Linguist v9.7.0 (license: mit).
name: Cirru
scope: source.cirru
file_extensions:
- cirru
contexts:
  main:
  - match: '"'
    push:
    - meta_scope: string.quoted.double.cirru
    - match: '"'
      pop: true
    - match: \\.
      scope: constant.character.escape.cirru
  - match: -?\b\d\S*\b
    scope: constant.numeric.cirru
  - match: (?=^)\s*\,
    scope: keyword.operator.cirru
  - match: \s\$\s*$
    scope: keyword.operator.cirru
  - match: (?=^)\s*[^\(\)\s][^\(\)\s]*
    scope: support.function.cirru
  - match: (?<=\()[^\(\)\s][^\(\)\s]*
    scope: support.function.cirru
  - match: (?=\$\s+)[^\(\)\s][^\(\)\s]*
    scope: support.function.cirru
  - match: \s+((\$\s+)+)([^\(\)\s][^\(\)\s]*)
    scope: entity.cirru
    captures:
      1: keyword.operator.cirru
      3: support.function.cirru
  - match: '[\)\(]'
    scope: keyword.operator.cirru
  - match: (?!=($\s+))[^\(\)\s][^\(\)\s]*
    scope: variable.parameter.cirru
