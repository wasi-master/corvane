%YAML 1.2
---
# Visual Basic 6 (source.vb6): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/serkonda7/vscode-vba.git via GitHub Linguist v9.7.0 (license: mpl-2.0).
name: Visual Basic 6
scope: source.vb6
hidden: true
contexts:
  main:
  - include: repo_module_metadata
  - include: repo_comments
  - include: repo_functions
  - include: repo_keywords
  - include: repo_numbers
  - include: repo_storage
  - include: repo_strings
  - include: repo_types
  - match: _(?=\s*\n)
    scope: constant.other.vb6
  repo_comments:
  - match: (?=')|(?:^(?:(\d*)\s*|[a-zA-Z][a-zA-Z0-9]{0,254}:\s*)|:\s*)(?=(?i:Rem ))
    captures:
      1: constant.numeric.decimal
    push:
    - match: (?<!\s_)$\n
      pop: true
    - match: \'.*
      scope: comment.line.quote
    - match: Rem .*
      scope: comment.line.rem
    - match: ^.*
      scope: comment.line.continuation
  repo_functions:
  - match: (?i:\b(Call|Function|Sub) )
    captures:
      1: keyword.other.vb6
    push:
    - match: \(|(?=\n)
      pop: true
    - match: (?i:\b([a-zA-Z][a-zA-Z0-9_]*)\b)
      scope: entity.name.function.vb6
  repo_keywords:
  - match: (?i:\b(Do( While| Until)?|While|Case( Else)?|Else(If)?|For( Each)?|(I)?If|In|New|(Select )?Case|Then|To|Step|With)\b)
    scope: keyword.conditional.vb6
  - match: (?i:\b(End( )?If|End (Select|With)|Next|Wend|Loop( While| Until)?|Exit (For|Do|While))\b)
    scope: keyword.conditional.end.vb6
  - match: (?i:\b(Exit (Function|Property|Sub)|As|And|By(Ref|Val)|Goto|Is|Like|Mod|Not|On Error|Optional|Or|Resume Next|Stop|Xor|Eqv|Imp|TypeOf|AddressOf)\b|(\b(End)\b(?=\n)))
    scope: keyword.control.vb6
  - match: (?i:\b(Open|Close|Line Input|Lock|Unlock|Print|Seek|Get|Put|Write)\b)
    scope: keyword.io.vb6
  - match: (?i:\b(Input)(?= \#))
    scope: keyword.io.vb6
  - match: (?i:\b(Attribute|Call|End (Function|Property|Sub|Type|Enum)|(Const|Function|Property|Sub|Type|Enum)|Declare|WithEvents|Event|RaiseEvent|Implements)\b)
    scope: keyword.other.vb6
  - match: (?i)\bOption (Base [01]|Compare (Binary|Text)|Explicit)\b
    scope: keyword.other.option.vb6
  - match: (?i)\b(DefBool|DefByte|DefInt|DefLng|DefLngLng|DefLngPtr|DefCur|DefSng|DefDbl|DefDec|DefDate|DefStr|DefObj|DefVar)\b
    scope: keyword.other.deftype.vb6
  - match: (?i:\b(Private|Public|Global|Friend)\b)
    scope: keyword.other.visibility.vb6
  - match: (?i)\b(Empty|False|Nothing|Null|True)\b
    scope: constant.language.vb6
  repo_module_metadata:
  - include: repo_comments
  repo_numbers:
  - match: (?i)\#((Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)|[0-9]{1,2})(-|\/)[0-9]{1,2}((-|\/)[0-9]{1,4})?\#
    scope: constant.numeric.date
  - match: (?<!\w)-?\d+(\.\d+)?
    scope: constant.numeric.decimal
  - match: (?i)-?&O[0-7]+
    scope: constant.numeric.octal
  - match: (?i)-?&H[0-9A-F]+
    scope: constant.numeric.hexadecimal
  repo_storage:
  - match: (?i)\b(Class|Const|Dim|(G|L|S)et|ReDim( Preserve)?|Erase|Static)\b
    scope: storage.modifier.vb6
  repo_strings:
  - match: \"[^\n\r\"]*"
    scope: string.quoted.double
  repo_types:
  - match: (?i)\b(Any|Byte|Boolean|Currency|Collection|Date|Double|Integer|Long|Object|Single|String|Variant)\b
    scope: support.type.builtin.vb6
  - match: (?i)(?<= As )([a-zA-Z][a-zA-Z0-9_]*)
    captures:
      1: support.type
