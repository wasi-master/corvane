    - include: repo_concise-style-line-scss
  - match: ^(\s*)(?=(?:html-)?style\b[^\s]*\.[tj]s\b)
    push:
    - match: ^(?!(?=^(?:\s*[})\]`]|\*/|\s*$|\1\s+(\S|$))))
