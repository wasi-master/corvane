    - include: repo_concise-open-tag-content
    - include: repo_concise-script-block
    - include: repo_concise-script-line
  - match: ^(\s*)(?=(?:html-)?style\b)
    push:
    - match: ^(?!(?=^(?:\s*[})\]`]|\*/|\s*$|\1\s+(\S|$))))
      pop: true
    - include: repo_concise-open-tag-content
    - include: repo_concise-style-block
    - include: repo_concise-style-line
  - match: ^(\s*)(?=(?:html-)?script\b)
    push:
    - match: ^(?!(?=^(?:\s*[})\]`]|\*/|\s*$|\1\s+(\S|$))))
      pop: true
    - include: repo_concise-open-tag-content
    - include: repo_concise-script-block
    - include: repo_concise-script-line
  - match: ^([ \t]*)(?=[a-zA-Z0-9_$@.#])
    push:
    - match: ^(?!(?=^(?:\s*[})\]`]|\*/|\s*$|\1\s+(\S|$))))
      pop: true
    - include: repo_concise-open-tag-content
    - include: repo_content-concise-mode
  repo_content-embedded-comment:
  - include: repo_placeholder
  - match: .
    scope: comment.block.marko
  repo_content-embedded-script:
  - include: repo_placeholder
  - include: scope:source.ts
  repo_content-embedded-style:
  - include: repo_placeholder
  - include: scope:source.css
  repo_content-embedded-style-less:
  - include: repo_placeholder
  - include: scope:source.css.less
  repo_content-embedded-style-scss:
  - include: repo_placeholder
  - include: scope:source.css.scss
  repo_content-html-mode:
  - include: repo_scriptlet
  - include: repo_cdata
  - include: repo_doctype
  - include: repo_declaration
  - include: repo_javascript-comments-after-whitespace
  - include: repo_html-comment
  - include: repo_invalid-close-tag
  - include: repo_tag-html
  - match: \\.
    scope: text.marko
  - include: repo_placeholder
  - match: .+?
    scope: text.marko
  repo_declaration:
  - match: (<\?)\s*([a-zA-Z0-9_$-]*)
    captures:
      1: punctuation.definition.tag.marko
      2: entity.name.tag.marko
    push:
    - meta_scope: meta.tag.metadata.processing.xml.marko
    - match: (\??>)
      pop: true
      captures:
        1: punctuation.definition.tag.marko
        2: entity.name.tag.marko
    - match: ((?:[^\s=?>]+|\?(?!>))+)(=)(?:("(?:[^"\\]+|\\.)*")|('(?:[^'\\]+|\\.)*')|((?:[^\s?>]+|\?(?!>))+))
      captures:
        1: entity.other.attribute-name.marko
        2: punctuation.separator.key-value.html
        3: string.quoted.double.marko
        4: string.quoted.single.marko
        5: string.unquoted.marko
  repo_doctype:
  - match: \s*<!(?=(?i:DOCTYPE\s))
    captures:
      0: punctuation.definition.tag.begin.marko
    push:
    - meta_scope: meta.tag.metadata.doctype.marko
    - match: '>'
      pop: true
      captures:
        0: punctuation.definition.tag.end.marko
    - match: (?i:DOCTYPE)
      scope: entity.name.tag.marko
    - match: '"'
      push:
      - meta_scope: string.quoted.double.marko
      - match: '"'
        pop: true
    - match: '[^\s>]+'
      scope: entity.other.attribute-name.marko
  repo_html-args-or-method:
  - include: repo_tag-type-params
  - match: \s*(?=\()
    push:
    - meta_scope: meta.embedded.ts
    - meta_content_scope: source.ts
    - match: (?<=\))
      pop: true
    - include: scope:source.ts
  - match: (?<=\))\s*(?={)
    push:
    - meta_scope: meta.embedded.ts
    - meta_content_scope: source.ts
    - match: (?<=})
      pop: true
    - include: scope:source.ts
  repo_html-comment:
  - match: \s*(<!(--)?)
    captures:
      1: punctuation.definition.comment.marko
    push:
    - meta_scope: comment.block.marko
    - match: \2>
      pop: true
      captures:
        0: punctuation.definition.comment.marko
  repo_invalid:
  - match: \S
    scope: invalid.illegal.character-not-allowed-here.marko
  repo_invalid-close-tag:
  - match: \s*</[^>]*
    push:
    - meta_scope: invalid.illegal.character-not-allowed-here.marko
    - match: '>'
      pop: true
  repo_javascript-comments:
  - match: \s*(?=/\*)
    push:
    - meta_content_scope: source.ts
    - match: (?<=\*/)
