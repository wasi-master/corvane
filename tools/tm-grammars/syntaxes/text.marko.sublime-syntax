      2: storage.modifier.marko.css
      3: punctuation.section.scope.begin.marko.css
    push:
    - meta_scope: meta.embedded.scss
    - meta_content_scope: source.scss
    - match: '}'
      pop: true
      captures:
        0: punctuation.section.scope.end.marko.css
    - include: scope:source.css.scss
  - match: ^\s*(style)(\b[^\s]*\.[tj]s)\s+({)
    captures:
      1: support.type.builtin.marko
      2: storage.modifier.marko.css
      3: punctuation.section.scope.begin.marko.css
    push:
    - meta_scope: meta.embedded.ts
    - meta_content_scope: source.ts
    - match: '}'
      pop: true
      captures:
        0: punctuation.section.scope.end.marko.css
    - include: scope:source.ts
  - match: ^\s*(?:((?:static|server|client)\b)|(?=(?:class|import|export)\b))
    captures:
      1: keyword.control.static.marko
    push:
    - meta_scope: meta.embedded.ts
    - meta_content_scope: source.ts
    - match: (?=\n|$)
      pop: true
    - include: scope:source.ts
  - include: repo_content-concise-mode
  repo_attr-value:
  - match: \s*(:?=)\s*
    push:
    - meta_scope: meta.embedded.ts
    - meta_content_scope: source.ts
    - match: (?=[,;\]]|/>|(?<=[^=>])>|(?<!^|[!~*%&^|?:]|[!~*%&^|?/<>+=-]=|[=>]>|[^.]\.|[^-]-|[^+]\+|[a-zA-Z0-9%).<\]}]\s/|[^.$\w]await|[^.$\w]async|[^.$\w]class|[^.$\w]function|[^.$\w]keyof|[^.$\w]new|[^.$\w]readonly|[^.$\w]infer|[^.$\w]typeof|[^.$\w]void)\s+(?![\n{(+!~*%&^|?:]|[<>/=-]=|[=>]>|\.[^.]|-[^-]|/[^>]|(?:in|instanceof|satisfies|as|extends)\s+[^:=/,;>]))
      pop: true
    - include: repo_javascript-expression
  repo_attrs:
  - include: repo_javascript-comments
  - match: (?:(key|on[a-zA-Z0-9_$-]+|[a-zA-Z0-9_$]+Change|no-update(?:-body)?(?:-if)?)|([a-zA-Z0-9_$][a-zA-Z0-9_$-]*)|(#[a-zA-Z0-9_$][a-zA-Z0-9_$-]*))(:[a-zA-Z0-9_$][a-zA-Z0-9_$-]*)?
    captures:
      1: support.type.attribute-name.marko
      2: entity.other.attribute-name.marko
      3: support.function.attribute-name.marko
      4: support.function.attribute-name.marko
    push:
    - meta_scope: meta.marko-attribute
    - include: repo_html-args-or-method
    - include: repo_attr-value
    - match: (?=.|$)
      pop: true
  - match: (\.\.\.)
    captures:
      1: keyword.operator.spread.marko
    push:
    - meta_scope: meta.marko-spread-attribute
    - meta_content_scope: source.ts
    - match: (?=[,;\]]|/>|(?<=[^=>])>|(?<!^|[!~*%&^|?:]|[!~*%&^|?/<>+=-]=|[=>]>|[^.]\.|[^-]-|[^+]\+|[a-zA-Z0-9%).<\]}]\s/|[^.$\w]await|[^.$\w]async|[^.$\w]class|[^.$\w]function|[^.$\w]keyof|[^.$\w]new|[^.$\w]readonly|[^.$\w]infer|[^.$\w]typeof|[^.$\w]void)\s+(?![\n{(+!~*%&^|?:]|[<>/=-]=|[=>]>|\.[^.]|-[^-]|/[^>]|(?:in|instanceof|satisfies|as|extends)\s+[^:=/,;>]))
      pop: true
    - include: repo_javascript-expression
  - match: \s*(,(?!,))
    captures:
      1: punctuation.separator.comma.marko
    push:
    - match: (?=\S)
      pop: true
      captures:
        1: punctuation.separator.comma.marko
  - include: repo_invalid
  repo_cdata:
  - match: \s*<!\[CDATA\[
    captures:
      0: punctuation.definition.tag.begin.marko
    push:
    - meta_scope: meta.tag.metadata.cdata.marko
    - meta_content_scope: string.other.inline-data.marko
    - match: ']]>'
      pop: true
      captures:
        0: punctuation.definition.tag.end.marko
  repo_concise-attr-group:
  - match: \s*(\[)
    captures:
      1: punctuation.section.scope.begin.marko
    push:
    - match: ']'
      pop: true
      captures:
        0: punctuation.section.scope.end.marko
    - include: repo_concise-attr-group
    - match: \s+
      push:
      - match: (?=\S)
        pop: true
    - include: repo_attrs
    - include: repo_invalid
  repo_concise-comment-block:
  - match: \s*(--+)\s*$
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-comment-block
    - match: \1
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
    - include: repo_content-embedded-comment
  repo_concise-comment-line:
  - match: \s*(--+)
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-comment-line
    - include: repo_content-embedded-comment
    - match: $
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
  repo_concise-html-block:
  - match: \s*(--+)\s*$
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-html-block
    - match: \1
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
    - include: repo_content-html-mode
  repo_concise-html-line:
  - match: \s*(--+)(?=\s+\S)(.*)($)
    scope: meta.section.marko-html-line
    captures:
      1: punctuation.section.embedded.scope.begin.marko
      3: punctuation.section.embedded.scope.end.marko
  repo_concise-open-tag-content:
  - include: repo_invalid-close-tag
  - include: repo_tag-before-attrs
  - include: repo_concise-semi-eol
  - match: (?!^)[, \t]
    push:
    - match: (?=--)|(?=\n)
      pop: true
    - include: repo_concise-semi-eol
    - include: repo_concise-attr-group
    - match: '[ \t]+'
      push:
      - match: (?=\S|\n)
        pop: true
    - include: repo_attrs
    - include: repo_invalid
  repo_concise-script-block:
  - match: \s*(--+)\s*$
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-script-block
    - match: \1
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
    - include: repo_content-embedded-script
  repo_concise-script-line:
  - match: \s*(--+)
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-script-line
    - include: repo_content-embedded-script
    - match: $
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
  repo_concise-semi-eol:
  - match: \s*(;)
    captures:
      1: punctuation.terminator.marko
    push:
    - match: $
      pop: true
    - include: repo_javascript-comments
    - include: repo_html-comment
    - include: repo_invalid
  repo_concise-style-block:
  - match: \s*(--+)\s*$
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-style-block
    - meta_content_scope: source.css
    - match: \1
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
    - include: repo_content-embedded-style
  repo_concise-style-block-less:
  - match: \s*(--+)\s*$
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-style-block
    - meta_content_scope: source.less
    - match: \1
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
    - include: repo_content-embedded-style-less
  repo_concise-style-block-scss:
  - match: \s*(--+)\s*$
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-style-block
    - meta_content_scope: source.scss
    - match: \1
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
    - include: repo_content-embedded-style-scss
  repo_concise-style-line:
  - match: \s*(--+)
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-style-line
    - meta_content_scope: source.css
    - include: repo_content-embedded-style
    - match: $
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
  repo_concise-style-line-less:
  - match: \s*(--+)
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-style-line
    - meta_content_scope: source.less
    - include: repo_content-embedded-style-less
    - match: $
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
  repo_concise-style-line-scss:
  - match: \s*(--+)
    captures:
      1: punctuation.section.embedded.scope.begin.marko
    push:
    - meta_scope: meta.section.marko-style-line
    - meta_content_scope: source.scss
    - include: repo_content-embedded-style-scss
    - match: $
      pop: true
      captures:
        0: punctuation.section.embedded.scope.end.marko
  repo_content-concise-mode:
  - include: repo_scriptlet
  - include: repo_javascript-comments
  - include: repo_cdata
  - include: repo_doctype
  - include: repo_declaration
  - include: repo_html-comment
  - include: repo_concise-html-block
  - include: repo_concise-html-line
  - include: repo_invalid-close-tag
  - include: repo_tag-html
  - match: ^(\s*)(?=html-comment\b)
    push:
    - match: ^(?!(?=^(?:\s*[})\]`]|\*/|\s*$|\1\s+(\S|$))))
      pop: true
    - include: repo_concise-open-tag-content
    - include: repo_concise-comment-block
    - include: repo_concise-comment-line
  - match: ^(\s*)(?=(?:html-)?style\b[^\s]*\.less\b)
    push:
    - match: ^(?!(?=^(?:\s*[})\]`]|\*/|\s*$|\1\s+(\S|$))))
      pop: true
    - include: repo_concise-open-tag-content
    - include: repo_concise-style-block-less
    - include: repo_concise-style-line-less
  - match: ^(\s*)(?=(?:html-)?style\b[^\s]*\.scss\b)
    push:
    - match: ^(?!(?=^(?:\s*[})\]`]|\*/|\s*$|\1\s+(\S|$))))
      pop: true
    - include: repo_concise-open-tag-content
