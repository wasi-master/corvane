  - match: (?:\s*\b(?:as|await|extends|in|instanceof|satisfies|keyof|new|typeof|void))+\s+(?![:=/,;>])[a-zA-Z0-9_$@#]*
  - match: (?<![a-zA-Z0-9%).<\]}])\s*/(?:[^\\\[/]+|\\.|\[(?:[^\\\]]+|\\.)*\])*/[a-zA-Z]*
    captures:
      0: string.regexp.ts
  - include: scope:source.ts
  repo_javascript-placeholder:
  - match: \${
    captures:
      0: punctuation.definition.template-expression.begin.ts
    push:
    - meta_content_scope: source.ts
    - match: '}'
      pop: true
      captures:
        0: punctuation.definition.template-expression.end.ts
    - include: scope:source.ts
  repo_open-tag-content:
  - include: repo_invalid-close-tag
  - include: repo_tag-before-attrs
  - match: (?!/?>)
    push:
    - match: (?=/?>)
      pop: true
    - include: repo_attrs
  repo_placeholder:
  - match: \$!?{
    captures:
      0: punctuation.definition.template-expression.begin.ts
    push:
    - meta_content_scope: source.ts
    - match: '}'
      pop: true
      captures:
        0: punctuation.definition.template-expression.end.ts
    - include: scope:source.ts
  repo_scriptlet:
  - match: ^\s*(\$)\s+
    captures:
      1: keyword.control.scriptlet.marko
    push:
    - meta_scope: meta.embedded.ts
    - meta_content_scope: source.ts
    - match: $
      pop: true
    - include: scope:source.ts
  repo_tag-before-attrs:
  - include: repo_tag-name
  - include: repo_tag-shorthand-class-or-id
  - match: /(?![/*])
    captures:
      0: punctuation.separator.tag-variable.marko
    push:
    - meta_scope: meta.embedded.ts
    - meta_content_scope: source.ts
    - match: (?=[,;(|/><]|:?=|\s+[^:]|$)
      pop: true
    - match: '[a-zA-Z$_][0-9a-zA-Z$_]*'
      scope: variable.other.constant.object.ts
    - match: '{'
      captures:
        0: punctuation.definition.binding-pattern.object.ts
      push:
      - match: '}'
        pop: true
        captures:
          0: punctuation.definition.binding-pattern.object.ts
      - include: scope:source.ts
      - include: repo_javascript-expression
    - match: \[
      captures:
        0: punctuation.definition.binding-pattern.array.ts
      push:
      - match: ']'
        pop: true
        captures:
          0: punctuation.definition.binding-pattern.array.ts
      - include: scope:source.ts
      - include: repo_javascript-expression
    - match: \s*(:)(?!=)
      captures:
        1: keyword.operator.type.annotation.ts
      push:
      - match: (?=[,;\](]|/>|(?<=[^=>])>|(?<!^|[!~*%&^|?:]|[!~*%&^|?/<>+=-]=|[=>]>|[^.]\.|[^-]-|[^+]\+|[a-zA-Z0-9%).<\]}]\s/|[^.$\w]await|[^.$\w]async|[^.$\w]class|[^.$\w]function|[^.$\w]keyof|[^.$\w]new|[^.$\w]readonly|[^.$\w]infer|[^.$\w]typeof|[^.$\w]void)\s+(?![\n{+!~*%&^|?:]|[<>/=-]=|[=>]>|\.[^.]|-[^-]|/[^>]|(?:in|instanceof|satisfies|as|extends)\s+[^:=/,;>]))
        pop: true
      - include: scope:source.ts
      - include: repo_javascript-expression
    - include: repo_javascript-expression
  - match: \s*\|
    captures:
      0: punctuation.section.scope.begin.marko
    push:
    - meta_content_scope: source.ts
    - match: \|
      pop: true
      captures:
        0: punctuation.section.scope.end.marko
    - include: scope:source.ts
    - include: scope:source.ts
    - include: scope:source.ts
    - include: scope:source.ts
    - include: scope:source.ts
    - match: (:)
      captures:
        1: keyword.operator.type.annotation.ts
      push:
      - meta_scope: meta.type.annotation.ts
      - match: (?=[,|])|(?==[^>])
        pop: true
      - include: scope:source.ts
    - include: scope:source.ts
    - match: ','
      scope: punctuation.separator.parameter.ts
    - include: scope:source.ts
  - include: repo_html-args-or-method
  - include: repo_attr-value
  repo_tag-html:
  - match: \s*(<)(?=(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr|const|debug|id|let|lifecycle|log|return)\b)
    captures:
      1: punctuation.definition.tag.begin.marko
    push:
    - match: /?>
      pop: true
      captures:
        0: punctuation.definition.tag.end.marko
    - include: repo_open-tag-content
  - match: \s*(<)(?=html-comment\b)
    captures:
      1: punctuation.definition.tag.begin.marko
    push:
    - match: />|(?<=</>|</html-comment>)
      pop: true
      captures:
        0: punctuation.definition.tag.end.marko
    - include: repo_open-tag-content
    - match: '>'
      captures:
        0: punctuation.definition.tag.end.marko
      push:
      - match: \s*(?:</>|</html-comment>)
        pop: true
        captures:
          1: punctuation.definition.tag.begin.marko
          3: punctuation.definition.tag.end.marko
      - include: repo_content-embedded-comment
  - match: \s*(<)(?=((?:html-)?style)\b[^\s]*\.less\b)
    captures:
      1: punctuation.definition.tag.begin.marko
    push:
    - match: />|(?<=</>)|(?<=</\2>)
      pop: true
      captures:
        0: punctuation.definition.tag.end.marko
    - include: repo_open-tag-content
