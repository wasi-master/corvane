file_extensions:
- xmake.lua
contexts:
  main:
  - match: \b(?:(local)\s+)?(function)\b(?![,:])
    captures:
      1: keyword.local.lua
      2: keyword.control.lua
    push:
    - meta_scope: meta.function.lua
    - match: (?<=[\)\-{}\[\]"'])
      pop: true
    - include: repo_comment
    - match: (\()
      captures:
        1: punctuation.definition.parameters.begin.lua
      push:
      - meta_scope: meta.parameter.lua
      - match: (\))|(?=[\-\.{}\[\]"'])
