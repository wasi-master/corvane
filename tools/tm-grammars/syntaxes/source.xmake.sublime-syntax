      1: keyword.control.goto.lua
      2: string.tag.lua
  - match: (::)\s*[a-zA-Z_][a-zA-Z0-9_]*\s*(::)
    scope: string.tag.lua
    captures:
      1: punctuation.section.embedded.begin.lua
      2: punctuation.section.embedded.end.lua
  - match: <\s*(const|close)\s*>
    captures:
      0: storage.type.attribute.lua
  - match: \<[a-zA-Z_\*][a-zA-Z0-9_\.\*\-]*\>
    scope: storage.type.generic.lua
  - match: \b(break|do|else|for|if|elseif|goto|return|then|repeat|while|until|end|in)\b
    scope: keyword.control.lua
  - match: \b(local)\b
