%YAML 1.2
---
# DM (source.dm): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/spacestation13/dm-syntax.git via GitHub Linguist v9.7.0 (license: mit).
name: DM
scope: source.dm
file_extensions:
- dm
contexts:
  main:
  - include: repo_preprocessor-rule-enabled
  - include: repo_preprocessor-rule-disabled
  - include: repo_preprocessor-rule-other
  - include: repo_comments
  - match: \b(var)[\/ ](?:(static|global|tmp|const)\/)?(?:(area|atom(?:/movable)?|client|database(?:/query)?|datum|exception|generator|icon|image|list|matrix|mob|mutable_appearance|obj|particles|regex|savefile|sound|turf|world)\/)?(?:([a-zA-Z0-9_\-$]*)\/)*([A-Za-z0-9_$]*)\b
    scope: meta.initialization.dm
    captures:
      1: storage.type.dm
      2: storage.modifier.dm
      3: support.class.dm
      5: variable.other.dm
  - match: \b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\.?[0-9]*)|(\.[0-9]+))((e|E)(\+|-)?[0-9]+)?)\b
    scope: constant.numeric.dm
  - match: \b(sleep|spawn|break|continue|do|else|for|goto|if|return|switch|while|try|catch|throw)\b
    scope: keyword.control.dm
  - match: \b(del|new)\b
    scope: keyword.other.dm
  - match: \b(proc|verb|operator)\b
    scope: storage.type.dm
  - match: \b(as|const|global|set|static|tmp)\b
    scope: storage.modifier.dm
  - match: (/)(area|atom(/movable)?|client|database(/query)?|datum|exception|generator|icon|image|list|matrix|mob|mutable_appearance|obj|particles|regex|savefile|sound|turf|world)\b
    captures:
      1: keyword.operator.dm
      2: support.class.dm
  - match: (\(|,)\s*(area|atom(/movable)?|client|database(/query)?|datum|exception|generator|icon|image|list|matrix|mob|mutable_appearance|obj|particles|regex|savefile|sound|turf|world)(?=/)
    captures:
      1: keyword.operator.dm
      2: support.class.dm
  - match: \b(list|call|input|locate|pick|arglist|CRASH|ASSERT|EXCEPTION|REGEX_QUOTE|REGEX_QUOTE_REPLACEMENT)(?>\s*\()
    captures:
      1: support.function.dm
  - match: \b(usr|world|src|args|vars)\b
    scope: variable.language.dm
  - match: (\?|(>|<)(=)?|\.|:|/(=)?|~|\+(\+|=)?|-(-|=)?|\*(\*|=)?|%|>>|<<|=(=)?|!(=)?|<>|&|&&|\^|\||\|\||\b(to|in|step)\b)
    scope: keyword.operator.dm
  - match: \b(DM_BUILD|DM_VERSION|__FILE__|__LINE__|__MAIN__|DEBUG|FILE_DIR|TRUE|FALSE)\b
    scope: constant.language.dm
  - match: \b([A-Z_][A-Z_0-9]+)\b
    scope: constant.language.dm
  - match: \bnull\b
    scope: constant.language.dm
  - match: '@{"'
    captures:
      0: punctuation.definition.string.begin.dm
    push:
    - meta_scope: string.quoted.other.dm
    - match: '"}'
      pop: true
      captures:
        0: punctuation.definition.string.end.dm
  - match: '@\(([^)]+)\)'
    captures:
      0: punctuation.definition.string.begin.dm
    push:
    - meta_scope: string.unquoted.dm
    - match: \1
      pop: true
      captures:
        0: punctuation.definition.string.end.dm
  - match: '@(.)'
    captures:
      0: punctuation.definition.string.begin.dm
    push:
    - meta_scope: string.quoted.other.dm
    - match: \1|$
      pop: true
      captures:
        0: punctuation.definition.string.end.dm
  - match: ({")
    captures:
      0: string.quoted.triple.dm
      1: punctuation.definition.string.begin.dm
    push:
    - meta_scope: meta.interpstring.dm
    - match: ("})
      pop: true
      captures:
        0: string.quoted.triple.dm
        1: punctuation.definition.string.end.dm
    - include: repo_string_escaped_char
    - include: repo_string_embedded_expression
    - match: .
      scope: string.quoted.triple.dm
  - match: (")
    captures:
      0: string.quoted.double.dm
      1: punctuation.definition.string.begin.dm
    push:
    - meta_scope: meta.interpstring.dm
    - match: ("|[^\\]$)
      pop: true
      captures:
        0: string.quoted.double.dm
        1: punctuation.definition.string.end.dm
    - include: repo_string_escaped_char
    - include: repo_string_embedded_expression
    - match: .
      scope: string.quoted.double.dm
  - match: ''''
    captures:
      0: punctuation.definition.string.begin.dm
    push:
    - meta_scope: string.quoted.single.dm
    - match: '''|[^\\]$'
      pop: true
      captures:
        0: punctuation.definition.string.end.dm
    - match: \\(.|\n)
      scope: constant.character.escape.dm
  - match: "(?x)\n^\\s* ((\\#)\\s*define) \\s+     # define\n((?<id>[a-zA-Z_][a-zA-Z0-9_]*))  # macro name\n(?:\n\t(\\()\n\t\t(\n\t\t\t\\s* \\g<id> \\s*         # first argument\n\t\t\t((,) \\s* \\g<id> \\s*)*  # additional arguments\n\t\t\t(?:\\.\\.\\.)?            # varargs ellipsis?\n\t\t)\n\t(\\))\n)"
    captures:
      1: keyword.control.directive.define.dm
      2: punctuation.definition.directive.dm
      3: entity.name.function.preprocessor.dm
      5: punctuation.definition.parameters.begin.dm
      6: variable.parameter.preprocessor.dm
      8: punctuation.separator.parameters.dm
      9: punctuation.definition.parameters.end.dm
    push:
    - meta_scope: meta.preprocessor.macro.dm
    - match: (?=(?://|/\*))|(?<!\\)(?=\n)
      pop: true
    - include: main
  - match: '(?x)

      ^\s* ((\#)\s*define) \s+     # define

      ((?<id>[a-zA-Z_][a-zA-Z0-9_]*))  # macro name'
    captures:
      1: keyword.control.directive.define.dm
      2: punctuation.definition.directive.dm
      3: variable.other.preprocessor.dm
    push:
    - meta_scope: meta.preprocessor.macro.dm
    - match: (?=(?://|/\*))|(?<!\\)(?=\n)
      pop: true
    - include: main
  - match: ^\s*(#\s*(error|warn))\b
    captures:
      1: keyword.control.import.error.dm
    push:
    - meta_scope: meta.preprocessor.diagnostic.dm
    - match: $
      pop: true
      captures:
        1: keyword.control.import.error.dm
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.dm
  - match: ^\s*(?:((#)\s*(?:elif|else|if|ifdef|ifndef))|((#)\s*(undef|include)))\b
    captures:
      1: keyword.control.directive.conditional.dm
      2: punctuation.definition.directive.dm
      4: punctuation.definition.directive.dm
    push:
    - meta_scope: meta.preprocessor.dm
    - match: (?=(?://|/\*))|(?<!\\)(?=\n)
      pop: true
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.dm
  - include: repo_block
  - match: "(?x)\n\t\t\t\t(?:  ^                                 # begin-of-line\n\t\t\t\t\t|\n\t\t\t\t\t\t (?: (?= \\s )           (?<!else|new|return) (?<=\\w)      #  or word + space before name\n\t\t\t\t\t\t\t | (?= \\s*[A-Za-z_] ) (?<!&&)       (?<=[*&>])   #  or type modifier before name\n\t\t\t\t\t\t )\n\t\t\t\t)\n\t\t\t\t(\\s*) (?!(while|for|do|if|else|switch|catch|enumerate|return|r?iterate)\\s*\\()\n\t\t\t\t(\n\t\t\t\t\t(?: [A-Za-z_][A-Za-z0-9_]*+ | :: )++ |                  # actual name\n\t\t\t\t\t(?: (?<=operator) (?: [-*&<>=+!]+ | \\(\\) | \\[\\] ) )  # if it is a C++ operator\n\t\t\t\t)\n\t\t\t\t \\s*(?=\\()"
    captures:
      1: punctuation.whitespace.function.leading.dm
      3: entity.name.function.dm
      4: punctuation.definition.parameters.dm
    push:
    - meta_scope: meta.function.dm
    - match: (?<=\})|(?=#)|(;)?
      pop: true
    - include: repo_comments
    - include: repo_parens
    - match: \bconst\b
      scope: storage.modifier.dm
    - include: repo_block
  repo_access:
  - match: \.[a-zA-Z_][a-zA-Z_0-9]*\b(?!\s*\()
    scope: variable.other.dot-access.dm
  repo_block:
  - match: \{
    push:
    - meta_scope: meta.block.dm
    - match: \}
      pop: true
    - include: repo_block_innards
  repo_block_innards:
  - include: repo_preprocessor-rule-enabled-block
  - include: repo_preprocessor-rule-disabled-block
  - include: repo_preprocessor-rule-other-block
  - include: repo_access
  - match: "(?x) (?: (?= \\s )  (?:(?<=else|new|return) | (?<!\\w)) (\\s+))?\n\t\t\t(\\b\n\t\t\t\t(?!(while|for|do|if|else|switch|catch|enumerate|return|r?iterate)\\s*\\()(?:(?!NS)[A-Za-z_][A-Za-z0-9_]*+\\b | :: )++                  # actual name\n\t\t\t)\n\t\t\t \\s*(\\()"
    scope: meta.function-call.dm
    captures:
      1: punctuation.whitespace.function-call.leading.dm
      2: support.function.any-method.dm
      3: punctuation.definition.parameters.dm
  - include: repo_block
  - include: main
  repo_comments:
  - match: ^/\* =(\s*.*?)\s*= \*/$\n?
    scope: comment.block.dm
    captures:
      1: meta.toc-list.banner.block.dm
  - match: /\*
    captures:
      0: punctuation.definition.comment.dm
    push:
    - meta_scope: comment.block.dm
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.dm
    - include: repo_comments
  - match: \*/.*\n
    scope: invalid.illegal.stray-comment-end.dm
  - match: ^// =(\s*.*?)\s*=\s*$\n?
    scope: comment.line.banner.dm
    captures:
      1: meta.toc-list.banner.line.dm
  - match: //
    captures:
      0: punctuation.definition.comment.dm
    push:
    - meta_scope: comment.line.double-slash.dm
    - match: '[^\\]$'
      pop: true
    - match: (?>\\\s*\n)
      scope: punctuation.separator.continuation.dm
  repo_disabled:
  - match: ^\s*#\s*if(n?def)?\b.*$
    push:
    - match: ^\s*#\s*endif\b
      pop: true
    - include: repo_disabled
  repo_parens:
  - match: \(
    push:
    - meta_scope: meta.parens.dm
    - match: \)
      pop: true
    - include: main
  repo_preprocessor-rule-disabled:
  - match: ^\s*(#(if)\s+(0+|FALSE)\b).*
    captures:
      1: meta.preprocessor.dm
      2: keyword.control.import.if.dm
      3: constant.numeric.preprocessor.dm
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.if.dm
        3: constant.numeric.preprocessor.dm
    - match: ^\s*(#\s*(else)\b)
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.else.dm
      push:
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.dm
          2: keyword.control.import.else.dm
      - include: main
    - include: repo_disabled
  repo_preprocessor-rule-disabled-block:
  - match: ^\s*(#(if)\s+(0+|FALSE)\b).*
    captures:
      1: meta.preprocessor.dm
      2: keyword.control.import.if.dm
      3: constant.numeric.preprocessor.dm
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.if.dm
        3: constant.numeric.preprocessor.dm
    - match: ^\s*(#\s*(else)\b)
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.else.dm
      push:
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.dm
          2: keyword.control.import.else.dm
      - include: repo_block_innards
    - include: repo_disabled
  repo_preprocessor-rule-enabled:
  - match: ^\s*(#(if)\s+(0*1|TRUE)\b)
    captures:
      1: meta.preprocessor.dm
      2: keyword.control.import.if.dm
      3: constant.numeric.preprocessor.dm
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.if.dm
        3: constant.numeric.preprocessor.dm
    - match: ^\s*(#\s*(else)\b).*
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.else.dm
      push:
      - meta_content_scope: comment.block.preprocessor.else-branch
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.dm
          2: keyword.control.import.else.dm
      - include: repo_disabled
    - include: main
  repo_preprocessor-rule-enabled-block:
  - match: ^\s*(#(if)\s+(0*1|TRUE)\b)
    captures:
      1: meta.preprocessor.dm
      2: keyword.control.import.if.dm
      3: constant.numeric.preprocessor.dm
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.if.dm
        3: constant.numeric.preprocessor.dm
    - match: ^\s*(#\s*(else)\b).*
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.else.dm
      push:
      - meta_content_scope: comment.block.preprocessor.else-branch.in-block
      - match: (?=^\s*#\s*endif\b)
        pop: true
        captures:
          1: meta.preprocessor.dm
          2: keyword.control.import.else.dm
      - include: repo_disabled
    - include: repo_block_innards
  repo_preprocessor-rule-other:
  - match: ^\s*((#\s*(if(n?def)?))\b.*?(?:(?=(?://|/\*))|$))
    captures:
      1: meta.preprocessor.dm
      2: keyword.control.import.dm
    push:
    - match: ^\s*((#\s*(endif))\b)
      pop: true
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.dm
    - include: main
  repo_preprocessor-rule-other-block:
  - match: ^\s*(#\s*(if(n?def)?)\b.*?(?:(?=(?://|/\*))|$))
    captures:
      1: meta.preprocessor.dm
      2: keyword.control.import.dm
    push:
    - match: ^\s*(#\s*(endif)\b)
      pop: true
      captures:
        1: meta.preprocessor.dm
        2: keyword.control.import.dm
    - include: repo_block_innards
  repo_string_embedded_expression:
  - match: (\[)
    captures:
      0: string.quoted.other.dm
      1: punctuation.definition.string.end.dm
    push:
    - meta_scope: meta.interpolation.dm
    - match: (\])
      pop: true
      captures:
        0: string.quoted.other.dm
        1: punctuation.definition.string.begin.dm
    - include: repo_string_embedded_expression_2
    - include: main
  repo_string_embedded_expression_2:
  - match: (\[)
    push:
    - match: (\])
      pop: true
    - include: repo_string_embedded_expression_2
    - include: main
  repo_string_escaped_char:
  - match: '\\([Tt]he|[Aa]|[Aa]n|[Hh]e|[Ss]he|[Hh]is|him|himself|herself|hers|proper|improper|th|s|(icon|ref|[Rr]oman)(?=\[)|\.\.\.|t|n|"|\\|<|>| |

      |\[|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{6})'
    scope: constant.character.escape.dm
  - match: \\.
    scope: invalid.illegal.unknown-escape.dm
