    - include: repo_modifiers
    - include: repo_variable
    - include: repo_block
    - include: repo_block-contents
  repo_class-name:
  - match: \b(class)\b
    captures:
      1: storage.type.class.hx
    push:
    - meta_scope: meta.class.identifier.hx
    - match: ([_A-Za-z]\w*)
      pop: true
      captures:
        1: entity.name.type.class.hx
    - include: repo_global
  repo_class-name-post:
  - match: (?<=\w)
    push:
    - match: ([\{;])
      pop: true
      captures:
        1: punctuation.definition.block.begin.hx
    - include: repo_modifiers-inheritance
    - include: repo_type
  repo_comments:
  - match: /\*\*(?!/)
    captures:
      0: punctuation.definition.comment.hx
    push:
    - meta_scope: comment.block.documentation.hx
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.hx
    - include: repo_javadoc-tags
  - match: /\*
    captures:
      0: punctuation.definition.comment.hx
    push:
    - meta_scope: comment.block.hx
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.hx
    - include: repo_javadoc-tags
  - match: (//).*$\n?
    scope: comment.line.double-slash.hx
    captures:
      1: punctuation.definition.comment.hx
  repo_conditional-compilation:
  - match: ((#(if|elseif))[\s!]+([a-zA-Z_][a-zA-Z0-9_]*(\.[a-zA-Z_][a-zA-Z0-9_]*)*)(?=\s|/\*|//))
    captures:
      0: punctuation.definition.tag
  - match: ((#(if|elseif))[\s!]*)(?=\()
    captures:
      0: punctuation.definition.tag
    push:
    - meta_scope: punctuation.definition.tag
    - match: (?<=\)|\n)
      pop: true
      captures:
        0: punctuation.definition.tag
    - include: repo_conditional-compilation-parens
  - match: (#(end|else|error|line))
    scope: punctuation.definition.tag
  - match: (#([a-zA-Z0-9_]*))\s
    scope: punctuation.definition.tag
  repo_conditional-compilation-parens:
  - match: \(
    push:
    - match: \)
      pop: true
    - include: repo_conditional-compilation-parens
  repo_constant-name:
  - match: \b([_A-Z][_A-Z0-9]*)\b
    scope: variable.other.hx
  repo_constants:
  - match: \b(true|false|null)\b
    scope: constant.language.hx
