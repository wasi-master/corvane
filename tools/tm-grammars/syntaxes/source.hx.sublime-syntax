      captures:
        1: punctuation.terminator.hx
    - include: repo_enum-name
    - include: repo_enum-name-post
    - include: repo_enum-block
  repo_enum-block:
  - match: (?<=\{)
    push:
    - meta_scope: meta.block.hx
    - match: (\})
