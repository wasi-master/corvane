    - include: repo_block
    - include: repo_block-contents
  repo_interface-name:
  - match: \b(interface)\b
    captures:
      1: storage.type.class.hx
    push:
    - match: ([_A-Za-z]\w*)
      pop: true
      captures:
        1: entity.name.type.class.hx
    - include: repo_global
  repo_interface-name-post:
  - match: (?<=\w)
    push:
    - match: ([\{;])
      pop: true
      captures:
        1: punctuation.definition.block.begin.hx
