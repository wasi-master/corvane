      0: constant.numeric.decimal.hx
      1: meta.delimiter.decimal.period.hx
      10: meta.delimiter.decimal.period.hx
      11: constant.numeric.suffix.hx
      12: meta.delimiter.decimal.period.hx
      13: constant.numeric.suffix.hx
      14: constant.numeric.suffix.hx
      2: constant.numeric.suffix.hx
      3: meta.delimiter.decimal.period.hx
      4: constant.numeric.suffix.hx
      5: meta.delimiter.decimal.period.hx
      6: constant.numeric.suffix.hx
      7: constant.numeric.suffix.hx
      8: meta.delimiter.decimal.period.hx
      9: constant.numeric.suffix.hx
