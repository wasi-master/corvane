    captures:
      0: keyword.operator.type.annotation.hx
    push:
    - match: (?=\)|,|=)
      pop: true
    - include: repo_type
  repo_block:
  - match: \{
    captures:
      0: punctuation.definition.block.begin.hx
    push:
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.block.end.hx
