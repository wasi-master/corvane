    - include: repo_modifiers
    - include: repo_variable
    - include: repo_block
    - include: repo_block-contents
  repo_abstract-name:
  - match: \b(abstract)\b
    captures:
      1: storage.type.class.hx
    push:
    - match: ([_A-Za-z]\w*)
      pop: true
      captures:
        1: entity.name.type.class.hx
    - include: repo_global
  repo_abstract-name-post:
  - match: (?<=\w)
    push:
    - match: ([\{;])
      pop: true
      captures:
        1: punctuation.definition.block.begin.hx
    - include: repo_global
    - match: \b(from|to)\b(?=\s*\{)
      captures:
        1: keyword.other.hx
      push:
      - match: (?<=\})
        pop: true
      - include: repo_type
    - match: \b(from|to)\b
      scope: keyword.other.hx
    - include: repo_type
    - match: '[\(\)]'
      scope: punctuation.definition.other.hx
  repo_accessor-method:
  - match: \b(get|set)_[_A-Za-z]\w*\b
    scope: entity.name.function.hx
  repo_all:
  - include: repo_global
  - include: repo_package
  - include: repo_import
  - include: repo_using
  - match: \b(final)\b(?=\s+(class|interface|extern|private)\b)
    scope: storage.modifier.hx
  - include: repo_abstract
  - include: repo_class
  - include: repo_enum
  - include: repo_interface
  - include: repo_typedef
  - include: repo_block
  - include: repo_block-contents
  repo_array:
  - match: \[
    captures:
      0: punctuation.definition.array.begin.hx
    push:
    - meta_scope: meta.array.literal.hx
    - match: \]
      pop: true
      captures:
        0: punctuation.definition.array.end.hx
    - include: repo_block
    - include: repo_block-contents
  repo_arrow-function:
  - match: (\()(?=[^(]*?\)\s*->)
    captures:
      1: punctuation.definition.parameters.begin.hx
    push:
    - meta_scope: meta.method.arrow.hx
    - match: (\))\s*(->)
      pop: true
      captures:
        1: punctuation.definition.parameters.end.hx
        2: storage.type.function.arrow.hx
    - include: repo_arrow-function-parameter
  repo_arrow-function-parameter:
