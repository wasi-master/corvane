    - include: repo_modifiers-inheritance
    - include: repo_type
  repo_javadoc-tags:
  - match: (@(?:param|exception|throws|event))\s+([_A-Za-z]\w*)\s+
    captures:
      1: storage.type.class.javadoc
      2: variable.other.javadoc
