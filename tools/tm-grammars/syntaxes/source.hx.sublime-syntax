      1: storage.type.class.javadoc
      2: constant.numeric.javadoc
  - match: '@(param|exception|throws|deprecated|returns?|since|default|see|event)'
    captures:
      0: storage.type.class.javadoc
  repo_keywords:
  - match: (?<=trace|$type|if|while|for|super)\s*(\()
