      4: support.package.hx
      5: entity.name.type.hx
      6: meta.brace.round.hx
    push:
    - match: (\))
      pop: true
      captures:
        1: meta.brace.round.hx
    - include: repo_block
    - include: repo_block-contents
  repo_enum-name:
  - match: \b(enum)\b
    captures:
      1: storage.type.class.hx
    push:
    - match: ([_A-Za-z]\w*)
      pop: true
      captures:
        1: entity.name.type.class.hx
    - include: repo_global
  repo_enum-name-post:
  - match: (?<=\w)
    push:
    - match: ([\{;])
      pop: true
      captures:
        1: punctuation.definition.block.begin.hx
    - include: repo_type
  repo_for-loop:
  - match: \b(for)\b\s*(\()
    captures:
      1: keyword.control.flow-control.hx
      2: meta.brace.round.hx
    push:
    - match: (\))
      pop: true
      captures:
        1: meta.brace.round.hx
    - match: \b(in)\b
      scope: keyword.other.in.hx
    - include: repo_block
    - include: repo_block-contents
  repo_function-type:
  - match: \(
    captures:
      0: punctuation.definition.parameters.begin.hx
    push:
    - match: \)
      pop: true
      captures:
        0: punctuation.definition.parameters.end.hx
    - include: repo_function-type-parameter
  repo_function-type-parameter:
  - match: (?<=\(|,)
    push:
    - match: (?=\)|,)
      pop: true
    - include: repo_global
    - include: repo_metadata
    - include: repo_operator-optional
    - include: repo_punctuation-comma
    - include: repo_function-type-parameter-name
    - include: repo_function-type-parameter-type-hint
    - include: repo_parameter-assign
    - include: repo_type
    - include: repo_global
  repo_function-type-parameter-name:
  - match: ([_a-zA-Z]\w*)(?=\s*:)
    captures:
