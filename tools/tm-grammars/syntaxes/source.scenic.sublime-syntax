%YAML 1.2
---
# Scenic (source.scenic): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/UCSCFormalMethods/Scenic-tmLanguage.git via GitHub Linguist v9.7.0 (license: mit).
name: Scenic
scope: source.scenic
file_extensions:
- scenic
first_line_match: ^#!.*\b(scenic)\b
contexts:
  main:
  - include: repo_statement
  - include: repo_expression
  repo_annotated-parameter:
  - match: "(?x)\n  \\b\n  ([[:alpha:]_]\\w*) \\s* (:)\n"
    captures:
      1: variable.parameter.function.language.scenic
      2: punctuation.separator.annotation.scenic
    push:
    - match: (,)|(?=\))
      pop: true
      captures:
        1: punctuation.separator.parameters.scenic
    - include: repo_expression
    - match: =(?!=)
      scope: keyword.operator.assignment.scenic
  repo_assignment-operator:
  - match: "(?x)\n     <<= | >>= | //= | \\*\\*=\n    | \\+= | -= | /= | @=\n    | \\*= | %= | ~= | \\^= | &= | \\|=\n    | =(?!=)\n"
    scope: keyword.operator.assignment.scenic
  repo_backticks:
  - match: \`
    push:
    - meta_scope: invalid.deprecated.backtick.scenic
    - match: (?:\`|(?<!\\)(\n))
      pop: true
    - include: repo_expression
  repo_builtin-callables:
  - include: repo_illegal-names
  - include: repo_illegal-object-name
  - include: repo_builtin-exceptions
  - include: repo_builtin-functions
  - include: repo_builtin-types
  - include: repo_builtin-types-scenic
  repo_builtin-exceptions:
  - match: "(?x) (?<!\\.) \\b(\n  (\n    Arithmetic | Assertion | Attribute | Buffer | BlockingIO\n    | BrokenPipe | ChildProcess\n    | (Connection (Aborted | Refused | Reset)?)\n    | EOF | Environment | FileExists | FileNotFound\n    | FloatingPoint | IO | Import | Indentation | Index | Interrupted\n    | IsADirectory | NotADirectory | Permission | ProcessLookup\n    | Timeout\n    | Key | Lookup | Memory | Name | NotImplemented | OS | Overflow\n    | Reference | Runtime | Recursion | Syntax | System\n    | Tab | Type | UnboundLocal | Unicode(Encode|Decode|Translate)?\n    | Value | Windows | ZeroDivision | ModuleNotFound\n  ) Error\n|\n  ((Pending)?Deprecation | Runtime | Syntax | User | Future | Import\n    | Unicode | Bytes | Resource\n  )? Warning\n|\n  SystemExit | Stop(Async)?Iteration\n  | KeyboardInterrupt\n  | GeneratorExit | (Base)?Exception\n  | (Guard | Precondition | Invariant)Violation\n)\\b\n"
    scope: support.type.exception.scenic
  repo_builtin-functions:
  - match: "(?x)\n  (?<!\\.) \\b(\n    __import__ | abs | aiter | all | any | anext | ascii | bin\n    | breakpoint | callable | chr | compile | copyright | credits\n    | delattr | dir | divmod | enumerate | eval | exec | exit\n    | filter | format | getattr | globals | hasattr | hash | help\n    | hex | id | input | isinstance | issubclass | iter | len\n    | license | locals | map | max | memoryview | min | next\n    | oct | open | ord | pow | print | quit | range | reload | repr\n    | reversed | round | setattr | sorted | sum | vars | zip\n  )\\b\n"
    scope: support.function.builtin.scenic
  - match: "(?x)\n  (?<!\\.) \\b(\n    resample | localPath | verbosePrint | simulation\n    | sin | cos | hypot\n  )\\b\n"
    scope: support.function.builtin.scenic
  - match: "(?x)\n  (?<!\\.) \\b(\n    file | reduce | intern | raw_input | unicode | cmp | basestring\n    | execfile | long | xrange\n  )\\b\n"
    scope: variable.legacy.builtin.scenic
  repo_builtin-names-scenic:
  - match: "(?x)\n  (?<!\\.) \\b(\n    globalParameters\n  )\\b\n"
    scope: support.constant.scenic
  repo_builtin-possible-callables:
  - include: repo_builtin-callables
  - include: repo_magic-names
  repo_builtin-types:
  - match: "(?x)\n  (?<!\\.) \\b(\n    bool | bytearray | bytes | classmethod | complex | dict\n    | float | frozenset | int | list | object | property\n    | set | slice | staticmethod | str | tuple | type\n\n    (?# Although 'super' is not a type, it's related to types,\n        and is special enough to be highlighted differently from\n        other built-ins)\n    | super\n  )\\b\n"
    scope: support.type.scenic
  repo_builtin-types-scenic:
  - match: "(?x)\n  (?<!\\.) \\b(\n    Point | OrientedPoint | Object\n    | Vector | Orientation | VectorField | PolygonalVectorField\n    | Shape | MeshShape | BoxShape | CylinderShape | ConeShape | SpheroidShape\n    | Region | PointSetRegion | RectangularRegion | CircularRegion\n    | SectorRegion | PolygonalRegion | PolylineRegion | PathRegion\n    | MeshVolumeRegion | MeshSurfaceRegion | BoxRegion | SpheroidRegion\n    | Workspace\n    | Range | DiscreteRange | Options | Discrete | Uniform\n    | Normal | TruncatedNormal\n    | VerifaiParameter | VerifaiRange | VerifaiDiscreteRange | VerifaiOptions\n  )\\b\n"
    scope: support.type.scenic
  repo_call-wrapper-inheritance:
  - match: "(?x)\n  \\b(?=\n    ([[:alpha:]_]\\w*) \\s* (\\()\n  )\n"
    push:
    - meta_scope: meta.function-call.scenic
    - match: (\))
      pop: true
      captures:
        1: punctuation.definition.arguments.end.scenic
    - include: repo_inheritance-name
    - include: repo_function-arguments
  repo_class-declaration:
  - match: "(?x)\n  \\s*(class)\\s+\n    (?=\n      [[:alpha:]_]\\w* \\s* (:|\\()\n    )\n"
    captures:
      1: storage.type.class.scenic
    push:
    - meta_scope: meta.class.scenic
    - match: (:)
      pop: true
      captures:
        1: punctuation.section.class.begin.scenic
    - include: repo_class-name
    - include: repo_class-inheritance
  repo_class-inheritance:
  - match: (\()
    captures:
      1: punctuation.definition.inheritance.begin.scenic
    push:
    - meta_scope: meta.class.inheritance.scenic
    - match: (\))
      pop: true
      captures:
        1: punctuation.definition.inheritance.end.scenic
    - match: (\*\*|\*)
      scope: keyword.operator.unpacking.arguments.scenic
    - match: ','
      scope: punctuation.separator.inheritance.scenic
    - match: =(?!=)
      scope: keyword.operator.assignment.scenic
    - match: \bmetaclass\b
      scope: support.type.metaclass.scenic
    - include: repo_illegal-names
    - include: repo_class-kwarg
    - include: repo_call-wrapper-inheritance
    - include: repo_expression-base
    - include: repo_member-access-class
    - include: repo_inheritance-identifier
  repo_class-kwarg:
  - match: "(?x)\n  \\b ([[:alpha:]_]\\w*) \\s*(=)(?!=)\n"
    captures:
      1: entity.other.inherited-class.scenic variable.parameter.class.scenic
      2: keyword.operator.assignment.scenic
  repo_class-name:
  - include: repo_illegal-object-name
  - include: repo_builtin-possible-callables
  - match: "(?x)\n  \\b ([[:alpha:]_]\\w*) \\b\n"
    scope: entity.name.type.class.scenic
  repo_codetags:
  - match: (?:\b(NOTE|XXX|HACK|FIXME|BUG|TODO)\b)
    captures:
      1: keyword.codetag.notation.scenic
  repo_comments:
  - match: "(?x)\n  (?:\n    \\# \\s* (type:)\n    \\s*+ (?# we want `\\s*+` which is possessive quantifier since\n             we do not actually want to backtrack when matching\n             whitespace here)\n    (?! $ | \\#)\n  )\n"
    captures:
      0: meta.typehint.comment.scenic
      1: comment.typehint.directive.notation.scenic
    push:
    - meta_scope: comment.line.number-sign.scenic
    - meta_content_scope: meta.typehint.comment.scenic
    - match: (?:$|(?=\#))
      pop: true
    - match: "(?x)\n   ignore\n  (?= \\s* (?: $ | \\#))\n"
      scope: comment.typehint.ignore.notation.scenic
    - match: "(?x)\n  (?<!\\.)\\b(\n    bool | bytes | float | int | object | str\n    | List | Dict | Iterable | Sequence | Set\n    | FrozenSet | Callable | Union | Tuple\n    | Any | None\n  )\\b\n"
      scope: comment.typehint.type.notation.scenic
    - match: ([\[\]\(\),\.\=\*]|(->))
      scope: comment.typehint.punctuation.notation.scenic
    - match: ([[:alpha:]_]\w*)
      scope: comment.typehint.variable.notation.scenic
  - include: repo_comments-base
  repo_comments-base:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.scenic
    push:
    - meta_scope: comment.line.number-sign.scenic
    - match: ($)
      pop: true
    - include: repo_codetags
  repo_comments-string-double-three:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.scenic
    push:
    - meta_scope: comment.line.number-sign.scenic
    - match: ($|(?="""))
      pop: true
    - include: repo_codetags
  repo_comments-string-single-three:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.scenic
    push:
    - meta_scope: comment.line.number-sign.scenic
    - match: ($|(?='''))
      pop: true
    - include: repo_codetags
  repo_curly-braces:
  - match: \{
    captures:
      0: punctuation.definition.dict.begin.scenic
    push:
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.dict.end.scenic
    - match: ':'
      scope: punctuation.separator.dict.scenic
    - include: repo_expression
  repo_decorator:
  - match: "(?x)\n  ^\\s*\n  ((@)) \\s* (?=[[:alpha:]_]\\w*)\n"
    captures:
      1: entity.name.function.decorator.scenic
      2: punctuation.definition.decorator.scenic
    push:
    - meta_scope: meta.function.decorator.scenic
    - match: "(?x)\n  ( \\) )\n    # trailing whitespace and comments are legal\n    (?: (.*?) (?=\\s*(?:\\#|$)) )\n  | (?=\\n|\\#)\n"
      pop: true
      captures:
        1: punctuation.definition.arguments.end.scenic
        2: invalid.illegal.decorator.scenic
    - include: repo_decorator-name
    - include: repo_function-arguments
  repo_decorator-name:
  - include: repo_builtin-callables
  - include: repo_illegal-object-name
  - match: "(?x)\n  ([[:alpha:]_]\\w*) | (\\.)\n"
    scope: entity.name.function.decorator.scenic
    captures:
      2: punctuation.separator.period.scenic
  - include: repo_line-continuation
  - match: "(?x)\n  \\s* ([^([:alpha:]\\s_\\.#\\\\] .*?) (?=\\#|$)\n"
    scope: invalid.illegal.decorator.scenic
    captures:
      1: invalid.illegal.decorator.scenic
  repo_docstring:
  - match: (\'\'\'|\"\"\")
    captures:
      1: punctuation.definition.string.begin.scenic
    push:
    - meta_scope: string.quoted.docstring.multi.scenic
    - match: (\1)
      pop: true
      captures:
        1: punctuation.definition.string.end.scenic
    - include: repo_docstring-prompt
    - include: repo_codetags
    - include: repo_docstring-guts-unicode
  - match: ([rR])(\'\'\'|\"\"\")
    captures:
      1: storage.type.string.scenic
      2: punctuation.definition.string.begin.scenic
    push:
    - meta_scope: string.quoted.docstring.raw.multi.scenic
    - match: (\2)
      pop: true
      captures:
        1: punctuation.definition.string.end.scenic
    - include: repo_string-consume-escape
    - include: repo_docstring-prompt
    - include: repo_codetags
  - match: (\'|\")
    captures:
      1: punctuation.definition.string.begin.scenic
    push:
    - meta_scope: string.quoted.docstring.single.scenic
    - match: (\1)|(\n)
      pop: true
      captures:
        1: punctuation.definition.string.end.scenic
        2: invalid.illegal.newline.scenic
    - include: repo_codetags
    - include: repo_docstring-guts-unicode
  - match: ([rR])(\'|\")
    captures:
      1: storage.type.string.scenic
      2: punctuation.definition.string.begin.scenic
    push:
    - meta_scope: string.quoted.docstring.raw.single.scenic
    - match: (\2)|(\n)
      pop: true
      captures:
        1: punctuation.definition.string.end.scenic
        2: invalid.illegal.newline.scenic
    - include: repo_string-consume-escape
    - include: repo_codetags
  repo_docstring-guts-unicode:
  - include: repo_escape-sequence-unicode
  - include: repo_escape-sequence
  - include: repo_string-line-continuation
  repo_docstring-prompt:
  - match: "(?x)\n  (?:\n    (?:^|) \\s* (?# '' is necessary for ST)\n    ((?:>>>|\\.\\.\\.) \\s) (?=\\s*\\S)\n  )\n"
    captures:
      1: keyword.control.flow.scenic
  repo_docstring-statement:
  - match: ^(?=\s*[rR]?(\'\'\'|\"\"\"|\'|\"))
    push:
    - match: ((?<=\1)|^)(?!\s*[rR]?(\'\'\'|\"\"\"|\'|\"))
      pop: true
    - include: repo_docstring
  repo_double-one-regexp-character-set:
  - match: "(?x)\n  \\[ \\^? \\] (?! .*?\\])\n"
  - match: (\[)(\^)?(\])?
    captures:
      1: punctuation.character.set.begin.regexp constant.other.set.regexp
      2: keyword.operator.negation.regexp
      3: constant.character.set.regexp
    push:
    - meta_scope: meta.character.set.regexp
    - match: (\]|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: punctuation.character.set.end.regexp constant.other.set.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_regexp-charecter-set-escapes
    - match: '[^\n]'
      scope: constant.character.set.regexp
  repo_double-one-regexp-comments:
  - match: \(\?#
    captures:
      0: punctuation.comment.begin.regexp
    push:
    - meta_scope: comment.regexp
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: punctuation.comment.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_codetags
  repo_double-one-regexp-conditional:
  - match: (\()\?\((\w+(?:\s+[[:alnum:]]+)?|\d+)\)
    captures:
      0: keyword.operator.conditional.regexp
      1: punctuation.parenthesis.conditional.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.conditional.negative.regexp punctuation.parenthesis.conditional.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-expression:
  - include: repo_regexp-base-expression
  - include: repo_double-one-regexp-character-set
  - include: repo_double-one-regexp-comments
  - include: repo_regexp-flags
  - include: repo_double-one-regexp-named-group
  - include: repo_regexp-backreference
  - include: repo_double-one-regexp-lookahead
  - include: repo_double-one-regexp-lookahead-negative
  - include: repo_double-one-regexp-lookbehind
  - include: repo_double-one-regexp-lookbehind-negative
  - include: repo_double-one-regexp-conditional
  - include: repo_double-one-regexp-parentheses-non-capturing
  - include: repo_double-one-regexp-parentheses
  repo_double-one-regexp-lookahead:
  - match: (\()\?=
    captures:
      0: keyword.operator.lookahead.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookahead.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookahead-negative:
  - match: (\()\?!
    captures:
      0: keyword.operator.lookahead.negative.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookahead.negative.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookbehind:
  - match: (\()\?<=
    captures:
      0: keyword.operator.lookbehind.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookbehind.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookbehind-negative:
  - match: (\()\?<!
    captures:
      0: keyword.operator.lookbehind.negative.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookbehind.negative.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-named-group:
  - match: "(?x)\n  (\\()  (\\?P <\\w+(?:\\s+[[:alnum:]]+)?>)\n"
    captures:
      1: support.other.parenthesis.regexp punctuation.parenthesis.named.begin.regexp
      2: entity.name.tag.named.group.regexp
    push:
    - meta_scope: meta.named.regexp
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.named.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-parentheses:
  - match: \(
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-parentheses-non-capturing:
  - match: '\(\?:'
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-one-regexp-expression
  repo_double-three-regexp-character-set:
  - match: "(?x)\n  \\[ \\^? \\] (?! .*?\\])\n"
  - match: (\[)(\^)?(\])?
    captures:
      1: punctuation.character.set.begin.regexp constant.other.set.regexp
      2: keyword.operator.negation.regexp
      3: constant.character.set.regexp
    push:
    - meta_scope: meta.character.set.regexp
    - match: (\]|(?="""))
      pop: true
      captures:
        1: punctuation.character.set.end.regexp constant.other.set.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_regexp-charecter-set-escapes
    - match: '[^\n]'
      scope: constant.character.set.regexp
  repo_double-three-regexp-comments:
  - match: \(\?#
    captures:
      0: punctuation.comment.begin.regexp
    push:
    - meta_scope: comment.regexp
    - match: (\)|(?="""))
      pop: true
      captures:
        1: punctuation.comment.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_codetags
  repo_double-three-regexp-conditional:
  - match: (\()\?\((\w+(?:\s+[[:alnum:]]+)?|\d+)\)
    captures:
      0: keyword.operator.conditional.regexp
      1: punctuation.parenthesis.conditional.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.conditional.negative.regexp punctuation.parenthesis.conditional.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-expression:
  - include: repo_regexp-base-expression
  - include: repo_double-three-regexp-character-set
  - include: repo_double-three-regexp-comments
  - include: repo_regexp-flags
  - include: repo_double-three-regexp-named-group
  - include: repo_regexp-backreference
  - include: repo_double-three-regexp-lookahead
  - include: repo_double-three-regexp-lookahead-negative
  - include: repo_double-three-regexp-lookbehind
  - include: repo_double-three-regexp-lookbehind-negative
  - include: repo_double-three-regexp-conditional
  - include: repo_double-three-regexp-parentheses-non-capturing
  - include: repo_double-three-regexp-parentheses
  - include: repo_comments-string-double-three
  repo_double-three-regexp-lookahead:
  - match: (\()\?=
    captures:
      0: keyword.operator.lookahead.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookahead.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookahead-negative:
  - match: (\()\?!
    captures:
      0: keyword.operator.lookahead.negative.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookahead.negative.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookbehind:
  - match: (\()\?<=
    captures:
      0: keyword.operator.lookbehind.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookbehind.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookbehind-negative:
  - match: (\()\?<!
    captures:
      0: keyword.operator.lookbehind.negative.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookbehind.negative.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-named-group:
  - match: "(?x)\n  (\\()  (\\?P <\\w+(?:\\s+[[:alnum:]]+)?>)\n"
    captures:
      1: support.other.parenthesis.regexp punctuation.parenthesis.named.begin.regexp
      2: entity.name.tag.named.group.regexp
    push:
    - meta_scope: meta.named.regexp
    - match: (\)|(?="""))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.named.end.regexp
        2: invalid.illegal.newline.scenic
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-parentheses:
