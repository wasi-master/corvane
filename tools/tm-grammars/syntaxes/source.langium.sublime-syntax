%YAML 1.2
---
# Langium (source.langium): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/eclipse-langium/language-langium.git via GitHub Linguist v9.7.0 (license: mit).
name: Langium
scope: source.langium
file_extensions:
- langium
contexts:
  main:
  - include: repo_regex
  - include: repo_comments
  - match: \b(left|right|assoc|current|entry|extends|fragment|grammar|hidden|import|infer|infers|infix|interface|returns|terminal|type|with|on)\b
    scope: keyword.control.langium
  - match: \b(?i:true|false)\b
    scope: constant.language.langium
  - match: (\{|\}|\:|\]|\[|\(|\)|(\??|\+?)\=|->|\=>|<|>|\,|\*|\+|\@|\||\&|\?|\!|\;)
    scope: keyword.symbol.langium
  - match: '"'
    push:
    - meta_scope: string.quoted.double.langium
    - match: '"'
      pop: true
    - include: repo_string-character-escape
  - match: ''''
    push:
    - meta_scope: string.quoted.single.langium
    - match: ''''
      pop: true
    - include: repo_string-character-escape
  repo_comments:
  - match: /\*
    captures:
      0: punctuation.definition.comment.langium
    push:
    - meta_scope: comment.block.langium
    - match: \*/
      pop: true
      captures:
        0: punctuation.definition.comment.langium
  - match: (^\s+)?(?=//)
    captures:
      1: punctuation.whitespace.comment.leading.cs
    push:
    - meta_scope: comment.line.langium
    - match: (?=$)
      pop: true
  repo_regex:
  - match: (?<!\+\+|--|})(?<=[=(:,\[?+!]|^return|[^\._$[:alnum:]]return|^case|[^\._$[:alnum:]]case|=>|&&|\|\||\*\/)\s*(\/)(?![\/*])(?=(?:[^\/\\\[\()]|\\.|\[([^\]\\]|\\.)+\]|\(([^\)\\]|\\.)+\))+\/([a-z]+|(?![\/\*])|(?=\/\*))(?!\s*[a-zA-Z0-9_$]))
    captures:
      1: punctuation.definition.string.begin.ts
    push:
    - meta_scope: string.regexp.ts
    - match: (/)([a-z]*)
      pop: true
      captures:
        1: punctuation.definition.string.end.ts
        2: keyword.other.ts
    - include: repo_regexp
  - match: ((?<![_$[:alnum:])\]]|\+\+|--|}|\*\/)|((?<=^return|[^\._$[:alnum:]]return|^case|[^\._$[:alnum:]]case))\s*)\/(?![\/*])(?=(?:[^\/\\\[]|\\.|\[([^\]\\]|\\.)*\])+\/([a-z]+|(?![\/\*])|(?=\/\*))(?!\s*[a-zA-Z0-9_$]))
    captures:
      0: punctuation.definition.string.begin.ts
    push:
    - meta_scope: string.regexp.ts
    - match: (/)([a-z]*)
      pop: true
      captures:
        1: punctuation.definition.string.end.ts
        2: keyword.other.ts
    - include: repo_regexp
  repo_regex-character-class:
  - match: \\[wWsSdDtrnvf]|\.
    scope: constant.other.character-class.regexp
  - match: \\([0-7]{3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})
    scope: constant.character.numeric.regexp
  - match: \\c[A-Z]
    scope: constant.character.control.regexp
  - match: \\.
    scope: constant.character.escape.backslash.regexp
  repo_regexp:
  - match: \\[bB]|\^|\$
    scope: keyword.control.anchor.regexp
  - match: \\[1-9]\d*|\\k<([a-zA-Z_$][\w$]*)>
    captures:
      0: keyword.other.back-reference.regexp
      1: variable.other.regexp
  - match: '[?+*]|\{(\d+,\d+|\d+,|,\d+|\d+)\}\??'
    scope: keyword.operator.quantifier.regexp
  - match: \|
    scope: keyword.operator.or.regexp
  - match: (\()((\?=)|(\?!)|(\?<=)|(\?<!))
    captures:
      1: punctuation.definition.group.regexp
      2: punctuation.definition.group.assertion.regexp
      3: meta.assertion.look-ahead.regexp
      4: meta.assertion.negative-look-ahead.regexp
      5: meta.assertion.look-behind.regexp
      6: meta.assertion.negative-look-behind.regexp
    push:
    - meta_scope: meta.group.assertion.regexp
    - match: (\))
      pop: true
      captures:
        1: punctuation.definition.group.regexp
    - include: repo_regexp
  - match: \((?:(\?:)|(?:\?<([a-zA-Z_$][\w$]*)>))?
    captures:
      0: punctuation.definition.group.regexp
      1: punctuation.definition.group.no-capture.regexp
      2: variable.other.regexp
    push:
    - meta_scope: meta.group.regexp
    - match: \)
      pop: true
      captures:
        0: punctuation.definition.group.regexp
    - include: repo_regexp
  - match: (\[)(\^)?
    captures:
      1: punctuation.definition.character-class.regexp
      2: keyword.operator.negation.regexp
    push:
    - meta_scope: constant.other.character-class.set.regexp
    - match: (\])
      pop: true
      captures:
        1: punctuation.definition.character-class.regexp
    - match: (?:.|(\\(?:[0-7]{3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}))|(\\c[A-Z])|(\\.))\-(?:[^\]\\]|(\\(?:[0-7]{3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}))|(\\c[A-Z])|(\\.))
      scope: constant.other.character-class.range.regexp
      captures:
        1: constant.character.numeric.regexp
        2: constant.character.control.regexp
        3: constant.character.escape.backslash.regexp
        4: constant.character.numeric.regexp
        5: constant.character.control.regexp
        6: constant.character.escape.backslash.regexp
    - include: repo_regex-character-class
  - include: repo_regex-character-class
  repo_string-character-escape:
  - match: \\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\{[0-9A-Fa-f]+\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)
    scope: constant.character.escape.langium
