%YAML 1.2
---
# Spline Font Database (text.sfd): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/Alhadis/language-fontforge via GitHub Linguist v9.7.0 (license: isc).
name: Spline Font Database
scope: text.sfd
file_extensions:
- sfd
contexts:
  main:
  - include: repo_main
  repo_address:
  - match: \d+[xX][A-Fa-f0-9]+
    scope: constant.numeric.hexadecimal.sfd
  repo_colour:
  - match: (#)[A-Fa-f0-9]{3,}|(?<=\s)[A-Fa-f0-9]{6,8}
    scope: constant.other.hex.colour.sfd
    captures:
      1: punctuation.definition.colour.sfd
  repo_comment:
  - match: ^(U?Comments?)(:)
    captures:
      1: variable.assignment.property.sfd
      2: punctuation.separator.dictionary.key-value.sfd
    push:
    - meta_scope: meta.user-comments.sfd
    - meta_content_scope: comment.line.field.sfd
    - match: $
      pop: true
  repo_control:
  - match: \b(Fore|Back|SplineSet|^End\w+)\b
  repo_copyright:
  - match: ^(Copyright)(:)
    captures:
      1: variable.assignment.property.sfd
      2: punctuation.separator.dictionary.key-value.sfd
    push:
    - meta_scope: meta.copyright-string.sfd
    - meta_content_scope: string.unquoted.copyright.info.sfd
    - match: $
      pop: true
    - include: scope:source.fontforge
  repo_encoding:
  - match: (?i)\b(ISO[-\w]+)(?<=\d)(?=\s|$)
    scope: constant.language.encoding.sfd
  repo_gaspTable:
  - match: ^(GaspTable)(:|(?=\s))
    captures:
      1: variable.assignment.property.sfd
      2: punctuation.separator.dictionary.key-value.sfd
    push:
    - meta_scope: meta.gasp-table.sfd
    - match: $
      pop: true
    - include: repo_main
  repo_header:
  - match: ^(SplineFontDB)(:)
    scope: meta.header.sfd
    captures:
      1: keyword.control.start.file.afm
      2: punctuation.separator.dictionary.key-value.sfd
  repo_image:
  - match: ^(Image)(?=:)(.+)$
    captures:
      1: keyword.control.begin.image.sfd
    push:
    - meta_scope: meta.image.sfd
    - meta_content_scope: string.unquoted.raw.data.sfd
    - match: ^(EndImage)\b
      pop: true
      captures:
        1: keyword.control.end.image.sfd
  repo_main:
  - include: repo_punctuation
  - include: repo_private
  - include: repo_header
  - include: repo_names
  - include: repo_image
  - include: repo_pickleData
  - include: repo_sections
  - include: repo_copyright
  - include: repo_comment
  - include: repo_gaspTable
  - include: repo_property
  - include: repo_control
  - include: repo_address
  - include: repo_encoding
  - include: scope:source.fontforge
  - include: repo_colour
  - include: repo_unquoted
  repo_names:
  - match: ^((\w+)Name)(:)\s*(\S+.*?)\s$
    scope: meta.dictionary.key-value.sfd
    captures:
      1: variable.assignment.property.sfd
      3: punctuation.separator.dictionary.key-value.sfd
  repo_pickleData:
  - match: ^(PickledData)(:)\s*(")
    captures:
      1: variable.assignment.property.sfd
      2: punctuation.separator.dictionary.key-value.sfd
      3: punctuation.definition.string.begin.sfd
    push:
    - meta_scope: meta.pickle-data.sfd
    - match: '"'
      pop: true
      captures:
        0: punctuation.definition.string.end.sfd
    - match: \\.
      scope: constant.character.escape.sfd
  repo_private:
  - match: ^BeginPrivate(?=:)
    captures:
      0: keyword.control.begin.private.sfd
    push:
    - meta_scope: meta.section.private.sfd
    - match: ^EndPrivate\b
      pop: true
      captures:
        0: keyword.control.end.private.sfd
    - match: ^\S+
      scope: entity.name.private.property.sfd
    - include: repo_main
  repo_property:
  - match: ^([^:]+)(:)
    scope: meta.dictionary.key-value.sfd
    captures:
      1: variable.assignment.property.sfd
      2: punctuation.separator.dictionary.key-value.sfd
  repo_punctuation:
  - match: <|>
    scope: punctuation.definition.brackets.angle.sfd
  - match: '[{}]'
    scope: punctuation.definition.brackets.curly.sfd
  repo_sections:
  - match: ^(Start|Begin)([A-Z]\w+)(?=:)
    push:
    - match: ^(End\2)\b
      pop: true
    - include: repo_main
  repo_unquoted:
  - match: \S+
    scope: string.unquoted.property.sfd
