%YAML 1.2
---
# Jac (source.jac): converted from TextMate by tools/tm-grammars/sync.py;
# source https://github.com/jaseci-labs/jac-vscode.git via GitHub Linguist v9.7.0 (license: mit).
name: Jac
scope: source.jac
file_extensions:
- jac
contexts:
  main:
  - include: repo_elements
  repo_ability:
  - match: (?x)\b(?:(cl|sv|na)\s+)?(can|with|def|impl|sem)\b(?=\s*[[:alpha:]_]\w*|\s*({|;|\(||\n))
    captures:
      1: storage.modifier.declaration.jac
      2: storage.type.function.jac
    push:
    - meta_scope: meta.function.jac
    - match: (?=\)|{)|;
      pop: true
      captures:
        1: punctuation.section.function.begin.jac
    - include: repo_comments
    - match: ','
      scope: punctuation.separator.jac
    - include: repo_parameters
    - include: repo_builtin-types
    - include: repo_statement-keyword
    - include: repo_string
    - include: repo_archetype_refdef
    - include: repo_arch-reference
    - include: repo_arch-var-reference
    - include: repo_return-annotation
    - match: "(?x)\n  \\b ([[:alpha:]_]\\w*) \\b\n"
      scope: entity.name.function.jac
  repo_accessor:
  - match: (?x)\b(?<!\.)(getter|setter|deleter)\b(?=\s*(\(|->|{|;|\n))
    captures:
      1: storage.type.function.jac
    push:
    - meta_scope: meta.function.accessor.jac
    - match: (?=\)|{)|;
      pop: true
      captures:
        1: punctuation.section.function.begin.jac
    - include: repo_comments
    - include: repo_parameters
    - include: repo_builtin-types
    - include: repo_statement-keyword
    - include: repo_string
  repo_annotated-parameter:
  - match: "(?x)\n  \\b\n  ([[:alpha:]_]\\w*) \\s* (:)\n"
    captures:
      1: variable.parameter.function.language.jac
      2: punctuation.separator.annotation.jac
    push:
    - match: (,)|(?=\))
      pop: true
      captures:
        1: punctuation.separator.parameters.jac
    - include: repo_expression
    - match: =(?!=)
      scope: keyword.operator.assignment.jac
  repo_arch-declaration:
  - match: (?x)\s*(enum|obj|class|node|edge|walker|test)\s*(?=\s*[[:alpha:]_]\w*|:(pub|priv|protect)?\s+[[:alpha:]_]\w*|\s*({|;|\n))
    captures:
      1: storage.type.class.jac
    push:
    - meta_scope: meta.class.jac
    - match: ({|;)
      pop: true
      captures:
        1: punctuation.section.class.begin.jac
    - match: :(pub|priv|protect)?
      captures:
        1: storage.modifier.declaration.jac
    - include: repo_class-name
    - include: repo_class-inheritance
  repo_arch-reference:
  - match: \b(impl|sem)\b\s*(?=\s*[[:alpha:]_]\w*|\s*( |:|\n))
    captures:
      1: storage.type.class.jac
    push:
    - meta_scope: meta.class.jac
    - match: ((?=:| )|;)
      pop: true
      captures:
        1: punctuation.section.class.begin.jac
    - include: repo_class-name
    - include: repo_class-inheritance
  repo_arch-var-reference:
  - match: \b(here|visitor|self|init|postinit|super|root)\b
    captures:
      1: storage.type.class.jac
  repo_archetype:
  - match: (?x)\b(enum|obj|class|node|edge|walker|test)\b(?=\s+[[:alpha:]_]\w*|:(pub|priv|protect)?\s+[[:alpha:]_]\w*|\s*({|;|\n))
    captures:
      1: storage.type.class.jac
    push:
    - meta_scope: meta.class.jac
    - match: (?={)|;
      pop: true
      captures:
        1: punctuation.section.class.begin.jac
    - match: :(pub|priv|protect)?
      captures:
        1: storage.modifier.declaration.jac
    - include: repo_class-name
    - include: repo_class-inheritance
  repo_archetype_refdef:
  - match: \b(impl|sem)\b
    captures:
      1: storage.type.class.jac
    push:
    - meta_scope: meta.class.jac
    - match: (?=:|{)
      pop: true
      captures:
        1: punctuation.section.class.begin.jac
    - include: repo_comments
    - match: \b([[:alpha:]_]\w*)\b
      scope: entity.name.function.jac
  repo_assignment-operator:
  - match: "(?x)\n     <<= | >>= | //= | \\*\\*=\n    | \\+= | -= | /= | @=\n    | \\*= | %= | ~= | \\^= | &= | \\|=\n    | =(?!=)\n"
    scope: keyword.operator.assignment.jac
  repo_builtin-callables:
  - include: repo_illegal-names
  - include: repo_illegal-object-name
  - include: repo_builtin-exceptions
  - include: repo_builtin-functions
  - include: repo_builtin-types
  repo_builtin-exceptions:
  - match: "(?x) (?<!\\.) \\b(\n  (\n    Arithmetic | Assertion | Attribute | Buffer | BlockingIO\n    | BrokenPipe | ChildProcess\n    | (Connection (Aborted | Refused | Reset)?)\n    | EOF | Environment | FileExists | FileNotFound\n    | FloatingPoint | IO | Import | Indentation | Index | Interrupted\n    | IsADirectory | NotADirectory | Permission | ProcessLookup\n    | Timeout\n    | Key | Lookup | Memory | Name | NotImplemented | OS | Overflow\n    | Reference | Runtime | Recursion | Syntax | System\n    | Tab | Type | UnboundLocal | Unicode(Encode|Decode|Translate)?\n    | Value | Windows | ZeroDivision | ModuleNotFound\n  ) Error\n|\n  ((Pending)?Deprecation | Runtime | Syntax | User | Future | Import\n    | Unicode | Bytes | Resource\n  )? Warning\n|\n  SystemExit | Stop(Async)?Iteration\n  | KeyboardInterrupt\n  | GeneratorExit | (Base)?Exception\n)\\b\n"
    scope: support.type.exception.jac
  repo_builtin-functions:
  - match: "(?x)\n  (?<!\\.) \\b(\n    __import__ | abs | aiter | all | anext | ascii | bin\n    | breakpoint | callable | chr | compile | copyright | credits\n    | delattr | dir | divmod | enumerate | eval | exec | exit\n    | filter | format | getattr | globals | hasattr | hash | help\n    | hex | id | input | isinstance | issubclass | iter | len\n    | license | locals | map | max | memoryview | min | next\n    | oct | open | ord | pow | print | quit | range | reload | repr\n    | reversed | round | setattr | sorted | sum | vars | zip\n  )\\b\n"
    scope: support.function.builtin.jac
  - match: "(?x)\n  (?<!\\.) \\b(\n    file | reduce | intern | raw_input | unicode | cmp | basestring\n    | execfile | long | xrange\n  )\\b\n"
    scope: variable.legacy.builtin.jac
  repo_builtin-possible-callables:
  - include: repo_builtin-callables
  - include: repo_magic-names
  repo_builtin-types:
  - match: '(?x)(?<!\.) \b(str|int|float|list|tuple|set|dict|bool|bytes|any|type)\b

      '
    scope: support.type.jac
  repo_c_style_block_comment:
  - match: (#\*)
    captures:
      1: punctuation.definition.comment.begin.jac
    push:
    - meta_scope: comment.block.jac
    - match: (\*#)
      pop: true
      captures:
        1: punctuation.definition.comment.end.jac
    - include: repo_codetags
  repo_call-wrapper-inheritance:
  - match: "(?x)\n  \\b(?=\n    ([[:alpha:]_]\\w*) \\s* (\\()\n  )\n"
    push:
    - meta_scope: meta.function-call.jac
    - match: (\))
      pop: true
      captures:
        1: punctuation.definition.arguments.end.jac
    - include: repo_inheritance-name
    - include: repo_function-arguments
  repo_class-inheritance:
  - match: (\()
    captures:
      1: punctuation.definition.inheritance.begin.jac
    push:
    - meta_scope: meta.class.inheritance.jac
    - match: (\))
      pop: true
      captures:
        1: punctuation.definition.inheritance.end.jac
    - match: (\*\*|\*)
      scope: keyword.operator.unpacking.arguments.jac
    - match: ','
      scope: punctuation.separator.inheritance.jac
    - match: =(?!=)
      scope: keyword.operator.assignment.jac
    - match: \bmetaclass\b
      scope: support.type.metaclass.jac
    - include: repo_illegal-names
    - include: repo_class-kwarg
    - include: repo_call-wrapper-inheritance
    - include: repo_expression-base
    - include: repo_member-access-class
    - include: repo_inheritance-identifier
  repo_class-kwarg:
  - match: "(?x)\n  \\b ([[:alpha:]_]\\w*) \\s*(=)(?!=)\n"
    captures:
      1: entity.other.inherited-class.jac variable.parameter.class.jac
      2: keyword.operator.assignment.jac
  repo_class-name:
  - include: repo_illegal-object-name
  - include: repo_builtin-possible-callables
  - match: "(?x)\n  \\b ([[:alpha:]_]\\w*) \\b\n"
    scope: entity.name.type.class.jac
  repo_codetags:
  - match: (?:\b(NOTE|XXX|HACK|FIXME|BUG|TODO)\b)
    captures:
      1: keyword.codetag.notation.jac
  repo_comments:
  - include: repo_c_style_block_comment
  - include: repo_py_style_comment
  repo_comments-base:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.jac
    push:
    - meta_scope: comment.line.number-sign.jac
    - match: ($)
      pop: true
    - include: repo_codetags
  repo_comments-string-double-three:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.jac
    push:
    - meta_scope: comment.line.number-sign.jac
    - match: ($|(?="""))
      pop: true
    - include: repo_codetags
  repo_comments-string-single-three:
  - match: (\#)
    captures:
      1: punctuation.definition.comment.jac
    push:
    - meta_scope: comment.line.number-sign.jac
    - match: ($|(?='''))
      pop: true
    - include: repo_codetags
  repo_curly-braces:
  - match: \{
    captures:
      0: punctuation.definition.dict.begin.jac
    push:
    - match: \}
      pop: true
      captures:
        0: punctuation.definition.dict.end.jac
    - match: ':'
      scope: punctuation.separator.dict.jac
    - include: repo_expression
  repo_decorator:
  - match: "(?x)\n  ^\\s*\n  ((@)) \\s* (?=[[:alpha:]_]\\w*)\n"
    captures:
      1: entity.name.function.decorator.jac
      2: punctuation.definition.decorator.jac
    push:
    - meta_scope: meta.function.decorator.jac
    - match: "(?x)\n  ( \\) )\n    # trailing whitespace and comments are legal\n    (?: (.*?) (?=\\s*(?:\\#|$)) )\n  | (?=\\n|\\#)\n"
      pop: true
      captures:
        1: punctuation.definition.arguments.end.jac
        2: invalid.illegal.decorator.jac
    - include: repo_decorator-name
    - include: repo_function-arguments
  repo_decorator-name:
  - include: repo_illegal-object-name
  - match: "(?x)\n  ([[:alpha:]_]\\w*) | (\\.)\n"
    scope: entity.name.function.decorator.jac
    captures:
      2: punctuation.separator.period.jac
  - include: repo_line-continuation
  - match: "(?x)\n  \\s* ([^([:alpha:]\\s_\\.#\\\\] .*?) (?=\\#|$)\n"
    scope: invalid.illegal.decorator.jac
    captures:
      1: invalid.illegal.decorator.jac
  repo_docstring:
  - match: (\'\'\'|\"\"\")
    captures:
      1: punctuation.definition.string.begin.jac
    push:
    - meta_scope: string.quoted.docstring.multi.jac
    - match: (\1)
      pop: true
      captures:
        1: punctuation.definition.string.end.jac
    - include: repo_docstring-prompt
    - include: repo_codetags
    - include: repo_docstring-guts-unicode
  - match: ([rR])(\'\'\'|\"\"\")
    captures:
      1: storage.type.string.jac
      2: punctuation.definition.string.begin.jac
    push:
    - meta_scope: string.quoted.docstring.raw.multi.jac
    - match: (\2)
      pop: true
      captures:
        1: punctuation.definition.string.end.jac
    - include: repo_string-consume-escape
    - include: repo_docstring-prompt
    - include: repo_codetags
  - match: (\'|\")
    captures:
      1: punctuation.definition.string.begin.jac
    push:
    - meta_scope: string.quoted.docstring.single.jac
    - match: (\1)|(\n)
      pop: true
      captures:
        1: punctuation.definition.string.end.jac
        2: invalid.illegal.newline.jac
    - include: repo_codetags
    - include: repo_docstring-guts-unicode
  - match: ([rR])(\'|\")
    captures:
      1: storage.type.string.jac
      2: punctuation.definition.string.begin.jac
    push:
    - meta_scope: string.quoted.docstring.raw.single.jac
    - match: (\2)|(\n)
      pop: true
      captures:
        1: punctuation.definition.string.end.jac
        2: invalid.illegal.newline.jac
    - include: repo_string-consume-escape
    - include: repo_codetags
  repo_docstring-guts-unicode:
  - include: repo_escape-sequence-unicode
  - include: repo_escape-sequence
  - include: repo_string-line-continuation
  repo_docstring-prompt:
  - match: (?x)(?:(?:^|) \s* (?# '' is necessary for ST)((?:>>>|\.\.\.) \s) (?=\s*\S))
    captures:
      1: keyword.control.flow.jac
  repo_docstring-statement:
  - match: ^(?=\s*[rR]?(\'\'\'|\"\"\"))
    push:
    - match: ((?<=\1)|^)(?!\s*[rR]?(\'\'\'|\"\"\"))
      pop: true
    - include: repo_docstring
  repo_double-one-regexp-character-set:
  - match: "(?x)\n  \\[ \\^? \\] (?! .*?\\])\n"
  - match: (\[)(\^)?(\])?
    captures:
      1: punctuation.character.set.begin.regexp constant.other.set.regexp
      2: keyword.operator.negation.regexp
      3: constant.character.set.regexp
    push:
    - meta_scope: meta.character.set.regexp
    - match: (\]|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: punctuation.character.set.end.regexp constant.other.set.regexp
        2: invalid.illegal.newline.jac
    - include: repo_regexp-charecter-set-escapes
    - match: '[^\n]'
      scope: constant.character.set.regexp
  repo_double-one-regexp-comments:
  - match: \(\?#
    captures:
      0: punctuation.comment.begin.regexp
    push:
    - meta_scope: comment.regexp
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: punctuation.comment.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_codetags
  repo_double-one-regexp-conditional:
  - match: (\()\?\((\w+(?:\s+[[:alnum:]]+)?|\d+)\)
    captures:
      0: keyword.operator.conditional.regexp
      1: punctuation.parenthesis.conditional.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.conditional.negative.regexp punctuation.parenthesis.conditional.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-expression:
  - include: repo_regexp-base-expression
  - include: repo_double-one-regexp-character-set
  - include: repo_double-one-regexp-comments
  - include: repo_regexp-flags
  - include: repo_double-one-regexp-named-group
  - include: repo_regexp-backreference
  - include: repo_double-one-regexp-lookahead
  - include: repo_double-one-regexp-lookahead-negative
  - include: repo_double-one-regexp-lookbehind
  - include: repo_double-one-regexp-lookbehind-negative
  - include: repo_double-one-regexp-conditional
  - include: repo_double-one-regexp-parentheses-non-capturing
  - include: repo_double-one-regexp-parentheses
  repo_double-one-regexp-lookahead:
  - match: (\()\?=
    captures:
      0: keyword.operator.lookahead.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookahead.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookahead-negative:
  - match: (\()\?!
    captures:
      0: keyword.operator.lookahead.negative.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookahead.negative.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookbehind:
  - match: (\()\?<=
    captures:
      0: keyword.operator.lookbehind.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookbehind.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-lookbehind-negative:
  - match: (\()\?<!
    captures:
      0: keyword.operator.lookbehind.negative.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: keyword.operator.lookbehind.negative.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-named-group:
  - match: "(?x)\n  (\\()  (\\?P <\\w+(?:\\s+[[:alnum:]]+)?>)\n"
    captures:
      1: support.other.parenthesis.regexp punctuation.parenthesis.named.begin.regexp
      2: entity.name.tag.named.group.regexp
    push:
    - meta_scope: meta.named.regexp
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.named.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-parentheses:
  - match: \(
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-one-regexp-parentheses-non-capturing:
  - match: '\(\?:'
    captures:
      0: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.begin.regexp
    push:
    - match: (\)|(?="))|((?=(?<!\\)\n))
      pop: true
      captures:
        1: support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-one-regexp-expression
  repo_double-three-regexp-character-set:
  - match: "(?x)\n  \\[ \\^? \\] (?! .*?\\])\n"
  - match: (\[)(\^)?(\])?
    captures:
      1: punctuation.character.set.begin.regexp constant.other.set.regexp
      2: keyword.operator.negation.regexp
      3: constant.character.set.regexp
    push:
    - meta_scope: meta.character.set.regexp
    - match: (\]|(?="""))
      pop: true
      captures:
        1: punctuation.character.set.end.regexp constant.other.set.regexp
        2: invalid.illegal.newline.jac
    - include: repo_regexp-charecter-set-escapes
    - match: '[^\n]'
      scope: constant.character.set.regexp
  repo_double-three-regexp-comments:
  - match: \(\?#
    captures:
      0: punctuation.comment.begin.regexp
    push:
    - meta_scope: comment.regexp
    - match: (\)|(?="""))
      pop: true
      captures:
        1: punctuation.comment.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_codetags
  repo_double-three-regexp-conditional:
  - match: (\()\?\((\w+(?:\s+[[:alnum:]]+)?|\d+)\)
    captures:
      0: keyword.operator.conditional.regexp
      1: punctuation.parenthesis.conditional.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.conditional.negative.regexp punctuation.parenthesis.conditional.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-expression:
  - include: repo_regexp-base-expression
  - include: repo_double-three-regexp-character-set
  - include: repo_double-three-regexp-comments
  - include: repo_regexp-flags
  - include: repo_double-three-regexp-named-group
  - include: repo_regexp-backreference
  - include: repo_double-three-regexp-lookahead
  - include: repo_double-three-regexp-lookahead-negative
  - include: repo_double-three-regexp-lookbehind
  - include: repo_double-three-regexp-lookbehind-negative
  - include: repo_double-three-regexp-conditional
  - include: repo_double-three-regexp-parentheses-non-capturing
  - include: repo_double-three-regexp-parentheses
  - include: repo_comments-string-double-three
  repo_double-three-regexp-lookahead:
  - match: (\()\?=
    captures:
      0: keyword.operator.lookahead.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookahead.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookahead-negative:
  - match: (\()\?!
    captures:
      0: keyword.operator.lookahead.negative.regexp
      1: punctuation.parenthesis.lookahead.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookahead.negative.regexp punctuation.parenthesis.lookahead.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookbehind:
  - match: (\()\?<=
    captures:
      0: keyword.operator.lookbehind.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookbehind.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-lookbehind-negative:
  - match: (\()\?<!
    captures:
      0: keyword.operator.lookbehind.negative.regexp
      1: punctuation.parenthesis.lookbehind.begin.regexp
    push:
    - match: (\)|(?="""))
      pop: true
      captures:
        1: keyword.operator.lookbehind.negative.regexp punctuation.parenthesis.lookbehind.end.regexp
        2: invalid.illegal.newline.jac
    - include: repo_double-three-regexp-expression
    - include: repo_comments-string-double-three
  repo_double-three-regexp-named-group:
  - match: "(?x)\n  (\\()  (\\?P <\\w+(?:\\s+[[:alnum:]]+)?>)\n"
